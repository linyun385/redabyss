# ============================================================
# 红渊 · 仓库忽略清单
# 原则：代码 / 文档 / 配置 / 卡数据 全部入库；大体积媒体入库外。
# 2026-11-08 建立
# ============================================================

# ---- 大体积媒体（合计约 2.4 GB，不入库）----
art/
models/
web/assets/
web/sfx/
dist/

# ---- data/ 只留文本，图片和视频排除 ----
data/**/*.png
data/**/*.webp
data/**/*.jpg
data/**/*.jpeg
data/**/*.mp4
data/**/*.gif

# ---- Python / Node 缓存 ----
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
node_modules/

# ---- 临时产物 ----
*.log
.tmp*
*.tmp
~$*

# ---- 工具截图（tools 下的调试截图，不入库）----
tools/*.png
tools/*.jpg

# ---- 备份快照（体积大、可重新生成；整理时归到各自 _backups/）----
web/_backups/

# ---- 系统 / 编辑器 ----
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# ---- 存档与运行时状态 ----
*.bak
*.bak-*
*.corrupt
*.recovered
