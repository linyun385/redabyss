<!DOCTYPE html>
<html lang="zh-CN" data-theme="C">
<head>
<meta charset="utf-8">
<title>红渊：下潜</title>
<style>
  :root {
    --bg: #0a0506;
    /* T76 选项变量（off 暗底：浅纸片选项，与暗底拉开） */
    --opt-bg: #e7dfcc; --opt-bg-hover: #f5eee0; --opt-fg: #2b2118; --opt-sub: #6b5334; --opt-border: #2b2118; --opt-bar: #84b2e4;
    --red: #8b1a1a;
    --red-hi: #e2705f;   /* T52：#d94a4a 在 D1 层底上只有 2.41，提到 3.22 */
    --text: #d8cfc9;
    --dim: #a89a90;      /* T52：#7a6f6a 在最黑两层只有 2.07，提到 3.68 */
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { height: 100%; }
  body {
    background: var(--bg);
    color: var(--text);
    font-family: ui-monospace, Consolas, monospace;
    font-size: 14px;
    line-height: 1.5;
    overflow: hidden;
    transition: background-color .4s ease;
  }
  .hidden { display: none !important; }
  #app { height: 100vh; display: flex; flex-direction: column; overflow: hidden; }

  /* 战斗屏必须能被压缩，否则日志会把页面撑爆、把「结束回合」挤出视口。
     同时和地图/事件/开场共用同一条 1240px 内容梁，切换界面不跳。 */
  #screen-combat {
    flex: 1 1 0; min-height: 0;
    display: flex; flex-direction: column;
    width: 100%; max-width: var(--lane);
    margin: 0 auto; box-sizing: border-box;
    position: relative;              /* 右侧卡牌信息区 #card-detail 以它为定位基准 */
  }

  /* ── 统一内容梁：所有界面同宽、同位置 ── */
  :root { --lane: 1240px; }

  #screen-select { margin: auto; text-align: center; width: 100%; max-width: var(--lane); }
  #screen-select h1 { color: var(--red-hi); font-size: 30px; letter-spacing: 8px; margin-bottom: 8px; }
  #screen-select .sub { color: var(--dim); margin-bottom: 40px; }
  .class-row { display: flex; gap: 24px; justify-content: center; }
  /* T78 卡面选择：纯卡面（立绘+职业名），点开详情模态 */
  .class-row { display: flex; gap: 26px; justify-content: center; flex-wrap: wrap; }
  .classface {
    width: 200px; padding: 0; background: #140c0d; border: 1px solid #4a2a2c; border-radius: 6px;
    cursor: pointer; overflow: hidden; text-align: center;
    transition: transform .15s ease, border-color .15s ease, box-shadow .15s ease;
  }
  .classface img { display: block; width: 100%; aspect-ratio: 3 / 4; object-fit: cover; }
  .classface .cname { display: block; padding: 10px 0 12px; color: var(--red-hi); font-size: 17px; letter-spacing: 4px; }
  .classface:hover, .classface:focus-visible { transform: translateY(-4px); border-color: var(--red-hi);
    box-shadow: 0 8px 22px rgba(226, 112, 95, .25); outline: none; }
  .classface:focus-visible { box-shadow: 0 8px 22px rgba(226, 112, 95, .25), 0 0 0 2px var(--red-hi); }
  /* T78 职业详情模态：左卡面大图 / 右详情（1280×720 下 40% / 60%） */
  #class-modal { position: fixed; inset: 0; background: rgba(4, 2, 3, .8); z-index: 95;
    display: flex; align-items: center; justify-content: center; }
  #class-modal.hidden { display: none; }
  #class-modal-box { position: relative; display: flex; gap: 0; width: min(940px, 92vw); max-height: 86vh;
    background: #101418; color: var(--text); border: 1px solid var(--red);
    border-radius: 8px; overflow: hidden; box-shadow: 0 14px 40px rgba(0, 0, 0, .6); }
  #class-modal-art { flex: 0 0 40%; min-height: 460px; background: #0d0708; }
  #class-modal-art img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #class-modal-detail { flex: 1 1 60%; padding: 30px 34px; text-align: left; overflow-y: auto; }
  #class-modal-detail h2 { color: var(--red-hi); font-size: 26px; letter-spacing: 6px; margin-bottom: 10px; }
  #class-modal-detail .cm-line { color: var(--text); margin-bottom: 18px; line-height: 1.8; }
  #class-modal-detail ul { list-style: none; padding: 0; margin: 0 0 16px; }
  #class-modal-detail .cm-stats li { color: var(--text); font-size: 14px; padding: 3px 0;
    border-bottom: 1px dashed rgba(139, 26, 26, .5); }
  #class-modal-detail .cm-mechs li { color: var(--dim); font-size: 13px; padding: 4px 0 4px 14px;
    position: relative; line-height: 1.7; }
  #class-modal-detail .cm-mechs li::before { content: "◆"; position: absolute; left: 0; color: var(--red); font-size: 10px; }
  #class-modal-detail .btnrow { margin-top: 22px; }
  #btn-dive-confirm { padding: 10px 26px; font-size: 15px; letter-spacing: 2px; }
  #class-modal-close { position: absolute; top: 6px; right: 10px; background: none; border: none;
    color: var(--text); font-size: 24px; cursor: pointer; line-height: 1; z-index: 2; }
  #class-modal-close:hover { color: var(--red-hi); }

  /* ── HUD ── */
  #hud {
    display: flex; flex-direction: column; align-items: center; gap: 3px;
    padding: 6px 14px 5px; border-bottom: 1px solid var(--red);
    background: #100809; white-space: nowrap;
    flex: 0 0 auto; overflow: hidden;
  }
  .hud-stats { display: flex; gap: 18px; justify-content: center; flex-wrap: wrap; }
  /* HUD 图标化：符号在前、文字标签弱化、符号与数字固定间距 */
  .hud-stats .stat { display: inline-flex; align-items: baseline; gap: 6px; }
  .hud-stats .ic { font-style: normal; font-size: 14px; line-height: 1; }
  .hud-stats .ic.hp { color: #8b2a20; }
  .hud-stats .ic.block { color: #5a7fa0; }
  .hud-stats .ic.energy { color: #a8834a; }
  .hud-stats .ic.res { color: #b05a1a; }
  .hud-stats .ic.gaze { color: #8b1a1a; }
  .hud-stats .ic.gold { color: #c9a35a; }
  .hud-stats .ic.parts { color: #8a8a8a; }
  .hud-stats .ic.clarity { color: #7a8fb0; }
  .hud-stats .k { color: var(--dim); font-size: 10px; opacity: .8; }
  .hud-relics { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; font-size: 12px; }
  #hud .k { color: var(--dim); }
  #hud .v { color: var(--text); }
  #hud .v.hp-low { color: var(--red-hi); }
  #hud #gaze-val.flash { animation: gazeblink .4s steps(2) 2; }
  @keyframes gazeblink { 50% { color: var(--red-hi); } }
  /* 获得格挡：盾形符号脉冲（T37） */
  #hud-block-wrap .ic.block.pulse { animation: blockpulse .4s ease; display: inline-block; }
  @keyframes blockpulse { 50% { transform: scale(1.5); } }
  /* 牌堆洗回：抽牌堆数字重置动画（T37） */
  #pile-draw.pulse { animation: pilepulse .4s ease; display: inline-block; }
  @keyframes pilepulse { 50% { transform: scale(1.3); color: var(--red-hi); } }
  /* 新回合行：600ms 提示（T37 时序表） */
  #log div.turnline.new { animation: turnflash .6s ease; }
  @keyframes turnflash { 0% { color: var(--red-hi); opacity: 0; } }
  #hud-relics span { cursor: help; color: var(--red-hi); }

  /* ── 敌人区 ── */
  #enemy-area {
    display: flex; gap: 20px; padding: 18px 14px; min-height: 150px;
    border-bottom: 1px solid #2a1517; flex: 0 0 auto; overflow-x: auto;
    justify-content: center;
  }
  .enemy {
    width: 230px; border: 1px solid #3a2022; border-radius: 4px;
    padding: 10px; background: #100a0b; position: relative; cursor: pointer;
  }
  .enemy.targetable { border-color: var(--red-hi); }
  .enemy.dead { opacity: .35; filter: grayscale(1); cursor: default; }
  .enemy .ename { color: var(--red-hi); }
  .enemy .intent { margin-top: 4px; color: var(--text); }
  .enemy .intent.flash { animation: intentblink .2s ease; }
  @keyframes intentblink { from { opacity: 0; } to { opacity: 1; } }
  /* 敌人受击：120ms 闪红 */
  .enemy.hitflash { animation: ehit .12s ease; }
  @keyframes ehit { 40% { border-color: var(--red-hi); background: #2a0d0e; } }
  .enemy .intent .i-atk { color: var(--red-hi); }
  .enemy .intent .i-def { color: #6f8b9a; }
  .enemy .hpbar { margin-top: 8px; height: 8px; background: #1c1012; border: 1px solid #3a2022; position: relative; }
  .enemy .hpbar > i { display: block; height: 100%; background: var(--red); }
  .enemy .hpbar .pmark { position: absolute; top: -2px; bottom: -2px; width: 1px; background: var(--red-hi); opacity: .8; }
  #phase-banner {
    position: fixed; top: 34%; left: 50%; transform: translateX(-50%);
    background: rgba(10,5,6,.92); color: var(--red-hi);
    border: 1px solid var(--red); border-radius: 4px;
    padding: 10px 22px; font-size: 15px; letter-spacing: 2px;
    opacity: 0; pointer-events: none; transition: opacity .3s; z-index: 40; max-width: 70vw;
  }
  #phase-banner.show { opacity: 1; }
  .enemy .hpnum { color: var(--dim); font-size: 12px; }
  .enemy .eblock { position: absolute; right: 8px; top: 8px; color: #6f8b9a; }
  /* 敌人图案区：60px 高，预留素材接口（内联背景样式覆盖层级符号） */
  .enemy .eart {
    height: 60px; margin: -10px -10px 8px;
    background: #1a1214; border-bottom: 1px solid #2a1517; border-radius: 3px 3px 0 0;
    display: flex; align-items: center; justify-content: center;
  }
  .enemy .eart span { font-size: 30px; color: #3a2224; }
  .float {
    position: absolute; left: 50%; top: 30%;
    transform: translateX(-50%);
    color: var(--red-hi); font-weight: bold; pointer-events: none;
    animation: floatup .4s ease-out forwards; z-index: 5;
  }
  .float.heal { color: #7da06f; }
  @keyframes floatup { to { transform: translate(-50%, -34px); opacity: 0; } }

  /* ── 日志 ── */
  #log-wrap {
    flex: 1 1 0; overflow-y: auto; padding: 8px 14px;
    border-bottom: 1px solid #2a1517; min-height: 60px;
  }
  #log { max-width: 900px; margin: 0 auto; text-align: center; }
  #log-wrap::-webkit-scrollbar, #help-page::-webkit-scrollbar { width: 8px; }
  #log-wrap::-webkit-scrollbar-thumb, #help-page::-webkit-scrollbar-thumb { background: #4a2a2c; border-radius: 4px; }
  #log-wrap::-webkit-scrollbar-track, #help-page::-webkit-scrollbar-track { background: transparent; }
  #log div { color: var(--dim); font-size: 12px; }
  #log div.turnline { color: var(--red); margin-top: 4px; }
  #log div.hurt { color: var(--text); }

  /* ── 手牌区 ── */
  #hand-area { padding: 8px 14px 12px; flex: 0 0 auto; }
  #hand { position: relative; height: 238px; min-height: 238px; }
  /* 卡牌模板：长方形（约 0.71），四段结构 cost/ctype → art → cname → ctext/cflavor。
     图案区是给未来素材留的接口：给 .art 元素加内联背景样式（如 backgroundImage 一项指向本地 webp）即可覆盖符号。 */
  .card {
    position: relative; width: 150px; height: 210px;
    display: flex; flex-direction: column; overflow: hidden;
    background: #140c0d; border: 1px solid #4a2a2c; border-radius: 5px;
    padding: 0; cursor: pointer; font-size: 12px;
  }
  .card:hover { border-color: var(--red-hi); }
  /* 可出的卡：hover 上浮 4px（性能降级或减动效时只留颜色变化） */
  .card { transition: transform .15s ease, border-color .15s ease, box-shadow .15s ease; }
  #flow-cards .card:not(.dimmed):not(.wrongworld):hover { transform: translateY(-4px); }
  html[data-theme="B"] .card:not(.dimmed):hover,
  html[data-theme="C"] .card:not(.dimmed):hover { box-shadow: 0 6px 14px rgba(0, 0, 0, .35); }
  .card.shakeit { animation: shakeit .3s ease; }
  @keyframes shakeit { 25% { transform: translateX(-4px); } 75% { transform: translateX(4px); } }
  .card.costly { border-color: var(--red); background: #170909; }
  .card.dimmed { opacity: .35; cursor: not-allowed; }
  .card.selected { outline: 1px solid var(--red-hi); border-color: var(--red-hi); }
  .card .cost {
    position: absolute; left: 5px; top: 5px; z-index: 2;
    width: 18px; height: 18px; border-radius: 50%;
    border: 1px solid var(--red-hi); color: var(--red-hi); background: #140c0d;
    text-align: center; line-height: 17px; font-size: 11px;
  }
  .card .art {
    height: 78px; flex: 0 0 auto;
    background: #1a1214; border-bottom: 1px solid #4a2a2c;
    display: flex; align-items: center; justify-content: center;
    position: relative; overflow: hidden;
  }
  .card .art-ph { font-size: 30px; color: #3a2224; }
  /* 填图开关：.art/.portrait/.eart 一旦带上内联背景样式，预留符号自动让位 */
  .card .art[style*="background"] .art-ph,
  .enemy .eart[style*="background"] span { display: none; }
  .card .cname { color: var(--text); font-size: 13px; padding: 6px 8px 0; }
  .card .cveins { margin-top: 3px; padding: 0 8px; }
  .card .cveins span {
    display: inline-block; padding: 0 3px; margin-right: 3px;
    border: 1px solid #4a2a2c; color: var(--dim); font-size: 10px; border-radius: 2px;
  }
  .card .ctype { position: absolute; right: 6px; top: 6px; z-index: 2; color: var(--dim); font-size: 10px; }
  .card .ctext { color: var(--dim); font-size: 11px; margin-top: 3px; padding: 0 8px; }
  .card .cflavor {
    margin-top: auto; padding: 3px 8px 6px; color: #5a4446; font-size: 10px;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  /* ── 手牌扇形叠放（T53：点击=详情，拖出=打出） ── */
  #hand .card {
    position: absolute; left: 50%; bottom: 4px; margin-left: -75px;
    --fan: translateX(calc(-50% + var(--tx, 0px))) translateY(var(--ty, 0px)) rotate(var(--rot, 0deg));
    transform: var(--fan);
    transform-origin: 50% 100%;
  }
  #hand .card:hover:not(.dimmed):not(.wrongworld):not(.dragging) {
    transform: translateX(calc(-50% + var(--tx, 0px))) translateY(calc(var(--ty, 0px) - 46px)) rotate(0deg) scale(1.06);
    z-index: 99;
  }
  #hand .card.selected {
    transform: translateX(calc(-50% + var(--tx, 0px))) translateY(calc(var(--ty, 0px) - 46px)) rotate(0deg);
    z-index: 98;
  }
  #hand .card.dragging { transition: none !important; z-index: 100; cursor: grabbing; }
  /* ── T53 卡牌详情：改成战斗屏右侧的常驻信息区（2026-10-30 用户定）──
     选/拖一张牌 → 右侧显示大卡面 + 数值 + 说明；不遮战斗、不盖手牌。 */
  #card-detail {
    position: absolute; right: 2px; top: 92px; width: 304px;
    background: #120a0b; border: 1px solid var(--red); border-radius: 6px;
    padding: 12px; z-index: 55;
    display: flex; flex-direction: column; gap: 10px;
    max-height: calc(100% - 112px); overflow: hidden;
  }
  #card-detail .cd-close {
    position: absolute; right: 6px; top: 4px; background: none; border: 0;
    color: var(--dim); font: inherit; font-size: 15px; cursor: pointer; padding: 2px 6px;
  }
  #card-detail .cd-close:hover { color: var(--red-hi); }
  #cd-box { display: flex; flex-direction: column; gap: 8px; min-height: 0; }
  #cd-card { display: flex; justify-content: center; }
  #cd-card .card { width: 168px; height: 236px; cursor: default; position: relative; }
  #cd-card .card .cname { font-size: 14px; }
  #cd-side { display: flex; flex-direction: column; min-height: 0; }
  #cd-side h3 { color: var(--red-hi); font-weight: normal; letter-spacing: 1px; margin: 0 0 6px; font-size: 14px; }
  #cd-lines { flex: 1 1 auto; font-size: 12.5px; color: var(--text); line-height: 1.65; overflow-y: auto; }
  #cd-lines .warn { color: var(--red-hi); }
  #cd-lines .osub { color: var(--dim); font-size: 12px; margin-top: 6px; }
  #cd-side .btnrow { display: flex; gap: 10px; margin-top: 8px; }
  #cd-side button { background: #1a0d0e; color: var(--red-hi); border: 1px solid var(--red); border-radius: 4px; font-family: inherit; padding: 5px 16px; cursor: pointer; }
  #cd-side button:disabled { opacity: .35; cursor: not-allowed; }
  #cd-side button:hover:not(:disabled) { border-color: var(--red-hi); }
  /* T76 选项变量（B/C 暗底+纸 UI：纸片选项，与卡牌同语言） */
  html[data-theme="B"], html[data-theme="C"] { --opt-bg: #e7dfcc; --opt-bg-hover: #f5eee0; --opt-fg: #2b2118; --opt-sub: #6b5334; --opt-border: #6b5334; --opt-bar: #84b2e4; }
  html[data-theme="B"] #card-detail, html[data-theme="C"] #card-detail { background: var(--paper); border-color: #b39a6b; }
  html[data-theme="B"] #cd-lines, html[data-theme="C"] #cd-lines { color: var(--ink); }
  html[data-theme="B"] #cd-side button, html[data-theme="C"] #cd-side button { background: #cfc3ae; }
  /* 拖动中靠近判定区的敌人点亮（判定区 = 矩形外扩，见 dropEnemy） */
  .enemy.drop-hot {
    border-color: #c8342a;
    box-shadow: 0 0 0 3px rgba(200, 52, 42, .35), 0 0 20px rgba(200, 52, 42, .45);
  }
  #hand-foot { display: flex; gap: 16px; align-items: center; margin-top: 8px; }
  #piles span { color: var(--dim); cursor: pointer; text-decoration: underline; margin-right: 12px; }
  #piles span:hover { color: var(--text); }
  #btn-end {
    margin-left: auto; background: #1a0d0e; color: var(--red-hi);
    border: 1px solid var(--red); border-radius: 4px;
    font-family: inherit; font-size: 14px; padding: 6px 22px; cursor: pointer;
  }
  #btn-end:hover { border-color: var(--red-hi); }

  /* ── ? 机制速查（战斗右下角） ── */
  #btn-help {
    flex: 0 0 auto; width: 30px; height: 30px; border-radius: 50%;
    background: #1a0d0e; color: var(--dim);
    border: 1px solid #4a2a2c; font-family: inherit; font-size: 15px;
    cursor: pointer; padding: 0;
  }
  #btn-help:hover { border-color: var(--red-hi); color: var(--red-hi); }
  #help-overlay { position: fixed; inset: 0; background: rgba(0,0,0,.74);
                  display: flex; align-items: center; justify-content: center; z-index: 60; }
  #help-page { width: min(600px, 92vw); max-height: 84vh; overflow-y: auto;
               background: #120a0b; border: 1px solid var(--red); border-radius: 4px;
               padding: 22px 26px; }
  #help-page h3 { color: var(--red-hi); letter-spacing: 4px; margin: 0 0 4px; font-size: 18px; font-weight: normal; }
  #help-page .hnote { color: var(--dim); margin: 0 0 14px; font-size: 13px; }
  #help-page .hrow { display: flex; gap: 14px; margin: 0 0 12px; text-align: left; }
  #help-page .hrow b { flex: 0 0 3em; color: var(--red-hi); font-weight: normal; }
  #help-page .hrow span { color: var(--text); }
  #help-page .btnrow { margin-top: 16px; display: flex; justify-content: center; }
  #help-page .btnrow button {
    background: #1a0d0e; color: var(--red-hi);
    border: 1px solid var(--red); border-radius: 4px;
    font-family: inherit; font-size: 14px; padding: 6px 22px; cursor: pointer;
  }
  #help-page .btnrow button:hover { border-color: var(--red-hi); }

  /* ── 流程屏（层/奖励/事件/结算） ── */
  #screen-flow { flex: 1 1 0; min-height: 0; overflow-y: auto; padding: 24px 16px;
                 display: flex; flex-direction: column; }
  #flow-panel { max-width: var(--lane); margin: auto; text-align: center; width: 100%; }
  /* 长文本保持左对齐，读起来才不累 */
  #flow-panel .flavor, #flow-panel .statline, #flow-panel .ending { text-align: left; }
  #flow-panel h2 { color: var(--red-hi); letter-spacing: 4px; margin-bottom: 6px; font-size: 20px; }
  #flow-panel .progress { color: var(--dim); margin-bottom: 18px; }
  #flow-panel .flavor { color: var(--dim); margin-bottom: 18px; white-space: pre-wrap; }
  #flow-panel .rulerow {
    color: var(--text);
    margin: 0 auto 18px; max-width: 640px; text-align: center;
  }
  /* 地图底部那句短提示跟着居中；正文长文本仍按 .flavor 左对齐 */
  #flow-panel .mapfoot { text-align: center; }
  #flow-panel .opts { display: flex; flex-direction: column; gap: 12px; max-width: 760px; margin: 0 auto; }
  .optbtn {
    text-align: left; background: var(--opt-bg); color: var(--opt-fg);
    border: 1px solid var(--opt-border); border-left: 3px solid var(--opt-bar);
    border-radius: 4px; padding: 16px 22px;
    font-family: inherit; font-size: 15px; cursor: pointer;
  }
  .optbtn:hover:not(:disabled) { background: var(--opt-bg-hover); border-color: var(--red-hi); }
  .optbtn:disabled { opacity: .45; cursor: not-allowed; }   /* T76: disabled 只降到 0.45 */
  .optbtn .osub { color: var(--dim); font-size: 12px; margin-top: 2px; }
  #flow-cards { display: flex; gap: 18px; flex-wrap: wrap; margin: 16px 0 20px; justify-content: center; }
  #flow-cards .card { width: 190px; height: 267px; font-size: 14px; }
  #flow-cards .card .cname { font-size: 15px; }
  #flow-cards .card .cost { width: 22px; height: 22px; line-height: 21px; font-size: 13px; }
  #flow-cards .card .art { height: 100px; }
  #flow-cards .card .art-ph { font-size: 40px; }
  #flow-panel .btnrow { margin-top: 16px; display: flex; gap: 12px; justify-content: center; }
  #flow-panel .btnrow button {
    background: #1a0d0e; color: var(--red-hi);
    border: 1px solid var(--red); border-radius: 4px;
    font-family: inherit; font-size: 14px; padding: 6px 22px; cursor: pointer;
  }
  #flow-panel .btnrow button:hover { border-color: var(--red-hi); }
  #flow-panel .statline { color: var(--text); margin: 3px 0; }
  #flow-panel .statline b { color: var(--red-hi); font-weight: normal; }
  #flow-panel .ending { color: var(--text); border: 1px solid var(--red); padding: 14px; margin-bottom: 16px; white-space: pre-wrap; }
  /* 死亡结算的"这一局最值得说的事"（T39） */
  #flow-panel .memoline { color: var(--red-hi); margin: 14px 0 4px; }
  /* 死因提示（T40）：弱化的说明行 */
  #flow-panel .hintline { color: var(--dim); font-size: 12px; margin: 6px 0 0; }
  /* 彩蛋触发的微闪：金色，与共振闪红区分 */
  body.eggflash #app { animation: eggflash .4s ease; }
  @keyframes eggflash { 30% { box-shadow: inset 0 0 60px rgba(201, 163, 90, .4); } }
  .relicrow { margin: 10px 0 16px; }
  .relicrow .relic {
    display: inline-block; border: 1px solid #4a2a2c; border-radius: 4px;
    background: #120a0b; padding: 8px 12px; margin: 0 8px 8px 0; cursor: pointer;
    font-size: 12px; max-width: 240px;
  }
  .relicrow .relic { transition: transform .15s ease, border-color .15s ease; }
  .relicrow .relic:hover { border-color: var(--red-hi); transform: translateY(-2px); }
  .relicrow .relic b { color: var(--red-hi); font-weight: normal; display: block; }
  .relicrow .relic i { color: var(--dim); font-style: normal; }

  /* ── 层内地图 ── */
  #map {
    display: flex; flex-direction: column-reverse; gap: 14px;
    margin: 12px auto 18px; width: fit-content;
  }
  .maprow { display: flex; gap: 150px; padding: 0 40px; justify-content: center; }
  .mnode {
    width: 140px; height: 80px; display: flex; align-items: center; justify-content: center;
    border: 1px solid #4a2a2c; border-radius: 4px; background: #120a0b;
    color: var(--dim); cursor: default; font-size: 22px; letter-spacing: 4px;
  }
  .mnode.done { opacity: .3; }
  .mnode.here { border-color: var(--red); color: var(--red-hi); }
  .mnode.pickable { border-color: var(--red-hi); color: var(--text); cursor: pointer;
    animation: mblink 1s steps(2) infinite, glowbreath 2s ease-in-out infinite; }
  .mnode.pickable { transition: transform .15s ease; }
  .mnode.pickable:hover { background: #1a0d0e; transform: translateY(-2px); }
  @keyframes mblink { 50% { border-color: var(--red); } }
  /* 可走节点的外层光晕呼吸（T37：一眼能分辨能点） */
  @keyframes glowbreath { 0%, 100% { box-shadow: 0 0 0 rgba(200, 60, 60, 0); } 50% { box-shadow: 0 0 16px rgba(200, 60, 60, .55); } }

  /* ── 通用浮层 ── */
  #toast {
    position: fixed; left: 50%; bottom: 170px; transform: translateX(-50%);
    background: #1a0d0e; color: var(--red-hi); border: 1px solid var(--red);
    padding: 4px 14px; border-radius: 4px; opacity: 0; pointer-events: none;
    transition: opacity .2s; z-index: 20; max-width: 70vw;
  }
  #toast.show { opacity: 1; }
  #overlay {
    position: fixed; inset: 0; background: rgba(4,2,3,.86);
    z-index: 30; display: flex; align-items: center; justify-content: center;
  }
  #overlay .panel {
    width: min(720px, 90vw); max-height: 80vh; overflow-y: auto;
    background: #100809; border: 1px solid var(--red); border-radius: 4px; padding: 20px;
  }
  #overlay .panel h3 { color: var(--red-hi); margin-bottom: 12px; letter-spacing: 4px; }
  #overlay .panel .prow { display: flex; gap: 10px; color: var(--dim); font-size: 12px; padding: 2px 0; }
  #overlay .panel .prow b { color: var(--text); font-weight: normal; }
  #overlay .panel button {
    margin-top: 16px; background: #1a0d0e; color: var(--red-hi);
    border: 1px solid var(--red); border-radius: 4px;
    font-family: inherit; padding: 5px 18px; cursor: pointer;
  }

  /* 营火 */
  .campopt {
    background: var(--opt-bg); color: var(--opt-fg);
    border: 1px solid var(--opt-border); border-left: 3px solid var(--opt-bar);
    border-radius: 4px; padding: 12px 16px;
    margin-bottom: 10px; max-width: 640px; cursor: pointer;
  }
  .campopt:hover { background: var(--opt-bg-hover); border-color: var(--red-hi); }
  .campopt b { color: var(--red); font-weight: normal; display: block; margin-bottom: 4px; }
  .campopt span { font-size: 13px; }
  .campopt.disabled { opacity: .45; cursor: default; }   /* T76: disabled 只降到 0.45 */
  .campopt.disabled:hover { background: var(--opt-bg); border-color: var(--opt-border); }
  /* T76 营火选项色条：按位轮换生态色板（与地图生态块同源，见 tools/check_palette.js） */
  .campopt:nth-of-type(3n+1) { border-left-color: #68b291; }
  .campopt:nth-of-type(3n+2) { border-left-color: #998b53; }
  .campopt:nth-of-type(3n)   { border-left-color: #c46994; }

  /* 商店 */
  .shopgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px; max-width: 880px; }
  .shopitem { border: 1px solid var(--red); border-radius: 4px; padding: 10px 12px; cursor: pointer; color: var(--text); }
  .shopitem:hover { border-color: var(--red-hi); background: #1a0d0e; }
  .shopitem b { display: block; color: var(--red-hi); font-weight: normal; margin-bottom: 4px; }
  .shopitem i { color: var(--dim); font-style: normal; font-size: 12px; display: block; margin-bottom: 6px; min-height: 30px; }
  .shopitem .price { color: #c9a35a; }
  .shopitem.cant { opacity: .35; cursor: default; }
  .shopitem.cant:hover { border-color: var(--red); background: none; }
  .shopitem.sold { opacity: .2; cursor: default; pointer-events: none; }

  /* 升级卡标记：金色边框 + 金色卡名 */
  .card.upgraded { border-color: #c9a35a; box-shadow: 0 0 0 1px #c9a35a; }
  .card.upgraded .cname { color: #c9a35a; }

  /* 无障碍：字号/低饱和切换、键盘焦点 */
  .fontbtns { position: fixed; right: 10px; top: 6px; z-index: 15; display: flex; gap: 4px; }
  .fontbtns button {
    background: #1a0d0e; color: var(--dim); border: 1px solid #3a1d1f;
    border-radius: 3px; font-family: inherit; font-size: 11px; padding: 2px 7px; cursor: pointer;
  }
  .fontbtns button:hover { color: var(--red-hi); border-color: var(--red); }
  body.lowsat #app { filter: saturate(.55) contrast(.95); }
  button:focus-visible, .mnode:focus-visible, .campopt:focus-visible, .card:focus-visible {
    outline: 2px solid #c9a35a; outline-offset: 1px;
  }

  /* 反馈：受击震屏、出牌飞出 */
  .intent.atk-hot { animation: atkpulse 1.4s ease-in-out infinite; }
  @keyframes atkpulse { 50% { border-color: var(--red-hi); color: var(--red-hi); } }

  #protocol-banner {
    text-align: center; margin: 6px auto 0; max-width: 60vw;
    border: 1px solid #c9a35a; color: #c9a35a; padding: 3px 10px; border-radius: 3px; letter-spacing: 2px;
  }
  #map.echo .mnode { border-color: #4d8f9e; }
  #map.echo .mnode.pickable { color: #9ed3de; }
  #map.echo .mnode.here { border-color: #9ed3de; }
  #hud-parts-wrap { cursor: pointer; }
  /* 苍民双世界：醒（冷灰蓝）/ 梦（暗红脉动） */
  #screen-combat.world-dream { transition: background .4s ease; background: #190708; }
  #screen-combat.world-wake { transition: background .4s ease; background: #101318; }
  #screen-combat.world-dream::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    box-shadow: inset 0 0 70px rgba(150, 25, 30, .35);
    animation: dreampulse 2s ease-in-out infinite;
  }
  @keyframes dreampulse { 50% { box-shadow: inset 0 0 40px rgba(150, 25, 30, .18); } }
  .card.wrongworld { opacity: .3; }
  .v.clarity-low { animation: atkpulse 1.2s ease-in-out infinite; color: var(--red-hi); }
  .enemy { transition: opacity .4s ease, filter .4s ease; }
  .enemy.dead { opacity: .25; }
  .intent.atk-hot { animation: atkpulse 1.4s ease-in-out infinite; }
  @keyframes atkpulse { 50% { border-color: var(--red-hi); color: var(--red-hi); } }

  @keyframes shake { 25% { transform: translateX(-7px); } 75% { transform: translateX(7px); } }
  body.shake #app { animation: shake .22s linear 1; }
  @keyframes cardfly { to { transform: translateY(-80px) scale(.65) rotate(6deg); opacity: 0; } }
  .card.ghost-fly { position: fixed; z-index: 40; animation: cardfly .22s ease-in forwards; pointer-events: none; }

  /* 濒血：红光从屏幕边缘往里渗 */
  body.dying #app::after {
    content: ''; position: fixed; inset: 0; pointer-events: none; z-index: 12;
    box-shadow: inset 0 0 90px rgba(160, 20, 25, .55);
    animation: dyingpulse 1.6s ease-in-out infinite;
  }
  @keyframes dyingpulse { 50% { box-shadow: inset 0 0 60px rgba(160, 20, 25, .3); } }

  /* 尊重系统「减少动态效果」设置 */
  @media (prefers-reduced-motion: reduce) {
    body.shake #app, .card.ghost-fly, body.dying #app::after,
    .mnode.pickable, #toast, body.resflash #app, #phase-banner.show,
    .card.shakeit, #hud-block-wrap .ic.block.pulse, #pile-draw.pulse,
    #log div.turnline.new, .enemy.hitflash { animation: none !important; }
    #flow-cards .card:not(.dimmed):hover, .mnode.pickable:hover, .relicrow .relic:hover { transform: none; }
    #hand .card:hover:not(.dimmed):not(.dragging) { transform: var(--fan); }
  }

  /* ───────── T44 材质候选主题（默认 off = 现状） ─────────
     切换：document.documentElement.dataset.theme = 'A' | 'B' | 'C' | 'off'
     A 全纸底：整页老化纸，棕墨主线，层色以 22% 混进纸底保深度信息
     B 暗底贴纸：背景/层色不动，卡牌 + 日志 + 速查页改纸底
     C 层色+纸纹：层色不动，叠纸纹与暗角，卡牌改纸底
     只动 CSS 变量层与覆盖样式；--layer-bg 由 applyLayerTheme 写入原始层色。 */
  :root { --paper: #d9cfbe; --ink: #2b2118; --ink-dim: #6b5334; --grain-opacity: .55; }
  /* T76 选项变量（A 全纸底：纸片比页底再亮一档） */
  html[data-theme="A"] { --opt-bg: #f2ead8; --opt-bg-hover: #faf4e9; --opt-fg: #2b2118; --opt-sub: #6b5334; --opt-border: #2b2118; --opt-bar: #84b2e4; }

  html[data-theme="A"] body {
    --bg: color-mix(in srgb, var(--paper) 78%, var(--layer-bg) 22%);
    --text: #2b2118;
    --dim: #6b5334;
    --red: #8b2a20;
    --red-hi: #6b1a12;
  }
  html[data-theme="A"] #hud { background: #cfc3ae; border-bottom-color: #8a7050; }
  html[data-theme="A"] .mnode { background: #cfc3ae; border-color: #8a7050; }
  html[data-theme="A"] .mnode.here { background: #d9cfbe; }
  html[data-theme="A"] .card { background: #d9cfbe; border-color: #8a7050; }
  html[data-theme="A"] .card.costly { background: #d3c6ae; }
  html[data-theme="A"] .card .cost { background: #d9cfbe; }
  html[data-theme="A"] .card .art { background: #e7dfcc; border-bottom-color: #b39a6b; }
  html[data-theme="A"] .card .cflavor { color: #8a7050; }
  html[data-theme="A"] .enemy { background: #d3c8b2; border-color: #8a7050; }
  html[data-theme="A"] .enemy .eart { background: #e7dfcc; border-bottom-color: #b39a6b; }
  html[data-theme="A"] .enemy .hpbar { background: #b9ac93; border-color: #8a7050; }
  html[data-theme="A"] .optbtn { background: #cfc3ae; border-color: #8a7050; }
  html[data-theme="A"] #flow-panel .btnrow button,
  html[data-theme="A"] #btn-end { background: #cfc3ae; border-color: #8b2a20; }
  html[data-theme="A"] .shopitem { background: #cfc3ae; }
  html[data-theme="A"] .relicrow .relic { background: #cfc3ae; border-color: #8a7050; }
  html[data-theme="A"] #help-page { background: #d9cfbe; }

  html[data-theme="B"] .card {
    background: var(--paper); border-color: #6b5334;
  }
  html[data-theme="B"] .card.costly { background: #d3c6ae; }
  html[data-theme="B"] .card .cname { color: var(--ink); }
  html[data-theme="B"] .card .ctext { color: var(--ink-dim); }
  html[data-theme="B"] .card .cflavor { color: #8a7050; }
  html[data-theme="B"] .card .cost { background: var(--paper); border-color: #6b1a12; color: #6b1a12; }
  html[data-theme="B"] .card .ctype { color: var(--ink-dim); }
  html[data-theme="B"] .card .cveins span { color: var(--ink-dim); border-color: #8a7050; }
  html[data-theme="B"] .card .art { background: #e7dfcc; border-bottom-color: #b39a6b; }
  html[data-theme="B"] #log-wrap { background: var(--paper); border: 1px solid #b39a6b; border-radius: 4px; }
  html[data-theme="B"] #log { color: var(--ink); }
  html[data-theme="B"] #help-page { background: var(--paper); }
  html[data-theme="B"] #help-page .hnote { color: var(--ink-dim); }
  html[data-theme="B"] #help-page .hrow span { color: var(--ink); }
  html[data-theme="B"] #help-page .btnrow button { background: #cfc3ae; }

  html[data-theme="C"] .card {
    background: var(--paper); border-color: #6b5334;
  }
  html[data-theme="C"] #log-wrap { background: var(--paper); border: 1px solid #b39a6b; border-radius: 4px; }
  html[data-theme="C"] #log div { color: var(--ink); }
  html[data-theme="C"] #log div.hurt { color: #6b1a12; }
  html[data-theme="C"] #help-page { background: var(--paper); }
  html[data-theme="C"] #help-page .hnote { color: var(--ink-dim); }
  html[data-theme="C"] #help-page .hrow span { color: var(--ink); }
  html[data-theme="C"] #help-page .btnrow button { background: #cfc3ae; }
  html[data-theme="C"] .card.costly { background: #d3c6ae; }
  html[data-theme="C"] .card .cname { color: var(--ink); }
  html[data-theme="C"] .card .ctext { color: var(--ink-dim); }
  html[data-theme="C"] .card .cflavor { color: #8a7050; }
  html[data-theme="C"] .card .cost { background: var(--paper); border-color: #6b1a12; color: #6b1a12; }
  html[data-theme="C"] .card .ctype { color: var(--ink-dim); }
  html[data-theme="C"] .card .cveins span { color: var(--ink-dim); border-color: #8a7050; }
  html[data-theme="C"] .card .art { background: #e7dfcc; border-bottom-color: #b39a6b; }
  html[data-theme="C"] body {
    /* 纹理与暗角画在背景层（内容之下），不覆盖任何文字 */
    background-color: var(--bg);
    background-image:
      radial-gradient(ellipse at center, rgba(0,0,0,0) 55%, rgba(20,12,8,.35) 100%),
      repeating-linear-gradient(0deg, rgba(107,83,52,.05) 0 1px, transparent 1px 3px),
      repeating-linear-gradient(90deg, rgba(43,33,24,.04) 0 1px, transparent 1px 4px);
    background-blend-mode: normal;
  }

  /* ───────── T50 素材降级：脉底纹 / 敌人剪影 / 遗物徽记（纯 CSS + 内联 SVG） ───────── */
  :root { --art-line: rgba(240, 236, 230, .16); }
  html[data-theme="B"] .card .art, html[data-theme="C"] .card .art { --art-line: rgba(43, 33, 24, .26); }
  .card .art { background-color: #1a1214; }
  html[data-theme="B"] .card .art, html[data-theme="C"] .card .art { background-color: #e7dfcc; }
  .card .art.v-light {
    background-image: radial-gradient(circle at 50% 42%, rgba(154, 132, 82, .18), transparent 62%),
      repeating-linear-gradient(60deg, transparent 0 6px, var(--art-line) 6px 7px),
      repeating-linear-gradient(-60deg, transparent 0 6px, var(--art-line) 6px 7px);
  }
  .card .art.v-water {
    background-image: repeating-linear-gradient(0deg, transparent 0 5px, rgba(90, 138, 154, .22) 5px 6px, transparent 6px 12px),
      repeating-linear-gradient(0deg, transparent 0 9px, var(--art-line) 9px 10px, transparent 10px 17px);
  }
  .card .art.v-heat {
    background-image: radial-gradient(circle at 50% 88%, rgba(160, 74, 53, .22), transparent 58%),
      repeating-linear-gradient(90deg, transparent 0 7px, rgba(160, 74, 53, .16) 7px 9px, transparent 9px 15px);
  }
  .card .art.v-tremor {
    background-image: repeating-linear-gradient(45deg, transparent 0 5px, var(--art-line) 5px 6px),
      repeating-linear-gradient(-45deg, transparent 0 5px, var(--art-line) 5px 6px);
  }
  .card .art.v-mineral {
    background-image: repeating-linear-gradient(0deg, transparent 0 11px, var(--art-line) 11px 12px),
      repeating-linear-gradient(90deg, transparent 0 11px, var(--art-line) 11px 12px),
      radial-gradient(circle at 30% 30%, rgba(154, 154, 138, .14), transparent 55%);
  }
  .card .art.v-none {
    background-image: radial-gradient(var(--art-line) 1px, transparent 1px);
    background-size: 8px 8px;
  }
  .esym { display: block; }
  .enemy .eart .esym-n { width: 26px; height: 26px; color: var(--dim); }
  .enemy .eart .esym-e { width: 32px; height: 32px; padding: 4px; border: 1px solid #8a7a4a; border-radius: 50%; color: #8a7a4a; }
  .enemy .eart .esym-b { width: 38px; height: 38px; padding: 5px; border: 1px solid #8b3a3a; border-bottom: 3px double #8b3a3a; color: #8b3a3a; }
  #hud-relics .rbadge, .relicrow .rbadge { width: 14px; height: 14px; color: var(--red-hi); flex: 0 0 auto; }
  .rbadge.rb-r0 { transform: rotate(0deg); } .rbadge.rb-r1 { transform: rotate(30deg); }
  .rbadge.rb-r2 { transform: rotate(60deg); } .rbadge.rb-r3 { transform: rotate(90deg); }
  .rbadge.rb-r4 { transform: rotate(120deg); } .rbadge.rb-r5 { transform: rotate(150deg); }
  #hud-relics span { display: inline-flex; align-items: center; gap: 4px; }
  .relicrow .relic { display: flex; align-items: flex-start; gap: 6px; }
  .relicrow .relic div { flex: 1 1 auto; }

  /* 帧耗时超标自动降级：关光晕和上浮，只留颜色变化（T37 性能保护） */
  body.perf-low .mnode.pickable { animation: mblink 1s steps(2) infinite; }
  body.perf-low #flow-cards .card:not(.dimmed):hover, body.perf-low .mnode.pickable:hover, body.perf-low .relicrow .relic:hover { transform: none; }
  body.perf-low #hand .card:hover:not(.dragging) { transform: var(--fan); }
  body.perf-low .card.shakeit, body.perf-low #hud-block-wrap .ic.block.pulse,
  body.perf-low #pile-draw.pulse { animation: none; }

  /* 共振阈值：屏幕边框闪红 */
  body.resflash #app { animation: resflash .5s steps(2) 2; }
  @keyframes resflash { 50% { box-shadow: inset 0 0 40px var(--red); } }

  /* ==T56-MAP-CSS== 新地图（默认；?map=old 回退）：右上常驻小图 + 行程列表 + 全屏总图。
     T71 版式重构：小图填满停靠容器（宽=父容器 100%，高≥260px@720）、总图真实比例+纵向滚动+0.6–2×缩放、
     行程列表、格子图标化（禁「战/事/随/商/英」汉字）、生态色板提亮（tools/check_palette.js 验证）。
     主题跟随：面板/文字用 --mm-* 变量，off 走 --bg/--text，B/C 走 --paper/--ink。 */
  :root {
    --mm-panel: #101418; --mm-ink: var(--text); --mm-dim: var(--dim);
    --mm-border: #2a323a; --mm-node: var(--text); --mm-node-ink: #101418;
    --mm-pick: var(--red-hi);
  }
  html[data-theme="B"], html[data-theme="C"] {
    --mm-panel: var(--paper); --mm-ink: var(--ink); --mm-dim: var(--ink-dim);
    --mm-border: #b39a6b; --mm-node: var(--ink); --mm-node-ink: var(--paper);
  }
  /* 小图停靠容器（2026-10-31 用户反馈最终版）：
     仅地图选择态显示 —— .big 大图居中偏下、行程列表在左，填满原先的空区；
     其余一切状态（事件/奖励/商店/营火/战斗）不放小图；
     大地图（总图）随时用 Tab 键或 HUD 上「地图」按钮呼出。 */
  #mm-dock {
    position: fixed; z-index: 45; display: none; pointer-events: none;
  }
  #mm-dock.show { display: block; }
  #mm-dock.big {
    bottom: 14px; top: auto; left: 50%; right: auto; transform: translate(-50%, 0);
    width: min(980px, 94vw); height: min(60vh, 470px);
  }
  #mm-dock.big #minimap {
    display: grid; grid-template-columns: minmax(190px, 250px) 1fr;
    grid-template-rows: auto auto 1fr;
    grid-template-areas: "head head" "legend legend" "log body";
    gap: 0 10px;
  }
  /* T75 图例条 */
  #mm-legend { display: none; }
  #mm-dock.big #mm-legend {
    grid-area: legend; display: flex; flex-wrap: wrap; gap: 1px 10px; align-items: center;
    font-size: 11px; color: var(--mm-dim); padding: 2px 2px 5px;
  }
  #mm-legend b { color: var(--mm-ink); font-weight: normal; letter-spacing: 2px; }
  #mm-legend .lg-i { color: var(--mm-ink); }
  #mm-legend .lg-tip { color: var(--mm-pick); margin-left: auto; }
  #mm-dock.big .mm-head { grid-area: head; }
  #mm-dock.big #mm-log { grid-area: log; flex: none; max-height: none; min-height: 0;
    border-top: none; border-right: 1px solid var(--mm-border); padding-right: 2px; }
  #mm-dock.big #mm-log-rows { height: 100%; }
  #mm-dock.big #mm-body { grid-area: body; }
  /* HUD 上的总图按钮（Tab 的可见入口） */
  #hud-mapbtn {
    background: none; border: 1px solid var(--red); color: var(--text);
    font: 12px/1.4 inherit; padding: 1px 10px; cursor: pointer; border-radius: 3px;
  }
  #hud-mapbtn:hover { border-color: var(--red-hi); color: var(--red-hi); }
  #minimap {
    width: 100%; height: 100%; box-sizing: border-box;
    display: none; flex-direction: column; gap: 4px;
    background: var(--mm-panel); color: var(--mm-ink);
    border: 1px solid var(--mm-border); border-radius: 4px;
    padding: 6px 7px; user-select: none; pointer-events: auto;
  }
  /* 默认隐藏：新地图模式由 #mm-dock.show 放出来；?map=old 回退时本模块不注入，面板保持隐藏 */
  #mm-dock.show:not(.big) #minimap { display: flex; }   /* .big 走 grid（见上） */
  #minimap .mm-head { display: flex; align-items: center; justify-content: space-between; flex: 0 0 auto; }
  #minimap .mm-head b { font-size: 12px; color: var(--mm-ink); font-weight: normal; letter-spacing: 1px; }
  #btn-fullmap {
    background: none; border: 1px solid var(--mm-border); color: var(--mm-ink);
    font: 12px/1.4 inherit; padding: 1px 8px; cursor: pointer; border-radius: 3px;
  }
  #btn-fullmap:hover { border-color: var(--mm-pick); color: var(--mm-pick); }
  /* 地图区：flex 撑满剩余空间，生态底铺满不留空白 */
  #mm-body { flex: 1 1 0; min-height: 0; position: relative; border: 1px solid var(--mm-border); border-radius: 3px; overflow: hidden; }
  #mm-body svg, #fm-svg svg { display: block; }
  .fm-cell { stroke: none; }
  .fm-line { stroke: var(--mm-ink); stroke-opacity: .5; stroke-width: 1.2; fill: none; }
  .fm-line.cross { stroke: var(--mm-pick); stroke-opacity: .85; stroke-dasharray: 5,3; }
  .fm-line.walked { stroke: var(--mm-ink); stroke-opacity: .95; stroke-width: 2; }
  .fm-node { fill: var(--mm-node); stroke: none; }
  .fm-node .fm-glyph { font: 12px "Microsoft YaHei", sans-serif; fill: var(--mm-node-ink); text-anchor: middle; dominant-baseline: central; pointer-events: none; }
  /* T75 能见度三态：near=可见未访问（真身）、unseen=可见范围外（?）、已知=全亮 */
  .fm-node.near { opacity: .95; }
  .fm-node.near circle { fill: var(--mm-panel); stroke: var(--mm-ink); stroke-opacity: .85; stroke-width: 1.4; }
  .fm-node.unseen { opacity: .35; }
  .fm-node.unseen circle { fill: var(--mm-panel); stroke: var(--mm-dim); stroke-opacity: .55; stroke-width: 1; }
  .fm-node.unseen .fm-glyph { fill: var(--mm-dim); }
  .fm-line.fog { stroke-opacity: .15; }
  /* T75 回返入口：已访问的直接入邻格（虚线圈） */
  .fm-node.btrack circle { stroke: var(--mm-ink); stroke-dasharray: 3,2; stroke-width: 1.6; }
  .fm-node.btrack { cursor: pointer; }
  .fm-node.btrack:hover circle { stroke: var(--mm-pick); stroke-dasharray: none; }
  /* pick/here/hl 的圈都要压过 seen（同等优先级靠后置胜出） */
  .fm-node.pick circle { stroke: var(--mm-pick); stroke-width: 1.6; }
  .fm-node.pick { cursor: pointer; }
  .fm-node.pick:hover { opacity: 1; }
  .fm-node.here circle { stroke: var(--mm-pick); stroke-width: 2; }
  .fm-node.hl circle { stroke: var(--mm-pick); stroke-width: 3; }
  .fm-node.hl .fm-glyph { fill: var(--mm-pick); }
  .fm-depth { stroke: var(--mm-ink); stroke-opacity: .4; stroke-dasharray: 6,4; }
  .fm-blabel { font: 12px "Microsoft YaHei", sans-serif; fill: var(--mm-dim); paint-order: stroke; stroke: var(--mm-panel); stroke-width: 3px; }
  .fm-blabel.cur { fill: var(--mm-pick); font-weight: bold; }
  .fm-band-cur { fill: var(--mm-pick); opacity: .12; }
  /* T71 提亮后的生态底：off 主题几乎不透明，B/C 纸面主题也保得住区分度 */
  .fm-eco { opacity: .9; }
  html[data-theme="B"] .fm-eco, html[data-theme="C"] .fm-eco { opacity: .6; }
  /* 行程列表：小图下方，超高内部滚动，不撑破面板 */
  #mm-log { flex: 0 1 auto; min-height: 76px; max-height: 42%; display: flex; flex-direction: column; }
  .mm-log-cap { flex: 0 0 auto; font-size: 11px; color: var(--mm-dim); letter-spacing: 2px; padding: 2px 2px 3px; border-top: 1px solid var(--mm-border); }
  #mm-log-rows { flex: 1 1 auto; min-height: 0; overflow-y: auto; overscroll-behavior: contain; }
  #mm-log-rows::-webkit-scrollbar { width: 8px; }
  #mm-log-rows::-webkit-scrollbar-thumb { background: var(--mm-border); border-radius: 4px; }
  .mm-log-empty { color: var(--mm-dim); font-size: 11px; padding: 8px 4px; }
  .mm-row {
    display: grid; grid-template-columns: 18px 1fr auto; grid-template-areas: "ic name tail" "ic desc desc";
    gap: 0 6px; padding: 3px 4px; border-radius: 3px; cursor: pointer; line-height: 1.5;
  }
  .mm-row:hover { background: rgba(127, 127, 127, .18); }
  .mm-row.active { outline: 1px solid var(--mm-pick); }
  .mm-ic { grid-area: ic; color: var(--mm-pick); text-align: center; font-size: 13px; }
  .mm-name { grid-area: name; font-weight: bold; font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .mm-tail { grid-area: tail; font-size: 11px; color: var(--mm-dim); white-space: nowrap; }
  .mm-gain { color: var(--mm-ink); }
  .mm-desc { grid-area: desc; font-size: 11px; color: var(--mm-dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  /* 总图：真实比例渲染 + 容器纵向滚动（滚动条/滚轮/拖拽三法），×/Esc/点背景关闭 */
  #fullmap-layer {
    position: fixed; inset: 0; background: rgba(4, 2, 3, .78); z-index: 90;
    display: none; align-items: center; justify-content: center;
  }
  #fullmap-layer.show { display: flex; }
  #fullmap-box {
    position: relative; background: var(--mm-panel); color: var(--mm-ink);
    border: 1px solid var(--mm-border); border-radius: 6px; padding: 10px;
    max-width: 94vw; max-height: 92vh; display: flex; flex-direction: column; gap: 6px;
  }
  #fm-hint { font-size: 11px; color: var(--mm-dim); }
  #fm-zbar { display: flex; align-items: center; gap: 6px; }
  #fm-zbar button {
    background: none; border: 1px solid var(--mm-border); color: var(--mm-ink);
    font: 12px/1.4 inherit; padding: 1px 9px; cursor: pointer; border-radius: 3px;
  }
  #fm-zbar button:hover { border-color: var(--mm-pick); color: var(--mm-pick); }
  #fm-zoom-val { min-width: 46px; text-align: center; font-size: 12px; color: var(--mm-dim); }
  #fm-svg {
    overflow: auto; border: 1px solid var(--mm-border); border-radius: 4px;
    width: fit-content; max-width: 88vw; height: min(70vh, 780px); box-sizing: border-box;
    background: rgba(0, 0, 0, .22);
  }
  #fm-svg.panning, #fm-svg.panning svg { cursor: grabbing; }
  #fm-svg::-webkit-scrollbar { width: 10px; height: 10px; }
  #fm-svg::-webkit-scrollbar-thumb { background: var(--mm-border); border-radius: 5px; }
  #fm-svg::-webkit-scrollbar-track { background: rgba(127, 127, 127, .12); }
  #fm-svg svg { cursor: grab; }
  #fm-close {
    position: absolute; top: 4px; right: 8px; background: none; border: none;
    color: var(--mm-ink); font-size: 20px; cursor: pointer; line-height: 1;
  }
  #fm-close:hover { color: var(--mm-pick); }
  .maphead { text-align: center; }
  #flow-panel.map-mode { margin: 0 auto; padding-top: 10px; }   /* 顶对齐：标题让出中部给小图 */
  .map-hint { font-size: 11px; color: var(--mm-dim); margin-left: 10px; }
  .fm-node.cursor circle { stroke: var(--mm-pick); stroke-width: 3; }
  .fm-node.cursor text { fill: var(--mm-pick); }
  .fm-node.cursor { filter: drop-shadow(0 0 5px rgba(226, 112, 95, .5)); }
  body.perf-low .fm-node.cursor { filter: none; }
  /* T67 素材态：有图时隐藏剪影/符号 */
  .eart.has-art svg { display: none; }
  .ending-art {
    width: 210px; height: 300px; margin: 0 auto 10px;
    background-size: cover; background-position: center;
    border: 1px solid var(--red); border-radius: 4px;
  }
  /* ==/T56-MAP-CSS== */
</style>
</head>
<body>
<div id="app">

  <!-- HUD 常驻：所有界面都在（选职业时隐藏） -->
  <header id="hud" class="hidden">
    <div class="hud-stats">
      <span class="stat" title="生命：血见底，下潜就停在这一层"><i class="ic hp">♥</i><span class="k">生命</span><span class="v" id="hud-hp"></span></span>
      <span class="stat" id="hud-block-wrap" title="格挡：敌人动手时先落在它上面；你的回合一结束就散（遗物可留一半）"><i class="ic block">⬢</i><span class="k">格挡</span><span class="v" id="hud-block"></span></span>
      <span class="stat" id="hud-energy-wrap" title="能量：每回合回满，出牌消耗"><i class="ic energy">✦</i><span class="k">能量</span><span class="v" id="hud-energy"></span></span>
      <span class="stat" id="hud-res-wrap" title="共鸣：每回合上涨，到 10/20/30 各触发一次本层回应，超 30 过载"><i class="ic res">∿</i><span class="k">共鸣</span><span class="v" id="hud-res"></span></span>
      <span class="stat" title="凝视：红渊看你的程度；每满 10 点，渊里的东西下手重一分"><i class="ic gaze">◉</i><span class="k">凝视</span><span class="v" id="gaze-val">0</span></span>
      <span class="stat" title="金币：在前哨杂货花掉"><i class="ic gold" id="hud-gold-ic">◈</i><span class="k" id="hud-gold-label">金币</span><span class="v" id="hud-gold">0</span></span>
      <span class="stat hidden" id="hud-parts-wrap" title="零件：黯民的回收货币，用于改造与拆解"><i class="ic parts">⚙</i><span class="k" id="hud-parts-label">零件</span><span class="v" id="hud-parts" style="cursor:pointer" title="点击打开回收面板">0</span></span>
      <span class="stat hidden" id="hud-clarity-wrap" title="清醒度：入梦的代价；耗尽会被强制叫醒"><i class="ic clarity">☾</i><span class="k">清醒度</span><span class="v" id="hud-clarity">0</span></span>
      <span class="stat hidden" id="hud-dream-wrap" title="梦境：梦体的生命"><span class="k">梦境</span><span class="v" id="hud-dream">60</span></span>
      <span class="stat" title="当前深度"><span class="k" id="hud-layer"></span></span>
    </div>
    <div class="hud-relics" id="hud-relics"></div>
  </header>

  <section id="screen-select" class="screen">
    <h1>红渊：下潜</h1>
    <p class="sub">一场不断向下的下潜。选一张卡面，看清楚你要以谁的身份走下去。</p>
    <div class="class-row">
      <button class="classface" data-class="diver" aria-haspopup="dialog">
        <img src="assets/class/diver.webp" alt="下潜者 卡面">
        <span class="cname">下潜者</span>
      </button>
      <button class="classface" data-class="tremor" aria-haspopup="dialog">
        <img src="assets/class/tremor.webp" alt="震语者 卡面">
        <span class="cname">震语者</span>
      </button>
      <button class="classface" data-class="cangmin" aria-haspopup="dialog">
        <img src="assets/class/cangmin.webp" alt="疯先知 卡面">
        <span class="cname">疯先知</span>
      </button>
      <button class="classface" data-class="anmin" aria-haspopup="dialog">
        <img src="assets/class/anmin.webp" alt="维护者 卡面">
        <span class="cname">维护者</span>
      </button>
    </div>
  </section>
  <!-- T78 职业详情模态：点卡面才构建/显示；必须点「以此身份下潜」才开局 -->
  <div id="class-modal" class="hidden" role="dialog" aria-modal="true" aria-label="职业详情">
    <div id="class-modal-box">
      <button id="class-modal-close" title="关闭（Esc / 点遮罩）">×</button>
      <div id="class-modal-art"></div>
      <div id="class-modal-detail"></div>
    </div>
  </div>

  <section id="screen-combat" class="screen hidden">
    <div id="protocol-banner" class="hidden"></div>
    <div id="enemy-area"></div>
    <div id="log-wrap"><div id="log"></div></div>
    <div id="hand-area">
      <div id="hand"></div>
      <div id="hand-foot">
        <div id="piles">
          <span id="pile-draw"></span>
          <span id="pile-discard"></span>
          <span id="pile-exhaust"></span>
        </div>
        <button id="btn-world" class="hidden">入梦</button>
        <button id="btn-end">结束回合</button>
        <button id="btn-help" title="机制速查">?</button>
      </div>
    </div>
    <!-- 卡牌信息区：选/拖一张牌时在右侧显示（不遮战斗、不盖手牌） -->
    <div id="card-detail" class="hidden">
      <button class="cd-close" id="cd-close" title="收起（Esc）">×</button>
      <div id="cd-box">
        <div id="cd-card"></div>
        <div id="cd-side">
          <h3 id="cd-name"></h3>
          <div id="cd-lines"></div>
          <div class="btnrow"><button id="cd-play">打出</button><button id="cd-cancel">收回</button></div>
        </div>
      </div>
    </div>
  </section>

  <section id="screen-flow" class="screen hidden">
    <div id="flow-panel"></div>
  </section>

</div>
<div id="help-overlay" class="hidden">
  <div id="help-page">
    <h3>下潜须知</h3>
    <p class="hnote">这一页写给还没死的人。</p>
    <div class="hrow"><b>生命</b><span>血见底，下潜就停在这一层。</span></div>
    <div class="hrow"><b>格挡</b><span>敌人动手时，先落在它上面。你的回合一结束，它就散了——有遗物替它续着的话，剩一半。</span></div>
    <div class="hrow"><b>能量</b><span>每回合回满。出牌花的都是它。</span></div>
    <div class="hrow"><b>共鸣</b><span>每回合自己涨，越深涨得越快。攒到 10、20、30，这一层的红光各应你一声，应什么由这一层定。过了 30，红光开始烧你，每回合都烧。</span></div>
    <div class="hrow"><b>凝视</b><span>红渊看你的时辰。每满 10，渊里的东西下手就重一分。有的牌，凝视不够高，不肯出手。</span></div>
    <div class="hrow"><b>代价</b><span>有些牌要你付利息——血，或者别的。它们确实值。</span></div>
    <div class="btnrow"><button id="btn-help-close">合上这页</button></div>
  </div>
</div>
<div id="toast"></div>
<div class="fontbtns">
  <button id="font-minus" title="缩小字号">文-</button>
  <button id="font-plus" title="放大字号">文+</button>
  <button id="lowsat" title="低饱和显示（减轻红光刺激）">素</button>
</div>
<div id="phase-banner"></div>
<svg style="display:none" aria-hidden="true"><defs>
  <symbol id="sym-eye" viewBox="0 0 24 24"><path d="M2 12 Q12 4 22 12 Q12 20 2 12 Z" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="1.5"/></symbol>
  <symbol id="sym-door" viewBox="0 0 24 24"><rect x="7" y="3" width="10" height="18" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="14.5" cy="12" r="1" fill="currentColor"/></symbol>
  <symbol id="sym-knife" viewBox="0 0 24 24"><path d="M12 2 L15 12 L12 14 L9 12 Z M11 15 L13 15 L13 21 L11 21 Z" fill="none" stroke="currentColor" stroke-width="1.5"/></symbol>
  <symbol id="sym-cup" viewBox="0 0 24 24"><path d="M5 5 H19 V11 A7 7 0 0 1 5 11 Z M19 7 H22 V9 A3 3 0 0 1 19 12" fill="none" stroke="currentColor" stroke-width="1.5"/></symbol>
  <symbol id="sym-snake" viewBox="0 0 24 24"><path d="M4 18 Q8 14 12 18 T20 18 M20 18 Q22 12 16 10 Q10 8 12 4" fill="none" stroke="currentColor" stroke-width="1.5"/></symbol>
  <symbol id="rb-0" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="2" fill="currentColor"/></symbol>
  <symbol id="rb-1" viewBox="0 0 24 24"><path d="M12 4 L20 19 L4 19 Z" fill="none" stroke="currentColor" stroke-width="1.5"/></symbol>
  <symbol id="rb-2" viewBox="0 0 24 24"><rect x="6" y="6" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.5"/></symbol>
  <symbol id="rb-3" viewBox="0 0 24 24"><path d="M12 3 L20 12 L12 21 L4 12 Z" fill="none" stroke="currentColor" stroke-width="1.5"/></symbol>
  <symbol id="rb-4" viewBox="0 0 24 24"><path d="M12 3 L14.4 9.6 L21 10 L16 14.4 L17.6 21 L12 17.4 L6.4 21 L8 14.4 L3 10 L9.6 9.6 Z" fill="none" stroke="currentColor" stroke-width="1.5"/></symbol>
  <symbol id="rb-5" viewBox="0 0 24 24"><path d="M12 4 V20 M4 12 H20" stroke="currentColor" stroke-width="1.5"/></symbol>
  <symbol id="rb-6" viewBox="0 0 24 24"><path d="M3 12 Q7 8 12 12 T21 12" fill="none" stroke="currentColor" stroke-width="1.5"/></symbol>
  <symbol id="rb-7" viewBox="0 0 24 24"><path d="M3 19 L9 9 L13 14 L16 10 L21 19 Z" fill="none" stroke="currentColor" stroke-width="1.5"/></symbol>
  <symbol id="rb-8" viewBox="0 0 24 24"><path d="M12 3 L19 7 V17 L12 21 L5 17 V7 Z" fill="none" stroke="currentColor" stroke-width="1.5"/></symbol>
  <symbol id="rb-9" viewBox="0 0 24 24"><path d="M16 4 A9 9 0 1 0 20 12 A7 7 0 1 1 16 4" fill="none" stroke="currentColor" stroke-width="1.5"/></symbol>
  <symbol id="rb-10" viewBox="0 0 24 24"><path d="M4 5 H20 M8 5 V19 M16 5 V19 M4 19 H20" fill="none" stroke="currentColor" stroke-width="1.5"/></symbol>
  <symbol id="rb-11" viewBox="0 0 24 24"><circle cx="9" cy="12" r="5" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="15" cy="12" r="5" fill="none" stroke="currentColor" stroke-width="1.5"/></symbol>
</defs></svg>
<div id="overlay" class="hidden"><div class="panel" id="overlay-panel"></div></div>

<div id="minimap" role="img" aria-label="小地图：玩家周边的事件格与区域">
  <div class="mm-head"><b id="mm-band">深度带</b><button id="btn-fullmap" title="打开总图（Esc 关闭）">总图</button></div>
  <div id="mm-body"></div>
</div>
<div id="fullmap-layer">
  <div id="fullmap-box" role="dialog" aria-label="总图：全区域">
    <button id="fm-close" title="关闭（Esc / 点背景）">×</button>
    <div id="fm-hint">滚轮缩放 · 拖动平移 · 已去过的高亮，没去过的只有周边一圈（未见的格子不在页面里）</div>
    <div id="fm-svg"></div>
  </div>
</div>


<script>
