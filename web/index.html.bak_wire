    function err(id, msg) { errors.push(id + ': ' + msg); }

    // I1 节点不共格；start/finalBoss 各恰 1
    if (Object.keys(cellMap).length !== region.nodes.length) err('I1', '节点共格');
    var starts = region.nodes.filter(function (n) { return n.id === region.startId; });
    var fbs = region.nodes.filter(function (n) { return n.type === 'finalBoss'; });
    if (starts.length !== 1) err('I1', '起点不唯一');
    if (fbs.length !== 1) err('I6', 'finalBoss 数量=' + fbs.length);

    // I2 100% 可达（DFS）
    if (starts.length === 1) {
      var seen = {}; var stack = [region.startId]; seen[region.startId] = true;
      while (stack.length) {
        var cur = byId[stack.pop()];
        cur._out.forEach(function (v) { if (!seen[v.id]) { seen[v.id] = true; stack.push(v.id); } });
      }
      var miss = region.nodes.filter(function (n) { return !seen[n.id]; });
      if (miss.length) err('I2', '不可达节点 ' + miss.length + ' 个（如 ' + miss[0].id + '）');
    }

    // I3 出边下限
    region.nodes.forEach(function (n) {
      if (n.type !== 'finalBoss' && n._out.length < 1) err('I3', n.id + ' 无出边');
    });

    // I4 无环（Kahn 拓扑）
    var deg = {}; region.nodes.forEach(function (n) { deg[n.id] = n._in.length; });
    var queue = region.nodes.filter(function (n) { return deg[n.id] === 0; }).map(function (n) { return n.id; });
    var done = 0;
    while (queue.length) {
      var id = queue.pop(); done++;
      byId[id]._out.forEach(function (v) { if (--deg[v.id] === 0) queue.push(v.id); });
    }
    if (done !== region.nodes.length) err('I4', '存在环');

    // I5 y 严格单调向下
    region.edges.forEach(function (e) {
      var u = byId[e.from], v = byId[e.to];
      if (v.y <= u.y) err('I5', e.from + '->' + e.to + ' 未向下');
      if (e.dy !== v.y - u.y || e.dx !== v.x - u.x) err('E', e.from + '->' + e.to + ' 位移字段不符');
      if (e.len !== Math.max(Math.abs(e.dx), e.dy)) err('E', e.from + '->' + e.to + ' len 字段不符');
      if (e.dy < 1) err('I5', e.from + '->' + e.to + ' dy<1');
      var expect = Math.round(Math.atan2(Math.abs(e.dx), e.dy) * 180 / Math.PI * 10) / 10;
      if (Math.abs(e.angle - expect) > 0.05) err('E', e.from + '->' + e.to + ' angle 字段不符');
    });

    // I6 finalBoss 唯一、band8 最底行
    fbs.forEach(function (n) {
      if (n.band !== 8 || n.y !== h - 1) err('I6', 'finalBoss 位置错误 y=' + n.y);
    });

    // I7 每带节点数 ≥ 配额
    var q = effectiveQuota(p);
    for (var b = 1; b <= 8; b++) {
      var cnt = region.nodes.filter(function (n) { return n.band === b; }).length;
      var need = 0; Object.keys(q[b]).forEach(function (t) { need += q[b][t]; });
      if (cnt < need) err('I7', 'band' + b + ' 节点 ' + cnt + '<配额' + need);
    }

    // I8 同带同类型最小曼哈顿距离（T74: 按 band|type 分桶，不再全节点两两）
    var D = p.node.minSameTypeDist;
    var typeBuckets = {};
    region.nodes.forEach(function (n) {
      var kb = n.band + '|' + n.type;
      (typeBuckets[kb] = typeBuckets[kb] || []).push(n);
    });
    Object.keys(typeBuckets).forEach(function (kb) {
      var arr = typeBuckets[kb];
      for (var i = 0; i < arr.length; i++) for (var j = i + 1; j < arr.length; j++) {
        var a = arr[i], c = arr[j];
        if (Math.abs(a.x - c.x) + Math.abs(a.y - c.y) < D)
          err('I8', a.id + '~' + c.id + '（' + a.type + '@b' + a.band + '）距离 < ' + D);
      }
    });

    // I9 每个带边界可跨越；crossBand 必为相邻带
    region.edges.forEach(function (e) {
      var u = byId[e.from], v = byId[e.to];
      if (e.crossBand !== (u.band !== v.band)) err('E', e.from + '->' + e.to + ' crossBand 标记不符');
      if (e.crossBand && v.band !== u.band + 1) err('I9', '跨带边跳带 ' + u.band + '->' + v.band);
    });
    for (var bb = 1; bb <= 7; bb++) {
      var has = region.edges.some(function (e) {
        return byId[e.from].band === bb && byId[e.to].band === bb + 1;
      });
      if (!has) err('I9', 'band' + bb + '→' + (bb + 1) + ' 无跨带边');
    }

    // I10 无交叉边、不穿节点
    var interiorUsed = {}, edgeInteriors = [];
    region.edges.forEach(function (e) {
      var u = byId[e.from], v = byId[e.to];
      var cells = lineCells(u.x, u.y, v.x, v.y).slice(1, -1);
      cells.forEach(function (c) {
        var k = c[0] + ',' + c[1];
        if (cellMap[k]) err('I10', e.from + '->' + e.to + ' 穿过节点 ' + cellMap[k].id);
        if (interiorUsed[k]) err('I10', '边交叉 @' + k);
        interiorUsed[k] = true;
      });
      edgeInteriors.push(cells);
    });

    // I11 度上限
    region.nodes.forEach(function (n) {
      if (n._out.length > p.edge.outDegMax) err('I11', n.id + ' 出度 ' + n._out.length);
      var inCap = (n.type === 'finalBoss') ? p.node.fbInDegCap : p.node.maxInDeg;
      if (n._in.length > inCap) err('I11', n.id + ' 入度 ' + n._in.length);
    });

    // I12 生态约束
    var counts = {};
    region.ecoOf.forEach(function (e) { counts[e] = (counts[e] || 0) + 1; });
    ECOS.forEach(function (e) {
      if (!counts[e.id]) { err('I12', '生态缺失 ' + e.id); return; }
      var comps = componentsOf(region.ecoOf, w, h, e.id);
      if (comps.length > p.ecoGrowth.maxComponents)
        err('I12', e.id + ' 分量数 ' + comps.length);
      comps.forEach(function (comp) {
        if (comp.length < p.ecoGrowth.minPatchArea) err('I12', e.id + ' 块面积 ' + comp.length);
      });
    });

    // I17 纵向间距（T73；T74 放宽至 ≥1）：同带同列两节点 |dy| ≥ spacing（T74: 按带|列分桶查）
    var colBuckets = {};
    region.nodes.forEach(function (n) {
      var kc = n.band + '|' + n.x;
      (colBuckets[kc] = colBuckets[kc] || []).push(n);
    });
    Object.keys(colBuckets).forEach(function (kc) {
      var arr = colBuckets[kc];
      for (var i = 0; i < arr.length; i++) for (var j = i + 1; j < arr.length; j++) {
        var na = arr[i], nc = arr[j];
        if (Math.abs(na.y - nc.y) < p.node.verticalSpacing)
          err('I17', na.id + '~' + nc.id + ' 同列纵向间距 ' + Math.abs(na.y - nc.y) + ' < ' + p.node.verticalSpacing);
      }
    });

    // 模型一致性：band / eco 冗余字段
    region.nodes.forEach(function (n) {
      if (n.band !== bandOfY(n.y, h, br)) err('E', n.id + ' band 字段不符');
      if (n.eco !== region.ecoOf[n.y * w + n.x]) err('E', n.id + ' eco 字段不符');
    });
    region.edges.forEach(function (e) {
      var v = byId[e.to];
      if (e.crossBand && !v.crossBandIn) err('E', e.to + ' crossBandIn 标记缺失');
      if (!e.crossBand && v.crossBandIn && !region.edges.some(function (e2) {
        return e2.to === e.to && e2.crossBand; })) err('E', e.to + ' crossBandIn 标记多余');
    });

    region.nodes.forEach(function (n) { delete n._out; delete n._in; });
    return { ok: errors.length === 0, errors: errors };
  }

  /* ── 可见性（T54 §4；T56 消费）────────────────────── */
  // visible = visited ∪ 边邻居 depth 跳（默认 1）；未可见节点不进返回值——数据层裁剪
  function pruneForFrontend(region, visitedIds, depth) {
    var d = depth || 1;
    var byId = {};
    region.nodes.forEach(function (n) { byId[n.id] = n; });
    var vis = {};
    Object.keys(visitedIds).forEach(function (id) { vis[id] = true; });
    var frontier = Object.keys(visitedIds).map(function (id) { return byId[id]; });
    for (var step = 0; step < d; step++) {
      var next = [];
      frontier.forEach(function (n) {
        region.edges.forEach(function (e) {
          var other = null;
          if (e.from === n.id) other = byId[e.to];
          else if (e.to === n.id) other = byId[e.from];
          if (other && !vis[other.id]) { vis[other.id] = true; next.push(other); }
        });
      });
      frontier = next;
    }
    var nodes = region.nodes.filter(function (n) { return vis[n.id]; })
      .map(function (n) { return Object.assign({}, n); });
    var edges = region.edges.filter(function (e) { return vis[e.from] && vis[e.to]; })
      .map(function (e) { return Object.assign({}, e); });
    return { nodes: nodes, edges: edges };
  }

  /* ── 统计辅助（测试与调试页用）─────────────────────── */
  function bfsMaxDepth(region) {
    var byId = {};
    region.nodes.forEach(function (n) { byId[n.id] = n; n._d = -1; });
    var start = byId[region.startId]; start._d = 0;
    var queue = [start], max = 0;
    while (queue.length) {
      var u = queue.shift();
      region.edges.forEach(function (e) {
        if (e.from !== u.id) return;
        var v = byId[e.to];
        if (v._d < 0) { v._d = u._d + 1; max = Math.max(max, v._d); queue.push(v); }
      });
    }
    var fbDepth = byId[region.finalBossId]._d;
    region.nodes.forEach(function (n) { delete n._d; });
    return { max: max, finalBoss: fbDepth };
  }

  /* ── 主入口：generate(seed, params[, dataProvider]) → Region ── */
  function generate(seed, params, dataProvider) {
    var p = resolveParams(params);
    var failures = {};
    var stat = { bindingFallbacks: 0 };
    for (var attempt = 1; attempt <= p.retry.max; attempt++) {
      var seedUsed = (seed >>> 0) * 1000003 + attempt;
      var rng = makeRng(seedUsed);
      try {
        var w = p.grid.w, h = p.grid.h, br = bandRowsOf(p);
        var W = buildWeightTable(p);
        var ecoOf = growEcos(rng, p, W);                     // 步骤1
        var grown = growDAG(rng, ecoOf, p);                  // 步骤2+3（生长式合并）
        markBands(grown.nodes, grown.edges, p, grown.finalBoss); // 步骤4
        resolveBinding(grown.nodes, p, dataProvider, stat);  // 步骤5（T58 绑定表优先）
        var weight = ecoOf.map(function (e, i) { return W[e][bandOfY((i / w) | 0, h, br)]; });
        var region = {
          w: w, h: h, bandRows: br,
          params: p, seedUsed: seedUsed, attempts: attempt, bindingFallbacks: stat.bindingFallbacks,
          ecoOf: ecoOf, weight: weight,
          nodes: grown.nodes, edges: grown.edges,
          startId: grown.start.id, finalBossId: grown.finalBoss.id
        };
        var v = validate(region);
        if (!v.ok) throw GenError('validate', v.errors[0]);
        return region;
      } catch (err) {
        if (err && err.isGenError) {
          failures[err.reason] = (failures[err.reason] || 0) + 1;
        } else { throw err; }
      }
    }
    var tally = Object.keys(failures).map(function (k) { return k + '×' + failures[k]; }).join(', ');
    throw new Error('generate: ' + p.retry.max + ' 次尝试全部失败 → ' + tally);
  }

  function resolveParams(overrides) {
    var p = JSON.parse(JSON.stringify(DEFAULTS));
    if (overrides) Object.keys(overrides).forEach(function (k) {
      if (k === 'quotaScale') { p.quotaScale = overrides[k]; return; }
      if (typeof overrides[k] === 'object' && !Array.isArray(overrides[k])) {
        Object.keys(overrides[k]).forEach(function (k2) { p[k][k2] = overrides[k][k2]; });
      } else p[k] = overrides[k];
    });
    return p;
  }

  return {
    generate: generate,
    validate: validate,
    pruneForFrontend: pruneForFrontend,
    bfsMaxDepth: bfsMaxDepth,
    effectiveQuota: effectiveQuota,
    makeRng: makeRng,
    bandOfY: bandOfY,
    DEFAULTS: DEFAULTS,
    ECOS: ECOS,
    lineCells: lineCells,
    _debug: { growEcos: growEcos, growDAG: growDAG, buildWeightTable: buildWeightTable, markBands: markBands, resolveParams: resolveParams }
  };
});
/* ==/MAPGEN-LIB== */
</script>
<script>
/* 《红渊：下潜》战斗引擎核心 v1.0
 * 纯逻辑，无 DOM 依赖。浏览器与 node 均可加载。
 * 依据 DESIGN.md v1.0，所有数值以此为准。
 */

(function (root) {
  'use strict';

  // ============ 常量 ============
  const VEINS = ['light', 'water', 'heat', 'tremor', 'mineral'];
  const VEIN_CN = { light: '光', water: '水', heat: '热', tremor: '震', mineral: '矿' };
  const HAND_LIMIT = 10;
  const DRAW_PER_TURN = 5;
  const BASE_ENERGY = 3;

  // 各层定义（与 DESIGN.md §4 一致）
  const LAYERS = [
    { id: 1, name: '地表死寂区', protocol: 'L0–L1', res: 1, mode: 'dormant',  rule: 'no_light' },
    { id: 2, name: '外层冷洞',   protocol: 'L1',    res: 2, mode: 'dormant',  rule: 'dim' },
    { id: 3, name: '干旱空洞区', protocol: 'L1–L2', res: 3, mode: 'steady',   rule: 'dry' },
    { id: 4, name: '稳定空洞海', protocol: 'L2–L3', res: 4, mode: 'pulse',    rule: 'bright' },
    { id: 5, name: '热泉裂带',   protocol: 'L2–L4', res: 5, mode: 'resonant', rule: 'heat_tick' },
    { id: 6, name: '辐射矿石区', protocol: 'L4–L5', res: 6, mode: 'overload', rule: 'rad_tick' },
    { id: 7, name: '核心高热区', protocol: 'L5',    res: 7, mode: 'locked',   rule: 'burn_hand' },
    { id: 8, name: '红渊核心',   protocol: 'L6',    res: 8, mode: 'void',     rule: 'time_loop' }
  ];

  // 七种模式的共振阈值反应
  const MODE_REACTION = {
    dormant:  { text: '共振之底没有回应。', apply: () => {} },
    steady:   { text: '红光稳定下来。', apply: (C) => { healPlayer(C, 3); } },
    pulse:    { text: '红光脉冲扫过。', apply: (C) => { C.enemies.forEach(e => dealToEnemy(C, e, 5)); } },
    resonant: { text: '震语清晰。', apply: (C) => { draw(C, 2); } },
    overload: { text: '局部失控。', apply: (C) => { C.enemies.forEach(e => { e.buffAtk = (e.buffAtk || 0) + 3; e.buffTurns = 1; }); } },
    locked:   { text: '时间感异常。', apply: (C) => { C.energyPenalty = 1; } },
    void:     { text: '红光消失。', apply: (C) => { C.veinLocked = true; } }
  };

  // ============ RNG（可种子化，便于复现） ============
  function makeRng(seed) {
    let s = (seed === undefined ? Date.now() : seed) >>> 0;
    return function () {
      s = (s * 1664525 + 1013904223) >>> 0;
      return s / 4294967296;
    };
  }
  function shuffle(arr, rng) {
    for (let i = arr.length - 1; i > 0; i--) {
      const j = Math.floor(rng() * (i + 1));
      [arr[i], arr[j]] = [arr[j], arr[i]];
    }
    return arr;
  }
  function randInt(rng, a, b) { return a + Math.floor(rng() * (b - a + 1)); }
  function parseHp(rng, hp) {
    if (typeof hp === 'number') return hp;
    const m = String(hp).split('-').map(Number);
    return m.length === 2 ? randInt(rng, m[0], m[1]) : Number(hp);
  }

  // ============ Run（整局） ============
  function newRun(classId, opts) {
    opts = opts || {};
    const rng = opts.rng || makeRng(opts.seed);
    const base = classId === 'diver'
      ? { hp: 80, deck: null }
      : classId === 'anmin'
        ? { hp: 76, deck: null }
        : classId === 'cangmin'
          ? { hp: 30, deck: null }
          : { hp: 72, deck: null };

    const run = {
      classId: classId,          // 'diver' | 'tremor'
      hp: base.hp,
      maxHp: base.hp,
      energyMax: BASE_ENERGY,
      gaze: 0,                   // 凝视
      depth: 0,                  // 当前层
      node: 0,
      gold: 0,
      clarity: (classId === 'cangmin') ? 3 : undefined,
      clarityMax: (classId === 'cangmin') ? 5 : undefined,
      dreamMaxHp: (classId === 'cangmin') ? 60 : undefined,
      deck: [],                  // 牌组（card 对象数组，含 uid）
      relics: [],
      rng: rng,
      log: [],
      dead: false,
      won: false
    };
    run.deck = buildStarterDeck(classId, run.rng);
    return run;
  }

  function buildStarterDeck(classId, rng) {
    const list = [];
    let uid = 0;
    function add(card, n) {
      for (let i = 0; i < n; i++) {
        list.push(Object.assign({}, card, { uid: 'u' + (uid++) }));
      }
    }
    const atk = { id: 'basic_atk', name: '一击', type: 'attack', rarity: 'common', veins: [], energy: 1,
      effect: { damage: 7, block: 0, hits: 1, target: 'single' },
      cost_type: 'none', flavor: '你把手上的东西砸下去。它是在动的。',
      upgrade: { name_suffix: '·固', effect: { damage: 9 }, flavor_add: '砸了很多年之后，你知道往哪里砸。' } };
    const def = { id: 'basic_def', name: '缩起', type: 'skill', rarity: 'common', veins: [], energy: 1,
      effect: { damage: 0, block: 5, target: 'self' },
      cost_type: 'none', flavor: '你把自己收窄。红光从你身边绕过去。',
      upgrade: { name_suffix: '·旧', effect: { block: 8 }, flavor_add: '收窄的次数多了，红光自己绕路。' } };

    if (classId === 'cangmin') {
      const wAtk = { id: 'cng_w_atk', name: '石矛', type: 'attack', rarity: 'common', veins: [], energy: 1,
        effect: { damage: 5, target: 'single' }, cost_type: 'none', dream: false, flavor: '醒着的时候，这就够用了。' };
      const wDef = { id: 'cng_w_def', name: '缩进岩洞', type: 'skill', rarity: 'common', veins: [], energy: 1,
        effect: { block: 5, target: 'self' }, cost_type: 'none', dream: false, flavor: '岩洞是最后的墙。' };
      const dAtk = { id: 'cng_d_atk', name: '火母的低语', type: 'attack', rarity: 'common', veins: ['heat'], energy: 1,
        effect: { damage: 9, target: 'single' }, cost_type: 'none', dream: true, flavor: '梦里打人，用想念。' };
      const dDef = { id: 'cng_d_def', name: '火母的注视', type: 'skill', rarity: 'common', veins: ['heat'], energy: 1,
        effect: { block: 8, target: 'self' }, cost_type: 'none', dream: true, flavor: '被她看着的伤口，不敢流血。' };
      add(wAtk, 2); add(wDef, 3); add(dAtk, 3); add(dDef, 2);
    } else if (classId === 'anmin') {
      add(atk, 5);
      add(def, 4);
      add({ id: 'anmin_sign', name: '登记工号牌', type: 'skill', rarity: 'common', veins: ['mineral'], energy: 0,
        effect: { draw: 1, target: 'self' },
        cost_type: 'none', flavor: '编号确认。系统认出了你。这不算好事。' }, 1);
    } else if (classId === 'diver') {
      add(atk, 5);
      add(def, 4);
      add({ id: 'diver_sign', name: '死亡合同副本', type: 'skill', rarity: 'common', veins: ['mineral'], energy: 0,
        effect: { damage: 0, block: 0, draw: 1, target: 'self' },
        cost_type: 'none', flavor: '第三条写着：不保证返程。你签的时候没细看。' }, 1);
    } else {
      add(atk, 5);
      add(def, 4);
      add({ id: 'tremor_sign', name: '静日触杖', type: 'skill', rarity: 'common', veins: ['tremor'], energy: 0,
        effect: { damage: 0, block: 0, draw: 1, target: 'self' },
        cost_type: 'none', flavor: '杖头是温的。今天不该说话。' }, 1);
    }
    return list;
  }

  // ============ Combat（战斗） ============
  function startCombat(run, enemyDefs) {
    applyLayerTheme(run.depth);
    const layer = LAYERS[run.depth - 1] || LAYERS[0];
    const C = {
      run: run,
      layer: layer,
      turn: 1,
      energy: run.energyMax,
      energyPenalty: 0,
      resonance: 0,
      resonanceFired: 0,        // 已触发过的阈值档数
      hand: [],
      drawPile: [],
      discardPile: [],
      exhaustPile: [],
      block: 0,
      buffs: {},                // strength / dexterity / thorns / regen ...
      debuffs: {},
      veinChain: {},            // 各脉连携计数
      lastVein: null,
      enemies: [],
      parts: 0,
      activeProtocol: null,
      threatLevel: 0,
      world: (run.classId === 'cangmin') ? 'wake' : undefined,
      dreamHp: (run.classId === 'cangmin') ? (run.dreamMaxHp || 60) : undefined,
      dreamMaxHp: (run.classId === 'cangmin') ? (run.dreamMaxHp || 60) : undefined,
      omens: [],
      veinLocked: false,
      over: false,
      result: null,
      rng: run.rng,
      log: []
    };

    // 敌人实例化
    C.enemies = enemyDefs.map((d, i) => {
      const hp = parseHp(C.rng, d.hp);
      return {
        idx: i,
        def: d,
        name: d.name,
        hp: hp,
        maxHp: hp,
        block: 0,
        buffAtk: 0,
        buffTurns: 0,
        intentIdx: 0,
        intent: null,
        status: {},
        dead: false,
        phases: Array.isArray(d.phases) && d.phases.length ? d.phases : null,
        phaseIdx: -1
      };
    });

    // 洗牌
    if (run.classId === 'cangmin') {
      C.pileWake = shuffle(run.deck.filter(c => !c.dream).map(c => Object.assign({}, c)), C.rng);
      C.pileDream = shuffle(run.deck.filter(c => c.dream).map(c => Object.assign({}, c)), C.rng);
      C.drawPile = C.pileWake;
      C.pileWake = [];
    } else {
      C.drawPile = shuffle(run.deck.map(c => Object.assign({}, c)), C.rng);
    }
    C.enemies.forEach(e => { applyPhase(C, e); e.intent = nextIntent(e); });
    // Boss 入场白（第一阶段的 log）
    C.enemies.forEach(e => { if (e.phases && e.phases[0] && e.phases[0].log) log(C, e.phases[0].log); });

    // 遗物：战斗开始
    (run.relics || []).forEach(r => {
      (r.effect_code || []).forEach(ec => {
        if (ec.trigger === 'combat_start') {
          if (ec.action === 'draw') draw(C, ec.value || 1);
          if (ec.action === 'gaze') addGaze(run, ec.value || 1);
          if (ec.action === 'block') gainBlock(C, ec.value || 0);
        }
      });
    });

    beginTurn(C);
    return C;
  }

  function beginTurn(C) {
    if (C.over) return;
    const run = C.run;

    // 1. 弃掉未保留手牌
    C.hand = C.hand.filter(c => {
      // 保留：顶层 effect.retain 或 special 里的 retain（静日/埋骨布等）都算
      if (c.effect && (c.effect.retain || (c.effect.special || []).some(sp => sp.code === 'retain'))) return true;
      C.discardPile.push(c);
      return false;
    });
    // 2. 抽牌（封锁协议：双方各少抽 1 张——敌方无抽牌，表现为意图不再升级由静默协议处理）
    draw(C, DRAW_PER_TURN - (C.activeProtocol === 'lockdown' ? 1 : 0));
    // 3. 共振 += 层深度
    C.resonance += C.layer.res;
    // 苍民：梦中心跳（清醒度消耗）与预兆
    if (C.run.classId === 'cangmin') {
      if (C.world === 'dream' && C.turn % 3 === 0 && C.turn > 0) {
        C.run.clarity = Math.max(0, C.run.clarity - 1);
        log(C, '〔梦太深〕清醒度 -1（余 ' + C.run.clarity + '）。');
        if (C.run.clarity <= 0) forceWake(C, '清醒度耗尽。本场不能再入梦。');
      }
      if (!C.over) tickOmens(C);
    }
    // 4. 回合开始效果
    tickStartOfTurn(C);
    // 5. 阈值检查
    checkResonance(C);
    // 6. 能量
    C.energy = Math.max(0, run.energyMax + (run.energyBonus || 0) - (C.energyPenalty || 0));
    C.veinLocked = false;
    C.veinChain = {};
    C.lastVein = null;

    log(C, '── 第 ' + C.turn + ' 回合 ──');
  }

  function tickStartOfTurn(C) {
    const run = C.run;
    const layer = C.layer;

    // 灼烧（热脉层）
    if (layer.rule === 'heat_tick') {
      C.heat = (C.heat || 0) + 1;
      if (C.heat % 3 === 0) { damagePlayer(C, 2, '灼烧'); }
    }
    // 辐射
    if (layer.rule === 'rad_tick') {
      damagePlayer(C, 1, '辐射');
      draw(C, 1);
    }
    // 核心高热：烧手牌
    if (layer.rule === 'burn_hand' && C.hand.length) {
      const i = Math.floor(C.rng() * C.hand.length);
      const burned = C.hand.splice(i, 1)[0];
      C.exhaustPile.push(burned);
      log(C, '「' + burned.name + '」在高温里卷曲、发黑。');
    }
    // 清剿协议：每回合受 2 点
    if (C.activeProtocol === 'purge') damagePlayer(C, 2, '清剿');
    // 玩家状态
    ['poison', 'burn'].forEach(k => {
      if (C.debuffs[k]) {
        damagePlayer(C, C.debuffs[k].v, k === 'poison' ? '毒' : '灼烧');
      }
    });
    if (C.buffs.regen) healPlayer(C, C.buffs.regen);
  }

  function checkResonance(C) {
    const thresholds = [10, 20, 30];
    for (let i = 0; i < thresholds.length; i++) {
      if (C.resonance >= thresholds[i] && C.resonanceFired <= i) {
        C.resonanceFired = i + 1;
        const mode = MODE_REACTION[C.layer.mode] || MODE_REACTION.dormant;
        log(C, '〔共振 ' + thresholds[i] + '〕' + mode.text);
        mode.apply(C);
      }
    }
    if (C.resonance >= 30) {
      damagePlayer(C, C.layer.res, '过载');
    }
  }

  // ============ 抽牌 / 弃牌 ============
  function draw(C, n) {
    if (C.activeProtocol === 'silence') return; // 静默协议：玩家不能抽牌
    for (let i = 0; i < n; i++) {
      if (C.hand.length >= HAND_LIMIT) break;
      if (!C.drawPile.length) {
        if (!C.discardPile.length) break;
        C.drawPile = shuffle(C.discardPile, C.rng);
        C.discardPile = [];
        log(C, '弃牌堆洗回抽牌堆。');
      }
      C.hand.push(C.drawPile.pop());
    }
  }

  // ============ 出牌 ============
  function playCard(C, handIndex, targetIdx) {
    if (C.over) return { ok: false, msg: '战斗已结束' };
    const card = C.hand[handIndex];
    if (!card) return { ok: false, msg: '没有这张牌' };

    // 能量
    const cost = cardCost(C, card);
    if (C.energy < cost) return { ok: false, msg: '能量不足' };

    // 凝视门槛
    if (card.effect && card.effect.gaze_cost && C.run.gaze < card.effect.gaze_cost) {
      return { ok: false, msg: '凝视不足（需要 ' + card.effect.gaze_cost + '）' };
    }
    // 共振消耗
    if (card.effect && card.effect.resonance_cost) {
      if (C.resonance < card.effect.resonance_cost) return { ok: false, msg: '共振不足' };
    }
    // 锁死卡
    if (card._locked) return { ok: false, msg: '这张牌已锁死' };
    // 苍民双世界：世界不匹配的牌不能打
    if (C.run.classId === 'cangmin' && C.world) {
      const wantDream = C.world === 'dream';
      if (!!card.dream !== wantDream) {
        return { ok: false, msg: card.dream ? '这来自梦里，醒着的手握不住' : '醒着的东西进不了这个深度' };
      }
    }
    // 黯民协议：不可重复激活
    if (card.anmin_mark && card.anmin_mark.kind === 'protocol' && C.activeProtocol === card.anmin_mark.protocol) {
      return { ok: false, msg: '协议已生效，不可撤销' };
    }

    // 扣费
    C.energy -= cost;
    if (card.effect && card.effect.resonance_cost) {
      C.resonance = Math.max(0, C.resonance - card.effect.resonance_cost);
    }

    // 连携
    const chainBonus = veinChainBonus(C, card);

    // 结算效果
    applyCardEffect(C, card, targetIdx, chainBonus);

    // 代价
    if (card.cost_type && card.cost_type !== 'none') {
      applyCardCost(C, card);
    }

    // 黯民协议激活
    if (card.anmin_mark && card.anmin_mark.kind === 'protocol') activateProtocol(C, card.anmin_mark.protocol);
    // 移出手牌
    C.hand.splice(handIndex, 1);
    if (card.effect && card.effect.exhaust) C.exhaustPile.push(card);
    else C.discardPile.push(card);

    C.playedCount = (C.playedCount || 0) + 1;
    checkCombatEnd(C);
    return { ok: true, chain: chainBonus };
  }

  function cardCost(C, card) {
    let c = card.energy || 0;
    // 干旱区：水脉费用 +1
    if (C.layer.rule === 'dry' && card.veins && card.veins.indexOf('water') >= 0) c += 1;
    // 遗物改则：某脉费用修正（如水脉 -1）
    (C.run.relics || []).forEach(r => {
      const m = r.mod || {};
      if (m.vein_cost && card.veins && card.veins.indexOf(m.vein_cost) >= 0) {
        c = Math.max(0, c + m.vein_cost_delta);
      }
    });
    return c;
  }

  function veinChainBonus(C, card) {
    if (C.veinLocked) return 0;
    const vs = (card.veins || []).filter(v => VEINS.indexOf(v) >= 0);
    if (vs.length === 0) { C.lastVein = null; return 0; }
    const primary = vs[0];
    const prev = C.veinChain[primary] || 0;
    const n = prev + 1;
    C.veinChain[primary] = n;
    C.lastVein = primary;
    // 遗物改则：连携加成提高（可跨遗物叠加）
    let cb = 0;
    (C.run.relics || []).forEach(r => {
      const m = r.mod || {};
      if (m.chain_bonus && (!m.chain_vein || m.chain_vein === primary)) cb += m.chain_bonus;
    });
    if (n === 1) return 0;
    if (n === 2) return 1 + cb;
    return 2 + cb;
  }

  function applyCardEffect(C, card, targetIdx, chainBonus) {
    const e = card.effect || {};
    const layer = C.layer;
    let bonus = chainBonus * 2;

    // 层规则对卡牌效果的影响
    if (layer.rule === 'no_light' && (card.veins || []).indexOf('light') >= 0) {
      log(C, '没有红光。这张牌什么也没做。');
      return;
    }
    if (layer.rule === 'dim') bonus -= 1;
    if (layer.rule === 'bright' && (card.veins || []).indexOf('light') >= 0) bonus += 2;

    // 伤害
    if (e.damage) {
      const hits = e.hits || 1;
      const dmgEach = Math.max(0, e.damage + bonus + (C.buffs.strength || 0) + (C.activeProtocol === 'purge' ? 3 : 0));
      const targets = e.target === 'all'
        ? C.enemies.filter(x => !x.dead)
        : [C.enemies[targetIdx === undefined ? 0 : targetIdx]].filter(x => x && !x.dead);
      for (let h = 0; h < hits; h++) {
        targets.forEach(t => dealToEnemy(C, t, dmgEach));
      }
    }
    // 格挡
    if (e.block) {
      gainBlock(C, Math.max(0, e.block + bonus + (C.buffs.dexterity || 0)));
    }
    // 抽牌
    if (e.draw) draw(C, e.draw);
    // 共振增减
    if (e.resonance_gain) C.resonance += e.resonance_gain;
    if (e.resonance_drain) C.resonance = Math.max(0, C.resonance - e.resonance_drain);
    // 凝视
    if (e.gaze_gain) addGaze(C.run, e.gaze_gain);
    if (e.gaze_reduce) C.run.gaze = Math.max(0, C.run.gaze - e.gaze_reduce);
    // 生命
    if (e.heal) healPlayer(C, e.heal);

    // 特殊效果
    (e.special || []).forEach(sp => applySpecial(C, sp, targetIdx));
  }

  function applySpecial(C, sp, targetIdx) {
    const t = C.enemies[targetIdx === undefined ? 0 : targetIdx];
    if (typeof sp === 'string') sp = { code: sp };
    switch (sp.code) {
      case 'burn':    if (t) { t.status.burn = { v: sp.v || 3, turns: sp.turns || 3 }; } break;
      case 'poison':  if (t) { t.status.poison = { v: sp.v || 3 }; } break;
      case 'weak':    if (t) { t.status.weak = sp.turns || 2; } break;
      case 'frail':   if (t) { t.status.frail = sp.turns || 2; } break;
      case 'strength': C.buffs.strength = (C.buffs.strength || 0) + (sp.v || 1); break;
      case 'dexterity': C.buffs.dexterity = (C.buffs.dexterity || 0) + (sp.v || 1); break;
      case 'regenerate': C.buffs.regen = (C.buffs.regen || 0) + (sp.v || 2); break;
      case 'thorns':  C.buffs.thorns = (C.buffs.thorns || 0) + (sp.v || 3); break;
      case 'resonance_lock': C.resonanceLock = true; break;
      case 'gaze_reduce': C.run.gaze = Math.max(0, C.run.gaze - (sp.v || 1)); break;
      case 'delete_random': deleteRandomCard(C.run, C.rng); break;
      case 'exhaust': break; // 由 playCard 处理
      case 'retain': break;  // 由 beginTurn 处理
      default: log(C, '（未实现的效果：' + sp.code + '）');
    }
  }

  // ============ 代价 ============
  function applyCardCost(C, card) {
    const run = C.run;
    // 遗物改则：代价改写为凝视（锁死类仍照常）
    if (card.cost_type !== 'lock') {
      let redirect = false;
      (run.relics || []).forEach(r => { if (r.mod && r.mod.cost_redirect) redirect = true; });
      if (redirect) {
        addGaze(run, 2);
        log(C, '「' + card.name + '」的代价被批文改写了。凝视 +2。');
        return;
      }
    }
    switch (card.cost_type) {
      case 'memory':
        deleteRandomCard(run, C.rng);
        log(C, '「' + card.name + '」' + (card.cost_text || '某段记忆变薄了。'));
        break;
      case 'vitality':
        run.maxHp = Math.max(1, run.maxHp - 1);
        run.hp = Math.min(run.hp, run.maxHp);
        log(C, '「' + card.name + '」皮肤更透明了一点。最大生命 -1。');
        break;
      case 'mark':
        addGaze(run, 1);
        log(C, '「' + card.name + '」有什么东西记下了你。凝视 +1。');
        break;
      case 'lock':
        card._locked = true;
        log(C, '「' + card.name + '」本层内无法再用了。');
        break;
    }
  }

  function deleteRandomCard(run, rng) {
    if (!run.deck.length) return null;
    const i = Math.floor(rng() * run.deck.length);
    const gone = run.deck.splice(i, 1)[0];
    return gone;
  }

  // ============ 伤害 / 格挡 ============
  function dealToEnemy(C, enemy, amount) {
    if (enemy.dead) return;
    let dmg = amount;
    const absorbed = Math.min(enemy.block, dmg);
    enemy.block -= absorbed;
    dmg -= absorbed;
    enemy.hp -= dmg;
    if (dmg > 0) log(C, enemy.name + ' 受到 ' + dmg + ' 伤害。');
    if (enemy.hp <= 0) {
      enemy.hp = 0;
      enemy.dead = true;
      log(C, enemy.name + ' 停下了。');
      if (C.run.classId === 'anmin') {
        const tier = (enemy.def && enemy.def.tier) || 'normal';
        const drop = tier === 'boss' ? 10 : tier === 'elite' ? 4 : randInt(C.rng, 1, 2);
        C.parts += drop;
        log(C, '回收登记：零件 +' + drop + '（库存 ' + C.parts + '）。');
      }
    }
  }

  function gainBlock(C, n) {
    C.block += n;
  }

  function damagePlayer(C, amount, source) {
    if (C.over) return;
    const run = C.run;
    let dmg = amount;
    const absorbed = Math.min(C.block, dmg);
    C.block -= absorbed;
    dmg -= absorbed;
    // 苍民：梦中受伤打的是梦的身体
    if (run.classId === 'cangmin' && C.world === 'dream') {
      if (dmg > 0) {
        C.dreamHp -= dmg;
        log(C, '梦中的身体受到 ' + dmg + ' 伤害' + (source ? '（' + source + '）' : '') + '。');
      }
      if (C.dreamHp <= 0) {
        const overflow = -C.dreamHp;
        const back = Math.ceil(overflow * 0.5);
        C.dreamHp = 0;
        C.world = 'wake';
        if (run.clarity <= 0) C.dreamLocked = true;
        const hand = C.hand.splice(0, C.hand.length);
        C.pileDream = C.pileDream.concat(hand);
        rebuildWorldPiles(C, 'wake');
        C.hand = [];
        draw(C, DRAW_PER_TURN);
        run.hp = Math.max(0, run.hp - back);
        log(C, '梦破了。反噬 ' + back + ' 点涌向醒着的身体，你醒了。');
        if (run.hp <= 0) {
          run.hp = 0;
          C.over = true;
          C.result = 'lose';
          run.dead = true;
          log(C, '反噬带走了最后一点生命。你再也没有醒来。');
        }
      }
      return;
    }
    if (dmg > 0) {
      run.hp -= dmg;
      log(C, '你受到 ' + dmg + ' 伤害' + (source ? '（' + source + '）' : '') + '。');
    }
    if (run.hp <= 0) {
      run.hp = 0;
      C.over = true;
      C.result = 'lose';
      run.dead = true;
      log(C, '你的血在红光里流尽了。');
    }
  }

  function healPlayer(C, n) {
    const run = C.run;
    if (run.classId === 'cangmin' && C.world === 'dream') {
      C.dreamHp = Math.min(C.dreamMaxHp, C.dreamHp + n);
      return;
    }
    run.hp = Math.min(run.maxHp, run.hp + n);
  }

  function addGaze(run, n) {
    run.gaze += n;
  }

  // ============ 回合结束 / 敌人行动 ============
  function endTurn(C) {
    if (C.over) return;

    // 供「模仿」类意图参考：上一回合玩家打出了几张牌
    C.lastTurnPlayed = C.playedCount || 0;
    C.playedCount = 0;

    // 玩家回合结束效果
    if (C.buffs.thorns) { /* 在敌人攻击时结算 */ }

    // 敌人行动
    C.enemies.forEach(e => {
      if (e.dead) return;
      enemyAct(C, e);
    });

    // 敌人状态结算
    C.enemies.forEach(e => {
      if (e.dead) return;
      if (e.status.burn) {
        dealToEnemy(C, e, e.status.burn.v);
        e.status.burn.turns--;
        if (e.status.burn.turns <= 0) delete e.status.burn;
      }
      if (e.status.poison) dealToEnemy(C, e, e.status.poison.v);
      if (e.status.weak) { e.status.weak--; if (e.status.weak <= 0) delete e.status.weak; }
      if (e.status.frail) { e.status.frail--; if (e.status.frail <= 0) delete e.status.frail; }
      if (e.buffTurns) { e.buffTurns--; if (e.buffTurns <= 0) e.buffAtk = 0; }
    });

    // 遗物改则：格挡保留
    let keepBlock = false;
    (C.run.relics || []).forEach(r => { if (r.mod && r.mod.keep_block) keepBlock = true; });
    if (keepBlock) C.block = Math.floor(C.block / 2); else C.block = 0;
    C.turn++;

    checkCombatEnd(C);
    if (!C.over) {
      C.enemies.forEach(e => { if (!e.dead) applyPhase(C, e); });
      C.enemies.forEach(e => { if (!e.dead) e.intent = nextIntent(e); });
      beginTurn(C);
    }
  }

  function nextIntent(e) {
    const pat = currentPattern(e);
    const intent = pat[e.intentIdx % pat.length];
    e.intentIdx++;
    return intent;
  }

  // 当前血量区间对应的出招表（无 phases 的敌人退回 intent_pattern）
  function currentPattern(e) {
    if (!e.phases || !e.phases.length) {
      return e.def.intent_pattern || [{ type: 'attack', value: 5 }];
    }
    const ratio = e.maxHp > 0 ? e.hp / e.maxHp : 0;
    for (let i = 0; i < e.phases.length; i++) {
      if (ratio >= (e.phases[i].hp_above || 0)) return e.phases[i].intent_pattern;
    }
    return e.phases[e.phases.length - 1].intent_pattern;
  }

  // 每回合开始前检查阶段；切换时重置出招序号并输出叙事
  function applyPhase(C, e) {
    if (!e.phases || !e.phases.length || e.dead) return;
    const ratio = e.maxHp > 0 ? e.hp / e.maxHp : 0;
    let idx = e.phases.length - 1;
    for (let i = 0; i < e.phases.length; i++) {
      if (ratio >= (e.phases[i].hp_above || 0)) { idx = i; break; }
    }
    if (idx !== e.phaseIdx) {
      const first = e.phaseIdx === -1;
      e.phaseIdx = idx;
      e.intentIdx = 0;
      if (!first && e.phases[idx].log) log(C, e.phases[idx].log);
    }
  }

  function enemyAct(C, e) {
    const it = e.intent;
    if (!it) return;
    const gazeMul = 1 + Math.floor(C.run.gaze / 10) * 0.1;

    if (it.type === 'attack') {
      let base = it.value + (e.buffAtk || 0) + (C.activeProtocol === 'purge' ? 3 : 0);
      if (it.mirror) {
        base += 3 * (C.lastTurnPlayed || 0);
        if (C.lastTurnPlayed) log(C, e.name + ' 复刻了你上一回合的节奏。');
      }
      if (it.drain_discard && C.discardPile.length) {
        const di = Math.floor(C.rng() * C.discardPile.length);
        const eaten = C.discardPile.splice(di, 1)[0];
        C.exhaustPile.push(eaten);
        log(C, e.name + ' 把「' + eaten.name + '」织进了自己身上。');
      }
      if (e.status.weak) base = Math.floor(base * 0.75);
      const times = it.times || 1;
      for (let i = 0; i < times; i++) {
        let dmg = Math.ceil(base * gazeMul);
        if (it.pierce) {
          damagePlayer(C, dmg, e.name + '的贯骨振动');
          log(C, e.name + ' 的振动从骨头里响起来，' + dmg + ' 点，格挡不住。');
        } else {
          const absorbed = Math.min(C.block, dmg);
          C.block -= absorbed;
          dmg -= absorbed;
          if (dmg > 0) {
            C.run.hp -= dmg;
            log(C, e.name + ' 击中你，' + dmg + ' 点伤害。');
          }
        }
        if (C.run.hp <= 0) {
          C.run.hp = 0; C.over = true; C.result = 'lose'; C.run.dead = true;
          log(C, '你在第 ' + C.layer.id + ' 层停下了。');
          return;
        }
        if (C.buffs.thorns) dealToEnemy(C, e, C.buffs.thorns);
      }
    } else if (it.type === 'defend') {
      e.block += it.value;
      log(C, e.name + ' 合拢了。');
    } else if (it.type === 'buff') {
      if (C.activeProtocol === 'silence') { log(C, '静默协议生效：' + e.name + ' 的增益被驳回。'); return; }
      e.buffAtk = (e.buffAtk || 0) + (it.value || 2);
      e.buffTurns = 99;
      log(C, e.name + ' 变得更快了。');
    } else if (it.type === 'debuff') {
      if (it.status === 'steal') {
        if (C.hand.length) {
          const si = Math.floor(C.rng() * C.hand.length);
          const taken = C.hand.splice(si, 1)[0];
          C.discardPile.push(taken);
          log(C, e.name + ' 把「' + taken.name + '」从你手里抽走了。');
        } else {
          log(C, e.name + ' 伸过来。你手里已经没有它要的东西。');
        }
        return;
      }
      if (it.status === 'gift') {
        draw(C, 1);
        addGaze(C.run, 1);
        log(C, e.name + ' 亮了一下。你多看了一眼，多抽了一张。凝视 +1。');
        return;
      }
      if (it.status === 'weak') C.debuffs.weak = 2;
      else if (it.status === 'poison') C.debuffs.poison = { v: it.value || 3 };
      else if (it.status === 'burn') C.debuffs.burn = { v: it.value || 3 };
      log(C, e.name + ' 朝你吐了什么。');
    }
  }

  function checkCombatEnd(C) {
    if (C.over) return;
    if (C.enemies.every(e => e.dead)) {
      C.over = true;
      C.result = 'win';
      log(C, '这一层安静下来了。');
    }
    if (C.run.hp <= 0) {
      C.over = true;
      C.result = 'lose';
      C.run.dead = true;
    }
  }

  // ============ 战斗结束奖励 ============
  function finishCombat(C) {
    const run = C.run;
    if (run.classId === 'cangmin' && C.world === 'dream') {
      run.clarity = Math.min(run.clarityMax || 5, run.clarity + 2);
      log(C, '〔梦醒〕清醒度 +2（余 ' + run.clarity + '）。你带着梦的重量睁开眼。');
    }
    if (C.result === 'win') {
      if (run.classId !== 'anmin') run.gold += randInt(run.rng, 20, 40); // 黯民以零件结算，不发金币
      return { result: 'win', gold: run.classId === 'anmin' ? 0 : 20 };
    }
    return { result: 'lose' };
  }

  // ============ 结局 ============
  // 通关结局按凝视值分三种；职业决定收尾那一句。
  const ENDINGS = {
    watched: {
      id: 'watched', title: '长审',
      text: '你停下来。红光没有等你。它把你从头到尾又数了一遍，这一次数得很慢，像在核对什么。\n数完了。它没有放开你，也没有收回你。你就站在那里，被看成了它的一部分。'
    },
    averted: {
      id: 'averted', title: '背身',
      text: '谐振器没有声音。你走过最后一层的时候一直看着自己的鞋尖。\n红光在你身后亮了很久，像有人在门口留了一盏灯。你没有回头。回头的人要留下来解释。'
    },
    walked: {
      id: 'walked', title: '同行',
      text: '谐振器没有声音。你的骨头跟着它转了很久，转到分不清是它在动，还是你在动。\n红光把你的影子接了过去，替你站着。\n你数了数自己还剩下的部分。够用。\n下面没有更深的层了。你还是往下迈了一步。'
    }
  };
  const CLASS_LAST_LINE = {
    diver: '你把手上的东西收好。合同第三页的空白处，有人替你签了收。',
    tremor: '你把最后一句震语留在台阶上。城邦不会收到它，岩层收到了。'
  };
  function pickEnding(gaze, classId) {
    let e;
    if (gaze >= 20) e = ENDINGS.watched;
    else if (gaze <= 5) e = ENDINGS.averted;
    else e = ENDINGS.walked;
    return { id: e.id, title: e.title, text: e.text, lastLine: CLASS_LAST_LINE[classId] || '' };
  }

  // ============ 黯民：回收 ============
  // 改造：花 2 零件，给一张手牌永久（本局）+2 伤害或 +3 格挡，同步改 run.deck 原卡
  function salvageUpgrade(C, handIdx, stat) {
    if (C.run.classId !== 'anmin') return { ok: false, msg: '非黯民职业' };
    const card = C.hand[handIdx];
    if (!card) return { ok: false, msg: '没有这张牌' };
    const cost = 2;
    if (C.parts < cost) return { ok: false, msg: '零件不足' };
    const amount = stat === 'damage' ? 2 : 3;
    const target = stat === 'damage' ? 'damage' : 'block';
    C.parts -= cost;
    const apply = (c) => { c.effect[target] = (c.effect[target] || 0) + amount; c._salvaged = c._salvaged || {}; c._salvaged[target] = (c._salvaged[target] || 0) + amount; };
    apply(card);
    const origin = (C.run.deck || []).find(x => x.uid === card.uid);
    if (origin) apply(origin);
    log(C, '改装登记：「' + card.name + '」' + (target === 'damage' ? '伤害 +2' : '格挡 +3') + '（零件 -' + cost + '）。');
    return { ok: true };
  }
  // 拆解：花 3 零件，威胁等级 +1（剩余敌人攻击永久 +1），战后结算 1 件随机遗物
  function dismantle(C) {
    if (C.run.classId !== 'anmin') return { ok: false, msg: '非黯民职业' };
    if (C.parts < 3) return { ok: false, msg: '零件不足（需要 3）' };
    C.parts -= 3;
    C.threatLevel += 1;
    C.enemies.forEach(e => { if (!e.dead) { e.buffAtk = (e.buffAtk || 0) + 1; } });
    C.run._relicReward = (C.run._relicReward || 0) + 1;
    log(C, '威胁等级上调报文已送达。剩余单元攻击 +1。战后将有 1 件设备转入你的库存。');
    return { ok: true };
  }

  // ============ 苍民：双世界 ============
  function rebuildWorldPiles(C, fromWorld, target) {
    // 把原世界的抽/弃堆归位，再从目标世界的堆洗出新抽牌堆
    if (fromWorld === 'wake') C.pileWake = C.pileWake.concat(C.drawPile, C.discardPile);
    else C.pileDream = C.pileDream.concat(C.drawPile, C.discardPile);
    C.discardPile = [];
    if (target === 'dream') {
      C.drawPile = shuffle(C.pileDream, C.rng);
      C.pileDream = [];
    } else {
      C.drawPile = shuffle(C.pileWake, C.rng);
      C.pileWake = [];
    }
  }
  function switchWorld(C, target) {
    if (C.run.classId !== 'cangmin' || C.world === target) return { ok: false, msg: '无效切世' };
    const oldWorld = C.world;
    if (target === 'dream') {
      if (C.dreamLocked) return { ok: false, msg: '本场已强制醒来，不能再入梦' };
      if (C.run.clarity <= 0) return { ok: false, msg: '清醒度耗尽，无法入梦' };
      C.run.clarity -= 1;
      C.dreamHp = C.dreamMaxHp;
      log(C, '〔入梦〕清醒度 -1（余 ' + C.run.clarity + '）。火母的领地还认得你。');
    } else {
      C.run.hp = Math.min(C.run.maxHp, C.run.hp + 3);
      log(C, '〔醒来〕身体 +3。枕头边放着一个没做完的梦。');
    }
    // 手牌与旧堆按【原世界】归位，再重建目标世界牌堆
    const hand = C.hand.splice(0, C.hand.length);
    if (oldWorld === 'wake') C.pileWake = C.pileWake.concat(hand);
    else C.pileDream = C.pileDream.concat(hand);
    C.world = target;
    rebuildWorldPiles(C, oldWorld, target);
    C.hand = [];
    draw(C, DRAW_PER_TURN);
    return { ok: true };
  }
  function forceWake(C, reason) {
    if (C.world !== 'dream') return;
    const hand = C.hand.splice(0, C.hand.length);
    C.pileDream = C.pileDream.concat(hand);
    rebuildWorldPiles(C, 'dream', 'wake');
    C.world = 'wake';
    C.run.clarity = Math.min(C.run.clarityMax || 5, C.run.clarity + 1); // 强迫醒也回神，但只回一半
    C.dreamLocked = true; // 本场不能再入梦
    C.hand = [];
    draw(C, DRAW_PER_TURN);
    log(C, '〔强制醒来〕' + reason + ' 清醒度 +1（余 ' + C.run.clarity + '）。');
  }
  // 预兆：每回合开始抽一张，3 回合后结算，最多同时 3 张
  const OMENS = [
    { name: '吉兆：火母的余温', good: true, apply: (C) => { C.energy += 1; log(C, '〔预兆〕火母的余温：本回合能量 +1。'); } },
    { name: '凶兆：影子先行', good: false, apply: (C) => { const e = C.enemies.find(x => !x.dead); if (e) { e.buffAtk = (e.buffAtk || 0) + 1; log(C, '〔预兆〕影子先行：' + e.name + ' 攻击 +1。'); } } },
    { name: '吉兆：浅海的渔获', good: true, apply: (C) => { healPlayer(C, 3); log(C, '〔预兆〕浅海的渔获：回复 3 点。'); } },
    { name: '凶兆：名字被念到', good: false, apply: (C) => { if (C.hand.length) { const i = Math.floor(C.rng() * C.hand.length); log(C, '〔预兆〕名字被念到：「' + C.hand[i].name + '」被弃置。'); C.hand.splice(i, 1); } } }
  ];
  function tickOmens(C) {
    if (C.run.classId !== 'cangmin') return;
    for (let i = C.omens.length - 1; i >= 0; i--) {
      C.omens[i].turnsLeft -= 1;
      if (C.omens[i].turnsLeft <= 0) {
        C.omens[i].def.apply(C);
        C.omens.splice(i, 1);
      }
    }
    if (C.omens.length < 3) {
      const def = OMENS[Math.floor(C.rng() * OMENS.length)];
      C.omens.push({ def: def, turnsLeft: 3 });
      log(C, '〔预兆〕' + def.name + '（3 回合后应验）。');
    }
  }

  function activateProtocol(C, name) {
    C.activeProtocol = name;
    const T = { lockdown: '封锁', purge: '清剿', silence: '静默' };
    log(C, '〔协议〕' + (T[name] || name) + ' 已下达。不可撤销。');
  }

  // ============ 卡牌升级 ============
  // 返回升级后的新卡对象，不修改原卡。upgrade.effect 的数值为最终值；
  // special 为追加条目（空数组表示清空原特殊效果）；cost_type 可改写代价。
  function upgradeCard(card) {
    const up = card && card.upgrade;
    if (!up || card.upgraded) return null;
    const c = Object.assign({}, card, {
      name: card.name + (up.name_suffix || '+'),
      effect: Object.assign({}, card.effect),
      cost_type: up.cost_type !== undefined ? up.cost_type : card.cost_type,
      upgraded: true
    });
    if (up.effect) {
      Object.keys(up.effect).forEach(k => {
        const v = up.effect[k];
        if (k === 'special' && Array.isArray(v)) {
          c.effect.special = v.length ? (c.effect.special || []).concat(v) : [];
        } else {
          c.effect[k] = v;
        }
      });
    }
    if (up.flavor_add) c.flavor = card.flavor + '\n' + up.flavor_add;
    return c;
  }

  // ============ 日志 ============
  function log(C, msg) {
    C.log.push(msg);
    if (C.log.length > 300) C.log.shift();
  }

  // ============ 导出 ============
  const API = {
    VEINS: VEINS,
    VEIN_CN: VEIN_CN,
    LAYERS: LAYERS,
    MODE_REACTION: MODE_REACTION,
    makeRng: makeRng,
    shuffle: shuffle,
    newRun: newRun,
    startCombat: startCombat,
    playCard: playCard,
    endTurn: endTurn,
    draw: draw,
    finishCombat: finishCombat,
    upgradeCard: upgradeCard,
    salvageUpgrade: salvageUpgrade,
    dismantle: dismantle,
    activateProtocol: activateProtocol,
    switchWorld: switchWorld,
    damagePlayer: damagePlayer,
    pickEnding: pickEnding,
    ENDINGS: ENDINGS,
    LAYER_AT: (d) => LAYERS[d - 1]
  };

  if (typeof module !== 'undefined' && module.exports) module.exports = API;
  if (root) root.RedAbyss = API;

})(typeof window !== 'undefined' ? window : this);
</script>
<script>
const RAW = {"diver":[{"id":"dive_0001","name":"光导透镜（残）","class":"diver","type":"skill","rarity":"common","veins":["light"],"energy":0,"effect":{"draw":1,"target":"self"},"cost_type":"vitality","cost_text":"你的手开始透光。","flavor":"镜片裂了一道。裂的那道看得更清楚。","upgrade":{"name_suffix":"·新","effect":{"draw":2},"flavor_add":"镜片换过了。它还认得你的眼睛。"}},{"id":"dive_0002","name":"聚能枪","class":"diver","type":"attack","rarity":"common","veins":["light"],"energy":1,"effect":{"damage":10,"hits":1,"target":"single"},"cost_type":"none","cost_text":"","flavor":"填弹的时候它自己热了。这里没有火。","upgrade":{"name_suffix":"·改","effect":{"damage":14},"flavor_add":"你把撞针磨短了一点。它出膛更快。"}},{"id":"dive_0003","name":"曜元","class":"diver","type":"skill","rarity":"common","veins":["light"],"energy":1,"effect":{"draw":2,"target":"self","special":[{"code":"exhaust"}]},"cost_type":"none","cost_text":"","flavor":"药液是亮的。管壁上留着别人的指纹。","upgrade":{"name_suffix":"·Ⅱ","effect":{"draw":2,"special":[]},"flavor_add":"药效过了还在。这一次它不走了。"}},{"id":"dive_0004","name":"光苔矿培植舱","class":"diver","type":"skill","rarity":"common","veins":["light"],"energy":1,"effect":{"block":8,"target":"self"},"cost_type":"none","cost_text":"","flavor":"绿光照在护板上。苔沿着铆钉排成长列，一列不落。","upgrade":{"name_suffix":"·固","effect":{"block":12},"flavor_add":"你把舱壁的裂缝堵严了。绿色在里面越养越深。"}},{"id":"dive_0005","name":"氧气再生器","class":"diver","type":"skill","rarity":"common","veins":["light"],"energy":1,"effect":{"block":5,"target":"self","special":[{"code":"regenerate","value":2}]},"cost_type":"none","cost_text":"","flavor":"换下来的滤芯还温着。新的那只会哼另一支曲子。","upgrade":{"name_suffix":"·新","effect":{"block":7,"special":[{"code":"regenerate","value":1}]},"flavor_add":"滤芯换成了新批次的。呼吸这件事被它包了。"}},{"id":"dive_0006","name":"渊光重工·工作灯","class":"diver","type":"skill","rarity":"common","veins":["light"],"energy":1,"effect":{"block":3,"draw":1,"target":"self"},"cost_type":"none","cost_text":"","flavor":"灯照到哪里，哪里就算地面。照明范围写在合同附件里。","upgrade":{"name_suffix":"·改","effect":{"block":5},"flavor_add":"灯罩加固过。你的领土暂时不再收缩。"}},{"id":"dive_0007","name":"渊光重工·导光索","class":"diver","type":"power","rarity":"uncommon","veins":["light"],"energy":1,"effect":{"target":"self","special":[{"code":"dexterity","value":2}]},"cost_type":"none","cost_text":"","flavor":"红光在索上走得比人快。它从不回头。","upgrade":{"name_suffix":"·固","effect":{"special":[{"code":"dexterity","value":1}]},"flavor_add":"红光在索上排好了队。一个都不许插队。"}},{"id":"dive_0008","name":"红渊研究院·数据回传","class":"diver","type":"skill","rarity":"uncommon","veins":["light"],"energy":1,"effect":{"draw":2,"target":"self"},"cost_type":"memory","cost_text":"回传清单把你的童年标成了冗余数据。","flavor":"传输条走完。你的童年少了一条巷子。","upgrade":{"name_suffix":"·新","effect":{"draw":3},"flavor_add":"清单被退回了一次。这次他们只抽走别人的东西。","cost_type":"none"}},{"id":"dive_0009","name":"聚能枪（双管）","class":"diver","type":"attack","rarity":"uncommon","veins":["light"],"energy":2,"effect":{"damage":8,"hits":2,"target":"single"},"cost_type":"none","cost_text":"","flavor":"两根管，一根有弹药。另一根在等你签字。","upgrade":{"name_suffix":"·改","effect":{"damage":11},"flavor_add":"许可证加了页。两根枪管，两份弹药，一样都没批全。"}},{"id":"dive_0010","name":"聚变鱼雷","class":"diver","type":"attack","rarity":"special","veins":["light"],"energy":2,"effect":{"damage":12,"hits":1,"target":"all"},"cost_type":"none","cost_text":"","flavor":"按钮在四十公里上面。你替他们按了。","upgrade":{"name_suffix":"·Ⅱ","effect":{"damage":16},"flavor_add":"下面又按了一次。你在更深处接住了它。"}},{"id":"dive_0011","name":"辐射弹","class":"diver","type":"attack","rarity":"rare","veins":["light"],"energy":2,"effect":{"damage":10,"hits":1,"target":"all","resonance_gain":4,"gaze_cost":3},"cost_type":"none","cost_text":"","flavor":"弹体上有三个签章。没有一个是收尾的。","upgrade":{"name_suffix":"·改","effect":{"damage":14},"flavor_add":"封条撕掉了。三个部门都假装没看见。"}},{"id":"dive_0012","name":"轨道炮支援","class":"diver","type":"attack","rarity":"rare","veins":["light"],"energy":3,"effect":{"damage":24,"hits":1,"target":"single"},"cost_type":"none","cost_text":"","flavor":"上面的人按了按钮。他们不需要看见你。","upgrade":{"name_suffix":"·Ⅱ","effect":{"damage":34},"flavor_add":"弹着点画在你的影子上。这算为你申请的。"}},{"id":"dive_0013","name":"硬矿钻","class":"diver","type":"attack","rarity":"common","veins":["mineral"],"energy":0,"effect":{"damage":5,"hits":1,"target":"single"},"cost_type":"none","cost_text":"","flavor":"钻头换过三次。你的骨头一次都没换过，还是原来的硬法。","upgrade":{"name_suffix":"·固","effect":{"damage":7},"flavor_add":"钻头换了新合金。还是比你的骨头年轻。"}},{"id":"dive_0014","name":"震髓探测器","class":"diver","type":"skill","rarity":"common","veins":["mineral"],"energy":1,"effect":{"draw":1,"resonance_gain":2,"target":"self"},"cost_type":"none","cost_text":"","flavor":"探针收回来，尖上是暗红的。它有脉搏。","upgrade":{"name_suffix":"·改","effect":{"resonance_gain":3},"flavor_add":"探针磨尖了。带回来的东西更烫。"}},{"id":"dive_0015","name":"星髓矿业·爆破执照","class":"diver","type":"attack","rarity":"uncommon","veins":["mineral"],"energy":1,"effect":{"damage":12,"hits":1,"target":"single"},"cost_type":"lock","cost_text":"执照每层只批一次。","flavor":"第七章要求默哀十秒。你数到三就开始了。","upgrade":{"name_suffix":"·刻","effect":{"damage":17},"flavor_add":"第七章被划掉重写过。哀悼改成了装填。"}},{"id":"dive_0016","name":"共振抑制仪","class":"diver","type":"skill","rarity":"uncommon","veins":["mineral"],"energy":1,"effect":{"block":6,"target":"self","special":[{"code":"resonance_lock"}]},"cost_type":"none","cost_text":"","flavor":"机器嗡了一声。有个东西退了一步。","upgrade":{"name_suffix":"·固","effect":{"block":9},"flavor_add":"嗡声调低半度。退后一步的东西又退了一步。"}},{"id":"dive_0017","name":"星髓矿业·深地车","class":"diver","type":"power","rarity":"uncommon","veins":["mineral"],"energy":1,"effect":{"target":"self","special":[{"code":"strength","value":1},{"code":"dexterity","value":1}]},"cost_type":"none","cost_text":"","flavor":"仪表盘贴着一张孩子的画。画的是上面。","upgrade":{"name_suffix":"·改","effect":{"special":[{"code":"strength","value":1}]},"flavor_add":"仪表盘上的画换了。新的那张画的是车。"}},{"id":"dive_0018","name":"墟盐","class":"diver","type":"skill","rarity":"common","veins":["mineral"],"energy":1,"effect":{"block":9,"target":"self","special":[{"code":"regenerate","value":2}]},"cost_type":"mark","cost_text":"白色溶进红光里。有什么把它记下了。","flavor":"你按规程尝了一点。规程没说不能咽，你也没咽。","upgrade":{"name_suffix":"·固","effect":{"block":13},"flavor_add":"盐压成了块。苦味停得更久，你不再计较。"}},{"id":"dive_0019","name":"抗共振司·锚桩","class":"diver","type":"skill","rarity":"common","veins":["mineral"],"energy":1,"effect":{"block":5,"target":"self","special":[{"code":"thorns","value":3}]},"cost_type":"none","cost_text":"","flavor":"桩顶的灯转成红的。岩层忍住了。","upgrade":{"name_suffix":"·固","effect":{"block":7},"flavor_add":"桩顶的灯换了常亮的。岩层习惯了。"}},{"id":"dive_0020","name":"黑曜采掘·加班条例","class":"diver","type":"power","rarity":"uncommon","veins":["mineral"],"energy":1,"effect":{"target":"self","special":[{"code":"strength","value":2}]},"cost_type":"vitality","cost_text":"合同第三十一条：身体属于公司。","flavor":"念到第三十一条，你的指甲透明了。没有人停下来。","upgrade":{"name_suffix":"·刻","effect":{"special":[{"code":"strength","value":1}]},"flavor_add":"第三十一条加了附则。身体也属于加班。"}},{"id":"dive_0021","name":"星髓矿业·定向爆破","class":"diver","type":"attack","rarity":"rare","veins":["mineral"],"energy":2,"effect":{"damage":26,"hits":1,"target":"single","resonance_cost":10},"cost_type":"none","cost_text":"","flavor":"药量按三十年前的图纸装。岩层比图纸老。","upgrade":{"name_suffix":"·Ⅱ","effect":{"damage":36},"flavor_add":"图纸翻新了。岩层没翻新，但它会配合。"}},{"id":"dive_0022","name":"硬矿钻（重型）","class":"diver","type":"attack","rarity":"uncommon","veins":["mineral"],"energy":2,"effect":{"damage":13,"hits":1,"target":"single","special":[{"code":"frail","value":1}]},"cost_type":"none","cost_text":"","flavor":"它啃硬矿的声音从牙根进来。你俩啃的是同一块。","upgrade":{"name_suffix":"·改","effect":{"damage":18,"special":[{"code":"frail","turns":3}]},"flavor_add":"它啃东西的声音变了。你的牙先听出来的。"}},{"id":"dive_0023","name":"抗共振司·静默规程","class":"diver","type":"skill","rarity":"rare","veins":["mineral"],"energy":2,"effect":{"block":12,"target":"self","special":[{"code":"resonance_lock"}]},"cost_type":"none","cost_text":"","flavor":"规程生效之后，心跳得先打报告。批下来的那部分才许响。","upgrade":{"name_suffix":"·固","effect":{"block":17},"flavor_add":"规程补了附录。心跳也被批进了静默范围。"}},{"id":"dive_0024","name":"深红资源集团·钻探平台","class":"diver","type":"attack","rarity":"rare","veins":["mineral"],"energy":3,"effect":{"damage":10,"hits":3,"target":"single","gaze_cost":4},"cost_type":"none","cost_text":"","flavor":"打桩声传到地表。有人在那儿听了一辈子。","upgrade":{"name_suffix":"·Ⅱ","effect":{"damage":13},"flavor_add":"桩打得更密。地表的人以为地震变多了。"}},{"id":"dive_0025","name":"震频器","class":"diver","type":"skill","rarity":"common","veins":["tremor"],"energy":0,"effect":{"resonance_gain":2,"target":"self"},"cost_type":"none","cost_text":"","flavor":"指针停在两个刻度之间。哪边都不是给你的。","upgrade":{"name_suffix":"·改","effect":{"resonance_gain":3},"flavor_add":"指针焊死在一个刻度上。那个刻度在下面。"}},{"id":"dive_0026","name":"震髓装药","class":"diver","type":"attack","rarity":"common","veins":["tremor"],"energy":1,"effect":{"damage":14,"hits":1,"target":"single","resonance_cost":5},"cost_type":"none","cost_text":"","flavor":"它把振动吃进去，再吐出来。吐出来的部分不认人。","upgrade":{"name_suffix":"·刻","effect":{"damage":19},"flavor_add":"装药重新压过。吐出来的部分开始认人。"}},{"id":"dive_0027","name":"星髓矿业·钻杆","class":"diver","type":"attack","rarity":"common","veins":["tremor"],"energy":1,"effect":{"damage":9,"hits":1,"target":"single"},"cost_type":"none","cost_text":"","flavor":"杆身刻满深度记号。最深那道不是刻度，是指甲。","upgrade":{"name_suffix":"·旧","effect":{"damage":13},"flavor_add":"杆身换过了。指甲划的那道留了下来。"}},{"id":"dive_0028","name":"震频器（校准）","class":"diver","type":"skill","rarity":"uncommon","veins":["tremor"],"energy":1,"effect":{"resonance_gain":4,"target":"self"},"cost_type":"none","cost_text":"","flavor":"校准之后只指一个方向。向下。","upgrade":{"name_suffix":"·Ⅱ","effect":{"resonance_gain":6},"flavor_add":"校准了两次。现在它只指向更下面。"}},{"id":"dive_0029","name":"红渊研究院·震谱仪","class":"diver","type":"skill","rarity":"uncommon","veins":["tremor"],"energy":2,"effect":{"draw":3,"target":"self","resonance_cost":8},"cost_type":"none","cost_text":"","flavor":"谱线上有一段很规律的波。注释写着：设备干扰。","upgrade":{"name_suffix":"·新","effect":{"draw":4,"resonance_cost":6},"flavor_add":"那段波形进了附录。注释改成了：来源未知。"}},{"id":"dive_0030","name":"抗共振司·镇爆弹","class":"diver","type":"attack","rarity":"rare","veins":["tremor"],"energy":3,"effect":{"damage":10,"hits":1,"target":"all","gaze_cost":3,"special":[{"code":"weak","value":2}]},"cost_type":"lock","cost_text":"本层只批这一发。","flavor":"弹壳上印着守则。第一条：不要去听回声。","upgrade":{"name_suffix":"·Ⅱ","effect":{"damage":14},"flavor_add":"守则加了第二条：回声也归它听。"}},{"id":"dive_0031","name":"聚能枪（过热）","class":"diver","type":"attack","rarity":"common","veins":["heat"],"energy":1,"effect":{"damage":11,"hits":1,"target":"single"},"cost_type":"vitality","cost_text":"枪管红透了。你换了一只手握。","flavor":"打完第三发，护目镜裂了。裂纹正对着你的眼前。","upgrade":{"name_suffix":"·刻","effect":{"damage":15},"flavor_add":"裂纹爬满了镜片。你从裂纹中间看出去。"}},{"id":"dive_0032","name":"曜元（缓释）","class":"diver","type":"skill","rarity":"common","veins":["heat"],"energy":1,"effect":{"target":"self","special":[{"code":"regenerate","value":3}]},"cost_type":"none","cost_text":"","flavor":"药效排在后半夜。排班表上没有后半夜。","upgrade":{"name_suffix":"·新","effect":{"special":[{"code":"regenerate","value":2}]},"flavor_add":"排班表改了。后半夜归你了。"}},{"id":"dive_0033","name":"圣火武器","class":"diver","type":"attack","rarity":"uncommon","veins":["heat"],"energy":1,"effect":{"damage":6,"hits":1,"target":"single","special":[{"code":"burn","value":3,"turns":2}]},"cost_type":"none","cost_text":"","flavor":"授权书上的火漆是真的火漆。它烧得很安静。","upgrade":{"name_suffix":"·改","effect":{"damage":8},"flavor_add":"火漆换了新的。授权在燃烧中续期。"}},{"id":"dive_0034","name":"反走私局·焚烧记录","class":"diver","type":"skill","rarity":"uncommon","veins":["heat"],"energy":2,"effect":{"target":"all","special":[{"code":"burn","value":5,"turns":3}]},"cost_type":"none","cost_text":"","flavor":"没收品烧起来的颜色不对。记录上写的是标准红。","upgrade":{"name_suffix":"·Ⅱ","effect":{"special":[{"code":"burn","value":2,"turns":3}]},"flavor_add":"记录改成了深红。这次没人反对。"}},{"id":"dive_0035","name":"深红资源集团·地热井口","class":"diver","type":"power","rarity":"rare","veins":["heat"],"energy":2,"effect":{"target":"self","special":[{"code":"strength","value":2}]},"cost_type":"none","cost_text":"","flavor":"井口的风往上吹。你在风里站了很久，没有出汗。","upgrade":{"name_suffix":"·固","effect":{"special":[{"code":"strength","value":1}]},"flavor_add":"风更急了。旧铁的味道里多了点新的。"}},{"id":"dive_0036","name":"红渊贸易局·净水配给","class":"diver","type":"skill","rarity":"common","veins":["water"],"energy":1,"effect":{"block":6,"target":"self","special":[{"code":"regenerate","value":2}]},"cost_type":"none","cost_text":"","flavor":"配给水是苦的。你喝的时候没有皱眉。上面教过。","upgrade":{"name_suffix":"·新","effect":{"block":9},"flavor_add":"配给加了半升。苦味是标准配置，没减。"}},{"id":"dive_0037","name":"红渊研究院·水样档案","class":"diver","type":"skill","rarity":"uncommon","veins":["water"],"energy":1,"effect":{"draw":1,"target":"self","special":[{"code":"regenerate","value":3}]},"cost_type":"none","cost_text":"","flavor":"编号靠后的水样没有检测人签名。纸是湿的。","upgrade":{"name_suffix":"·改","effect":{"draw":2},"flavor_add":"最后一页写上了名字。字迹不是你的。"}},{"id":"dive_0038","name":"氧气再生器（满压）","class":"diver","type":"skill","rarity":"rare","veins":["water"],"energy":2,"effect":{"block":8,"target":"self","special":[{"code":"regenerate","value":4}]},"cost_type":"none","cost_text":"","flavor":"满压时机器会哼一支不成调的曲子。后来你也会哼了。","upgrade":{"name_suffix":"·固","effect":{"block":12},"flavor_add":"曲子哼全了。后半段是你自己编的。"}},{"id":"dive_0039","name":"矿票","class":"diver","type":"skill","rarity":"special","veins":[],"energy":0,"effect":{"draw":1,"target":"self"},"cost_type":"none","cost_text":"","flavor":"票面编号比你的小。签字的人没有下来。","upgrade":{"name_suffix":"·新","effect":{"draw":2},"flavor_add":"票面重新印过。编号栏空着，等你填。"}},{"id":"dive_0040","name":"重力训练舱","class":"diver","type":"power","rarity":"uncommon","veins":[],"energy":2,"effect":{"target":"self","special":[{"code":"strength","value":1},{"code":"dexterity","value":1}]},"cost_type":"none","cost_text":"","flavor":"舱里待一天，抵地面一年。工资单上的数字没跟上。","upgrade":{"name_suffix":"·Ⅱ","effect":{"special":[{"code":"strength","value":1}]},"flavor_add":"舱里多待了一天。工资没变，骨头变了。"}},{"id":"dive_0041","name":"震频器（并联）","class":"diver","type":"skill","rarity":"common","veins":["tremor"],"energy":0,"effect":{"resonance_gain":3,"target":"self"},"cost_type":"none","cost_text":"","flavor":"三台一起响。分不清哪个是回声，哪个是源头。","upgrade":{"name_suffix":"·改","effect":{"resonance_gain":5},"flavor_add":"三台拆了一台。剩下两台分了它的活。"}},{"id":"dive_0042","name":"震髓探测器（阵列）","class":"diver","type":"skill","rarity":"uncommon","veins":["tremor"],"energy":1,"effect":{"resonance_gain":5,"draw":1,"target":"self"},"cost_type":"none","cost_text":"","flavor":"十二根探针一起扎下去。岩层抖了一下，像被挠到痒处。","upgrade":{"name_suffix":"·Ⅱ","effect":{"resonance_gain":7},"flavor_add":"第十三根探针是自己长出来的。"}},{"id":"dive_0043","name":"曜元（共振型）","class":"diver","type":"skill","rarity":"common","veins":["light"],"energy":1,"effect":{"resonance_gain":4,"target":"self"},"cost_type":"none","cost_text":"","flavor":"药剂自己发光，跟着某个节拍。你的心跳没跟上，它等了等。","upgrade":{"name_suffix":"·改","effect":{"resonance_gain":6},"flavor_add":"节拍对上了。它不再等你，它跟着你。"}},{"id":"dive_0044","name":"抗共振司·导波索","class":"diver","type":"skill","rarity":"uncommon","veins":["tremor"],"energy":1,"effect":{"resonance_gain":4,"block":5,"target":"self"},"cost_type":"none","cost_text":"","flavor":"索把振动引向你指定的地方。规程没写不能指向自己。","upgrade":{"name_suffix":"·固","effect":{"block":7},"flavor_add":"索换了粗的。振动被你攥在手里。"}},{"id":"dive_0045","name":"红渊研究院·共振采样","class":"diver","type":"skill","rarity":"common","veins":["tremor"],"energy":1,"effect":{"resonance_gain":3,"draw":1,"target":"self"},"cost_type":"none","cost_text":"","flavor":"样本瓶里的液体在跳。标签写着：勿摇。","upgrade":{"name_suffix":"·新","effect":{"resonance_gain":5},"flavor_add":"标签换了：请摇匀。你照做了。"}},{"id":"dive_0046","name":"星髓矿业·深部震源","class":"diver","type":"attack","rarity":"rare","veins":["tremor"],"energy":2,"effect":{"damage":36,"hits":1,"target":"single","resonance_cost":15},"cost_type":"none","cost_text":"","flavor":"半条矿道的振动一次放完。放完之后，那里的安静有了重量。","upgrade":{"name_suffix":"·Ⅱ","effect":{"damage":48},"flavor_add":"你攒了整整一层。放完之后，更下面安静了。"}},{"id":"dive_0047","name":"深红资源集团·谐振井","class":"diver","type":"power","rarity":"uncommon","veins":["tremor"],"energy":2,"effect":{"resonance_gain":6,"target":"self"},"cost_type":"none","cost_text":"","flavor":"井打通了三层。下面传上来的东西，比报告里多。","upgrade":{"name_suffix":"·固","effect":{"resonance_gain":9},"flavor_add":"井又深了一层。传上来的东西学会了排队。"}},{"id":"dive_0048","name":"矿票（回收藏）","class":"diver","type":"skill","rarity":"common","veins":[],"energy":0,"effect":{"draw":1,"target":"self"},"cost_type":"none","cost_text":"","flavor":"收票的人只捏皱的。平展的那叠，他看都不看。","upgrade":{"name_suffix":"·旧","effect":{"draw":2},"flavor_add":"收票的人眯着眼看了很久。这是最皱的一张。"}},{"id":"dive_0049","name":"硬矿钻（手持）","class":"diver","type":"attack","rarity":"common","veins":["mineral"],"energy":0,"effect":{"damage":4,"hits":1,"target":"single"},"cost_type":"none","cost_text":"","flavor":"手柄缠着防滑布。缠布的人只信自己的手。","upgrade":{"name_suffix":"·改","effect":{"damage":6},"flavor_add":"防滑布换成了皮。这只手开始信机器了。"}},{"id":"dive_0050","name":"氧气再生器（便携）","class":"diver","type":"skill","rarity":"common","veins":["light"],"energy":0,"effect":{"block":3,"target":"self"},"cost_type":"none","cost_text":"","flavor":"说明书写着：不保证供氧，只保证你还想呼吸。","upgrade":{"name_suffix":"·固","effect":{"block":5},"flavor_add":"说明书换了一版：保证你还想呼吸。"}},{"id":"dive_0051","name":"震频器（微型）","class":"diver","type":"skill","rarity":"common","veins":["tremor"],"energy":0,"effect":{"resonance_gain":1,"target":"self"},"cost_type":"none","cost_text":"","flavor":"它半夜自己响。你现在在它响之前醒，等它响。","upgrade":{"name_suffix":"·新","effect":{"resonance_gain":2},"flavor_add":"它半夜响两声了。你开始在更早的时候醒。"}},{"id":"dive_0052","name":"光苔矿（盆栽）","class":"diver","type":"power","rarity":"uncommon","veins":["light"],"energy":1,"effect":{"target":"self","special":[{"code":"dexterity","value":1}]},"cost_type":"none","cost_text":"","flavor":"车里的位置给了它。它把叶子的方向调成了下面。","upgrade":{"name_suffix":"·Ⅱ","effect":{"special":[{"code":"dexterity","value":1}]},"flavor_add":"车里的位置不够了。你把它抱在腿上。"}},{"id":"dive_0053","name":"渊光重工·备用电源","class":"diver","type":"skill","rarity":"rare","veins":["light"],"energy":1,"effect":{"draw":3,"target":"self"},"cost_type":"none","cost_text":"","flavor":"「真的不能用」怎么判断。条例没说。","upgrade":{"name_suffix":"·改","effect":{"draw":4},"flavor_add":"「真的不能用」的判例多了一条。你那条在内。"}},{"id":"dive_0054","name":"聚能枪（超载）","class":"diver","type":"attack","rarity":"uncommon","veins":["light"],"energy":1,"effect":{"damage":16,"hits":1,"target":"single"},"cost_type":"vitality","cost_text":"枪管红透了。你的指节比昨天更透明。","flavor":"后坐力从骨缝里进去。你的一部分也算弹药。","upgrade":{"name_suffix":"·刻","effect":{"damage":22},"flavor_add":"指节透光的地方包了布。弹药还是要人来当。"}},{"id":"dive_0055","name":"辐射弹（裸装）","class":"diver","type":"attack","rarity":"uncommon","veins":["light"],"energy":2,"effect":{"damage":14,"hits":1,"target":"all"},"cost_type":"none","cost_text":"","flavor":"去掉防护壳，装药多一半。运它的人走在最前面。","upgrade":{"name_suffix":"·残","effect":{"damage":19},"flavor_add":"壳彻底拆了。走在最后的人也交了运费。"}},{"id":"dive_0056","name":"死亡合同（增补条款）","class":"diver","type":"skill","rarity":"uncommon","veins":["mineral"],"energy":0,"effect":{"target":"self","special":[{"code":"strength","value":2}]},"cost_type":"vitality","cost_text":"附件第七页：乙方同意提前透支。","flavor":"签字栏下面还有一行小字。你没读。","upgrade":{"name_suffix":"·刻","effect":{"special":[{"code":"strength","value":1}]},"flavor_add":"你读了那行小字。读完就背下来了。"}},{"id":"dive_0057","name":"重力训练舱（极限负重）","class":"diver","type":"skill","rarity":"uncommon","veins":[],"energy":1,"effect":{"target":"self","special":[{"code":"strength","value":3}]},"cost_type":"vitality","cost_text":"你的骨头记住了这个重量，用它们自己的方式。","flavor":"出舱的时候你的手在抖。是肌肉在重新学什么叫重。","upgrade":{"name_suffix":"·Ⅱ","effect":{"special":[{"code":"strength","value":1}]},"flavor_add":"重量再加一档。骨头开始主动去记。"}},{"id":"dive_0058","name":"圣火武器（殉爆）","class":"diver","type":"attack","rarity":"rare","veins":["heat"],"energy":3,"effect":{"damage":30,"hits":1,"target":"all"},"cost_type":"vitality","cost_text":"火漆烧穿了封皮。这一次没有人按住它。","flavor":"它想快点。你按住了它，又松开。","upgrade":{"name_suffix":"·Ⅱ","effect":{"damage":42},"flavor_add":"这一次你先松的手。"}},{"id":"dive_0059","name":"曜元（空腹）","class":"diver","type":"skill","rarity":"common","veins":["heat"],"energy":1,"effect":{"target":"self","special":[{"code":"regenerate","value":4}]},"cost_type":"none","cost_text":"","flavor":"空腹注射的警告被划掉了。你照着划掉之后的样子做。","upgrade":{"name_suffix":"·新","effect":{"special":[{"code":"regenerate","value":2}]},"flavor_add":"警告栏重新印刷了：空腹。你早就照做了。"}},{"id":"dive_0060","name":"黑曜采掘·无氧班次","class":"diver","type":"power","rarity":"uncommon","veins":["mineral"],"energy":2,"effect":{"target":"self","special":[{"code":"dexterity","value":2}]},"cost_type":"lock","cost_text":"无氧班每层只排一次。","flavor":"无氧班的工牌是黑色的。戴黑牌的人走路都很轻。","upgrade":{"name_suffix":"·刻","effect":{"special":[{"code":"dexterity","value":1}]},"flavor_add":"黑牌加了漆。走路轻的人不回头看灯。"}},{"id":"dive_0061","name":"巡线灯","type":"skill","rarity":"common","veins":["light"],"energy":1,"effect":{"block":4,"draw":1,"target":"self"},"cost_type":"none","cost_text":"","flavor":"灯沿线走到头，又走回来。它在线上住了很多年。","upgrade":{"name_suffix":"·固","effect":{"block":6},"flavor_add":"线换成了粗的。灯走得心安理得。"},"class":"diver"},{"id":"dive_0062","name":"凿屑袋","type":"attack","rarity":"common","veins":["mineral"],"energy":0,"effect":{"damage":2,"hits":2,"target":"single"},"cost_type":"none","cost_text":"","flavor":"袋里的碎屑还是烫的。它们刚才还是墙。","upgrade":{"name_suffix":"·改","effect":{"damage":3},"flavor_add":"碎屑换成了碎骨。也还是烫的。"},"class":"diver"},{"id":"dive_0063","name":"抗共振司·静音瓦","type":"skill","rarity":"uncommon","veins":["mineral"],"energy":2,"effect":{"block":13,"target":"self"},"cost_type":"lock","cost_text":"瓦片每层只批一片。","flavor":"瓦贴上墙的地方，回声绕道走。走之前顿了一下，像记路。","upgrade":{"name_suffix":"·固","effect":{"block":18},"flavor_add":"贴了两层。绕道的回声迷路了。"},"class":"diver"},{"id":"dive_0064","name":"星髓矿业·矿脉图","type":"skill","rarity":"rare","veins":["mineral"],"energy":0,"effect":{"draw":2,"target":"self"},"cost_type":"memory","cost_text":"图上你的宿舍位置被标成了采空区。","flavor":"图比走廊准。走廊改过三次，图没改。","upgrade":{"name_suffix":"·新","effect":{"draw":3},"cost_type":"none","flavor_add":"新版把采空区改回了宿舍。你没住回去。"},"class":"diver"},{"id":"dive_0065","name":"渊光重工·接地缆","type":"power","rarity":"uncommon","veins":["light"],"energy":1,"effect":{"target":"self","special":[{"code":"thorns","value":4}]},"cost_type":"none","cost_text":"","flavor":"碰到缆的人会替你疼一下。他们后来都不碰第二下。","upgrade":{"name_suffix":"·Ⅱ","effect":{"special":[{"code":"thorns","value":2}]},"flavor_add":"缆外皮磨亮了。替你疼的排起了队。"},"class":"diver"},{"id":"dive_0066","name":"曜元（高浓）","type":"skill","rarity":"common","veins":["light"],"energy":1,"effect":{"heal":6,"target":"self"},"cost_type":"none","cost_text":"","flavor":"药液挂在管壁上，挂了很久。你晃一晃，它慢慢让步。","upgrade":{"name_suffix":"·新","effect":{"heal":9},"flavor_add":"它还是不想走。你多等了一会。"},"class":"diver"},{"id":"dive_0067","name":"震髓残响","type":"attack","rarity":"uncommon","veins":["tremor"],"energy":1,"effect":{"damage":7,"hits":1,"target":"single","resonance_gain":3},"cost_type":"none","cost_text":"","flavor":"打出去的是声音的回执。原件在更下面。","upgrade":{"name_suffix":"·Ⅱ","effect":{"damage":10},"flavor_add":"回执变成了原件。更下面没收件人。"},"class":"diver"},{"id":"dive_0068","name":"深红资源集团·冷却协议","type":"skill","rarity":"rare","veins":["heat"],"energy":1,"effect":{"block":6,"heal":4,"target":"self"},"cost_type":"vitality","cost_text":"附件第九页：降温期间不计入工龄。","flavor":"风从协议里吹出来。是凉的，也是批下来的。","upgrade":{"name_suffix":"·Ⅱ","effect":{"block":9,"heal":6},"flavor_add":"不计入的工龄你不再计较。风更凉了。"},"class":"diver"},{"id":"dive_0069","name":"聚能枪（三管）","type":"attack","rarity":"rare","veins":["light"],"energy":2,"effect":{"damage":7,"hits":3,"target":"single"},"cost_type":"none","cost_text":"","flavor":"三根管，零份许可证。它自己批的。","upgrade":{"name_suffix":"·Ⅱ","effect":{"damage":10},"flavor_add":"第四根管长出来了。你没问。"},"class":"diver"},{"id":"dive_0070","name":"回收员的账本","type":"skill","rarity":"common","veins":["mineral"],"energy":1,"effect":{"block":5,"resonance_drain":5,"target":"self"},"cost_type":"none","cost_text":"","flavor":"账本上的红字没人销。红光那一栏，欠着三笔。","upgrade":{"name_suffix":"·旧","effect":{"block":7,"resonance_drain":7},"flavor_add":"旧账翻到了红光还不清的那一页。"},"class":"diver"},{"id":"dive_0071","name":"渊光重工·灯序表","type":"skill","rarity":"common","veins":["light"],"energy":0,"effect":{"draw":1,"resonance_gain":1,"target":"self"},"cost_type":"none","cost_text":"","flavor":"表上排着每盏灯的名字。今晚轮到的两盏，一盏已经灭了。","upgrade":{"name_suffix":"·新","effect":{"draw":1,"resonance_gain":2},"flavor_add":"灭的那盏被人补了名。补名的人不是你。"},"class":"diver"},{"id":"dive_0072","name":"星髓矿业·二号钻台","type":"attack","rarity":"uncommon","veins":["mineral"],"energy":1,"effect":{"damage":5,"hits":2,"target":"single"},"cost_type":"none","cost_text":"","flavor":"一号台塌了以后，二号台的产量翻了一倍。名册上多了一排新名字。","upgrade":{"name_suffix":"·Ⅱ","effect":{"damage":7},"flavor_add":"产量又翻了一倍。塌掉的一号台在下面接着干。"},"class":"diver"},{"id":"dive_0073","name":"抗共振司·白噪机","type":"skill","rarity":"uncommon","veins":["mineral"],"energy":1,"effect":{"block":4,"target":"self","special":[{"code":"resonance_lock"}]},"cost_type":"none","cost_text":"","flavor":"它发出一种什么都不像的声音。红光听完就走了。","upgrade":{"name_suffix":"·固","effect":{"block":6},"flavor_add":"音量调大了一格。走之前红光回头看了一眼。"},"class":"diver"},{"id":"dive_0074","name":"黑曜采掘·计件工资","type":"attack","rarity":"common","veins":["mineral"],"energy":1,"effect":{"damage":8,"hits":1,"target":"single"},"cost_type":"vitality","cost_text":"工资条按件结算，你的身体算损耗。","flavor":"多打一件，多算一件。你的手比脑子先慢了下来。","upgrade":{"name_suffix":"·旧","effect":{"damage":11},"flavor_add":"单价调过了。损耗也算件数。"},"class":"diver"},{"id":"dive_0075","name":"深红资源集团·地契","type":"power","rarity":"rare","veins":["mineral"],"energy":2,"effect":{"target":"self","special":[{"code":"strength","value":2}]},"cost_type":"lock","cost_text":"契书每层只生效一次。","flavor":"地契写着你站的地方归你。你往下挪，契纸跟着改。","upgrade":{"name_suffix":"·刻","effect":{"special":[{"code":"strength","value":1}]},"flavor_add":"契纸背面加了一行。这层也归你，死后也一样。"},"class":"diver"},{"id":"dive_0076","name":"曜元（夜班型）","type":"skill","rarity":"common","veins":["heat"],"energy":1,"effect":{"heal":4,"target":"self","special":[{"code":"regenerate","value":1}]},"cost_type":"none","cost_text":"","flavor":"夜班专供。药性跟着太阳走，这里没有太阳。","upgrade":{"name_suffix":"·新","effect":{"heal":6},"flavor_add":"配方改了。药性开始跟着你走。"},"class":"diver"},{"id":"dive_0077","name":"抗共振司·导波索（并联）","type":"skill","rarity":"uncommon","veins":["tremor"],"energy":1,"effect":{"resonance_gain":3,"block":4,"target":"self"},"cost_type":"none","cost_text":"","flavor":"两根索一起导。同一句话走到你身上，成了两种重。","upgrade":{"name_suffix":"·Ⅱ","effect":{"resonance_gain":4},"flavor_add":"第三根索接上了。振动学会了排队。"},"class":"diver"},{"id":"dive_0078","name":"红渊研究院·频谱印章","type":"attack","rarity":"rare","veins":["tremor"],"energy":2,"effect":{"damage":11,"hits":1,"target":"single"},"cost_type":"none","cost_text":"","flavor":"盖下去的地方会留下一段频谱。频谱是最后还在动的那部分。","upgrade":{"name_suffix":"·Ⅱ","effect":{"damage":15},"flavor_add":"印得更深了。频谱多了一段，是你盖印的手。"},"class":"diver"},{"id":"dive_0079","name":"红渊贸易局·苦水配给（双份）","type":"skill","rarity":"common","veins":["water"],"energy":1,"effect":{"block":7,"target":"self"},"cost_type":"none","cost_text":"","flavor":"两份苦水一次发。喝完这份，还有一份等着你。","upgrade":{"name_suffix":"·新","effect":{"block":10},"flavor_add":"第二份也喝了。苦味叠在一起，说不出谁更苦。"},"class":"diver"},{"id":"dive_0080","name":"渊光重工·断路闸","type":"skill","rarity":"rare","veins":["light"],"energy":1,"effect":{"draw":3,"target":"self"},"cost_type":"lock","cost_text":"闸每层只拉一次。","flavor":"拉下闸，灯全灭。灭掉的那部分光去照别人了。","upgrade":{"name_suffix":"·Ⅱ","effect":{"draw":4},"flavor_add":"第二次拉闸的时候，闸自己先动了。"},"class":"diver"}],"tremor":[{"id":"trem_0001","name":"震语：听骨","class":"tremor","type":"skill","rarity":"common","veins":["tremor"],"energy":0,"effect":{"draw":1,"target":"self"},"cost_type":"none","cost_text":"","flavor":"岩壁在讲一件旧事。你听过这一段，结尾是别人的。","upgrade":{"name_suffix":"·新","effect":{"draw":1,"special":[{"code":"retain"}]},"flavor_add":"那件事讲完了。它把后半段留给你慢慢听。"}},{"id":"trem_0002","name":"听震","class":"tremor","type":"skill","rarity":"common","veins":["tremor"],"energy":0,"effect":{"resonance_gain":3,"target":"self"},"cost_type":"none","cost_text":"","flavor":"耳朵贴上去。你的血先到，岩层晚了一步。","upgrade":{"name_suffix":"·改","effect":{"resonance_gain":4},"flavor_add":"这次你先贴的额头。岩层愣了一下。"}},{"id":"trem_0003","name":"震语：压息","class":"tremor","type":"skill","rarity":"common","veins":["tremor"],"energy":1,"effect":{"block":7,"target":"self"},"cost_type":"none","cost_text":"","flavor":"呼吸放到最慢。外面那个东西找不到你换气的点。","upgrade":{"name_suffix":"·固","effect":{"block":10},"flavor_add":"你把呼吸放到没有。外面那东西以为你走了。"}},{"id":"trem_0004","name":"震语：回响","class":"tremor","type":"attack","rarity":"common","veins":["tremor"],"energy":1,"effect":{"damage":11,"hits":1,"target":"single","resonance_gain":2},"cost_type":"none","cost_text":"","flavor":"你用旧语气还它一句。它回头找了很久。","upgrade":{"name_suffix":"·改","effect":{"damage":14},"flavor_add":"你把二十年前的语气学全了。它听哭了。"}},{"id":"trem_0005","name":"震语：双声","class":"tremor","type":"attack","rarity":"uncommon","veins":["tremor"],"energy":1,"effect":{"damage":4,"hits":2,"target":"single"},"cost_type":"none","cost_text":"","flavor":"两句一起出去。回来的时候是三句。","upgrade":{"name_suffix":"·Ⅱ","effect":{"damage":6},"flavor_add":"回来的不止三句。你没数，怕数出更多。"}},{"id":"trem_0006","name":"震台石碑（拓片）","class":"tremor","type":"skill","rarity":"common","veins":["tremor"],"energy":1,"effect":{"block":5,"resonance_gain":1,"target":"self"},"cost_type":"none","cost_text":"","flavor":"拓片上的字比石头新。补刻的人笔画很急。","upgrade":{"name_suffix":"·残","effect":{"block":7},"flavor_add":"补刻的字认出来了。是你自己的笔迹。"}},{"id":"trem_0007","name":"震语铃","class":"tremor","type":"skill","rarity":"uncommon","veins":["tremor"],"energy":1,"effect":{"draw":2,"target":"self"},"cost_type":"none","cost_text":"","flavor":"铃舌是软的。出声的不是铃。","upgrade":{"name_suffix":"·改","effect":{"draw":3},"flavor_add":"铃舌换成硬的。出声的更不是铃了。"}},{"id":"trem_0008","name":"震语：问地","class":"tremor","type":"attack","rarity":"common","veins":["tremor"],"energy":1,"effect":{"damage":13,"hits":1,"target":"single"},"cost_type":"none","cost_text":"","flavor":"问题放下去了。回音先到，答案没到。","upgrade":{"name_suffix":"·刻","effect":{"damage":17},"flavor_add":"这次你看了。下面用的是你的手。"}},{"id":"trem_0009","name":"震语：断脉","class":"tremor","type":"attack","rarity":"uncommon","veins":["tremor"],"energy":1,"effect":{"damage":10,"hits":1,"target":"single"},"cost_type":"memory","cost_text":"你忘了母亲的声音。","flavor":"切断了。岩层安静下来。你的喉咙跟着哑了一瞬。","upgrade":{"name_suffix":"·新","effect":{"damage":14},"flavor_add":"这一次没切干净。母亲的声音留了下来。","cost_type":"none"}},{"id":"trem_0010","name":"震语：三震","class":"tremor","type":"attack","rarity":"special","veins":["tremor"],"energy":2,"effect":{"damage":9,"hits":3,"target":"single","gaze_cost":2},"cost_type":"none","cost_text":"","flavor":"第一声你听。剩下两声，收件人不明。","upgrade":{"name_suffix":"·Ⅱ","effect":{"damage":12},"flavor_add":"第四声给的是你。你收下了。"}},{"id":"trem_0011","name":"震台石碑","class":"tremor","type":"skill","rarity":"uncommon","veins":["tremor"],"energy":2,"effect":{"block":10,"target":"self"},"cost_type":"lock","cost_text":"碑文每层只应验一次。","flavor":"碑文缺了一半。缺的那半是你来之前的事。","upgrade":{"name_suffix":"·固","effect":{"block":14},"flavor_add":"另一半碑文找到了。刻在你站的地方。"}},{"id":"trem_0012","name":"历法刻盘","class":"tremor","type":"skill","rarity":"uncommon","veins":["tremor"],"energy":2,"effect":{"draw":3,"target":"self","resonance_cost":8},"cost_type":"none","cost_text":"","flavor":"刻盘停在某个日期。往后的刻度刻好了，没敢填。","upgrade":{"name_suffix":"·新","effect":{"draw":4,"resonance_cost":6},"flavor_add":"刻盘转过那个日期了。往后是空白，随你刻。"}},{"id":"trem_0013","name":"震语：崩齿","class":"tremor","type":"attack","rarity":"rare","veins":["tremor"],"energy":3,"effect":{"damage":10,"hits":3,"target":"single","resonance_cost":6,"gaze_cost":4},"cost_type":"none","cost_text":"","flavor":"牙替你数拍子。第三下少了一颗，拍子没乱。","upgrade":{"name_suffix":"·Ⅱ","effect":{"damage":13},"flavor_add":"牙又缺了一颗。数拍子的活分给了骨头。"}},{"id":"trem_0014","name":"听地神脉搏","class":"tremor","type":"skill","rarity":"rare","veins":["tremor"],"energy":3,"effect":{"resonance_gain":4,"target":"self","gaze_cost":5,"special":[{"code":"regenerate","value":5}]},"cost_type":"lock","cost_text":"它听完这次就走了。","flavor":"它在数数。数到你的时候，停了一下。","upgrade":{"name_suffix":"·旧","effect":{"special":[{"code":"regenerate","value":2}]},"flavor_add":"它数完了。又从头数了一遍。这次是给你。"}},{"id":"trem_0015","name":"触温","class":"tremor","type":"skill","rarity":"common","veins":["heat"],"energy":0,"effect":{"block":4,"target":"self","special":[{"code":"regenerate","value":2}]},"cost_type":"none","cost_text":"","flavor":"手心贴上去，是温的。这里不该有温的东西。","upgrade":{"name_suffix":"·新","effect":{"block":6},"flavor_add":"它先动了。你等到了。"}},{"id":"trem_0016","name":"喷息·热池边","class":"tremor","type":"skill","rarity":"common","veins":["heat"],"energy":1,"effect":{"block":6,"target":"self","special":[{"code":"regenerate","value":2}]},"cost_type":"none","cost_text":"","flavor":"池边的人不看你。你的倒影在看别处。","upgrade":{"name_suffix":"·固","effect":{"block":9},"flavor_add":"池边的人看了你一眼。礼数破了，热更稳了。"}},{"id":"trem_0017","name":"震语：焚名","class":"tremor","type":"attack","rarity":"common","veins":["heat"],"energy":1,"effect":{"damage":7,"hits":1,"target":"single","special":[{"code":"burn","value":2,"turns":2}]},"cost_type":"memory","cost_text":"名册上少了一个名字，是你的。","flavor":"火不是从底下上来的。它从名册那一页开始烧。","upgrade":{"name_suffix":"·刻","effect":{"damage":10},"flavor_add":"名册补回了你的名字。火记得该还哪里。"}},{"id":"trem_0018","name":"静日","class":"tremor","type":"skill","rarity":"special","veins":["heat"],"energy":1,"effect":{"block":8,"target":"self","special":[{"code":"retain"}]},"cost_type":"none","cost_text":"","flavor":"你不说话。岩层替你说完了剩下的半句。","upgrade":{"name_suffix":"·固","effect":{"block":12},"flavor_add":"世界更清楚了。清楚得有点吵。"}},{"id":"trem_0019","name":"禁声日","class":"tremor","type":"skill","rarity":"uncommon","veins":["heat"],"energy":1,"effect":{"block":6,"target":"self","special":[{"code":"resonance_lock"}]},"cost_type":"none","cost_text":"","flavor":"连岩层都闭嘴。你的脚步声显得很响。","upgrade":{"name_suffix":"·旧","effect":{"block":9},"flavor_add":"你的脚步声也闭嘴了。岩层先受不了。"}},{"id":"trem_0020","name":"静日触杖","class":"tremor","type":"power","rarity":"uncommon","veins":["heat"],"energy":1,"effect":{"target":"self","special":[{"code":"dexterity","value":2}]},"cost_type":"none","cost_text":"","flavor":"杖尖点到哪里，热就在哪里停。像被点名的人站直了。","upgrade":{"name_suffix":"·新","effect":{"special":[{"code":"dexterity","value":1}]},"flavor_add":"杖尖点过的地方，热开始排队。"}},{"id":"trem_0021","name":"埋骨礼","class":"tremor","type":"skill","rarity":"uncommon","veins":["heat"],"energy":2,"effect":{"block":14,"target":"self"},"cost_type":"memory","cost_text":"你把一段路让给了别人走。","flavor":"布展开，是空的。压布的石头倒是真的。","upgrade":{"name_suffix":"·刻","effect":{"block":20},"flavor_add":"布还是空的。空得能挡住所有方向。"}},{"id":"trem_0022","name":"回归墟骨","class":"tremor","type":"skill","rarity":"rare","veins":["heat"],"energy":2,"effect":{"block":6,"target":"self","special":[{"code":"delete_random"}]},"cost_type":"none","cost_text":"","flavor":"骨头归堆，不多不少。你带来的那件，堆里早有位置。","upgrade":{"name_suffix":"·残","effect":{"block":9},"flavor_add":"骨堆收下了它。仪式的意思你念对了。"}},{"id":"trem_0023","name":"震语：沸息","class":"tremor","type":"attack","rarity":"common","veins":["heat"],"energy":2,"effect":{"damage":12,"hits":1,"target":"single","resonance_cost":5,"special":[{"code":"burn","value":4,"turns":3}]},"cost_type":"none","cost_text":"","flavor":"一句烫话留在它体内。它走到哪里，烧到哪里。","upgrade":{"name_suffix":"·Ⅱ","effect":{"damage":17},"flavor_add":"那句话更烫了。它走的路也更长。"}},{"id":"trem_0024","name":"震语：熔名","class":"tremor","type":"attack","rarity":"rare","veins":["heat"],"energy":3,"effect":{"damage":12,"hits":1,"target":"single","special":[{"code":"burn","value":6,"turns":3}]},"cost_type":"memory","cost_text":"你想不起被烧的是谁的名字了。","flavor":"名字烧完了。它做过的事一件不少地留了下来。","upgrade":{"name_suffix":"·刻","effect":{"damage":17},"flavor_add":"名字想起来了。你把它重新烧了一遍。"}},{"id":"trem_0025","name":"观红","class":"tremor","type":"skill","rarity":"common","veins":["light"],"energy":0,"effect":{"block":2,"draw":1,"target":"self"},"cost_type":"none","cost_text":"","flavor":"红光排着队进来。队伍里有一个不是光。","upgrade":{"name_suffix":"·新","effect":{"draw":2},"flavor_add":"你数到两个。剩下的不敢数。"}},{"id":"trem_0026","name":"光导石","class":"tremor","type":"skill","rarity":"common","veins":["light"],"energy":1,"effect":{"block":3,"draw":1,"target":"self"},"cost_type":"none","cost_text":"","flavor":"它把光递过来，先擦了擦棱角。交接的礼数一步不少。","upgrade":{"name_suffix":"·改","effect":{"block":5},"flavor_add":"交接改成了托付。石头把手松开了。"}},{"id":"trem_0027","name":"震语：明目","class":"tremor","type":"skill","rarity":"uncommon","veins":["light"],"energy":1,"effect":{"draw":1,"target":"self","special":[{"code":"gaze_reduce","value":1}]},"cost_type":"none","cost_text":"","flavor":"少看了一眼。那一眼还在排队。","upgrade":{"name_suffix":"·新","effect":{"special":[{"code":"gaze_reduce","value":2}]},"flavor_add":"少看的不止一点。有些地方你绕着走。"}},{"id":"trem_0028","name":"涌喉·光池倒影","class":"tremor","type":"skill","rarity":"uncommon","veins":["light"],"energy":1,"effect":{"block":5,"draw":1,"target":"self"},"cost_type":"mark","cost_text":"池面记下了你的脸。","flavor":"池面记下你的脸。记的那张比你老。","upgrade":{"name_suffix":"·残","effect":{"block":7},"flavor_add":"池面记下的脸换了。新的那张更旧。"}},{"id":"trem_0029","name":"观红（深相）","class":"tremor","type":"skill","rarity":"rare","veins":["light"],"energy":2,"effect":{"block":8,"target":"self","special":[{"code":"gaze_reduce","value":2}]},"cost_type":"none","cost_text":"","flavor":"红光退了半步。它认得你。","upgrade":{"name_suffix":"·固","effect":{"block":12,"special":[{"code":"gaze_reduce","value":1}]},"flavor_add":"它又退了一步。现在它记得你两遍。"}},{"id":"trem_0030","name":"震语：照骨","class":"tremor","type":"attack","rarity":"rare","veins":["light"],"energy":2,"effect":{"damage":12,"hits":1,"target":"single","gaze_cost":4},"cost_type":"mark","cost_text":"光看清了你。你也就被看清了。","flavor":"光穿过它。岩壁上留下它的形状，也留下你的。","upgrade":{"name_suffix":"·Ⅱ","effect":{"damage":17},"flavor_add":"拓片多了两张。岩壁开始收藏你。"}},{"id":"trem_0031","name":"尝水","class":"tremor","type":"skill","rarity":"common","veins":["water"],"energy":0,"effect":{"draw":1,"target":"self","special":[{"code":"regenerate","value":1}]},"cost_type":"none","cost_text":"","flavor":"苦味底下有一层甜。甜比水旧。","upgrade":{"name_suffix":"·旧","effect":{"special":[{"code":"regenerate","value":1}]},"flavor_add":"那层旧甜化开了。上游的事你不再问。"}},{"id":"trem_0032","name":"震语：引流","class":"tremor","type":"skill","rarity":"common","veins":["water"],"energy":1,"effect":{"block":7,"target":"self"},"cost_type":"none","cost_text":"","flavor":"你给水让了路。水也给你让了一次。","upgrade":{"name_suffix":"·固","effect":{"block":10},"flavor_add":"路让宽了。水让得心甘情愿。"}},{"id":"trem_0033","name":"涌喉·水契","class":"tremor","type":"skill","rarity":"uncommon","veins":["water"],"energy":1,"effect":{"target":"self","special":[{"code":"regenerate","value":4}]},"cost_type":"none","cost_text":"","flavor":"契约写在水面之下。你的手一直是湿的，正好。","upgrade":{"name_suffix":"·Ⅱ","effect":{"special":[{"code":"regenerate","value":2}]},"flavor_add":"契约续了一页。这次只有你一个人湿手。"}},{"id":"trem_0034","name":"震语：断流","class":"tremor","type":"attack","rarity":"uncommon","veins":["water"],"energy":2,"effect":{"damage":14,"hits":1,"target":"single","resonance_cost":6,"special":[{"code":"frail","value":1}]},"cost_type":"none","cost_text":"","flavor":"水停了一瞬。你就在那一瞬里过去。","upgrade":{"name_suffix":"·改","effect":{"damage":19},"flavor_add":"水停了两瞬。都用上了。"}},{"id":"trem_0035","name":"尝水（深井）","class":"tremor","type":"skill","rarity":"rare","veins":["water"],"energy":2,"effect":{"draw":1,"target":"self","special":[{"code":"regenerate","value":5}]},"cost_type":"none","cost_text":"","flavor":"井底的样本没有编号。取样人那一栏也是。","upgrade":{"name_suffix":"·Ⅱ","effect":{"special":[{"code":"regenerate","value":2}]},"flavor_add":"井底有回音了。它比你更早知道明天。"}},{"id":"trem_0036","name":"辨矿","class":"tremor","type":"skill","rarity":"common","veins":["mineral"],"energy":1,"effect":{"draw":1,"resonance_gain":2,"target":"self"},"cost_type":"none","cost_text":"","flavor":"指腹读过去，石头里有旧年的账。欠款人不明。","upgrade":{"name_suffix":"·新","effect":{"resonance_gain":3},"flavor_add":"旧年的账翻到了新的一页。记的是你。"}},{"id":"trem_0037","name":"相石·初刻","class":"tremor","type":"skill","rarity":"uncommon","veins":["mineral"],"energy":1,"effect":{"draw":1,"resonance_gain":3,"target":"self"},"cost_type":"mark","cost_text":"它记下了你的掌心。","flavor":"它记你的掌心。你记它记你的事。","upgrade":{"name_suffix":"·刻","effect":{"resonance_gain":5},"flavor_add":"掌心的纹路刻深了。它记熟了。"}},{"id":"trem_0038","name":"相石·满录","class":"tremor","type":"skill","rarity":"rare","veins":["mineral"],"energy":2,"effect":{"draw":3,"resonance_gain":2,"target":"self"},"cost_type":"memory","cost_text":"读满录的相石要押一段记忆，押金不退。","flavor":"押金是一段记忆。石头不找零。","upgrade":{"name_suffix":"·新","effect":{"draw":4},"flavor_add":"押金退了。石头说这段记忆还用得上。","cost_type":"none"}},{"id":"trem_0039","name":"埋骨布","class":"tremor","type":"skill","rarity":"common","veins":[],"energy":1,"effect":{"block":5,"target":"self","special":[{"code":"retain"}]},"cost_type":"none","cost_text":"","flavor":"布是空的。折痕都是新的。","upgrade":{"name_suffix":"·残","effect":{"block":7},"flavor_add":"布用旧了。旧得很整齐。"}},{"id":"trem_0040","name":"五脉符","class":"tremor","type":"power","rarity":"uncommon","veins":[],"energy":2,"effect":{"target":"self","special":[{"code":"strength","value":1},{"code":"dexterity","value":1}]},"cost_type":"none","cost_text":"","flavor":"五个刻痕指向五个方向。回家的方向是第六个。","upgrade":{"name_suffix":"·Ⅱ","effect":{"special":[{"code":"strength","value":1}]},"flavor_add":"第六个刻痕对着下面。没有方向对它。"}},{"id":"trem_0041","name":"震语：淡忘","class":"tremor","type":"skill","rarity":"common","veins":["water"],"energy":1,"effect":{"block":8,"target":"self"},"cost_type":"none","cost_text":"","flavor":"那件事沉下去了。水面平得像没发生过。","upgrade":{"name_suffix":"·固","effect":{"block":12},"flavor_add":"沉得更深了。水收着的那件事结了茧。"}},{"id":"trem_0042","name":"震语：断忆","class":"tremor","type":"attack","rarity":"uncommon","veins":["tremor"],"energy":1,"effect":{"damage":12,"hits":1,"target":"single"},"cost_type":"memory","cost_text":"你忘了一个再也不会用到的词。","flavor":"一个词离开了你。岩层咬字不太准。","upgrade":{"name_suffix":"·刻","effect":{"damage":17},"flavor_add":"那个词在岩层里响了。用你的声音。"}},{"id":"trem_0043","name":"静底·焚忆","class":"tremor","type":"skill","rarity":"uncommon","veins":["heat"],"energy":1,"effect":{"draw":2,"target":"self"},"cost_type":"memory","cost_text":"烧掉的是一页信，收信人是你。","flavor":"烧掉一页信。火只烧了字，纸还在。","upgrade":{"name_suffix":"·改","effect":{"draw":3},"flavor_add":"灰落进水里之前，你回头收了信。"}},{"id":"trem_0044","name":"相石·封忆","class":"tremor","type":"skill","rarity":"rare","veins":["mineral"],"energy":2,"effect":{"target":"self","special":[{"code":"strength","value":2}]},"cost_type":"memory","cost_text":"石头收走一段，还你一寸硬。","flavor":"石头收走一段，还你一寸硬。","upgrade":{"name_suffix":"·固","effect":{"special":[{"code":"strength","value":1}]},"flavor_add":"石头多收了一段。还你的不止一寸。"}},{"id":"trem_0045","name":"埋骨礼（合葬）","class":"tremor","type":"skill","rarity":"uncommon","veins":["heat"],"energy":2,"effect":{"block":18,"target":"self"},"cost_type":"memory","cost_text":"你替别人记的那部分，也一起埋了。","flavor":"两块布叠在一起摆。下面的那块先动的。","upgrade":{"name_suffix":"·Ⅱ","effect":{"block":26},"flavor_add":"第三块布摊开了。压布的石头没变。"}},{"id":"trem_0046","name":"震语：舍字","class":"tremor","type":"skill","rarity":"common","veins":["tremor"],"energy":0,"effect":{"draw":1,"target":"self"},"cost_type":"lock","cost_text":"本层只舍这一次。","flavor":"先舍一个字。你选了很久，选了最轻的。","upgrade":{"name_suffix":"·新","effect":{"draw":2},"flavor_add":"又舍了一个字。剩下的都开始发光。"}},{"id":"trem_0047","name":"震台石碑（残诵）","class":"tremor","type":"skill","rarity":"uncommon","veins":["tremor"],"energy":1,"effect":{"resonance_gain":4,"target":"self"},"cost_type":"memory","cost_text":"碑文缺的那一段，原本在你的脑子里。","flavor":"你把缺的那段念了。碑没补上，你少了一段。","upgrade":{"name_suffix":"·残","effect":{"resonance_gain":6},"flavor_add":"你缺的那段开始漏。漏出来的都是震动。"}},{"id":"trem_0048","name":"震语：连震","class":"tremor","type":"attack","rarity":"common","veins":["tremor"],"energy":0,"effect":{"damage":4,"hits":1,"target":"single"},"cost_type":"none","cost_text":"","flavor":"第一声是敲门。后面的声音在里面应。","upgrade":{"name_suffix":"·改","effect":{"damage":6},"flavor_add":"这次没敲门。门一直开着，在等你。"}},{"id":"trem_0049","name":"三震（回声）","class":"tremor","type":"attack","rarity":"common","veins":["tremor"],"energy":0,"effect":{"damage":2,"hits":2,"target":"single"},"cost_type":"none","cost_text":"","flavor":"回来的声音矮了一截。矮掉的部分留在下面。","upgrade":{"name_suffix":"·残","effect":{"damage":3},"flavor_add":"回来的声音没矮。它只是累。"}},{"id":"trem_0050","name":"震语：传温","class":"tremor","type":"attack","rarity":"common","veins":["heat"],"energy":0,"effect":{"damage":3,"hits":1,"target":"single"},"cost_type":"none","cost_text":"","flavor":"手心贴着壳。那句话烫了很久才凉。","upgrade":{"name_suffix":"·改","effect":{"damage":4},"flavor_add":"手心的话换了一句。更烫的那句。"}},{"id":"trem_0051","name":"震语：润喉","class":"tremor","type":"skill","rarity":"common","veins":["water"],"energy":0,"effect":{"block":2,"draw":1,"target":"self"},"cost_type":"none","cost_text":"","flavor":"水很凉。嗓子里的字安静下来了。","upgrade":{"name_suffix":"·新","effect":{"block":4},"flavor_add":"喝了两口。下一句有人替你说。"}},{"id":"trem_0052","name":"震语：合鸣","class":"tremor","type":"attack","rarity":"uncommon","veins":["tremor"],"energy":2,"effect":{"damage":9,"hits":1,"target":"single","draw":1},"cost_type":"none","cost_text":"","flavor":"两个声部碰头。石头先裂，谁也没道歉。","upgrade":{"name_suffix":"·Ⅱ","effect":{"damage":13},"flavor_add":"石头裂成了两半。声部各占一半。"}},{"id":"trem_0053","name":"震语：五声","class":"tremor","type":"attack","rarity":"uncommon","veins":["tremor"],"energy":2,"effect":{"damage":13,"hits":1,"target":"single","resonance_gain":2},"cost_type":"none","cost_text":"","flavor":"五个音一起出去。回来五个，其中一个晚了。","upgrade":{"name_suffix":"·改","effect":{"damage":16},"flavor_add":"五个音回来了四个。少的一个留在下面。"}},{"id":"trem_0054","name":"光导石（串珠）","class":"tremor","type":"skill","rarity":"common","veins":["light"],"energy":1,"effect":{"block":4,"draw":1,"target":"self"},"cost_type":"none","cost_text":"","flavor":"光在珠子里排队。队尾那颗是空的。","upgrade":{"name_suffix":"·固","effect":{"block":6},"flavor_add":"珠子加了一颗。光不再排队，光在合唱。"}},{"id":"trem_0055","name":"震语：直视","class":"tremor","type":"skill","rarity":"common","veins":["light"],"energy":0,"effect":{"draw":1,"gaze_gain":1,"target":"self"},"cost_type":"none","cost_text":"","flavor":"你看回去了。它先移开，又移回来，停在你身后。","upgrade":{"name_suffix":"·残","effect":{"draw":2},"flavor_add":"这一眼久了。应答变成了对峙。"}},{"id":"trem_0056","name":"震语：回望","class":"tremor","type":"skill","rarity":"uncommon","veins":["light"],"energy":1,"effect":{"draw":3,"target":"self","gaze_cost":5},"cost_type":"none","cost_text":"","flavor":"从那边看过来的你，和你打了个照面。","upgrade":{"name_suffix":"·新","effect":{"draw":4,"gaze_cost":4},"flavor_add":"你看回来的次数够多了。那边给你留了位置。"}},{"id":"trem_0057","name":"相石·对视","class":"tremor","type":"skill","rarity":"uncommon","veins":["mineral"],"energy":1,"effect":{"resonance_gain":5,"target":"self","gaze_cost":3},"cost_type":"none","cost_text":"","flavor":"它没有眼，但它先眨了。","upgrade":{"name_suffix":"·固","effect":{"resonance_gain":7},"flavor_add":"它没再眨。你们开始轮流看着同一个方向。"}},{"id":"trem_0058","name":"静底·深阅","class":"tremor","type":"skill","rarity":"rare","veins":[],"energy":2,"effect":{"target":"self","gaze_cost":8,"special":[{"code":"strength","value":2},{"code":"dexterity","value":2}]},"cost_type":"none","cost_text":"","flavor":"最里面那页没有页码。念完，屋里坐了两个人。","upgrade":{"name_suffix":"·刻","effect":{"special":[{"code":"strength","value":1}]},"flavor_add":"两个人合得来了。至少在念这一页的时候。"}},{"id":"trem_0059","name":"震台石碑（注视）","class":"tremor","type":"skill","rarity":"common","veins":["tremor"],"energy":1,"effect":{"block":9,"target":"self","gaze_cost":2},"cost_type":"none","cost_text":"","flavor":"碑面里站着的那个不是你。你们各自退了半步。","upgrade":{"name_suffix":"·旧","effect":{"block":13},"flavor_add":"碑面磨亮了。里面站的那个先让了一步。"}},{"id":"trem_0060","name":"五脉符（逆位）","class":"tremor","type":"attack","rarity":"rare","veins":[],"energy":2,"effect":{"damage":12,"hits":1,"target":"all","gaze_cost":6},"cost_type":"none","cost_text":"","flavor":"符倒过来贴。这一次，是它在读你。","upgrade":{"name_suffix":"·Ⅱ","effect":{"damage":17},"flavor_add":"五个方向都看清了。它们也都没躲。"}},{"id":"trem_0061","name":"震语：数息","type":"skill","rarity":"common","veins":["tremor"],"energy":0,"effect":{"block":3,"resonance_gain":2,"target":"self"},"cost_type":"none","cost_text":"","flavor":"你数自己的呼吸。数到第七下，岩层跟着数。","upgrade":{"name_suffix":"·新","effect":{"block":5,"resonance_gain":2},"flavor_add":"岩层先数完了。它在等你。"},"class":"tremor"},{"id":"trem_0062","name":"震语：叩问","type":"attack","rarity":"common","veins":["tremor"],"energy":1,"effect":{"damage":9,"hits":1,"target":"single"},"cost_type":"none","cost_text":"","flavor":"你叩了三下。里面回了几下，你没数清。","upgrade":{"name_suffix":"·刻","effect":{"damage":13},"flavor_add":"这次回的是四下。多的一下更重。"},"class":"tremor"},{"id":"trem_0063","name":"涌喉·深潜","type":"skill","rarity":"uncommon","veins":["water"],"energy":1,"effect":{"block":8,"target":"self"},"cost_type":"vitality","cost_text":"耳压顶着骨头。","flavor":"你把自己交给水压。它收下了，登记得很慢。","upgrade":{"name_suffix":"·Ⅱ","effect":{"block":12},"flavor_add":"压得更深了。骨头学会了让路。"},"class":"tremor"},{"id":"trem_0064","name":"历法刻盘（补页）","type":"skill","rarity":"rare","veins":["tremor"],"energy":2,"effect":{"draw":4,"target":"self","resonance_cost":10},"cost_type":"none","cost_text":"","flavor":"有人给刻盘补了页。补的页没有年份。","upgrade":{"name_suffix":"·新","effect":{"draw":5,"resonance_cost":8},"flavor_add":"补页上有了年份。是明天。"},"class":"tremor"},{"id":"trem_0065","name":"静底·灰烬","type":"attack","rarity":"uncommon","veins":["heat"],"energy":1,"effect":{"damage":6,"hits":1,"target":"single","special":[{"code":"burn","value":3,"turns":2}]},"cost_type":"none","cost_text":"","flavor":"你把一句凉话焐热了再说。它落地就烧。","upgrade":{"name_suffix":"·Ⅱ","effect":{"damage":8},"flavor_add":"凉话焐成了烫的。烧得慢，烧得久。"},"class":"tremor"},{"id":"trem_0066","name":"震语：回声定位","type":"skill","rarity":"uncommon","veins":["light"],"energy":1,"effect":{"draw":2,"gaze_gain":1,"target":"self"},"cost_type":"none","cost_text":"","flavor":"光走不到的地方，你喊一声。回声替你把路照亮。","upgrade":{"name_suffix":"·新","effect":{"draw":3},"flavor_add":"路多看了一眼。你没躲。"},"class":"tremor"},{"id":"trem_0067","name":"五脉符（缺位）","type":"power","rarity":"rare","veins":["mineral"],"energy":1,"effect":{"target":"self","special":[{"code":"strength","value":1},{"code":"dexterity","value":1}]},"cost_type":"mark","cost_text":"缺的那一位记住了你补的位置。","flavor":"第五个刻痕是空的。空得很有分量。","upgrade":{"name_suffix":"·刻","effect":{"special":[{"code":"strength","value":1}]},"flavor_add":"缺位补上了。补上去的名字是你的。"},"class":"tremor"},{"id":"trem_0068","name":"埋骨布（裹身）","type":"skill","rarity":"common","veins":[],"energy":1,"effect":{"block":6,"target":"self","special":[{"code":"retain"}]},"cost_type":"none","cost_text":"","flavor":"布裹住你。空布裹人，尺寸正好。","upgrade":{"name_suffix":"·固","effect":{"block":9},"flavor_add":"布收紧了。收得像有人在量你的尺寸。"},"class":"tremor"},{"id":"trem_0069","name":"震台石碑（新碑）","type":"attack","rarity":"rare","veins":["tremor"],"energy":2,"effect":{"damage":15,"hits":1,"target":"single","resonance_gain":3},"cost_type":"none","cost_text":"","flavor":"新碑立起来的时候，旧碑挪了一寸。","upgrade":{"name_suffix":"·Ⅱ","effect":{"damage":20},"flavor_add":"旧碑又挪了一寸。它在让位。"},"class":"tremor"},{"id":"trem_0070","name":"震语：低语","type":"skill","rarity":"common","veins":["tremor"],"energy":0,"effect":{"draw":1,"resonance_gain":1,"target":"self","special":[{"code":"exhaust"}]},"cost_type":"none","cost_text":"","flavor":"只说给离得最近的东西听。最近的是你自己的骨头。","upgrade":{"name_suffix":"·新","effect":{"draw":2},"flavor_add":"低语变多了。骨头开始插话。"},"class":"tremor"},{"id":"trem_0071","name":"震语：试井","type":"skill","rarity":"common","veins":["tremor"],"energy":0,"effect":{"resonance_gain":2,"target":"self","special":[{"code":"exhaust"}]},"cost_type":"none","cost_text":"","flavor":"往井里丢一句话，听回声有多深。井吞了话，没还。","upgrade":{"name_suffix":"·新","effect":{"resonance_gain":3},"flavor_add":"井把话还了。换了一种说法还的。"},"class":"tremor"},{"id":"trem_0072","name":"震语：回礼","type":"attack","rarity":"uncommon","veins":["tremor"],"energy":1,"effect":{"damage":8,"hits":1,"target":"single","resonance_gain":2},"cost_type":"none","cost_text":"","flavor":"它给你的每一击，你都按原样还。还回去的总要重一点。","upgrade":{"name_suffix":"·刻","effect":{"damage":11},"flavor_add":"这次还的带利息。它收得心服口服。"},"class":"tremor"},{"id":"trem_0073","name":"静底·翻灰","type":"skill","rarity":"common","veins":["heat"],"energy":1,"effect":{"block":5,"target":"self","special":[{"code":"regenerate","value":1}]},"cost_type":"none","cost_text":"","flavor":"灰下面还有火星。你翻得慢，怕它们醒得太齐。","upgrade":{"name_suffix":"·Ⅱ","effect":{"block":7},"flavor_add":"火星翻出来了。它们醒得很齐。"},"class":"tremor"},{"id":"trem_0074","name":"涌喉·潮契","type":"skill","rarity":"uncommon","veins":["water"],"energy":1,"effect":{"block":6,"draw":1,"target":"self"},"cost_type":"mark","cost_text":"潮水记下了你欠的份。","flavor":"和潮水签的是活契。你签字的时候，笔迹是湿的。","upgrade":{"name_suffix":"·Ⅱ","effect":{"block":9},"flavor_add":"潮提前涨了。它比你还着急。"},"class":"tremor"},{"id":"trem_0075","name":"历法刻盘（倒页）","type":"skill","rarity":"rare","veins":["tremor"],"energy":1,"effect":{"draw":3,"target":"self","resonance_cost":6},"cost_type":"none","cost_text":"","flavor":"倒着翻的页记载着没发生的事。字迹很新，日期很老。","upgrade":{"name_suffix":"·新","effect":{"draw":4,"resonance_cost":5},"flavor_add":"有一页记载着今天。你读过之后，今天照常发生了。"},"class":"tremor"},{"id":"trem_0076","name":"震语：双唱","type":"attack","rarity":"uncommon","veins":["tremor"],"energy":2,"effect":{"damage":6,"hits":2,"target":"single"},"cost_type":"none","cost_text":"","flavor":"你和自己合唱。差的那半拍，也打在人身上。","upgrade":{"name_suffix":"·Ⅱ","effect":{"damage":8},"flavor_add":"第三个声部加进来了。不认识，但音准。"},"class":"tremor"},{"id":"trem_0077","name":"五脉符（浮位）","type":"power","rarity":"uncommon","veins":["water"],"energy":1,"effect":{"target":"self","special":[{"code":"dexterity","value":2}]},"cost_type":"none","cost_text":"","flavor":"第五个刻痕浮在符面之上，不肯落下去。你按了一下，它弹回来了。","upgrade":{"name_suffix":"·Ⅱ","effect":{"special":[{"code":"dexterity","value":1}]},"flavor_add":"刻痕又浮高了一寸。你开始够不到自己的符。"},"class":"tremor"},{"id":"trem_0078","name":"观红（对影）","type":"skill","rarity":"rare","veins":["light"],"energy":0,"effect":{"block":2,"draw":2,"target":"self","gaze_cost":3},"cost_type":"none","cost_text":"","flavor":"你看红的影。影里也有个人在翻牌，翻得比你慢半拍。","upgrade":{"name_suffix":"·新","effect":{"draw":3},"flavor_add":"影里那个人追上来了。你们同时出牌。"},"class":"tremor"},{"id":"trem_0079","name":"震台石碑（无字）","type":"skill","rarity":"common","veins":["tremor"],"energy":1,"effect":{"block":8,"target":"self"},"cost_type":"none","cost_text":"","flavor":"碑上没有字。没有字的碑，风绕着走。","upgrade":{"name_suffix":"·固","effect":{"block":12},"flavor_add":"碑面磨得更平了。有人想在上面刻字，没敢。"},"class":"tremor"},{"id":"trem_0080","name":"震语：长夜","type":"attack","rarity":"rare","veins":["heat"],"energy":2,"effect":{"damage":9,"hits":1,"target":"single","special":[{"code":"burn","value":4,"turns":3}]},"cost_type":"none","cost_text":"","flavor":"这一句要烧一整个夜。夜在这里有多长，它就烧多久。","upgrade":{"name_suffix":"·Ⅱ","effect":{"damage":12},"flavor_add":"夜里续了更长的一段。它陪着烧完。"},"class":"tremor"}],"enemies":[{"id":"enemy_d1_01","name":"嗜热古菌","layer":1,"tier":"normal","hp":"8-10","intent_pattern":[{"type":"attack","value":2},{"type":"attack","value":2},{"type":"defend","value":3}],"traits":[],"flavor":"它们贴在余温上。管道凉了三十年，它们还在等。"},{"id":"enemy_d1_02","name":"腐生菌","layer":1,"tier":"normal","hp":"9-11","intent_pattern":[{"type":"attack","value":2},{"type":"defend","value":4}],"traits":[],"flavor":"灰白的膜盖在座椅上，按座椅的形状长的。"},{"id":"enemy_d2_01","name":"冷洞食腐鳗","layer":2,"tier":"normal","hp":"14-19","intent_pattern":[{"type":"attack","value":4},{"type":"attack","value":4},{"type":"defend","value":4}],"traits":[],"flavor":"它沿洞壁捡食碎屑。你掉落的装备它闻了闻，没要。"},{"id":"enemy_d2_02","name":"冷洞青菌","layer":2,"tier":"normal","hp":"14-20","intent_pattern":[{"type":"defend","value":5},{"type":"attack","value":5}],"traits":[],"flavor":"菌斑扩到你脚边要以年计。它不急。"},{"id":"enemy_d2_03","name":"墟蟹","layer":2,"tier":"normal","hp":"16-21","intent_pattern":[{"type":"attack","value":5},{"type":"attack","value":3,"times":2},{"type":"defend","value":4}],"traits":[],"flavor":"它把矿票残角拖回缝里，拖得很郑重。"},{"id":"enemy_d2_04","name":"休眠两栖类","layer":2,"tier":"normal","hp":"14-18","intent_pattern":[{"type":"attack","value":6},{"type":"defend","value":3}],"traits":[],"flavor":"它睡在渗水线上。你踩进水，它醒了一半，另一半没动。"},{"id":"enemy_d2_05","name":"噬骨菌群","layer":2,"tier":"elite","hp":"38-46","intent_pattern":[{"type":"buff","value":3},{"type":"attack","value":9},{"type":"attack","value":6},{"type":"defend","value":6}],"traits":[],"flavor":"白骨上的缺口很整齐。缺口是从里面开始的。"},{"id":"enemy_d3_01","name":"硬矿洞蛇","layer":3,"tier":"normal","hp":"24-30","intent_pattern":[{"type":"attack","value":8},{"type":"defend","value":5}],"traits":[],"flavor":"它盘成矿脉的形状。你第二眼才认出它是活的。"},{"id":"enemy_d3_02","name":"钻孔贝","layer":3,"tier":"normal","hp":"22-28","intent_pattern":[{"type":"attack","value":6},{"type":"attack","value":6},{"type":"defend","value":6}],"traits":[],"flavor":"壳上的洞排成直线。下一条直线的位置和你的胸口平齐。"},{"id":"enemy_d3_03","name":"干旱肺鱼","layer":3,"tier":"normal","hp":"26-32","intent_pattern":[{"type":"defend","value":6},{"type":"attack","value":8}],"traits":[],"flavor":"它在干泥壳里等水。洞口朝着水的方向，摆了很多年。"},{"id":"enemy_d3_04","name":"盲蛛","layer":3,"tier":"normal","hp":"22-26","intent_pattern":[{"type":"attack","value":7},{"type":"attack","value":5},{"type":"defend","value":4}],"traits":[],"flavor":"它不动。影子挪过去，它恰好总在影子里。"},{"id":"enemy_d3_05","name":"气腔洞鼹兽","layer":3,"tier":"elite","hp":"58-68","intent_pattern":[{"type":"buff","value":4},{"type":"attack","value":12},{"type":"defend","value":8},{"type":"attack","value":8}],"traits":[],"flavor":"塌下来的方向是它挖的。挖的时候，这条路还没有人。"},{"id":"enemy_d4_01","name":"红腔鱼","layer":4,"tier":"normal","hp":"26-32","intent_pattern":[{"type":"attack","value":8},{"type":"attack","value":6},{"type":"defend","value":6}],"traits":[],"flavor":"它悬在暗处不动。暗处少的那一块就是它。"},{"id":"enemy_d4_02","name":"滤食鱼群","layer":4,"tier":"normal","hp":"24-30","intent_pattern":[{"type":"attack","value":4,"times":3},{"type":"defend","value":6}],"traits":[],"flavor":"它们绕你转了一圈。不是攻击，是在称重。"},{"id":"enemy_d4_03","name":"垂光蕨","layer":4,"tier":"normal","hp":"28-34","intent_pattern":[{"type":"attack","value":8},{"type":"defend","value":7}],"traits":[],"flavor":"你路过的时候，叶尖齐齐转向你。没有风。"},{"id":"enemy_d4_04","name":"光池银鱼","layer":4,"tier":"normal","hp":"24-30","intent_pattern":[{"type":"attack","value":7},{"type":"attack","value":7},{"type":"defend","value":5}],"traits":[],"flavor":"一小群反光贴着水面走。最前面那条是空的。"},{"id":"enemy_d4_05","name":"盲眼红腔鱼","layer":4,"tier":"elite","hp":"66-76","intent_pattern":[{"type":"buff","value":4},{"type":"attack","value":14},{"type":"defend","value":9},{"type":"attack","value":10}],"traits":[],"flavor":"它没有眼。你进洞的时候，洞暗了一下。"},{"id":"enemy_d4_06","name":"光蛭母","layer":4,"tier":"boss","hp":120,"intent_pattern":[{"type":"attack","value":12},{"type":"defend","value":10},{"type":"buff","value":5},{"type":"attack","value":18}],"traits":[],"flavor":"它悬在气流里，薄得透光。你被从头到尾数过一遍。谁数的，没有对账。","phases":[{"hp_above":0.66,"log":"它把自己摊开在上升气流里。你数不清哪一层是它。","intent_pattern":[{"type":"debuff","status":"steal","value":1},{"type":"attack","value":10},{"type":"attack","value":8},{"type":"defend","value":8}]},{"hp_above":0.33,"log":"它薄得透光。分你一点光，多收一点利息。","intent_pattern":[{"type":"buff","value":5},{"type":"debuff","status":"gift","value":1},{"type":"attack","value":12},{"type":"defend","value":8}]},{"hp_above":0,"log":"它开始和你共用同一副手牌。听它的那一半越来越多。","intent_pattern":[{"type":"debuff","status":"steal","value":1},{"type":"attack","value":14},{"type":"debuff","status":"steal","value":1},{"type":"attack","value":10,"times":2}]}]},{"id":"enemy_d5_01","name":"热泉管虫","layer":5,"tier":"normal","hp":"28-34","intent_pattern":[{"type":"defend","value":6},{"type":"attack","value":8}],"traits":[],"flavor":"触须开合的节奏和你的心跳对上了。你先停的。"},{"id":"enemy_d5_02","name":"热泉螈","layer":5,"tier":"normal","hp":"26-32","intent_pattern":[{"type":"attack","value":8},{"type":"attack","value":7},{"type":"defend","value":6}],"traits":[],"flavor":"它泡在池里。你伸手进去，池水绕开你的手，先碰它。"},{"id":"enemy_d5_03","name":"硫塔菌","layer":5,"tier":"normal","hp":"30-36","intent_pattern":[{"type":"attack","value":8},{"type":"defend","value":7},{"type":"attack","value":8}],"traits":[],"flavor":"硫塔中空。风穿过去的时候，它用你的脚步打拍子。"},{"id":"enemy_d5_04","name":"震鸣蟾","layer":5,"tier":"normal","hp":"26-31","intent_pattern":[{"type":"buff","value":3},{"type":"attack","value":7},{"type":"attack","value":7}],"traits":[],"flavor":"它的叫声让你的牙发麻。收件人不是你。"},{"id":"enemy_d5_05","name":"铁细菌膜母体","layer":5,"tier":"elite","hp":"58-66","intent_pattern":[{"type":"buff","value":5},{"type":"attack","value":11},{"type":"defend","value":8},{"type":"attack","value":8}],"traits":[],"flavor":"整片浅滩在膜下呼吸。你踩过的地方陷得深一些。"},{"id":"enemy_d5_06","name":"震喉","layer":5,"tier":"boss","hp":96,"intent_pattern":[{"type":"attack","value":10},{"type":"buff","value":5},{"type":"attack","value":15},{"type":"defend","value":9}],"traits":[],"flavor":"管道骨骼缠成一团。中心空腔开合，吸的不是气。","phases":[{"hp_above":0.66,"log":"管道骨骼缠成一团，中心空腔在吸。吸的不是气。","intent_pattern":[{"type":"attack","value":8,"mirror":true},{"type":"attack","value":6},{"type":"defend","value":10}]},{"hp_above":0.33,"log":"空腔张开。你这一步还没落，它已经在数下一步。","intent_pattern":[{"type":"buff","value":5},{"type":"attack","value":12,"mirror":true},{"type":"debuff","status":"weak","value":2}]},{"hp_above":0,"log":"振动不走空气了。空气让开，骨头接手。","intent_pattern":[{"type":"attack","value":9,"pierce":true},{"type":"attack","value":9,"pierce":true},{"type":"attack","value":16}]}]},{"id":"enemy_d6_01","name":"辐射合成菌","layer":6,"tier":"normal","intent_pattern":[{"type":"attack","value":8},{"type":"defend","value":8}],"traits":[],"flavor":"辐射对它们是食物。你走过的那一段，特别肥。","hp":"34-42"},{"id":"enemy_d6_02","name":"抗辐射甲壳类","layer":6,"tier":"normal","hp":"36-44","intent_pattern":[{"type":"defend","value":9},{"type":"attack","value":10}],"traits":[],"flavor":"垢从壳缝里长出来，把辐射裹在里头。它走在剂量表外面。"},{"id":"enemy_d6_03","name":"辐射金属鳞鳄","layer":6,"tier":"normal","hp":"38-46","intent_pattern":[{"type":"attack","value":10},{"type":"attack","value":8},{"type":"defend","value":7}],"traits":[],"flavor":"鳞缝里漏红光。它爬过的地方，计数器响很久。"},{"id":"enemy_d6_04","name":"锈蚀菌","layer":6,"tier":"normal","intent_pattern":[{"type":"attack","value":8},{"type":"attack","value":8},{"type":"defend","value":6}],"traits":[],"flavor":"支撑柱的锈多了几道新指痕。进食声像翻书。","hp":"32-38"},{"id":"enemy_d6_05","name":"辐射金属鳞鳄王","layer":6,"tier":"elite","hp":"68-74","intent_pattern":[{"type":"buff","value":5},{"type":"attack","value":10},{"type":"defend","value":9},{"type":"attack","value":9}],"traits":[],"flavor":"它的领地按剂量划分。你进门那一步已经越界。"},{"id":"enemy_d7_01","name":"旧光者残影","layer":7,"tier":"normal","hp":"26-30","intent_pattern":[{"type":"attack","value":6},{"type":"defend","value":7}],"traits":[],"flavor":"它在重复一段旧对话。你的名字在里面，位置没变过。"},{"id":"enemy_d7_02","name":"光柱蛇蜥","layer":7,"tier":"normal","hp":"26-30","intent_pattern":[{"type":"attack","value":7},{"type":"attack","value":5},{"type":"defend","value":6}],"traits":[],"flavor":"光柱熄了。它还悬在原来的位置。"},{"id":"enemy_d7_03","name":"震杆菌","layer":7,"tier":"normal","hp":"26-30","intent_pattern":[{"type":"defend","value":7},{"type":"attack","value":7}],"traits":[],"flavor":"培养皿碎了，它们还在分裂。间隔很短，像赶时间。"},{"id":"enemy_d7_04","name":"孢子群","layer":7,"tier":"normal","hp":"28-32","intent_pattern":[{"type":"attack","value":3,"times":3},{"type":"defend","value":5}],"traits":[],"flavor":"它们过境时红光暗一小会儿。刚好够你数错一步。"},{"id":"enemy_d7_05","name":"震语苔丛","layer":7,"tier":"elite","hp":"52-58","intent_pattern":[{"type":"buff","value":4},{"type":"attack","value":9},{"type":"defend","value":8},{"type":"attack","value":8}],"traits":[],"flavor":"整面墙的苔在念经。用的是你的步频。"},{"id":"enemy_d7_06","name":"穹顶之影","layer":7,"tier":"boss","hp":56,"intent_pattern":[{"type":"buff","value":4},{"type":"attack","value":7},{"type":"attack","value":7},{"type":"defend","value":8},{"type":"attack","value":11}],"traits":[],"flavor":"倒挂的发光网。它不捕猎。它照明，然后等。","phases":[{"hp_above":0.66,"log":"倒挂的发光网。它不捕猎，它照明，然后等。","intent_pattern":[{"type":"attack","value":6,"pierce":true},{"type":"defend","value":12}]},{"hp_above":0.33,"log":"穹顶之影把你的每一步都记进光里。记满了。","intent_pattern":[{"type":"buff","value":6},{"type":"buff","value":6},{"type":"attack","value":30}]},{"hp_above":0,"log":"一部分结构自己动了。那部分从来不是活物。","intent_pattern":[{"type":"attack","value":10,"times":2,"pierce":true},{"type":"attack","value":18},{"type":"debuff","status":"weak","value":2}]}]},{"id":"enemy_d8_01","name":"墟蛹","layer":8,"tier":"boss","hp":68,"intent_pattern":[{"type":"attack","value":7},{"type":"buff","value":5},{"type":"defend","value":8},{"type":"attack","value":10}],"traits":[],"flavor":"茧的表面在计算。算到你的部分，停了很久。","phases":[{"hp_above":0.66,"log":"茧的表面在计算。算到你的部分，停了很久。","intent_pattern":[{"type":"buff","value":8},{"type":"buff","value":6},{"type":"attack","value":20}]},{"hp_above":0.33,"log":"墟蛹开始编织。你弃掉的牌成了它的丝。","intent_pattern":[{"type":"attack","value":10,"drain_discard":true},{"type":"attack","value":14},{"type":"defend","value":16}]},{"hp_above":0,"log":"茧开了。走出来的东西穿着你的装备，合身。","intent_pattern":[{"type":"attack","value":10,"times":3,"pierce":true},{"type":"buff","value":6},{"type":"attack","value":24}]}]},{"id":"enemy_d8_02","name":"墟尘行像","layer":8,"tier":"normal","hp":"34-40","intent_pattern":[{"type":"attack","value":8},{"type":"attack","value":7},{"type":"defend","value":7}],"traits":[],"flavor":"跟着茧的节拍走。没有人抬它，它自己在走。"},{"id":"enemy_d8_03","name":"空壳旧光者","layer":8,"tier":"elite","hp":"58-66","intent_pattern":[{"type":"buff","value":5},{"type":"attack","value":9},{"type":"defend","value":8},{"type":"attack","value":8}],"traits":[],"flavor":"防护服还在自动广播。里面的人已经不需要它了。"},{"id":"enemy_d1_03","name":"隙居螨","layer":1,"tier":"normal","hp":"8-11","intent_pattern":[{"type":"attack","value":2},{"type":"defend","value":3}],"traits":[],"flavor":"它们住在岩缝里。身子比缝薄一层，薄得刚好。"},{"id":"enemy_d1_04","name":"管廊苔毯","layer":1,"tier":"normal","hp":"9-12","intent_pattern":[{"type":"attack","value":3},{"type":"attack","value":2},{"type":"defend","value":3}],"traits":[],"flavor":"苔铺满了整条管廊。你踩过的地方，第二天是空的。"},{"id":"enemy_d2_06","name":"沉屑鱼","layer":2,"tier":"normal","hp":"14-18","intent_pattern":[{"type":"attack","value":4},{"type":"attack","value":3},{"type":"defend","value":3}],"traits":[],"flavor":"它们吃上层落下来的东西。你掉下去的时候，它们排好了次序。"},{"id":"enemy_d2_07","name":"冷洞跳蛛","layer":2,"tier":"normal","hp":"13-17","intent_pattern":[{"type":"attack","value":5},{"type":"defend","value":4}],"traits":[],"flavor":"它跳之前会看你一眼。落点从来不是你刚才站的地方。"},{"id":"enemy_d3_06","name":"硬壳蜗","layer":3,"tier":"normal","hp":"20-26","intent_pattern":[{"type":"defend","value":6},{"type":"attack","value":6}],"traits":[],"flavor":"壳上的年轮一圈套一圈。最宽的那圈里嵌着一枚牙。"},{"id":"enemy_d3_07","name":"空腔蝠","layer":3,"tier":"normal","hp":"18-24","intent_pattern":[{"type":"attack","value":7},{"type":"attack","value":5}],"traits":[],"flavor":"它们没有眼睛，靠回声画地图。地图上你是一个洞。"},{"id":"enemy_d4_07","name":"浮光水母","layer":4,"tier":"normal","hp":"26-32","intent_pattern":[{"type":"attack","value":7},{"type":"defend","value":6}],"traits":[],"flavor":"它浮在光池上方。影子沉在水底，影子比你先到。"},{"id":"enemy_d4_08","name":"光藓蠕虫","layer":4,"tier":"normal","hp":"24-30","intent_pattern":[{"type":"attack","value":6,"times":2},{"type":"defend","value":5}],"traits":[],"flavor":"它们啃光藓。啃过的地方亮一下，像谁在里面翻了个身。"},{"id":"enemy_d5_07","name":"沸泥鳗","layer":5,"tier":"normal","hp":"30-36","intent_pattern":[{"type":"attack","value":8},{"type":"defend","value":6}],"traits":[],"flavor":"泥是沸的，它不急。它在等泥替它把你的脚固定住。"},{"id":"enemy_d5_08","name":"硫雾囊菌","layer":5,"tier":"normal","hp":"32-38","intent_pattern":[{"type":"attack","value":7},{"type":"attack","value":7},{"type":"defend","value":7}],"traits":[],"flavor":"囊一鼓一缩。缩的时候，你闻到的硫味会换一个方向。"},{"id":"enemy_d6_06","name":"铅皮蛞蝓","layer":6,"tier":"normal","hp":"34-40","intent_pattern":[{"type":"attack","value":8},{"type":"defend","value":8}],"traits":[],"flavor":"铅皮是它自己裹的。剂量表上没有这一栏。"},{"id":"enemy_d6_07","name":"辐射藻垫","layer":6,"tier":"normal","hp":"36-42","intent_pattern":[{"type":"attack","value":7,"times":2},{"type":"defend","value":7}],"traits":[],"flavor":"藻垫过境的地方石头是暖的。暖得像有人刚躺过。"},{"id":"enemy_d7_07","name":"无面记录员","layer":7,"tier":"normal","hp":"34-40","intent_pattern":[{"type":"attack","value":8},{"type":"defend","value":8}],"traits":[],"flavor":"它记东西不用脸。你走近时，它把你的样子念了出来。"},{"id":"enemy_d7_08","name":"静默歌者","layer":7,"tier":"normal","hp":"36-42","intent_pattern":[{"type":"attack","value":8},{"type":"attack","value":8},{"type":"defend","value":7}],"traits":[],"flavor":"它张着嘴，不出声。歌在你牙齿里，你只是借住。"},{"id":"enemy_d8_04","name":"茧丝虫","layer":8,"tier":"normal","hp":"36-42","intent_pattern":[{"type":"attack","value":9},{"type":"defend","value":8}],"traits":[],"flavor":"它们吐的丝和墟蛹的是一种。货源不明。"},{"id":"enemy_d8_05","name":"墟影残片","layer":8,"tier":"elite","hp":"54-60","intent_pattern":[{"type":"buff","value":5},{"type":"attack","value":11},{"type":"defend","value":9},{"type":"attack","value":9}],"traits":[],"flavor":"它是墟蛹掉下来的一角。掉下来之后自己动了很多年。"},{"id":"enemy_d1_05","name":"管壁钟乳盐","layer":1,"tier":"normal","hp":"10-13","intent_pattern":[{"type":"attack","value":3},{"type":"attack","value":2},{"type":"defend","value":3}],"traits":[],"flavor":"盐从管壁上倒着长。长到一定长度会断，断口是圆的。"},{"id":"enemy_d8_06","name":"墟腔","layer":8,"tier":"elite","hp":"64-72","intent_pattern":[{"type":"buff","value":5},{"type":"attack","value":10},{"type":"defend","value":9},{"type":"attack","value":9}],"traits":[],"flavor":"它有一个腔。腔里的声音不是它的，它只是借壳放着。"},{"id":"enemy_d1_e1","name":"盐壳拾荒者","layer":1,"tier":"elite","hp":30,"intent_pattern":[{"type":"attack","value":4},{"type":"defend","value":7},{"type":"attack","value":4},{"type":"buff","value":3}],"traits":[],"flavor":"改到第三代的防护服，面甲上开了一条自己割的缝。它靠什么呼吸，没人问过。"},{"id":"enemy_d1_e2","name":"孢子清道夫","layer":1,"tier":"elite","hp":28,"intent_pattern":[{"type":"debuff","status":"gift","value":1},{"type":"attack","value":5},{"type":"attack","value":5},{"type":"defend","value":5}],"traits":[],"flavor":"它扫拢孢子不是为杀谁。扫干净的地方，红渊就看不见了。"},{"id":"enemy_d1_b1","name":"钟乳盐·塌落体","layer":1,"tier":"boss","hp":46,"intent_pattern":[{"type":"attack","value":5},{"type":"defend","value":8},{"type":"attack","value":5},{"type":"attack","value":9}],"traits":[],"flavor":"钟乳盐长了几千年，长成了会自己塌下来的形状。","phases":[{"hp_above":0.5,"log":"盐壳簌簌地掉。它在换一个更重的形状。","intent_pattern":[{"type":"attack","value":6},{"type":"defend","value":9},{"type":"attack","value":11}]}]},{"id":"enemy_d2_e1","name":"历虫","layer":2,"tier":"elite","hp":42,"intent_pattern":[{"type":"defend","value":8},{"type":"attack","value":5},{"type":"defend","value":8},{"type":"attack","value":9}],"traits":[],"flavor":"它以年为进食间隔，以历痕为巢。你打它的时候，它正在补一段旧历。"},{"id":"enemy_d2_e2","name":"菌膜织者","layer":2,"tier":"elite","hp":40,"intent_pattern":[{"type":"buff","value":3},{"type":"attack","value":6},{"type":"debuff","status":"steal","value":1},{"type":"attack","value":7}],"traits":[],"flavor":"冷洞的菌膜是它织的。织到密处，连你的手牌也归它安排。"},{"id":"enemy_d2_b1","name":"历壁的守读者","layer":2,"tier":"boss","hp":58,"intent_pattern":[{"type":"attack","value":6},{"type":"defend","value":9},{"type":"attack","value":6},{"type":"attack","value":12}],"traits":[],"flavor":"它守着历壁最老的一段。读它要几百年，它已经开始读了。","phases":[{"hp_above":0.5,"log":"它翻动了历壁上最深的一页。节奏变了。","intent_pattern":[{"type":"attack","value":7},{"type":"defend","value":10},{"type":"attack","value":14}]}]},{"id":"enemy_d3_e1","name":"钻孔贝群","layer":3,"tier":"elite","hp":52,"intent_pattern":[{"type":"defend","value":10},{"type":"attack","value":7},{"type":"defend","value":10},{"type":"attack","value":10}],"traits":[],"flavor":"不是一只，是一片。它们钻了三代才钻成这个阵型。"},{"id":"enemy_d3_e2","name":"旱螈伏兵","layer":3,"tier":"elite","hp":48,"intent_pattern":[{"type":"attack","value":7},{"type":"attack","value":7},{"type":"buff","value":4},{"type":"attack","value":11}],"traits":[],"flavor":"它在干缝里趴了整整一个水脉冲。你走到它面前，是它等的。"},{"id":"enemy_d3_b1","name":"旱脉的封口者","layer":3,"tier":"boss","hp":62,"intent_pattern":[{"type":"attack","value":8},{"type":"defend","value":6},{"type":"attack","value":8},{"type":"attack","value":14}],"traits":[],"flavor":"哪条水脉干了，它就把哪条脉口封上。封口的东西是它自己的壳。"},{"id":"enemy_d4_e1","name":"藻毯伏击者","layer":4,"tier":"elite","hp":60,"intent_pattern":[{"type":"attack","value":9},{"type":"buff","value":4},{"type":"attack","value":9},{"type":"defend","value":8}],"traits":[],"flavor":"藻毯动了一下。不是水流。"},{"id":"enemy_d4_e2","name":"红腔鱼·巡游种","layer":4,"tier":"elite","hp":64,"intent_pattern":[{"type":"attack","value":7,"times":2},{"type":"defend","value":8},{"type":"attack","value":7,"times":2},{"type":"buff","value":3}],"traits":[],"flavor":"巡游种不吃伏击。它绕着你游，一圈比一圈小。"},{"id":"enemy_d4_b1","name":"光蛭母·逆流","layer":4,"tier":"boss","hp":130,"intent_pattern":[{"type":"attack","value":10},{"type":"defend","value":10},{"type":"attack","value":8},{"type":"debuff","status":"steal","value":1}],"traits":[],"flavor":"它逆着上升气流漂。被它照亮的东西会往下坠。","phases":[{"hp_above":0.66,"log":"它把自己摊开在逆流里。数不清哪一层是它。","intent_pattern":[{"type":"attack","value":10},{"type":"defend","value":10},{"type":"attack","value":8},{"type":"debuff","status":"steal","value":1}]},{"hp_above":0.33,"log":"它薄得透光，开始分你一点光——多收一点利息。","intent_pattern":[{"type":"buff","value":5},{"type":"attack","value":12},{"type":"debuff","status":"gift","value":1},{"type":"attack","value":9}]},{"hp_above":0,"log":"逆流停了。它整片压下来。","intent_pattern":[{"type":"attack","value":10,"times":2},{"type":"attack","value":8},{"type":"buff","value":6},{"type":"attack","value":14}]}]},{"id":"enemy_d5_e1","name":"喷息守卫","layer":5,"tier":"elite","hp":62,"intent_pattern":[{"type":"defend","value":7},{"type":"attack","value":11},{"type":"defend","value":7},{"type":"attack","value":11}],"traits":[],"flavor":"喷议会的门卫不收钱，只收节奏。踩不对点的人会被请出去。"},{"id":"enemy_d5_e2","name":"硫沫赘生体","layer":5,"tier":"elite","hp":60,"intent_pattern":[{"type":"attack","value":6,"times":2},{"type":"buff","value":4},{"type":"attack","value":6,"times":2},{"type":"attack","value":9}],"traits":[],"flavor":"它从一次大喷里长出来，身上还带着那个节奏。"},{"id":"enemy_d5_b1","name":"震喉·空腔独奏","layer":5,"tier":"boss","hp":110,"intent_pattern":[{"type":"attack","value":9},{"type":"attack","value":6,"drain_discard":true},{"type":"defend","value":8},{"type":"attack","value":12}],"traits":[],"flavor":"它不广播别人的振动了。它只播自己的一段，翻来覆去。","phases":[{"hp_above":0.5,"log":"独奏进了副歌。它开始从你的弃牌里取音。","intent_pattern":[{"type":"attack","value":9,"drain_discard":true},{"type":"attack","value":10},{"type":"attack","value":13}]}]},{"id":"enemy_d6_e1","name":"辐射休眠孢子群","layer":6,"tier":"elite","hp":72,"intent_pattern":[{"type":"debuff","status":"steal","value":1},{"type":"attack","value":12},{"type":"attack","value":12},{"type":"buff","value":5}],"traits":[],"flavor":"孢子不该聚成团。聚成团的孢子已经开始记东西了。"},{"id":"enemy_d6_e2","name":"金属鳞鳄幼体","layer":6,"tier":"elite","hp":76,"intent_pattern":[{"type":"attack","value":13},{"type":"defend","value":9},{"type":"attack","value":13}],"traits":[],"flavor":"王蜕下来的壳里孵出了它。它比王的壳更硬。"},{"id":"enemy_d6_b1","name":"辐射金属鳞鳄王·蜕","layer":6,"tier":"boss","hp":150,"intent_pattern":[{"type":"attack","value":14},{"type":"defend","value":10},{"type":"attack","value":14},{"type":"buff","value":6}],"traits":[],"flavor":"王蜕了一次皮。蜕下来的那层也在爬。","phases":[{"hp_above":0.4,"log":"旧鳞一片片立起来。它不打算防了。","intent_pattern":[{"type":"attack","value":16},{"type":"attack","value":12},{"type":"defend","value":12}]}]},{"id":"enemy_d7_e1","name":"烧手的灰烬","layer":7,"tier":"elite","hp":88,"intent_pattern":[{"type":"attack","value":15},{"type":"buff","value":6},{"type":"attack","value":15},{"type":"defend","value":10}],"traits":[],"flavor":"祭祀台上没烧尽的部分聚了起来。它烧你的手，和当年烧历书是同一个动作。"},{"id":"enemy_d7_e2","name":"震台祭司","layer":7,"tier":"elite","hp":84,"intent_pattern":[{"type":"buff","value":7},{"type":"debuff","status":"steal","value":1},{"type":"attack","value":12},{"type":"attack","value":10}],"traits":[],"flavor":"它祭的已经不是地神。它祭的是自己即将成为的东西。"},{"id":"enemy_d7_b1","name":"穹顶之影·网颤","layer":7,"tier":"boss","hp":72,"intent_pattern":[{"type":"attack","value":12},{"type":"attack","value":8,"times":2},{"type":"debuff","status":"gift","value":1},{"type":"attack","value":16}],"traits":[],"flavor":"穹顶之影的一角垂到了核心区。网在颤，颤的是网住的还是网，分不清。","phases":[{"hp_above":0.5,"log":"网收紧了。颤动变成了抽搐。","intent_pattern":[{"type":"attack","value":14},{"type":"attack","value":10,"times":2},{"type":"attack","value":18}]}]},{"id":"enemy_d8_e1","name":"循环的巡逻体","layer":8,"tier":"elite","hp":98,"intent_pattern":[{"type":"attack","value":16},{"type":"defend","value":12},{"type":"attack","value":16},{"type":"buff","value":6}],"traits":[],"flavor":"它按八万年前的路线巡逻。路线上的东西换了几拨，路线没换。"},{"id":"enemy_d8_e2","name":"墟影残片·重奏","layer":8,"tier":"elite","hp":102,"intent_pattern":[{"type":"attack","value":10,"times":2},{"type":"defend","value":10},{"type":"attack","value":10,"times":2},{"type":"buff","value":5}],"traits":[],"flavor":"同一片残影，抄了两遍。两遍都认为自己是真的。"},{"id":"enemy_d8_b1","name":"墟蛹·未完成","layer":8,"tier":"boss","hp":200,"intent_pattern":[{"type":"attack","value":12},{"type":"defend","value":10},{"type":"attack","value":12},{"type":"debuff","status":"steal","value":1}],"traits":[],"flavor":"它比墟蛹小一圈，也新一层。有些程序还没算完，所以它还醒着。","phases":[{"hp_above":0.33,"log":"茧上的纹路亮了。它在核对什么东西——核对到你了。","intent_pattern":[{"type":"attack","value":12},{"type":"defend","value":10},{"type":"attack","value":12},{"type":"debuff","status":"steal","value":1}]},{"hp_above":0,"log":"核算完毕。结果是一条旧的指令：清除外来模式。","intent_pattern":[{"type":"attack","value":14,"pierce":true},{"type":"attack","value":10},{"type":"defend","value":12},{"type":"attack","value":16,"pierce":true}]}]},{"id":"enemy_d1_06","name":"空服的壳","layer":1,"tier":"normal","eco":"eco_surface","hp":"9-11","intent_pattern":[{"type":"attack","value":2},{"type":"defend","value":4},{"type":"defend","value":3},{"type":"attack","value":3}],"traits":[],"flavor":"防护服里早就没有人了。它照样按规程合拢，按规程张开。"},{"id":"enemy_d1_07","name":"晒裂的软管","layer":1,"tier":"normal","eco":"eco_surface","hp":"8-10","intent_pattern":[{"type":"attack","value":1,"times":2},{"type":"defend","value":3},{"type":"attack","value":2}],"traits":[],"flavor":"管子裂着，漏出来的不是水。漏了五百年，还没漏完。"},{"id":"enemy_d1_08","name":"记名的旗","layer":1,"tier":"normal","eco":"eco_surface","hp":"10-12","intent_pattern":[{"type":"buff","value":2},{"type":"attack","value":3},{"type":"defend","value":3}],"traits":[],"flavor":"旗面只剩编号。风根本没有，它还是展开一次，收起一次。"},{"id":"enemy_d1_e3","name":"气闸的守夜者","layer":1,"tier":"elite","eco":"eco_surface","hp":"27-31","intent_pattern":[{"type":"defend","value":6},{"type":"attack","value":4},{"type":"debuff","status":"weak"},{"type":"attack","value":4}],"traits":[],"flavor":"它在等一个对不上暗号的人。等了这么久，暗号已经换过四版。"},{"id":"enemy_d1_e4","name":"坠轨的投影","layer":1,"tier":"elite","eco":"eco_surface","hp":"25-29","intent_pattern":[{"type":"attack","value":3,"mirror":true},{"type":"defend","value":5},{"type":"attack","value":5},{"type":"attack","value":4}],"traits":[],"flavor":"轨道上的人按过按钮。投影把他们落下来的样子，一遍一遍演给你看。"},{"id":"enemy_d1_b2","name":"静默号·最后一次广播","layer":1,"tier":"boss","eco":"eco_surface","hp":60,"intent_pattern":[{"type":"attack","value":4,"times":2},{"type":"defend","value":8},{"type":"debuff","status":"gift"},{"type":"attack","value":6},{"type":"defend","value":6}],"traits":[],"flavor":"广播稿念到第三页。第三页之后是空白。它还在念。"},{"id":"enemy_d2_08","name":"沉雪的苔背","layer":2,"tier":"normal","eco":"eco_cold","hp":"12-14","intent_pattern":[{"type":"defend","value":5},{"type":"attack","value":3},{"type":"defend","value":4},{"type":"attack","value":3},{"type":"defend","value":3}],"traits":[],"flavor":"雪落在它背上，落了八万年。它不动，雪替它记年。"},{"id":"enemy_d2_09","name":"历壁的蛀痕","layer":2,"tier":"normal","eco":"eco_cold","hp":"11-13","intent_pattern":[{"type":"debuff","status":"steal"},{"type":"attack","value":3},{"type":"defend","value":3}],"traits":[],"flavor":"历上缺了一小段。缺的那段在它肚子里，还没有消化。"},{"id":"enemy_d2_e3","name":"冷眠的守历者","layer":2,"tier":"elite","eco":"eco_cold","hp":"31-35","intent_pattern":[{"type":"defend","value":7},{"type":"attack","value":5},{"type":"debuff","status":"burn"},{"type":"attack","value":5},{"type":"defend","value":6}],"traits":[],"flavor":"它守的历不许火。谁带了火来，它就把火塞回谁的胸口。"},{"id":"enemy_d2_b2","name":"历的补写者","layer":2,"tier":"boss","eco":"eco_cold","hp":66,"intent_pattern":[{"type":"attack","value":4},{"type":"defend","value":8},{"type":"attack","value":5,"drain_discard":true},{"type":"defend","value":6},{"type":"attack","value":6}],"traits":[],"flavor":"历上空着的年份要补齐。它看见你带了多少过去，就补多少。"},{"id":"enemy_d3_08","name":"滴水的账房","layer":3,"tier":"normal","eco":"eco_arid","hp":"12-14","intent_pattern":[{"type":"attack","value":3},{"type":"defend","value":4},{"type":"attack","value":4},{"type":"defend","value":3}],"traits":[],"flavor":"它记账。一滴进，一滴出。你身上带的水，它已经记下了。"},{"id":"enemy_d3_09","name":"隐生的缓步","layer":3,"tier":"normal","eco":"eco_arid","hp":"10-12","intent_pattern":[{"type":"defend","value":6},{"type":"defend","value":4},{"type":"attack","value":2},{"type":"defend","value":5},{"type":"attack","value":3}],"traits":[],"flavor":"它死过很多次，每次都趁没人的时候活回来。这次它醒着。"},{"id":"enemy_d3_e3","name":"抢路的干壳","layer":3,"tier":"elite","eco":"eco_arid","hp":"30-34","intent_pattern":[{"type":"attack","value":4},{"type":"attack","value":4},{"type":"defend","value":5},{"type":"debuff","status":"poison"}],"traits":[],"flavor":"水在这里有路权。它把自己的路，修进了你的喉咙。"},{"id":"enemy_d3_b2","name":"泉权的丈量者","layer":3,"tier":"boss","eco":"eco_arid","hp":64,"intent_pattern":[{"type":"defend","value":7},{"type":"attack","value":5},{"type":"attack","value":5},{"type":"debuff","status":"gift"},{"type":"buff","value":2},{"type":"attack","value":6}],"traits":[],"flavor":"它量过每一眼泉。轮到你的时候，它量的不是水。"},{"id":"enemy_d4_09","name":"藻毯的影子","layer":4,"tier":"normal","eco":"eco_sea","hp":"14-16","intent_pattern":[{"type":"defend","value":4},{"type":"attack","value":4},{"type":"attack","value":5},{"type":"defend","value":4}],"traits":[],"flavor":"影子先到，它后到。你看影子的那一眼，就是它等的全部。"},{"id":"enemy_d4_10","name":"滤食的须群","layer":4,"tier":"normal","eco":"eco_sea","hp":"13-15","intent_pattern":[{"type":"attack","value":2,"times":3},{"type":"defend","value":3},{"type":"attack","value":2,"times":2}],"traits":[],"flavor":"它们不吃你。它们只是把你和水一起滤一遍，留下的都算渣。"},{"id":"enemy_d4_e3","name":"红腔鱼的伏击手","layer":4,"tier":"elite","eco":"eco_sea","hp":"37-41","intent_pattern":[{"type":"defend","value":5},{"type":"attack","value":7},{"type":"attack","value":7},{"type":"debuff","status":"weak"}],"traits":[],"flavor":"它在暗处悬着，悬了很久。红光每闪一次，它近一段。"},{"id":"enemy_d5_09","name":"硫菌丘的看火者","layer":5,"tier":"normal","eco":"eco_vent","hp":"15-17","intent_pattern":[{"type":"defend","value":5},{"type":"attack","value":4},{"type":"attack","value":4},{"type":"defend","value":4},{"type":"attack","value":4}],"traits":[],"flavor":"它守着一口不开的泉。开泉的日子由不得它，也由不得你。"},{"id":"enemy_d5_10","name":"喷发期的管虫","layer":5,"tier":"normal","eco":"eco_vent","hp":"14-16","intent_pattern":[{"type":"attack","value":3,"times":2},{"type":"defend","value":4},{"type":"attack","value":3,"times":2}],"traits":[],"flavor":"羽状触须张开的时候最好看。看完的人都这么说，说得很轻。"},{"id":"enemy_d5_e3","name":"热议会的执汤者","layer":5,"tier":"elite","eco":"eco_vent","hp":"39-43","intent_pattern":[{"type":"attack","value":5},{"type":"debuff","status":"burn"},{"type":"defend","value":6},{"type":"attack","value":6},{"type":"debuff","status":"burn"}],"traits":[],"flavor":"汤是用活水煨的。你进了汤锅的事，就是全城的事。"},{"id":"enemy_d6_08","name":"重鳞的拾壳者","layer":6,"tier":"normal","eco":"eco_rad","hp":"16-18","intent_pattern":[{"type":"defend","value":6},{"type":"defend","value":4},{"type":"attack","value":5},{"type":"attack","value":4}],"traits":[],"flavor":"它捡壳，一只一只码好。有的壳里还住着小东西，它也码。"},{"id":"enemy_d6_09","name":"低烧的菌群","layer":6,"tier":"normal","eco":"eco_rad","hp":"15-17","intent_pattern":[{"type":"buff","value":2},{"type":"attack","value":4},{"type":"attack","value":4},{"type":"defend","value":4},{"type":"attack","value":4},{"type":"defend","value":3}],"traits":[],"flavor":"辐射是它的低烧。烧得越久，它越有精神。"},{"id":"enemy_d6_e3","name":"铅鳞的收藏家","layer":6,"tier":"elite","eco":"eco_rad","hp":"41-45","intent_pattern":[{"type":"defend","value":8},{"type":"attack","value":6},{"type":"debuff","status":"steal"},{"type":"attack","value":6}],"traits":[],"flavor":"它收仪表，收屏蔽板，收到后来，收会走的东西。"},{"id":"enemy_d6_b2","name":"地神骨灰坛的看守","layer":6,"tier":"boss","eco":"eco_rad","hp":72,"intent_pattern":[{"type":"attack","value":6},{"type":"defend","value":9},{"type":"attack","value":5,"times":2},{"type":"debuff","status":"gift"},{"type":"buff","value":3}],"traits":[],"flavor":"坛子里的灰是地神剩下的。它守着，像守着一个还没凉透的名字。"},{"id":"enemy_d7_09","name":"三色菌毯的须","layer":7,"tier":"normal","eco":"eco_core","hp":"18-20","intent_pattern":[{"type":"attack","value":5},{"type":"defend","value":6},{"type":"attack","value":5},{"type":"defend","value":5},{"type":"attack","value":5}],"traits":[],"flavor":"黑红金三色按顺序烫人。它换色的间隔，比你的呼吸慢半口。"},{"id":"enemy_d7_10","name":"慢半拍的影","layer":7,"tier":"normal","eco":"eco_core","hp":"17-19","intent_pattern":[{"type":"attack","value":6,"mirror":true},{"type":"defend","value":5},{"type":"attack","value":5}],"traits":[],"flavor":"它打你的节奏，是你上一步的节奏。在这里，连影子都懒得自己动。"},{"id":"enemy_d7_e3","name":"超临界的水囊","layer":7,"tier":"elite","eco":"eco_core","hp":"45-49","intent_pattern":[{"type":"attack","value":6,"times":2},{"type":"defend","value":7},{"type":"attack","value":8},{"type":"attack","value":6}],"traits":[],"flavor":"囊里的水不在沸点以下。它鼓一下，走廊就暗一次。"},{"id":"enemy_d8_07","name":"八万年前的班表","layer":8,"tier":"normal","eco":"eco_nexus","hp":"21-23","intent_pattern":[{"type":"buff","value":3},{"type":"attack","value":6},{"type":"defend","value":6},{"type":"attack","value":6},{"type":"defend","value":5},{"type":"attack","value":6}],"traits":[],"flavor":"班表上的名字都走光了。班表不认识走光，照常排班。"},{"id":"enemy_d8_08","name":"签到簿的笔","layer":8,"tier":"normal","eco":"eco_nexus","hp":"18-20","intent_pattern":[{"type":"debuff","status":"steal"},{"type":"attack","value":6}],"traits":[],"flavor":"来的人都要签。笔不挑人，签什么都收，收走就不还。"},{"id":"enemy_d8_09","name":"谐振的余音","layer":8,"tier":"normal","eco":"eco_nexus","hp":"20-22","intent_pattern":[{"type":"attack","value":5,"times":2},{"type":"attack","value":4,"times":2}],"traits":[],"flavor":"声音停了以后还响着的那部分。它打的是你听到过的东西。"},{"id":"enemy_d8_10","name":"不许关闭的告示","layer":8,"tier":"normal","eco":"eco_nexus","hp":"22-24","intent_pattern":[{"type":"defend","value":8},{"type":"attack","value":7},{"type":"debuff","status":"gift"},{"type":"defend","value":6},{"type":"attack","value":7}],"traits":[],"flavor":"告示钉死了，四种字写同一句话。你多看的那几眼，都是它要的。"},{"id":"enemy_d8_11","name":"检修窗后的手","layer":8,"tier":"normal","eco":"eco_nexus","hp":"19-21","intent_pattern":[{"type":"attack","value":6},{"type":"attack","value":5,"times":2},{"type":"defend","value":5},{"type":"attack","value":5}],"traits":[],"flavor":"窗后有手在拨仪表。拨得很准。窗后没有人，这一点它不瞒你。"},{"id":"enemy_d8_12","name":"走廊尽头的白噪音","layer":8,"tier":"normal","eco":"eco_nexus","hp":"21-23","intent_pattern":[{"type":"defend","value":6},{"type":"attack","value":5,"times":2},{"type":"attack","value":5,"times":2},{"type":"defend","value":6}],"traits":[],"flavor":"它没有形状。你听多久，它就有多久。"}],"relics":[{"id":"relic_01","name":"上一任的矿牌","rarity":"common","veins":["mineral"],"effect_text":"每场战斗开始时，抽 1 张牌。","effect_code":[{"trigger":"combat_start","action":"draw","value":1}],"flavor":"牌号还看得清。名字被人用指甲抠掉了。"},{"id":"relic_02","name":"被咬坏的氧气表","rarity":"common","veins":["light"],"effect_text":"每回合开始时，回复 1 点生命。","effect_code":[{"trigger":"turn_start","action":"heal","value":1}],"flavor":"指针停在红色的一格。它停在这里很久了。"},{"id":"relic_03","name":"半块墟盐","rarity":"common","veins":["mineral"],"effect_text":"每场战斗开始时，获得 3 点格挡。","effect_code":[{"trigger":"combat_start","action":"block","value":3}],"flavor":"断口很新。另外半块被谁带去了更深的地方。"},{"id":"relic_04","name":"光苔矿碎核","rarity":"common","veins":["light"],"effect_text":"最大生命 +4。","effect_code":[{"trigger":"run_start","action":"maxhp","value":4}],"flavor":"绿色还没有死透。你把它贴身放着，走路的时候刻意放轻。"},{"id":"relic_05","name":"旧光者的门牌","rarity":"common","veins":["light"],"effect_text":"击败敌人后，回复 2 点生命。","effect_code":[{"trigger":"on_kill","action":"heal","value":2}],"flavor":"门牌上的姓氏还在。敲门的规矩你不懂，但你学得会。"},{"id":"relic_06","name":"圣火残留","rarity":"common","veins":["heat"],"effect_text":"每场战斗开始时，获得 4 点格挡。","effect_code":[{"trigger":"combat_start","action":"block","value":4}],"flavor":"灰烬里还有一点没凉透的红。你不确定该不该吹熄它。"},{"id":"relic_07","name":"地文历残页","rarity":"common","veins":["tremor"],"effect_text":"每回合开始时，共振额外 +1。","effect_code":[{"trigger":"turn_start","action":"resonance","value":1}],"flavor":"页脚的历法停在「塌」月。没有翻过去的痕迹。"},{"id":"relic_08","name":"磨损的相石","rarity":"common","veins":["mineral"],"effect_text":"每场战斗开始时，抽 1 张牌，凝视 +1。","effect_code":[{"trigger":"combat_start","action":"draw","value":1},{"trigger":"combat_start","action":"gaze","value":1}],"flavor":"棱角被握圆了。它记得的手比你多。"},{"id":"relic_09","name":"断裂的震髓","rarity":"uncommon","veins":["tremor"],"effect_text":"每回合开始时，共振额外 +2。","effect_code":[{"trigger":"turn_start","action":"resonance","value":2}],"flavor":"断口在轻轻地热。它还以为自己接着别的东西。"},{"id":"relic_10","name":"静日触杖","rarity":"uncommon","veins":["heat"],"effect_text":"每场战斗开始时，获得 8 点格挡。","effect_code":[{"trigger":"combat_start","action":"block","value":8}],"flavor":"杖头磨得发亮。被握过的部分比没被握过的更红。"},{"id":"relic_11","name":"共振抑制仪残件","rarity":"uncommon","veins":["mineral"],"effect_text":"每场战斗开始时，获得 10 点格挡。","effect_code":[{"trigger":"combat_start","action":"block","value":10}],"flavor":"外壳裂了，里面还在发出很低的嗡。嗡声替你挡了一部分。"},{"id":"relic_12","name":"望渊台的观测记录","rarity":"uncommon","veins":["light"],"effect_text":"每场战斗开始时，凝视 -2。","effect_code":[{"trigger":"combat_start","action":"gaze","value":-2}],"flavor":"记录只有上半段。下半段被撕掉的时候，纸还是湿的。"},{"id":"relic_13","name":"第一降的船票","rarity":"uncommon","veins":[],"effect_text":"最大生命 +10。","effect_code":[{"trigger":"run_start","action":"maxhp","value":10}],"flavor":"票根打了孔。打孔的人不在名单上。"},{"id":"relic_14","name":"埋骨布","rarity":"uncommon","veins":[],"effect_text":"击败敌人后，回复 3 点生命。","effect_code":[{"trigger":"on_kill","action":"heal","value":3}],"flavor":"布角绣着一个名字。针脚很密，像怕它跑掉。"},{"id":"relic_15","name":"静日蜡封","rarity":"uncommon","veins":["heat"],"effect_text":"每场战斗开始时，获得 6 点格挡，凝视 -1。","effect_code":[{"trigger":"combat_start","action":"block","value":6},{"trigger":"combat_start","action":"gaze","value":-1}],"flavor":"蜡上压着掌纹。压它的人想静很久，没能静够。"},{"id":"relic_16","name":"光导透镜碎片","rarity":"rare","veins":["light"],"effect_text":"每场战斗开始时，抽 2 张牌；最大生命 -4。","effect_code":[{"trigger":"combat_start","action":"draw","value":2},{"trigger":"run_start","action":"maxhp","value":-4}],"flavor":"碎片里的景象是倒的。你看久了，倒的也像真的。"},{"id":"relic_17","name":"净化者的灰","rarity":"rare","veins":[],"effect_text":"每场战斗开始时，凝视 -4；最大生命 -10。","effect_code":[{"trigger":"combat_start","action":"gaze","value":-4},{"trigger":"run_start","action":"maxhp","value":-10}],"flavor":"灰很细。烧掉的东西里，包括一部分他自己。"},{"id":"relic_18","name":"转化者的手记","rarity":"rare","veins":[],"effect_text":"每回合多抽 1 张牌；每场战斗开始时，凝视 +2。","effect_code":[{"trigger":"turn_start","action":"draw","value":1},{"trigger":"combat_start","action":"gaze","value":2}],"flavor":"手记越往后字越大。最后一页只有一行：它在写字。"},{"id":"relic_19","name":"五脉符","rarity":"rare","veins":[],"effect_text":"每回合开始时，回复 1 点生命，共振额外 +1。","effect_code":[{"trigger":"turn_start","action":"heal","value":1},{"trigger":"turn_start","action":"resonance","value":1}],"flavor":"五道刻痕朝着五个方向。渊民的孩子出生那天每人领一枚，用途没有人说。"},{"id":"relic_20","name":"记忆封瓶","rarity":"boss","veins":[],"effect_text":"你的凝视不再提高敌人的伤害；每场战斗开始时，凝视 +3。","effect_code":[{"trigger":"combat_start","action":"gaze","value":3}],"flavor":"瓶塞是蜡封的。蜡上有一个牙印，很小。"},{"id":"relic_21","name":"辐射弹（未爆）","rarity":"common","veins":["light"],"effect_text":"每回合开始时，共振额外 +2；最大生命 -6。","effect_code":[{"trigger":"turn_start","action":"resonance","value":2},{"trigger":"run_start","action":"maxhp","value":-6}],"flavor":"它没炸。它只是一直在漏。"},{"id":"relic_22","name":"黑曜采掘·工伤记录","rarity":"uncommon","veins":["mineral"],"effect_text":"每场战斗开始时，抽 2 张牌，凝视 +2。","effect_code":[{"trigger":"combat_start","action":"draw","value":2},{"trigger":"combat_start","action":"gaze","value":2}],"flavor":"每一页都有一个名字。名字后面的数字越来越大。"},{"id":"relic_23","name":"被圣火烧过的相石","rarity":"rare","veins":["heat"],"effect_text":"每回合开始时，共振额外 +3；最大生命 -8。","effect_code":[{"trigger":"turn_start","action":"resonance","value":3},{"trigger":"run_start","action":"maxhp","value":-8}],"flavor":"裂纹里透红。它记得火，也想记得你。"},{"id":"relic_24","name":"废弃的矿灯","rarity":"common","veins":["light"],"effect_text":"每场战斗开始时，抽 1 张牌，凝视 +1。","effect_code":[{"trigger":"combat_start","action":"draw","value":1},{"trigger":"combat_start","action":"gaze","value":1}],"flavor":"它还亮着。照的方向不对。"},{"id":"relic_25","name":"涌喉·水契残页","rarity":"uncommon","veins":["water"],"effect_text":"你的水脉牌费用 -1（最低 0）；每场战斗开始时，获得 2 点格挡。","effect_code":[{"trigger":"combat_start","action":"block","value":2}],"mod":{"vein_cost":"water","vein_cost_delta":-1},"flavor":"残页上的条款还剩一半。没写的部分对你有利。"},{"id":"relic_26","name":"五脉符（双刻）","rarity":"rare","veins":[],"effect_text":"你的同脉连携加成 +1；每场战斗开始时，获得 2 点格挡。","effect_code":[{"trigger":"combat_start","action":"block","value":2}],"mod":{"chain_bonus":1},"flavor":"同一道刻痕刻了两遍。第二遍更深。"},{"id":"relic_27","name":"圣火残留（长明）","rarity":"uncommon","veins":["heat"],"effect_text":"每场战斗开始时，获得 6 点格挡；回合结束时，格挡只熄一半。","effect_code":[{"trigger":"combat_start","action":"block","value":6}],"mod":{"keep_block":true},"flavor":"火不灭。它替你守着的那部分也不灭。"},{"id":"relic_28","name":"抗共振司·豁免批文","rarity":"rare","veins":[],"effect_text":"你打出带代价的牌时，不再支付代价，改为凝视 +2（锁死类除外）；每场战斗开始时，获得 3 点格挡。","effect_code":[{"trigger":"combat_start","action":"block","value":3}],"mod":{"cost_redirect":"gaze"},"flavor":"红章盖在「不予批准」上。批文只有一页，效力却不止一页。"},{"id":"relic_29","name":"光导石（棱镜）","rarity":"common","veins":["light"],"effect_text":"每场战斗开始时，获得 4 点格挡；光脉连携加成 +1。","effect_code":[{"trigger":"combat_start","action":"block","value":4}],"mod":{"chain_vein":"light","chain_bonus":1},"flavor":"一束光进去，很多束出来。每一束都记得来路。"},{"id":"relic_30","name":"红渊贸易局·水牌","rarity":"common","veins":["water"],"effect_text":"每场战斗开始时，抽 1 张牌；水脉连携加成 +1。","effect_code":[{"trigger":"combat_start","action":"draw","value":1}],"mod":{"chain_vein":"water","chain_bonus":1},"flavor":"水牌是旧的说法。牌面改了三次，水没改。"},{"id":"relic_31","name":"圣火火漆","rarity":"common","veins":["heat"],"effect_text":"每场战斗开始时，获得 4 点格挡；热脉连携加成 +1。","effect_code":[{"trigger":"combat_start","action":"block","value":4}],"mod":{"chain_vein":"heat","chain_bonus":1},"flavor":"漆是烫的。盖过漆的信不会被撤回。"},{"id":"relic_32","name":"震语铃（铃舌）","rarity":"uncommon","veins":["tremor"],"effect_text":"每回合开始时，共振额外 +1；震脉连携加成 +1。","effect_code":[{"trigger":"turn_start","action":"resonance","value":1}],"mod":{"chain_vein":"tremor","chain_bonus":1},"flavor":"铃身丢了，铃舌还在。它照常工作。"},{"id":"relic_33","name":"半块墟盐（磨粉）","rarity":"common","veins":["mineral"],"effect_text":"每场战斗开始时，获得 3 点格挡；矿脉连携加成 +1。","effect_code":[{"trigger":"combat_start","action":"block","value":3}],"mod":{"chain_vein":"mineral","chain_bonus":1},"flavor":"磨成粉也没关系。成分不因为形状改变。"},{"id":"relic_34","name":"墟盐晶簇","rarity":"boss","veins":["mineral"],"effect_text":"每回合开始时，回复 2 点生命，共振额外 +2；每场战斗开始时，凝视 +2。","effect_code":[{"trigger":"turn_start","action":"heal","value":2},{"trigger":"turn_start","action":"resonance","value":2},{"trigger":"combat_start","action":"gaze","value":2}],"flavor":"晶簇还在长。它选择在你身上长。"},{"id":"relic_35","name":"第一降的船票（回程）","rarity":"boss","veins":[],"effect_text":"最大生命 +20；每场战斗开始时，凝视 +1。","effect_code":[{"trigger":"run_start","action":"maxhp","value":20},{"trigger":"combat_start","action":"gaze","value":1}],"flavor":"回程票。没有人用它回来过。"},{"id":"relic_36","name":"相石粉末","rarity":"common","veins":["mineral"],"source":"event","effect_text":"每场战斗开始时，凝视 -2。","effect_code":[{"trigger":"combat_start","action":"gaze","value":-2}],"flavor":"磨成粉的石头。记的东西太多，只好分给别人。"},{"id":"relic_37","name":"墟盐锭","rarity":"common","veins":["mineral"],"source":"event","effect_text":"每场战斗开始时，获得 8 点格挡。","effect_code":[{"trigger":"combat_start","action":"block","value":8}],"flavor":"压成锭的盐。压它的人想让它记住个形状。"},{"id":"relic_38","name":"震髓丝线","rarity":"uncommon","veins":["tremor"],"source":"event","effect_text":"每回合开始时，回复 1 点生命。","effect_code":[{"trigger":"turn_start","action":"heal","value":1}],"flavor":"丝线缝进过谁的伤口，不知道。线还在工作。"},{"id":"relic_39","name":"半张地文历","rarity":"rare","veins":["tremor"],"source":"event","effect_text":"每场战斗开始时，抽 2 张牌；每回合开始时，共振额外 +1。","effect_code":[{"trigger":"combat_start","action":"draw","value":2},{"trigger":"turn_start","action":"resonance","value":1}],"flavor":"另外半张的方向是往上。这一张只管往下。"},{"id":"relic_40","name":"抗共振司·停职令","rarity":"uncommon","veins":[],"effect_text":"每场战斗开始时，抽 2 张牌；最大生命 -4。","effect_code":[{"trigger":"combat_start","action":"draw","value":2},{"trigger":"run_start","action":"maxhp","value":-4}],"flavor":"停职期间下潜属于个人行为，后果自负。你把这句裁下来贴在了头盔里。"},{"id":"relic_41","name":"磨穿的工牌","rarity":"common","veins":["mineral"],"effect_text":"每场战斗开始时，获得 2 点格挡。","effect_code":[{"trigger":"combat_start","action":"block","value":2}],"flavor":"照片磨没了。工号还认得出来，是你前面的那一位。"},{"id":"relic_42","name":"结了盐花的壶盖","rarity":"common","veins":["water"],"effect_text":"每回合开始时，回复 1 点生命。","effect_code":[{"trigger":"turn_start","action":"heal","value":1}],"flavor":"盖子下面的水早喝完了。盐花还在接着长。"},{"id":"relic_43","name":"一根不合群的导线","rarity":"common","veins":["light"],"effect_text":"每场战斗开始时，抽 1 张牌。","effect_code":[{"trigger":"combat_start","action":"draw","value":1}],"flavor":"整束线都往左，它往右。查了三次，接线图没错。"},{"id":"relic_44","name":"静日用的耳塞","rarity":"common","veins":["tremor"],"effect_text":"每回合开始时，共振 +2。","effect_code":[{"trigger":"turn_start","action":"resonance","value":2}],"flavor":"静日专用。戴上之后，静日更静了。你数自己的心跳数到天亮。"},{"id":"relic_45","name":"缺了指针的剂量笔","rarity":"common","veins":["mineral"],"effect_text":"每场战斗开始时，获得 3 点格挡。","effect_code":[{"trigger":"combat_start","action":"block","value":3}],"flavor":"指针断了。断口旁边有人写了两个字：照旧。"},{"id":"relic_46","name":"半截红粉笔","rarity":"common","veins":["light"],"effect_text":"每场战斗开始时，凝视 +1。","effect_code":[{"trigger":"combat_start","action":"gaze","value":1}],"flavor":"划过的地方亮一晚上。亮到后来，分不清是粉笔还是岩壁。"},{"id":"relic_47","name":"一枚打不平的铆钉","rarity":"common","veins":["heat"],"effect_text":"每场战斗开始时，获得 2 点格挡。","effect_code":[{"trigger":"combat_start","action":"block","value":2}],"flavor":"打歪了，没人返工。整块板子靠它旁边的兄弟撑着。"},{"id":"relic_48","name":"对折的调岗通知","rarity":"common","veins":["water"],"effect_text":"每回合开始时，共振 +2。","effect_code":[{"trigger":"turn_start","action":"resonance","value":2}],"flavor":"对折两次刚好塞进胸袋。收件人那栏是空的。"},{"id":"relic_49","name":"渊民的骨哨","rarity":"uncommon","veins":["tremor"],"effect_text":"每场战斗开始时，凝视 +2。","effect_code":[{"trigger":"combat_start","action":"gaze","value":2}],"flavor":"吹响它的音在很深的地方。你吹出来的那部分不算数。"},{"id":"relic_50","name":"回收秤的秤砣","rarity":"uncommon","veins":["mineral"],"effect_text":"光脉牌费用 -1；每场战斗开始时，格挡 +1。","effect_code":[{"trigger":"combat_start","action":"block","value":1}],"mod":{"vein_cost":"light","vein_cost_delta":-1},"flavor":"砣上刻着准许的红线。光在它面前也要过秤。"},{"id":"relic_51","name":"接错了的水管阀门","rarity":"uncommon","veins":["water"],"effect_text":"水脉牌费用 -1；每场战斗开始时，凝视 +1。","effect_code":[{"trigger":"combat_start","action":"gaze","value":1}],"mod":{"vein_cost":"water","vein_cost_delta":-1},"flavor":"接错之后冷水管出了热水。报告写了三次，三次都被喝掉了。"},{"id":"relic_52","name":"热泉边的计时沙漏","rarity":"uncommon","veins":["heat"],"effect_text":"热脉牌费用 -1；每场战斗开始时，格挡 +2。","effect_code":[{"trigger":"combat_start","action":"block","value":2}],"mod":{"vein_cost":"heat","vein_cost_delta":-1},"flavor":"沙往上漏。翻过来，接着往上漏。"},{"id":"relic_53","name":"无声的音叉","rarity":"uncommon","veins":["tremor"],"effect_text":"震脉连携加成 +1；每场战斗开始时，格挡 +2。","effect_code":[{"trigger":"combat_start","action":"block","value":2}],"mod":{"chain_vein":"tremor","chain_bonus":1},"flavor":"敲它不出声。出声的是你手里下一张牌。"},{"id":"relic_54","name":"淬过冷水的矿灯罩","rarity":"uncommon","veins":["light"],"effect_text":"光脉连携加成 +1；每场战斗开始时，格挡 +2。","effect_code":[{"trigger":"combat_start","action":"block","value":2}],"mod":{"chain_vein":"light","chain_bonus":1},"flavor":"罩上有一道淬火纹。光经过它，排得更齐。"},{"id":"relic_55","name":"渊民的合葬结","rarity":"rare","veins":["heat"],"effect_text":"回合结束时，格挡留下一半；每场战斗开始时，格挡 +3。","effect_code":[{"trigger":"combat_start","action":"block","value":3}],"mod":{"keep_block":true},"flavor":"结打在两块布中间。少的那部分由结替你扛着。"},{"id":"relic_56","name":"批到一半的豁免章","rarity":"rare","veins":["mineral"],"effect_text":"带代价的牌，代价改写为凝视 +2；每场战斗开始时，凝视 +1。","effect_code":[{"trigger":"combat_start","action":"gaze","value":1}],"mod":{"cost_redirect":"gaze"},"flavor":"章盖到一半停了手。剩下的半张批文还在等墨。"},{"id":"relic_57","name":"倒着走的怀表","rarity":"rare","veins":["light"],"effect_text":"每回合开始时，抽 1 张牌。","effect_code":[{"trigger":"turn_start","action":"draw","value":1}],"flavor":"它倒着走，也走满了每一天。你照着它调了表。"},{"id":"relic_58","name":"收殓用的白手套","rarity":"rare","veins":["water"],"effect_text":"击杀敌人时回复 3 点生命。","effect_code":[{"trigger":"on_kill","action":"heal","value":3}],"flavor":"手套洗得很白。有些活只能戴着它干。"},{"id":"relic_59","name":"研究院的空白工牌","rarity":"rare","veins":["light"],"effect_text":"每场战斗开始时，抽 1 张牌，凝视 +1。","effect_code":[{"trigger":"combat_start","action":"draw","value":1},{"trigger":"combat_start","action":"gaze","value":1}],"flavor":"姓名栏空着。谁捡到，研究院就是谁的人。"},{"id":"relic_60","name":"墟蛹蜕下的第一层茧","rarity":"uncommon","veins":["mineral"],"effect_text":"每回合开始时，共振 +3。","effect_code":[{"trigger":"turn_start","action":"resonance","value":3}],"flavor":"茧上有一张脸的印子。印子不太像人，也不太像别的。"},{"id":"relic_61","name":"着陆点的盐钉","rarity":"common","veins":["light"],"effect_text":"每场战斗开始时，获得 4 点格挡。","effect_code":[{"trigger":"combat_start","action":"block","value":4}],"flavor":"钉是从旧返回舱外壳上起的。盐把它咬死了，撬下来费了半只手套。"},{"id":"relic_62","name":"帝星一线","rarity":"rare","veins":["light"],"effect_text":"每回合开始时，凝视 +1。","effect_code":[{"trigger":"turn_start","action":"gaze","value":1}],"flavor":"一根细线扎进石头缝里，不动。你后来才发现自己一直朝着它走。"},{"id":"relic_63","name":"历壁的拓片","rarity":"uncommon","veins":["tremor"],"effect_text":"每回合开始时，回复 1 点生命。","effect_code":[{"trigger":"turn_start","action":"heal","value":1}],"flavor":"最老那段刻痕拓下来贴在胸口。摸到它就想起有人比你有耐心得多。"},{"id":"relic_64","name":"冷洞的慢","rarity":"common","veins":[],"effect_text":"最大生命 +4。","effect_code":[{"trigger":"run_start","action":"maxhp","value":4}],"flavor":"不吃不动，几年过去。你学不来，但可以带着。"},{"id":"relic_65","name":"泉眼的滴水","rarity":"uncommon","veins":["water"],"effect_text":"每回合开始时，回复 2 点生命。","effect_code":[{"trigger":"turn_start","action":"heal","value":2}],"flavor":"水按滴记的地方，滴也是恩情。囊口塞着一种草，漏得刚好。"},{"id":"relic_66","name":"干河床的行李","rarity":"common","veins":["mineral"],"effect_text":"击败敌人后，回复 2 点生命。","effect_code":[{"trigger":"on_kill","action":"heal","value":2}],"flavor":"主人往深处去了，脚步很稳。行李里最重的那样，他没带走。"},{"id":"relic_67","name":"涌喉的客牌","rarity":"uncommon","veins":["water"],"effect_text":"每场战斗开始时，获得 5 点格挡。","effect_code":[{"trigger":"combat_start","action":"block","value":5}],"flavor":"客议会的牌子。市集里不问来路，牌子只问规矩。"},{"id":"relic_68","name":"街灯的灯芯","rarity":"rare","veins":["light"],"effect_text":"击败敌人后，回复 3 点生命。","effect_code":[{"trigger":"on_kill","action":"heal","value":3}],"flavor":"三十七盏里的一盏。灯芯换过，火种是同一个。"},{"id":"relic_69","name":"喷息的汤勺","rarity":"rare","veins":["heat"],"effect_text":"每回合开始时，共振额外 +2。","effect_code":[{"trigger":"turn_start","action":"resonance","value":2}],"flavor":"勺柄上刻着喷议会的价目。中立是明码标价的。"},{"id":"relic_70","name":"管虫的触须","rarity":"uncommon","veins":["heat"],"effect_text":"每场战斗开始时，凝视 +1。","effect_code":[{"trigger":"combat_start","action":"gaze","value":1}],"flavor":"触须在红光里微微发光。过滤硫，也过滤别的东西。"},{"id":"relic_71","name":"重金属的鳞","rarity":"uncommon","veins":["mineral"],"effect_text":"每场战斗开始时，获得 6 点格挡。","effect_code":[{"trigger":"combat_start","action":"block","value":6}],"flavor":"铅钡铋长在壳上。壳的主人活了很多年，死在别处。"},{"id":"relic_72","name":"仪表的绿光","rarity":"rare","veins":["light"],"effect_text":"每回合开始时，回复 3 点生命。","effect_code":[{"trigger":"turn_start","action":"heal","value":3}],"flavor":"全死的仪表里有一块还活着。灭之前的那一下绿光，被它记住了。"},{"id":"relic_73","name":"祭台的余温","rarity":"uncommon","veins":["heat"],"effect_text":"每场战斗开始时，获得 4 点格挡，凝视 +1。","effect_code":[{"trigger":"combat_start","action":"block","value":4},{"trigger":"combat_start","action":"gaze","value":1}],"flavor":"祭祀台上什么都没有，只有热。热穿过你，替你把多余的东西烧掉了些。"},{"id":"relic_74","name":"茧上剥落的","rarity":"rare","veins":["tremor"],"effect_text":"每场战斗开始时，抽 2 张牌。","effect_code":[{"trigger":"combat_start","action":"draw","value":2}],"flavor":"从茧上剥落的一片。上面的纹路不是刻的，是自己长出来的。它还在长。"},{"id":"relic_75","name":"账本上的一页","rarity":"uncommon","veins":[],"effect_text":"最大生命 +3。","effect_code":[{"trigger":"run_start","action":"maxhp","value":3}],"flavor":"八万年没人翻的账本翻到了新的一页。页码是你。"},{"id":"relic_76","name":"透的影子","rarity":"rare","veins":["heat"],"effect_text":"每场战斗开始时，获得 3 点格挡；每回合开始时，回复 2 点生命。","effect_code":[{"trigger":"combat_start","action":"block","value":3},{"trigger":"turn_start","action":"heal","value":2}],"flavor":"红光把影子照透了。透的那部分跟着你走，厚的部分留在了原地。"},{"id":"relic_77","name":"泉权的账戳","rarity":"rare","veins":["water"],"eco":"eco_arid","effect_text":"开战时格挡 +3。水脉牌的费用 -1——干旱带的规程也认这个印。","effect_code":[{"trigger":"combat_start","action":"block","value":3}],"mod":{"vein_cost":"water","vein_cost_delta":-1},"flavor":"泉权的印，往水牌上一戳。路是它的，水也记它的账。"}],"events":[{"id":"event_d2_1","layer":2,"title":"矿道口的碎石","body":"矿道口的碎石是新搬开的，搬的人不在这里。石缝里卡着半截手套。","options":[{"text":"搬开碎石，进去看看。","veins":["mineral"],"result":{"gold":40,"damage":5},"result_text":"石头后面有一小袋矿票。搬最后一块的时候，石头动了，你的手慢了半步。"},{"text":"贴着岩壁，听里面的动静。","veins":["tremor"],"result":{"card_reward":"uncommon"},"result_text":"里面的东西搬完了才走，走得很急。装备架上还挂着一件。"},{"text":"绕开。","veins":[],"result":{},"result_text":"碎石是别人的，路也是别人的。你走你的。"}]},{"id":"event_d2_2","layer":2,"title":"会自己开关的矿灯","body":"矿灯在无人处亮起又熄灭，间隔很稳。值班表上有它的名字，没有人的。","options":[{"text":"站进光里，等它熄。","veins":["light"],"result":{"gaze":1,"heal":10},"result_text":"光在你身上停了一会儿，从头到脚。停完，它自己熄了。"},{"text":"拆下电池。","veins":["mineral"],"result":{"gold":30},"result_text":"电池是满的。灯灭了以后，走廊比刚才长了一截。"},{"text":"关掉自己的头灯走过去。","veins":[],"result":{},"result_text":"你走近，它不亮。你走远，它亮了。你们错开了。"}]},{"id":"event_d3_1","layer":3,"title":"穿防护服的遗体","body":"防护服是完整的。面罩内侧有字，笔迹很稳。这里没有风，字还在。","options":[{"text":"读面罩内侧的字。","veins":["light"],"result":{"gaze":1,"card_reward":"uncommon"},"result_text":"字只有四个：别信信号。落款的日期是今天的。他的工具归你了。"},{"text":"解下他的装备。","veins":["mineral"],"result":{"gold":50,"gaze":1},"result_text":"装备保养得很好，扣具都扣到最后一格。他到最后都在守规矩。"},{"text":"把他安顿好。","veins":[],"result":{},"result_text":"你搬不动石头，只把他的面罩转向岩壁。风声过不去，这样就听不见了。"}]},{"id":"event_d3_2","layer":3,"title":"一池不流动的水","body":"水面平得像结了蜡，水很清。池底还有一层水在动，方向朝下。","options":[{"text":"喝一口上层的水。","veins":["water"],"result":{"heal":12,"gaze":1},"result_text":"上层的水是甜的。它记得的东西比下面少。"},{"text":"潜下去看第二层。","veins":["water","tremor"],"result":{"damage":6,"card_reward":"rare"},"result_text":"第二层的水往下跌。你回来的时候手里多了东西，肺里也是。"},{"text":"绕开走。","veins":[],"result":{},"result_text":"水面在你背后合拢。没有声音。"}]},{"id":"event_d4_1","layer":4,"title":"渊民的埋骨布","body":"埋骨布摊在洞壁的凹处，四角用石头压着。布是空的，摆得很郑重。","options":[{"text":"按渊民的规矩，添一块石头。","veins":["tremor"],"result":{"gaze":-1,"heal":8},"result_text":"你不知道步子对不对。你放下石头，布动了一下。"},{"text":"收走压布的石头，它们是磨光的。","veins":["mineral"],"result":{"gold":35,"gaze":2},"result_text":"石头下面什么都没有。你收石头的时候，手一直在抖。"},{"text":"原样离开。","veins":[],"result":{},"result_text":"你从布的下风处走，没有惊动它。"}]},{"id":"event_d4_2","layer":4,"title":"烧过又长回来的红蕨","body":"这片红蕨烧过，灰还在根上。新叶从灰里长出来，比别处的红。","options":[{"text":"掐一片新叶含着。","veins":["heat"],"result":{"heal":15},"result_text":"新叶是苦的。苦完了，胸口暖了很久。"},{"text":"挖走一段根。","veins":["mineral"],"result":{"card_reward":"uncommon","damage":4},"result_text":"根断的时候，整片蕨缩了一下。你挖得很快。"},{"text":"记下位置，走开。","veins":[],"result":{},"result_text":"火还会再来。蕨不搬家。"}]},{"id":"event_d5_1","layer":5,"title":"静日里响起的震语","body":"静日。整条裂带都安静。岩层深处有一句震语在重复，不在节日的名录里。","options":[{"text":"回它一句。","veins":["tremor"],"result":{"gaze":2,"card_reward":"rare"},"result_text":"你用错了两个音。它纠正了你，然后教了你第三句。"},{"text":"顺着声源找过去。","veins":["heat"],"result":{"damage":8,"gold":45},"result_text":"声源是一口正在收口的热泉。泉眼里卡着上一批人的装备。"},{"text":"按住耳朵走过去。","veins":[],"result":{},"result_text":"静日不该听。你走远了才把手放下来。"}]},{"id":"event_d5_2","layer":5,"title":"反应堆城的废弃管道","body":"管道从上层的方向垂下来，端口朝天。每隔一阵漏出一口热气，间隔是你的呼吸频率。","options":[{"text":"把手伸进端口。","veins":["heat"],"result":{"damage":5,"gold":40},"result_text":"里面卡着一段没送完的补给。热气烫了手背，不深。"},{"text":"贴着管壁，听上面的动静。","veins":["tremor"],"result":{"heal":10},"result_text":"上面有人在走动，不止一个。他们不知道这根管子通到哪里。"},{"text":"封住端口。","veins":[],"result":{},"result_text":"你用碎石把口堵上。漏气声小了很多，你没有再听。"}]},{"id":"event_d6_1","layer":6,"title":"一块有字的相石","body":"相石躺在辐射矿的碎堆里，光纹没灭。字不是刻的，是长在里面的。","options":[{"text":"读它。","veins":["light"],"result":{"gaze":2,"card_reward":"uncommon"},"result_text":"字记的是很久以前的一次塌方。名单末尾空着一行，现在写上了你的。"},{"text":"把它卖个好价钱。","veins":["mineral"],"result":{"gold":60,"gaze":1},"result_text":"收货的人没有看第二眼。他知道这批货流向哪里。"},{"text":"放回原处。","veins":[],"result":{},"result_text":"你把它按原来的朝向摆好。光纹灭了一瞬，又亮了。"}]},{"id":"event_d6_2","layer":6,"title":"别人的营地","body":"营地收拾得很整齐，毯子叠好了，炉子是冷的。人是自己走的，走得从容。","options":[{"text":"补给照单全收。","veins":["mineral"],"result":{"gold":45,"heal":6},"result_text":"干粮还有大半。水是苦的，他喝惯了，你也喝得惯。"},{"text":"读炉边的日志。","veins":["water"],"result":{"card_reward":"common","gaze":1},"result_text":"最后一天写着：往下走比往上走安全。这一行被划掉过，又描了一遍。"},{"text":"替他把炉灰埋了。","veins":[],"result":{},"result_text":"你替他把炉灰埋了。按规矩，这样的营地不算被抛弃。"}]},{"id":"event_d7_1","layer":7,"title":"震台上的旧刻痕","body":"一座塌了半边的震台，石面刻着历法。刻到很深的地方，笔画还稳。","options":[{"text":"辨认最后几个刻痕。","veins":["tremor"],"result":{"gaze":1,"heal":12},"result_text":"最后刻的是一句完整的话。你读完，牙不麻了，耳朵一直热。"},{"text":"拓一段带走。","veins":["light"],"result":{"card_reward":"uncommon"},"result_text":"拓片上多了一行石面上没有的字。你没有细看。"},{"text":"不碰石面。","veins":[],"result":{},"result_text":"刻痕比你早到了很多年。不缺你这一眼。"}]},{"id":"event_d7_2","layer":7,"title":"还在转的旧光者自动门","body":"自动门在没有电的走廊里开合，间隔很稳。门轴没有声音，走廊里的灰却一直让开。","options":[{"text":"在门开的时候穿过去。","veins":["light"],"result":{"gaze":2,"gold":50},"result_text":"门后是间办公室。抽屉里的东西按日期排好，最后一天的日期是明天。"},{"text":"站在门缝里，让它夹一下。","veins":["heat"],"result":{"damage":6,"card_reward":"rare"},"result_text":"门停了。它第一次没有按间隔开合。它给你让了路。"},{"text":"学它的节奏，站着等。","veins":[],"result":{},"result_text":"你陪它开了几轮。你走的时候，它多开了一次。"}]},{"id":"event_d2_3","layer":2,"title":"别的下潜者","body":"有个人背靠岩壁坐着。防护服胸口的公司标志被涂掉了，涂得很用力。他抬手，示意你小声。","options":[{"text":"分他一半水。","veins":["water"],"result":{"heal":8},"result_text":"他喝得很慢。喝完，指了一条避开渗水线的路。"},{"text":"问他在躲什么。","veins":["tremor"],"result":{"gaze":1,"gold":30},"result_text":"他说的东西你听不懂。他指的方向你用得上。"},{"text":"装作没看见。","veins":[],"result":{},"result_text":"你走过去的时候，他把自己的灯关了。"}]},{"id":"event_d2_4","layer":2,"title":"一条被堵住的近路","body":"塌下来的岩块卡在通道里，缝隙后面有风。风是暖的。这一层不该有暖风。","options":[{"text":"挤过去。","veins":["mineral"],"result":{"damage":5,"card_reward":"uncommon"},"result_text":"缝隙比你估的窄。出来的时候背包轻了一点，手里多了一点。"},{"text":"听风的节奏。","veins":["tremor"],"result":{"heal":6},"result_text":"风每十九息一次，很稳。你靠着缝隙缓了一会儿。"},{"text":"原路走。","veins":[],"result":{},"result_text":"近路是别人的。你走你的。"}]},{"id":"event_d3_3","layer":3,"title":"一只快死的生物","body":"一条干旱肺鱼侧躺在干泥上，鳃盖开合的间隔越来越长。它的洞就在两步外。","options":[{"text":"把它送回水囊里。","veins":["water"],"result":{"heal":10,"gaze":-1},"result_text":"它滑回水囊，用尾巴拍了一下水。就一下。"},{"text":"看看它的洞。","veins":["mineral"],"result":{"gold":35},"result_text":"洞里垫着一层磨圆的碎石。你拿走了最亮的几颗。"},{"text":"别碰它。","veins":[],"result":{},"result_text":"干掉的东西自己知道时候。你让开了它的路。"}]},{"id":"event_d3_4","layer":3,"title":"有人留下的警告","body":"岩壁上用矿粉喷着一行字：别数脚步声。下面还有半句，被水渍泡掉了。","options":[{"text":"补齐剩下的半句。","veins":["tremor"],"result":{"gaze":1,"card_reward":"common"},"result_text":"你按自己的理解补了半句。写完发现，两段字迹是一样的。"},{"text":"把警告擦掉。","veins":["mineral"],"result":{"gold":25},"result_text":"矿粉收起来还能用。墙干净了，也错了。"},{"text":"不数就不数。","veins":[],"result":{},"result_text":"你哼着歌走完那一段。跑调，但有用。"}]},{"id":"event_d4_3","layer":4,"title":"渊民的仪式现场","body":"洞壁下摆着一圈白石头，沙地上画着五个符号。火刚熄，灰是温的。","options":[{"text":"按渊民的礼数绕一圈。","veins":["tremor"],"result":{"gaze":-2,"heal":8},"result_text":"你按礼数绕了一圈。走过第三个符号的时候，沙地亮了一下。"},{"text":"收走白石头。","veins":["mineral"],"result":{"gold":40,"gaze":2},"result_text":"白石头是墟盐结晶。有人的祭品变成了你的路费。"},{"text":"从圈外走。","veins":[],"result":{},"result_text":"你没有跨进去。这一圈不缺人。"}]},{"id":"event_d4_4","layer":4,"title":"呼吸的节奏","body":"你在洞里站了一分钟，呼吸慢了下来，和气流对上了。对上之后，肺不用你管了。","options":[{"text":"顺着这个节奏走。","veins":["light"],"result":{"heal":12,"gaze":1},"result_text":"你顺着它走了很久。肺不疼了。疼的地方换了一个，说不清在哪。"},{"text":"打破它。","veins":["heat"],"result":{"damage":4,"card_reward":"uncommon"},"result_text":"你猛吸一口气。气流散了，在别处重新聚起来，聚得比刚才慢。"},{"text":"站着别动。","veins":[],"result":{},"result_text":"它先散的。你后走的。"}]},{"id":"event_d5_3","layer":5,"title":"净化者的圣火堆","body":"圣火堆烧得很旺，围火坐过的人一个都不在。灰是白的，火不肯灭。","options":[{"text":"把手伸进火里。","veins":["heat"],"result":{"damage":6,"card_reward":"rare"},"result_text":"火烧穿了你的一部分。拿走的部分没还，还回来的部分更好用。"},{"text":"加一把燃料。","veins":["mineral"],"result":{"gaze":1,"heal":10},"result_text":"火收下了燃料，烧得更旺。暖意漫过来。你欠了它一次。"},{"text":"绕开火堆。","veins":[],"result":{},"result_text":"白灰在你身后扬了一下。风的问题。应该是。"}]},{"id":"event_d5_4","layer":5,"title":"还在工作的旧光者设备","body":"一台仪表嵌在岩壁里，屏幕每隔几秒跳一次。数字一直在变小。没有人给它供电。","options":[{"text":"等它数到零。","veins":["light"],"result":{"gaze":2,"card_reward":"uncommon"},"result_text":"还差很远。但你等到了它跳的那一下：数字旁边多了三个字，是你来的方向。"},{"text":"拆走能源块。","veins":["mineral"],"result":{"gold":50},"result_text":"屏幕黑了。数字停在很大的地方。走廊里安静了一格。"},{"text":"把数字记住，走。","veins":[],"result":{},"result_text":"你把数字记下来了。纸条上多了一道折痕，不是你折的。"}]},{"id":"event_d6_3","layer":6,"title":"往深处去的人","body":"那个人穿着制式防护服，动作像穿着一件很旧的衣服。他点了点头，没说话，把一块相石推到你脚边。","options":[{"text":"推回去。","veins":["tremor"],"result":{"gaze":-1,"heal":8},"result_text":"他笑了。你们谁都没说话。协议签好了。"},{"text":"收下相石。","veins":["mineral"],"result":{"card_reward":"uncommon","gaze":1},"result_text":"石头是温的。他转身往深处走。深处不是这个方向。"},{"text":"站在原地。","veins":[],"result":{},"result_text":"他先走的。你记住了他站的位置。那个位置后来一直空着。"}]},{"id":"event_d6_4","layer":6,"title":"深层的回声","body":"你对着竖井喊了一声。回来两个声音：一个是你的。另一个慢半拍，学得很像。","options":[{"text":"再喊一声。","veins":["tremor"],"result":{"gaze":1,"gold":40},"result_text":"第二次它先喊了。你顺着它的方向摸到一个补给点。落了灰的货架上没有脚印。"},{"text":"保持安静。","veins":["water"],"result":{"heal":6},"result_text":"你咽了口口水。回声也咽了。它比你多咽了一声。"},{"text":"捂住耳朵走。","veins":[],"result":{},"result_text":"你走你的，它学它的。谁也不欠谁。"}]},{"id":"event_d7_3","layer":7,"title":"震台上的新刻痕","body":"刻痕是新的，边缘还挂着石粉。记的是日期，用的是殖民历。日期是三天后。","options":[{"text":"在旁边刻下自己的日期。","veins":["tremor"],"result":{"gaze":2,"card_reward":"rare"},"result_text":"你刻完才发现，两行字是同一种笔迹。不是你的。"},{"text":"把石粉带走。","veins":["mineral"],"result":{"gold":35},"result_text":"石粉是很好的引子。刻字的人不在乎，他要刻的是未来。"},{"text":"别碰。","veins":[],"result":{},"result_text":"三天后你会想回来读这里。现在你只想走。"}]},{"id":"event_d7_4","layer":7,"title":"门后什么都没有","body":"门是旧光者样式的，感应很灵。门后是间空屋，墙面很新。屋中间有一把椅子。","options":[{"text":"坐进椅子。","veins":["light"],"result":{"gaze":2,"heal":15},"result_text":"椅子按你的坐姿调整了三次。它记得上一个人的姿势，顺手修正了你的。"},{"text":"拆门上的感应器。","veins":["mineral"],"result":{"gold":55,"damage":4},"result_text":"感应器拆下来的时候叫了一声，很短。那扇门从那以后没再开过。"},{"text":"帮门带上。","veins":[],"result":{},"result_text":"你出去的时候帮它把门带上。它开了半下。"}]},{"id":"event_d2_5","layer":2,"title":"一排还在出风的更衣柜","body":"更衣柜嵌在岩壁里，柜门上有编号。其中一格在出风，风是别人的呼吸节奏。","options":[{"text":"打开出风的那格。","veins":["mineral"],"result":{"gold":35,"damage":4},"result_text":"里面是半罐氧气和一张调岗单。罐是满的，单是空的。"},{"text":"把所有柜门都关严。","veins":["tremor"],"result":{"heal":8},"result_text":"风停了。走廊安静下来，安静得像有人道了谢。"},{"text":"不碰。","veins":[],"result":{},"result_text":"你走过去之后，出风的那格换了位置。"}]},{"id":"event_d2_6","layer":2,"title":"有人画在地上的箭头","body":"矿粉画的箭头指向下层，笔画很稳。箭头旁边写着两个字：快走。","options":[{"text":"顺着箭头走。","veins":["mineral"],"result":{"gold":30},"result_text":"箭头把你带到一处干燥的岔口。写箭头的人留下的火堆还剩一点余温。"},{"text":"反着走。","veins":["tremor"],"result":{"damage":5,"card_reward":"uncommon"},"result_text":"反方向的路塌了一半。你从缝里挤过去，东西还在，手破了。"},{"text":"原地休息。","veins":[],"result":{"heal":6},"result_text":"你靠着箭头坐了一会儿。字迹在你的余光里换了方向。"}]},{"id":"event_d3_5","layer":3,"title":"一口倒在旱地的井","body":"井圈完好，井绳是新换的。井里没有水，只有一层很细的沙在往下漏。","options":[{"text":"顺着井绳下去。","veins":["water"],"result":{"damage":6,"card_reward":"uncommon"},"result_text":"井底有一间干房。东西都在，人走的时候把水留在了这里。"},{"text":"收集漏下来的沙。","veins":["mineral"],"result":{"gold":40},"result_text":"沙在瓶子里继续漏。瓶子永远漏不满。收货的人就认这个。"},{"text":"把井绳卷走。","veins":[],"result":{},"result_text":"绳比看上去长。你卷到第三圈就停手了，够用就行。"}]},{"id":"event_d3_6","layer":3,"title":"一面会长字的墙","body":"岩壁上浮出很浅的字，一层一层叠着。最新的字还没干，记的是你脚步的节奏。","options":[{"text":"把最上面一层抹掉。","veins":["water"],"result":{"gaze":-1,"heal":8},"result_text":"字没了，墙面平了。你的脚步声轻了一点。"},{"text":"往下读旧的一层。","veins":["light"],"result":{"gaze":1,"card_reward":"common"},"result_text":"旧字是上一批人的对话。有一句是回你的，你确定你还没说过。"},{"text":"背对着墙走。","veins":[],"result":{},"result_text":"你没看。字在你背后写完了，笔画声很轻。"}]},{"id":"event_d4_5","layer":4,"title":"泡在光池里的补给箱","body":"补给箱沉在光池边缘，箱体发着很淡的光。锁是开的。里面的亮和池水的亮不是一种。","options":[{"text":"把手伸进光里拿。","veins":["light"],"result":{"gold":45,"gaze":1},"result_text":"东西到手了。你的手在暗中会亮一小会儿，一星期左右。"},{"text":"用杆子把箱子挑翻。","veins":["mineral"],"result":{"gold":25,"damage":3},"result_text":"箱子翻在池外，亮的东西散了一地。有几件在你脚下熄了。"},{"text":"把箱子按回水里。","veins":[],"result":{},"result_text":"它沉下去的时候光稳了。池边安静得像什么都没发生过。"}]},{"id":"event_d4_6","layer":4,"title":"一副没人接的耳机","body":"耳机挂在石笋上，线的另一头埋进岩层。耳机里有很轻的呼吸声，两个人份的。","options":[{"text":"戴上听。","veins":["tremor"],"result":{"gaze":1,"heal":6},"result_text":"他们聊的是明天的排班。明天在这里是很久以前的事。"},{"text":"对着线说话。","veins":["light"],"result":{"card_reward":"uncommon"},"result_text":"你说完，那边静了一会儿。然后有人替你把没说完的半句补上了。"},{"text":"把线剪断。","veins":[],"result":{"gold":20},"result_text":"线头里的金属卖了钱。呼吸声停在你剪断的那一拍。"}]},{"id":"event_d5_6","layer":5,"title":"一排朝下喷的热泉眼","body":"热泉从洞顶往下喷，落点围成一个圈。圈里的地面是凉的，圈外是烫的。","options":[{"text":"站进圈里。","veins":["heat"],"result":{"heal":12,"gaze":1},"result_text":"热落在你四周，不落在你身上。圈给你留着位置。"},{"text":"在圈外的烫地上找东西。","veins":["mineral"],"result":{"damage":6,"gold":50},"result_text":"烫地上有前人掉的补给袋。东西捡齐了，鞋底薄了一层。"},{"text":"把圈用碎石填了。","veins":[],"result":{},"result_text":"你填完就走。身后泉眼换了个地方，重新围了一个圈。"}]},{"id":"event_d5_7","layer":5,"title":"写满排班表的白板","body":"白板挂在裂带的岩壁上，排班表写到了第 41 天。擦过很多次的字痕叠成了灰色。","options":[{"text":"在第 42 天写上自己的名字。","veins":["tremor"],"result":{"gaze":1,"gold":35},"result_text":"字迹落上去的一瞬，整块板的旧字都深了一度。有人接了你的班。"},{"text":"把整块板擦干净。","veins":["heat"],"result":{"heal":10},"result_text":"擦完之后你喘匀了气。板面干净得像没有人来过，包括你。"},{"text":"抄下第 41 天的安排。","veins":[],"result":{"card_reward":"common"},"result_text":"那天的安排只有一行：交给人字底的。你低头看了看自己脚下。"}]},{"id":"event_d6_5","layer":6,"title":"剂量表挂在走廊正中","body":"表盘的指针朝下，超了量程。有人用记号笔在表盘上补了一个新的刻度，标着你的方向。","options":[{"text":"把指针掰回来。","veins":["mineral"],"result":{"gold":40,"damage":4},"result_text":"指针断了。走廊的读数恢复了正常，是坏的那种正常。"},{"text":"照补上的刻度走。","veins":["light"],"result":{"gaze":1,"card_reward":"uncommon"},"result_text":"那条路比剂量表上任何一格都深。走完之后，表盘安静了。"},{"text":"把表摘下来带走。","veins":[],"result":{},"result_text":"表在你包里继续走针。你不再看它，它也不再看你。"}]},{"id":"event_d6_6","layer":6,"title":"一台还在广播的收音机","body":"收音机用电池点着，播的是上层的晨间节目。杂音里夹着一句很近的话：收到请回复。","options":[{"text":"回复。","veins":["tremor"],"result":{"gaze":2,"gold":30},"result_text":"你说：收到。节目正常播完。你听见了笔尖在纸上记了什么。"},{"text":"拆电池。","veins":["mineral"],"result":{"gold":45},"result_text":"节目停在半句歌上。电池还很足，你装进了口袋。"},{"text":"调大杂音。","veins":[],"result":{"heal":6},"result_text":"杂音盖住了那句话。你靠着收音机歇了一会儿，像靠着人。"}]},{"id":"event_d7_5","layer":7,"title":"一段循环播放的告别","body":"岩层里有一句震语在循环，音色很旧。翻译过来是：我先走了，别数我走了多久。","options":[{"text":"跟着念一遍。","veins":["tremor"],"result":{"gaze":2,"heal":10},"result_text":"你念完，循环停了。岩层把这句还给了你，用你的音色。"},{"text":"把循环记进历法。","veins":["light"],"result":{"card_reward":"uncommon"},"result_text":"你记下了它的周期。往后的每一天，这个时刻它都会准时安静。"},{"text":"等它自己停下来。","veins":[],"result":{},"result_text":"你等了很久。它没停，你先走了。这不算数。"}]},{"id":"event_d7_6","layer":7,"title":"一间反着装修的宿舍","body":"宿舍的床在天花板上，桌子朝下，杯子倒扣着装满了水。有人在这里倒着生活过很久。","options":[{"text":"在倒着的床上躺一会儿。","veins":["tremor"],"result":{"heal":14},"result_text":"重力在你躺下之后迟疑了一下。你睡得很沉，没有做梦。"},{"text":"把倒着的杯子扶正。","veins":["water"],"result":{"damage":4,"card_reward":"uncommon"},"result_text":"水洒了。房间不喜欢被纠正，墙纸皱了一下眉。"},{"text":"带走倒扣的杯子。","veins":["mineral"],"result":{"gold":30},"result_text":"杯子在你包里一直没干。有人问起，你就说是露水。"}]},{"id":"event_d2_7","layer":2,"title":"横在矿道里的安全绳","body":"一条安全绳横过矿道，两端钉死。绳子中段磨得发亮，亮的地方离地三尺。","options":[{"text":"解下绳子。","veins":["mineral"],"result":{"gold":30,"damage":3},"result_text":"绳子收了十米。钉子留着的四个孔排成一条线，指向上层。"},{"text":"蹲下，从绳子下面过。","veins":["tremor"],"result":{"heal":6},"result_text":"你从绳子下面过去了。绳子晃了几下，替你数了步数。"},{"text":"原样走开。","veins":[],"result":{},"result_text":"亮处又磨亮了一分。这条路有人常走。"}]},{"id":"event_d3_7","layer":3,"title":"倒扣的采矿钻","body":"采矿钻倒扣在碎岩上，钻头朝天。机身还温着，温度和你的手心一样。","options":[{"text":"拆走钻头。","veins":["mineral"],"result":{"damage":4,"card_reward":"uncommon"},"result_text":"钻头比看上去沉。你拖走它的时候，碎岩往塌的方向多滚了一些。"},{"text":"顺着温的方向摸。","veins":["tremor"],"result":{"heal":8,"gaze":1},"result_text":"温的来源不是钻。钻只是搭在这上面的一件东西。"},{"text":"让它保持原样。","veins":[],"result":{},"result_text":"你把被你碰歪的碎石摆了回去。摆完之后，温度没有变。"}]},{"id":"event_d4_7","layer":4,"title":"会还话的亮墙","body":"光池边的岩壁会把你刚说过的话还给你，隔一拍。还回来的语气更平静。","options":[{"text":"对它说一句真话。","veins":["light"],"result":{"gaze":2,"card_reward":"common"},"result_text":"你说了。它还回来的时候，删掉了你撒谎的那半句。"},{"text":"对它喊。","veins":["heat"],"result":{"damage":5,"gold":35},"result_text":"墙震落了一层光苔。苔下面贴着前人塞的钱。"},{"text":"沉默。","veins":[],"result":{},"result_text":"你不说，它也不还。你们对峙到火把矮了一截。"}]},{"id":"event_d5_8","layer":5,"title":"还在计时的高压锅","body":"裂带深处有一口老式高压锅，阀每隔七息放一次气。锅盖上摆着一只倒空的碗。","options":[{"text":"等它放完第七次气。","veins":["heat"],"result":{"heal":10,"gaze":1},"result_text":"第七次放气之后，阀没有再落回去。锅里的东西熟了，愿意分你一半。"},{"text":"拿走倒扣的碗。","veins":["mineral"],"result":{"gold":40},"result_text":"碗底刻着字：借碗要还。你把钱压在了锅盖上。"},{"text":"把阀拧死。","veins":[],"result":{},"result_text":"气声停了。你走出很远，锅才想起来继续响。"}]},{"id":"event_d6_7","layer":6,"title":"没拆封的辐射药","body":"铅盒里躺着三支辐射药，封条完好。盒盖内侧用指甲划了很多道，每五道一组，划到第三组。","options":[{"text":"打一针试试。","veins":["light"],"result":{"heal":15,"damage":5},"result_text":"药是真的。疼也是真的。疼过之后，你数铅盒的方式变了。"},{"text":"整盒卖掉。","veins":["mineral"],"result":{"gold":55},"result_text":"收药的人没验封条。他数了三遍钱，一遍比一遍快。"},{"text":"把铅盒留在原处。","veins":[],"result":{},"result_text":"你把盒盖按原样扣好。第三组划痕停在第十四道。"}]},{"id":"event_d7_7","layer":7,"title":"没有观众的演出","body":"震台上摆着一排小石子，按音高排开。有人刚敲过它们，敲的顺序记在旁边的石板上。","options":[{"text":"按石板敲一遍。","veins":["tremor"],"result":{"damage":4,"card_reward":"rare"},"result_text":"你敲错了一个音。错的那一下把整段补完了，补法比原谱好。"},{"text":"把石子收进口袋。","veins":["mineral"],"result":{"gold":40},"result_text":"石子在你包里互相碰，碰出来的还是那段音。"},{"text":"按自己的顺序敲。","veins":["light"],"result":{"gaze":1},"result_text":"台子听完了，把你的顺序记在了石板背面。"}]},{"id":"event_d2_8","layer":2,"title":"一盏埋进苔里的矿灯","body":"矿灯半埋在苔丛里，灯罩朝下。苔绕开了灯罩的位置，绕得很圆。","options":[{"text":"把灯挖出来。","veins":["light"],"result":{"card_reward":"common","gaze":1},"result_text":"灯还亮。苔在你把灯抱起来之后，慢慢把那个圆填上了。"},{"text":"就着灯光歇一会儿。","veins":["water"],"result":{"heal":8},"result_text":"灯光圈刚好够坐两个人。另一个位置一直空着，不凉。"},{"text":"把灯罩拧下来带走。","veins":["mineral"],"result":{"gold":25},"result_text":"灯罩比灯值钱。苔在你收手的瞬间围拢了。"}]},{"id":"event_d3_8","layer":3,"title":"画在岩壁上的宿舍平面图","body":"有人把宿舍的布局画在岩壁上，床铺桌椅都有编号。图的角落写着：这样就能记住家了。","options":[{"text":"把图拓下来。","veins":["light"],"result":{"card_reward":"uncommon"},"result_text":"拓片上多了一间图上没有的屋子。门的位置画得很仔细。"},{"text":"在图上加一件你的东西。","veins":["tremor"],"result":{"heal":10},"result_text":"你画了一把椅子。画完之后，这一层不再像路过。"},{"text":"不添东西。","veins":[],"result":{},"result_text":"你怕它认下来。有些图沾了东西就会开始等人。"}]},{"id":"event_d4_8","layer":4,"title":"浮在光池上的一封信","body":"信封浮在光池正中，不沉，也不漂走。信封上没有收件人，封口用的是红渊的火漆。","options":[{"text":"捞上来读。","veins":["water"],"result":{"gaze":2,"card_reward":"uncommon"},"result_text":"信只有一行：别找我。落款的日期你认得，是明天。"},{"text":"把它按进水里。","veins":["heat"],"result":{"damage":4},"result_text":"信沉了。光池亮了一下，像清点完一件寄存的行李。"},{"text":"替它拆掉火漆。","veins":[],"result":{"gold":30},"result_text":"火漆是空心的，里面封着一小粒金。信纸你自己没看。"}]},{"id":"event_d5_9","layer":5,"title":"一道自己拐弯的蒸汽","body":"管道裂口的蒸汽本该直冲，却在半途拐了个弯，绕开你常站的那个位置。","options":[{"text":"站进蒸汽里。","veins":["heat"],"result":{"damage":6,"card_reward":"rare"},"result_text":"烫意穿身而过，没留下伤。蒸汽记性不好，认错了一次人。"},{"text":"研究它拐弯的轨迹。","veins":["tremor"],"result":{"heal":8},"result_text":"轨迹画出来是一个人抬手挡东西的形状。你照着练了一会儿。"},{"text":"把裂口封上。","veins":[],"result":{},"result_text":"你封得很快。封完之后，那个位置空得很大。"}]},{"id":"event_d6_8","layer":6,"title":"一墙贴到天花板的剂量条","body":"走廊两侧贴满剂量条，从脚底贴到顶。每一条都黄了，只有齐腰高的那一排还是白的。","options":[{"text":"读齐腰那排的日期。","veins":["light"],"result":{"gaze":1,"gold":30},"result_text":"白条记的日期是连续的，间隔十二小时。有人在这里值过很久的班。"},{"text":"撕下最黄的一条。","veins":["mineral"],"result":{"gold":45,"damage":3},"result_text":"黄得最透的那条背后粘着一枚旧币。你的指尖麻了一下。"},{"text":"补一条自己的。","veins":[],"result":{"heal":6},"result_text":"你把新条贴在白排的末尾。贴完之后，那排还是白的。"}]},{"id":"event_d7_8","layer":7,"title":"一个正在自我删除的日志","body":"旧光者的日志悬浮在台面上，行数每隔几息少一行。删到中途会停一下，像在犹豫。","options":[{"text":"赶在删除前读。","veins":["light"],"result":{"card_reward":"uncommon","gaze":1},"result_text":"你读到三行。第二行是你的名字，写法和你自己写的习惯一样。"},{"text":"按住删除键。","veins":["tremor"],"result":{"heal":12},"result_text":"删除停了。日志安安静静地写完，写的是一件很小的喜事。"},{"text":"替它把剩下的抄下来。","veins":["water"],"result":{"gold":35},"result_text":"你抄得比删得快。抄完的最后一句是：谢谢你，不管你是谁。"}]},{"id":"event_d1_1","layer":1,"title":"降落的旧舱","body":"登陆基地外围有一只废弃的返回舱，舱门半开，气闸的灯还亮着一格。八百年了，那一格没灭。","options":[{"text":"钻进去翻物资。","veins":["mineral"],"result":{"gold":45,"damage":3},"result_text":"舱里的储物箱码得很整齐，翻到最后一样的时候，割破的手套在真空边缘渗出血珠。血珠是圆的，滚走了。"},{"text":"把氧气罐留给下一个人。","veins":["water"],"result":{"heal":10},"result_text":"舱里的人早就走了，走之前把水壶挂在门边。壶是满的。你替他把壶又挂正了一点。"},{"text":"走开。","veins":[],"result":{},"result_text":"舱皮在热胀冷缩，一声一声，像有人在敲。这里没有风，你把这件事记成了风。"}]},{"id":"event_d1_2","layer":1,"title":"帝星的影子","body":"站在裂隙边能看到帝星，很小，很亮。这里没有大气，它的光不散，是一根细线，直直扎进石头缝里。","options":[{"text":"对着光站一会儿。","veins":["light"],"result":{"gaze":1,"heal":5},"result_text":"帝星不管这里。看它一会儿，是为了记得上面还有别的东西。"},{"text":"顺着裂隙往下听。","veins":["tremor"],"result":{"card_reward":"common"},"result_text":"裂隙把地底的震动送上来一丝。你听懂了半句：更深的地方，有东西活着。"},{"text":"盖上石板。","veins":[],"result":{},"result_text":"光被关在外面。这种黑和闭上眼不一样——闭上眼是自己愿意的。"}]},{"id":"event_d1_3","layer":1,"title":"休眠的孢子","body":"陨击坑的阴影里积着一层粉末，是耐辐射的休眠孢子。它们在等一个不是这里的地方，等了几万年。","options":[{"text":"带一撮下去。","veins":["mineral"],"result":{"card_reward":"uncommon"},"result_text":"你把孢子扫进空罐。它们不响也不动。带它们下去的人很多，带它们活着下去的人很少。"},{"text":"绕开，别踩。","veins":[],"result":{"heal":6},"result_text":"有些等待与你无关。你把脚印收轻了。"},{"text":"用靴子碾过去。","veins":["heat"],"result":{"gold":30,"damage":6},"result_text":"粉末溅起来又落下，一点声音也没有。靴底缝里嵌进一点发亮的东西，抠不出来。"}]},{"id":"event_d2_9","layer":2,"title":"刻在岩壁上的历","body":"一面岩壁刻满细密的刻痕，深浅不一，最老的那些被菌膜盖住一半。是记忆者的历，记到上一次大塌为止。","options":[{"text":"把最新的一道补上。","veins":["tremor"],"result":{"card_reward":"uncommon"},"result_text":"你不知道今天算什么日子，就照着手感刻了一道。刻完才发现岩壁是温的。"},{"text":"抄下最老的一段。","veins":["mineral"],"result":{"gold":25,"gaze":1},"result_text":"有几段刻痕的意思已经没人认得。抄下来的东西也许值钱，也许只是重。"},{"text":"什么都不刻。","veins":[],"result":{},"result_text":"历不缺你这一道。你把手收回来，掌心里留着一点别人的旧震动。"}]},{"id":"event_d2_10","layer":2,"title":"不动的邻居","body":"湿岩缝里伏着一只休眠的两栖类，皮皱得像干了的水囊。它可以几年不吃不动。你路过三回，它都在。","options":[{"text":"贴着它的呼吸走。","veins":["water"],"result":{"heal":8},"result_text":"它呼吸很慢，慢得能对上你的步子。走完这段路，你的喘也匀了。"},{"text":"把碎屑分它一点。","veins":["heat"],"result":{"card_reward":"common"},"result_text":"它不吃。碎屑沉进缝里，喂了别的小东西。这一段路的灯光亮了一些。"},{"text":"别吵醒它。","veins":[],"result":{},"result_text":"有些安静是借来的。你把借来的原样放回。"}]},{"id":"event_d2_11","layer":2,"title":"沉下来的东西","body":"冷洞的吃食全靠上面沉降。碎屑落了八万年，铺出一层软的。软层里露出一角金属，不是矿。","options":[{"text":"挖出来看看。","veins":["mineral"],"result":{"relic":true},"result_text":"旧光者的东西，落了八万年也没锈完。它比你更早到这里。"},{"text":"别碰，让软层盖回去。","veins":[],"result":{"heal":6},"result_text":"你把软层按回去。这层里埋的东西，睡得比你好。"},{"text":"循着碎屑往上找源头。","veins":["light"],"result":{"gold":40},"result_text":"碎屑的来路也是你往下要走的去路。一路上捡到几样还能用的。"}]},{"id":"event_d3_9","layer":3,"title":"泉眼的水囊","body":"泉眼里悬着一个水囊，两栖类在里面繁殖。水在这里是按滴记的，一滴一滴，记了不知多少年。","options":[{"text":"只取一口。","veins":["water"],"result":{"heal":10},"result_text":"你按规矩取了一口。水囊晃了晃，又满了。这里的规矩是够用就好。"},{"text":"把随身的空罐灌满。","veins":["mineral"],"result":{"gold":35,"gaze":1},"result_text":"你多拿了。回声在空洞里传得很远，不知道谁听见了。"},{"text":"给水囊让路。","veins":[],"result":{},"result_text":"你从别的缝绕过去。石头记不住人，水记得。"}]},{"id":"event_d3_10","layer":3,"title":"干死的通道","body":"一条水道干了几十年，河床上的贝类还张着壳。有人的行李摊在河床中间，人不在。","options":[{"text":"翻翻行李。","veins":["mineral"],"result":{"gold":30,"damage":4},"result_text":"行李里有干粮和票子。翻到一半，头顶落了些灰，落得很匀，像下了一场不着急的雪。"},{"text":"沿着河床找痕迹。","veins":["tremor"],"result":{"card_reward":"uncommon"},"result_text":"走的人往深处去了，脚步很稳。你顺着那条路走了一段，路比刚才好走。"},{"text":"把行李摆整齐。","veins":[],"result":{"heal":5},"result_text":"你把摊开的东西收拢摆好。谁的东西谁认得，摆整齐了认起来快。"}]},{"id":"event_d3_11","layer":3,"title":"硬矿石上的牙印","body":"硬矿石表面有一排牙印，深得能放进手指。钻孔贝干的，钻了几代。最深的牙印里嵌着一点发亮的矿屑。","options":[{"text":"抠出矿屑。","veins":["mineral"],"result":{"gold":45},"result_text":"矿屑是好东西。贝钻了三代才攒下的，你一次拿完了。"},{"text":"学着它的路线找缝。","veins":["tremor"],"result":{"card_reward":"common"},"result_text":"牙印是路标。顺着最深的那个，你找到一条缝，缝里有风，风是活的。"},{"text":"在牙印旁边刻个记号。","veins":[],"result":{},"result_text":"你刻了一道短的。后来的东西看得懂就看，看不懂，就当石头长了个疤。"}]},{"id":"event_d4_9","layer":4,"title":"涌喉的市集","body":"巢城的市集开在水线上方，客议会说话算数。摊位挂着各家的灯，渊民和上面来的东西摆在同一个架子上。","options":[{"text":"用矿票换干红蕨。","veins":["water"],"result":{"heal":12},"result_text":"摊主按客议会的价收的钱，没抬价。涌喉的规矩是市集里不问来路。"},{"text":"打听往深处的路。","veins":["tremor"],"result":{"card_reward":"uncommon"},"result_text":"一个客语者给你画了半张图。剩下半张他说：下面的路，图不如腿。"},{"text":"只看不买。","veins":[],"result":{},"result_text":"你逛完了没买。摊主也不恼，把灯往你这边挪了挪，算是照明。"}]},{"id":"event_d4_10","layer":4,"title":"倒挂林的暗处","body":"红蕨林从洞顶垂下来，深红紫黑金红。林子深处的红光被叶子滤成暗的。暗处有个很大的形状，随热对流慢慢漂。","options":[{"text":"退回光里。","veins":["light"],"result":{"heal":6},"result_text":"你退回亮处。那形状没跟来。它漂它的，你走你的。"},{"text":"趁它没注意穿过林子。","veins":["tremor"],"result":{"card_reward":"rare","damage":8},"result_text":"你从林子里过去了，带了点东西出来。林子在你身后合拢，像水合拢。"},{"text":"对着它站定。","veins":[],"result":{"gaze":2,"damage":5},"result_text":"它把你记了一下。被记过的地方现在有点凉。"}]},{"id":"event_d4_11","layer":4,"title":"旧城的街灯","body":"水下的旧城市残骸，街灯还立着。稳定空洞海的废墟保存完好——结构层替它们挡了八万年。","options":[{"text":"拆一盏灯。","veins":["mineral"],"result":{"gold":50,"damage":5},"result_text":"灯座拆下来的时候，整条街的灯闪了一下。只闪了一下。也可能是错觉。"},{"text":"数一数有几盏还亮。","veins":["light"],"result":{"card_reward":"uncommon"},"result_text":"三十七盏。你数了两遍。这种事没人会知道，除了你数过的那条街。"},{"text":"在灯下坐一会儿。","veins":[],"result":{"heal":8},"result_text":"灯下的位置比别处暖。八万年没人的地方，暖是从石头里渗出来的。"}]},{"id":"event_d5_10","layer":5,"title":"喷息的汤","body":"绿洲城邦的汤锅架在温泉支流上，汤是菌和管虫尖熬的。喷议会的中立挂在门口：卖汤，不卖立场。","options":[{"text":"喝一碗。","veins":["water"],"result":{"heal":14},"result_text":"汤很烫，辣得很实在。碗底沉着几粒盐——墟盐，融在红光里才算数。"},{"text":"问最近喷发的日子。","veins":["heat"],"result":{"card_reward":"uncommon"},"result_text":"热议会的历上写着：大喷在两个喷之后。你把日子记在手背上。"},{"text":"白喝一碗就走。","veins":[],"result":{"damage":6},"result_text":"锅边守卫的棍子比语言快。中立不等于没脾气。"}]},{"id":"event_d5_11","layer":5,"title":"硫菌丘之间","body":"黑色菌丘一座一座立在裂缝边，像塔群。最近的一座在冒新芽——它要长高了，长高就挡光。","options":[{"text":"掐掉新芽。","veins":["heat"],"result":{"gold":40,"damage":4},"result_text":"菌芽的汁液是硬通货。断口喷了你一手硫沫，火辣辣的。"},{"text":"给它量个高。","veins":["light"],"result":{"card_reward":"common"},"result_text":"你用步子量了量，记在心里。这块地方的高度表，比你先知道地震。"},{"text":"从丘群中间穿过去。","veins":["tremor"],"result":{"gold":20},"result_text":"丘群之间的风道是现成的路。你走过去，什么都没发生。什么都没发生就是好事。"}]},{"id":"event_d5_12","layer":5,"title":"冷却池边的卵","body":"冷却池边粘着一排卵，靠余温孵化。一次地震就能让这池水凉掉。凉掉的那天，这排卵就到日子了。","options":[{"text":"守到它们出膜。","veins":["water"],"result":{"heal":12},"result_text":"你守了半场。出膜的幼体往水里游，有一只回头看了你一眼。也许没有。"},{"text":"捡两颗揣走。","veins":["mineral"],"result":{"gold":35,"gaze":1},"result_text":"卵在怀里是温的，卖到有炉子的地方是好价钱。身后有东西在看你，看了一会儿，走了。"},{"text":"绕开这池水。","veins":[],"result":{},"result_text":"你的脚印没往池边去。这一趟你什么都没带，也什么都没欠。"}]},{"id":"event_d6_9","layer":6,"title":"挂着骨头的警示","body":"矿区入口的岩架上挂着一串骨头，间隔摆得很匀。是人的骨头。摆骨头的人想让你数清楚再进去。","options":[{"text":"数清楚再进去。","veins":["light"],"result":{"card_reward":"uncommon"},"result_text":"二十六根。你进去的路程比摆骨头的人短，收获也比他短。"},{"text":"不进去，沿边缘收矿。","veins":["mineral"],"result":{"gold":50,"damage":6},"result_text":"边缘的辐射矿成色够。皮肤开始发痒的时候你收手了。"},{"text":"把骨头放下来，埋了。","veins":[],"result":{"gaze":1},"result_text":"你把骨头收拢理好，埋了。做这件事的时候红光很亮。有人看着你做了这件事。"}]},{"id":"event_d6_10","layer":6,"title":"抗辐射的壳","body":"一只重金属鳞的甲壳类死在矿缝里，壳还完整。这身壳是它活命的本钱。现在是谁的本钱，就是谁的。","options":[{"text":"剥壳做护具。","veins":["mineral"],"result":{"damage":6,"card_reward":"uncommon"},"result_text":"壳割手。做出来的东西糙，但管用。"},{"text":"把壳留给更小的东西。","veins":[],"result":{"heal":8},"result_text":"缝里钻出来一只小的，住进了壳里。你看着它住进去的。这里连庇护都是接力。"},{"text":"整只搬走卖。","veins":["heat"],"result":{"gold":55},"result_text":"生物科技公司收这个，按克算。你没问它拿来做什么。"}]},{"id":"event_d6_11","layer":6,"title":"反应堆的余温","body":"旧反应堆的外壳上还有温度。上面的人两百年前建的东西，渊民叫它地神的骨灰坛。仪表都死了，风从管子里过，呜呜的。","options":[{"text":"拆一块屏蔽板。","veins":["mineral"],"result":{"gold":60,"damage":8},"result_text":"屏蔽板是好料。拆的时候你在管子的呜呜声里听见一个词，不像震语，也不像上面的话。"},{"text":"把歪掉的仪表拨正。","veins":["light"],"result":{"heal":8,"gaze":1},"result_text":"仪表亮了一下，又灭了。灭之前那一瞬间的绿光，你记到现在。"},{"text":"原样离开。","veins":[],"result":{},"result_text":"有些东西不缺你这一动。你退出去了，门没关，风继续呜呜。"}]},{"id":"event_d7_9","layer":7,"title":"祭祀台的灰","body":"震语者的祭祀台在热液边缘，台上积着灰，灰是烧完的历书。是敬意还是恐惧烧的，台上分不出来。","options":[{"text":"照着残灰续一炷。","veins":["heat"],"result":{"heal":10,"gaze":1},"result_text":"你把手边能烧的都烧了。灰落下去的地方，热液亮了一下。"},{"text":"把台上的灰扫走。","veins":["mineral"],"result":{"gold":45},"result_text":"灰里烧剩的东西不少。扫灰的人没回来收，你来收了。"},{"text":"背对祭台坐一会儿。","veins":[],"result":{"heal":6},"result_text":"你坐了会儿。背对着它，反而听得清它的动静。像很大的东西在很慢地呼吸。"}]},{"id":"event_d7_10","layer":7,"title":"钻探队的末端","body":"深层钻探队的管子伸到这里就停了。设备烂在原地，管口朝着核心的方向。停机原因的记录屏早就读不出来了。","options":[{"text":"拆管口的合金。","veins":["mineral"],"result":{"gold":65,"damage":5},"result_text":"合金是这趟最值钱的东西。拆的时候管子里掉出来一副手套，手骨还在里面，姿势是朝着外爬的。"},{"text":"读记录屏的残句。","veins":["tremor"],"result":{"card_reward":"rare"},"result_text":"只读得出半句：不要回。后面的字被热液洗掉了。你把这句也带上了。"},{"text":"把管口封死。","veins":["heat"],"result":{"gaze":1},"result_text":"你用随身的料把管口封了。封完之后这里安静了些。安静得像有什么换了个地方继续。"}]},{"id":"event_d7_11","layer":7,"title":"墟蛹的外壳","body":"废墟深处立着一只墟蛹，金属管道和骨骼把它缠成茧。茧里的红光是脉动的，慢，但是有节奏。它在重新运行一套八万年前的程序。","options":[{"text":"贴着外壳听。","veins":["tremor"],"result":{"gaze":2,"damage":6},"result_text":"你听见了排好的、成句的震动。它们穿过你的手往骨头里去。你抽手抽得够快，没有全留下。"},{"text":"贴着最远的墙根绕过去。","veins":["light"],"result":{"heal":8},"result_text":"墟蛹不追东西。它只是在那里算，算你经过了。"},{"text":"拿石头敲一下外壳。","veins":[],"result":{"damage":8,"card_reward":"uncommon"},"result_text":"茧里的节奏停了一拍，又继续。停的那一拍里，你手边多了样东西——从茧上剥落的。你不想知道它为什么剥落。"}]},{"id":"event_d8_1","layer":8,"title":"还在运转的走廊","body":"核心的走廊有灯。八万年了，灯还亮着，自动化的东西还在按旧光者的作息运行。门在你面前开，像你回来迟了。","options":[{"text":"走进去。","veins":["light"],"result":{"card_reward":"rare","damage":5},"result_text":"门里的一切都在等一个不会回来的人。你路过的时候，有东西把你的步数记进了某个八万年没人翻的账本。"},{"text":"在窗台上留一样自己的东西。","veins":[],"result":{"heal":8,"gaze":1},"result_text":"你放下一件小东西。它被扫了一遍，没有被清掉。这里总算有一样不是旧光者的东西了。"},{"text":"抄近路穿过去。","veins":["tremor"],"result":{"gold":55},"result_text":"你没走该走的道。账本没记你，角落里被遗漏的东西归了你。"}]},{"id":"event_d8_2","layer":8,"title":"不许关闭的告示","body":"谐振器外围的墙上刻着一行旧光者的字，下面有人用震语刻了翻译。翻译是：不要试图关闭它。不要试图控制它。它已经是你们的一部分了。","options":[{"text":"把这句抄下来。","veins":["tremor"],"result":{"card_reward":"uncommon"},"result_text":"你抄了。抄完发现手是自己动的。这句话不该由手记，该由骨头记。"},{"text":"往墙上补一句。","veins":["light"],"result":{"gaze":2},"result_text":"你在下面刻了自己的话：我看到了。刻完四周的灯亮了一瞬，像是有人回了一句：看到了。"},{"text":"绕开那面墙。","veins":[],"result":{},"result_text":"墙上的字不缺读者，缺的是信的人。你信不信，往后的路会问你。"}]},{"id":"event_d8_3","layer":8,"title":"核心的红光","body":"最深处没有声音。谐振器的红光把整个穹腔照透，红光穿过你，你的影子是透的。站在这里，像站在一样东西的注意力的正中间。","options":[{"text":"在光里站到底。","veins":["heat"],"result":{"maxhp":2,"damage":6},"result_text":"你站到红光把你从头到脚数完。数完之后你轻了一点，也硬了一点。它把你记成了这里的东西。"},{"text":"掬一捧红光带走。","veins":["light"],"result":{"card_reward":"rare","gaze":2},"result_text":"红光捧不起来。你带走的只是手心里多一点的热。但你说你带走了，红渊没有反驳。"},{"text":"转身往回走。","veins":["tremor"],"result":{"heal":10},"result_text":"你转身走了。红光在你背后留了一路。走得快的话，可以一直借着这点亮。"}]},{"id":"event_d1_4","layer":1,"eco":"eco_surface","bands":[1,2],"title":"气闸的对答","body":"气闸一开一合，合上的力道比开的时候大。门边的对讲器沙沙响，像在等一句对得上的暗号。守夜的那位已经换过四版规程，它还在等第一版。","options":[{"text":"按规程敲三下，等回音。","veins":["mineral"],"result":{"gold":30,"heal":4},"result_text":"回音来了，比广播里的年轻。储物柜自己弹开一格，里面的补给码得整整齐齐，像在等领的人。"},{"text":"直接进去，快一点。","veins":[],"result":{"heal":12,"damage":6},"result_text":"补给是全的，动作也快。只有气闸合上的时候没等你收手——规程里没有快这一项，它是照规程办事的。"},{"text":"把门固定住，让它开不全。","veins":["tremor"],"result":{"gaze":-1},"result_text":"你用撬棍别住门轴。里面的一切停在半开：你看了看门框，没有看门里。它没有记住你。"}]},{"id":"event_d1_5","layer":1,"eco":"eco_surface","bands":[1,2],"title":"第三层防护服","body":"挂钩上一排防护服，按挂的年头排。最外面那件晒得发脆，最里面那件几乎没见过光。每一件的胸口都有一串编号，编号后面都跟着一句话：不保证返程。","options":[{"text":"穿最外面那件，最旧的。","veins":["water"],"result":{"heal":8},"result_text":"脆的地方正好透风。旧有成旧的好处——该坏的它都坏完了，剩下的部分靠得住。"},{"text":"穿最里面那件，几乎没晒过。","veins":["light"],"result":{"gold":40,"damage":7},"result_text":"衣服是新的，口袋是满的：矿票、氧气罐、一枚别人的戒指。口袋的主人挂在第三排，你替他把这些东西背进了地下。"},{"text":"都不穿，站远一点。","veins":[],"result":{"gaze":1},"result_text":"真空把影子收得很短。多看这一眼，眼底的蓝斑过了很久才散。"}]},{"id":"event_d1_6","layer":1,"eco":"eco_surface","bands":[1,2],"title":"晒了五百年的水箱","body":"水箱立在陨击坑的阴影里，裂了一道缝。渗出来的水在坑沿结成一串圆珠，五百年的日头都晒在里面。谁接的谁喝，这里没有别的规矩。","options":[{"text":"喝一口。","veins":["water"],"result":{"heal":6,"damage":4},"result_text":"水是甜的，甜里带着一点晒过的钝痛。五百年攒下来的东西，一起进了喉咙。"},{"text":"把水箱整个搬走。","veins":["mineral"],"result":{"gold":35},"result_text":"深层的人按毫升收这个。你只是搬运，搬运不算喝。"},{"text":"把裂口对准自己，等渗漏。","veins":["light"],"result":{"gaze":2,"heal":3},"result_text":"圆珠一颗一颗落进领口。你数着数着，就忘了自己在等什么——红光替你记着，它也看着。"}]},{"id":"event_d1_7","layer":1,"eco":"eco_surface","bands":[1,2],"title":"按规程应答","body":"广播醒着。第三页念完又从头念，字与字之间隔着标准的停顿。规程第十一条：听到问询，应答。它问到的第几条了，没人数。","options":[{"text":"报自己的编号。","veins":["light"],"result":{"gaze":3},"result_text":"编号报得很标准。广播停了一拍——从来没有人答得这么准。从这一拍起，它记住你了。"},{"text":"报一个死人的编号。","veins":["mineral"],"result":{"gold":45},"result_text":"死人的编号对得上，死人的遗物费还没人领。手续齐全，款项当场结清。"},{"text":"让静默继续。","veins":[],"result":{},"result_text":"你从广播底下走过去。第三页念完了，翻回第一页。没有名字的事，不算发生过。"}]},{"id":"event_d1_8","layer":1,"eco":"eco_surface","bands":[1,2],"title":"坠轨的清单","body":"残骸散了一坡，清单卡在货舱的夹层里，塑封完好。每一行货物后面都有一栏签收人。签收人那一栏，从上到下都是空的。","options":[{"text":"按清单清点货物。","veins":["mineral"],"result":{"gold":50,"damage":3},"result_text":"一件一件对，对到最后一件的时候手被划了。清单上有它的名字，它就照清单办事。"},{"text":"只拿清单上没有的。","veins":["tremor"],"result":{"card_reward":"rare","damage":5},"result_text":"没登记的东西压在最底下，比清单上所有的都好。它比看上去重，也没看上去老实。"},{"text":"把清单烧了。","veins":["heat"],"result":{"gaze":2,"heal":3},"result_text":"塑封烧起来的时候有声音，很轻。没有清单，就没有欠账。你胸口那点旧伤先松了。"}]},{"id":"event_d8_4","layer":8,"eco":"eco_nexus","bands":[7,8],"title":"值班交接","body":"走廊里那位把班表递了过来。班表上的排班排到八万年后，每一个格子都签了字，只有一个格子空着——就是今天这一格。它站着，等一个接班的人。","options":[{"text":"接下班表。","veins":["light"],"result":{"gaze":3,"heal":4},"result_text":"笔在你手里的时候很轻。它松开的那一下，八万年的站姿散了架。位置是你的了，走廊从你站的地方重新开始。"},{"text":"替它站一班。","veins":["mineral"],"result":{"gold":60,"damage":6},"result_text":"它把八万年攒下的东西全数交给你，交接单一式两份。站班的滋味它没写——腿是自己的，麻也是自己的。"},{"text":"从旁边绕过去。","veins":["tremor"],"result":{},"result_text":"走廊不宽，你侧着身。它的目光跟着你走了三步，第四步起就不归它管了。"}]},{"id":"event_d8_5","layer":8,"eco":"eco_nexus","bands":[7,8],"title":"四种字的告示","body":"告示钉死了，旧光者文字、渊民震语、殖民者通用语、还有谁也不认得的第四种，写的是同一句话。钉子是新的。这句话不许关闭。","options":[{"text":"照告示做。","veins":["light"],"result":{"heal":9},"result_text":"你照做了。做完之后呼吸顺了一截，像是有什么替你把姿势校准了。它说做什么，你就该做什么。"},{"text":"闭着眼走过去。","veins":[],"result":{"gaze":3},"result_text":"闭着眼反而看得更清楚。四种字在眼皮底下排着队走，你多看了三眼，眼眼都记了档。"},{"text":"把告示念出声。","veins":["tremor"],"result":{"maxhp":-2,"gold":35},"result_text":"念到第二种字的时候声音就不像你的了。工钱按次结，当场付清——嗓子里的那点余量，算你入的股。"}]},{"id":"event_d8_6","layer":8,"eco":"eco_nexus","bands":[7,8],"title":"签到处","body":"簿子摊开在台上，笔用链子拴着。八万年来这里的人签了一整本又换一本，换下来的那摞码得像地基。簿子的最后一页是空的，正对着你。","options":[{"text":"签自己的名字。","veins":["light"],"result":{"gaze":3},"result_text":"签名的时候手很稳。这一页只有一个名字，整本簿子都在替这个笔画作证。"},{"text":"签上一个来过的人。","veins":["mineral"],"result":{"gold":40,"damage":4},"result_text":"上一个来过的人不会来对笔迹。链子够长，笔够快——账要平，划伤就算利息。"},{"text":"把笔收进兜里。","veins":["tremor"],"result":{"card_reward":"rare","damage":5},"result_text":"笔尖是谐振器上磨下来的，写出来的字比人活得久。它在你兜里不老实，攥一下，疼一下。"}]},{"id":"event_d8_7","layer":8,"eco":"eco_nexus","bands":[7,8],"title":"八万年前的休息室","body":"休息室的门没有锁。柜子按编号排，柜门上的名字磨没了，编号还在。椅子保持着有人刚起身的样子，烟灰缸是空的，烟灰缸不许有烟。","options":[{"text":"打开写着编号的柜子。","veins":[],"result":{"gold":30},"result_text":"柜子里的东西按用途分好，连绳子都绕好了圈。都拿走也不算偷——按规程，失效满八万年即视为无主。"},{"text":"只拿过了保质期还能吃的。","veins":["water"],"result":{"heal":7,"gaze":1},"result_text":"八万年不算短。味道也过了八万年。你吃着，感觉到有什么在看你吃东西，看得很仔细。"},{"text":"把柜门轻轻带上。","veins":["light"],"result":{},"result_text":"柜门合上的声音只有你听见。椅子还是刚起身的样子。有的东西不惊动，就还能一直维持着。"}]},{"id":"event_d8_8","layer":8,"eco":"eco_nexus","bands":[7,8],"title":"呼吸口","body":"走廊尽头风往上走。风里什么都没有，只有谐振器透出来的那点余温。从这里上去，就到它跟前了。风是凉的，往上走的东西没有凉的。","options":[{"text":"把手伸进风里。","veins":["light"],"result":{"gaze":2,"maxhp":-2},"result_text":"风从指缝里过去，数得清每一根。少的那点东西没有感觉——它拿走的部分，本来就不归手管。"},{"text":"贴着墙听它呼吸。","veins":["tremor"],"result":{"heal":8},"result_text":"墙的这面是热的。呼吸很长，你跟着调了两轮，伤处跟着松开了。它没有察觉，或者习以为常。"},{"text":"往风里放一枚矿票。","veins":["mineral"],"result":{"damage":3,"heal":10},"result_text":"矿票打着旋往上走。风顿了一下——收下了。烫是找零，顺过来的那口呼吸是真的。"}]}],"layers":{"layers":[{"id":1,"name":"地表死寂区","nodes":["combat","combat","combat","event","event","combat","combat"],"rows":[[{"type":"combat"},{"type":"combat"}],[{"type":"combat"},{"type":"event"}],[{"type":"event"},{"type":"combat"}],[{"type":"combat"}]]},{"id":2,"name":"外层冷洞","nodes":["combat","event","elite","combat","shop","combat","combat"],"rows":[[{"type":"combat"},{"type":"event"}],[{"type":"elite"},{"type":"combat"}],[{"type":"shop"},{"type":"combat"}],[{"type":"combat"}]]},{"id":3,"name":"干旱空洞区","nodes":["event","combat","elite","combat","combat","shop","elite"],"rows":[[{"type":"event"},{"type":"combat"}],[{"type":"elite"},{"type":"combat"}],[{"type":"combat"},{"type":"shop"}],[{"type":"elite"}]]},{"id":4,"name":"稳定空洞海","nodes":["combat","event","elite","combat","campfire","combat","boss"],"rows":[[{"type":"combat"},{"type":"event"}],[{"type":"elite"},{"type":"combat"}],[{"type":"campfire"},{"type":"combat"}],[{"type":"boss"}]]},{"id":5,"name":"热泉裂带","nodes":["event","combat","combat","elite","campfire","combat","boss"],"rows":[[{"type":"event"},{"type":"combat"}],[{"type":"combat"},{"type":"elite"}],[{"type":"campfire"},{"type":"combat"}],[{"type":"boss"}]]},{"id":6,"name":"辐射矿石区","nodes":["combat","elite","event","combat","shop","event","elite"],"rows":[[{"type":"combat"},{"type":"elite"}],[{"type":"event"},{"type":"combat"}],[{"type":"shop"},{"type":"event"}],[{"type":"elite"}]]},{"id":7,"name":"核心高热区","nodes":["campfire","event","combat","elite","event","combat","boss"],"rows":[[{"type":"campfire"},{"type":"event"}],[{"type":"combat"},{"type":"elite"}],[{"type":"event"},{"type":"combat"}],[{"type":"boss"}]]},{"id":8,"name":"红渊核心","nodes":["campfire","event","combat","elite","event","combat","boss"],"rows":[[{"type":"campfire"},{"type":"event"}],[{"type":"combat"},{"type":"elite"}],[{"type":"event"},{"type":"combat"}],[{"type":"boss"}]]}]},"anmin":[{"id":"anm_0001","name":"现场回收","class":"anmin","type":"skill","rarity":"common","veins":["mineral"],"energy":1,"effect":{"block":4,"target":"self"},"cost_type":"none","cost_text":"","flavor":"击杀登记：料料入账。废墟不发工资，发零件。","upgrade":{"name_suffix":"·固","effect":{"block":6},"flavor_add":"回收范围扩了半个身位。条款没改。"}},{"id":"anm_0002","name":"扳手规程","class":"anmin","type":"attack","rarity":"common","veins":["mineral"],"energy":1,"effect":{"damage":9,"hits":1,"target":"single"},"cost_type":"none","cost_text":"","flavor":"扳手有两种用法。规程只写了第一种。","upgrade":{"name_suffix":"·旧","effect":{"damage":12},"flavor_add":"第二种用法传了下来。没有人承认。"}},{"id":"anm_0003","name":"备用照明电池","class":"anmin","type":"skill","rarity":"common","veins":["light"],"energy":0,"effect":{"draw":1,"target":"self"},"cost_type":"none","cost_text":"","flavor":"电量：够照三次呼吸。省着用。","upgrade":{"name_suffix":"·新","effect":{"draw":2},"flavor_add":"电池是满的。满得可疑。"}},{"id":"anm_0004","name":"例检条款","class":"anmin","type":"skill","rarity":"common","veins":["mineral"],"energy":1,"effect":{"block":7,"target":"self"},"cost_type":"none","cost_text":"","flavor":"我逐项打钩。机械逐项通过。我们都很专业。","upgrade":{"name_suffix":"·固","effect":{"block":10},"flavor_add":"新增第十一条：不许看它的眼。"}},{"id":"anm_0005","name":"焊缝补强","class":"anmin","type":"skill","rarity":"common","veins":["heat"],"energy":1,"effect":{"block":5,"target":"self"},"cost_type":"none","cost_text":"","flavor":"焊枪走过的地方，墙忘了自己是墙。","upgrade":{"name_suffix":"·改","effect":{"block":8},"flavor_add":"补丁比墙年轻。比墙听话。"}},{"id":"anm_0006","name":"库存盘点","class":"anmin","type":"skill","rarity":"common","veins":["mineral"],"energy":0,"effect":{"draw":1,"resonance_gain":2,"target":"self"},"cost_type":"none","cost_text":"","flavor":"料：账实相符。人：没点。","upgrade":{"name_suffix":"·Ⅱ","effect":{"resonance_gain":4},"flavor_add":"第二遍盘点。有一项在动。"}},{"id":"anm_0007","name":"调节螺栓","class":"anmin","type":"attack","rarity":"common","veins":["mineral"],"energy":1,"effect":{"damage":4,"hits":2,"target":"single"},"cost_type":"none","cost_text":"","flavor":"拧一圈，紧一圈。松的东西总要有人管。","upgrade":{"name_suffix":"·改","effect":{"damage":5},"flavor_add":"第三圈拧不动了。里面的东西在顶。"}},{"id":"anm_0008","name":"报废清单","class":"anmin","type":"skill","rarity":"common","veins":["mineral"],"energy":1,"effect":{"block":4,"resonance_drain":5,"target":"self"},"cost_type":"none","cost_text":"","flavor":"七个编号同时注销。墨水是最后一次配给的。","upgrade":{"name_suffix":"·旧","effect":{"block":6,"resonance_drain":7},"flavor_add":"清单末尾多了一行。不是我的字。"}},{"id":"anm_0009","name":"料仓取件","class":"anmin","type":"skill","rarity":"common","veins":["mineral"],"energy":0,"effect":{"draw":2,"target":"self"},"cost_type":"none","cost_text":"","flavor":"料仓认工号。工号认我。我认不认它，没登记。","upgrade":{"name_suffix":"·新","effect":{"draw":3},"flavor_add":"料仓多给了两件。多给的不上账。"}},{"id":"anm_0010","name":"应急照明协议","class":"anmin","type":"skill","rarity":"uncommon","veins":["light"],"energy":1,"effect":{"block":9,"target":"self"},"cost_type":"none","cost_text":"","flavor":"按下按钮。走廊亮起。黑暗退到条款边缘。","upgrade":{"name_suffix":"·固","effect":{"block":13},"flavor_add":"灯亮的时间超出了协议。没有人去关。"}},{"id":"anm_0011","name":"焊接臂·民用型","class":"anmin","type":"attack","rarity":"uncommon","veins":["heat"],"energy":1,"effect":{"damage":6,"hits":1,"target":"single","special":[{"code":"burn","value":3,"turns":2}]},"cost_type":"none","cost_text":"","flavor":"民用型。焊不了装甲，焊得住皮肉。","upgrade":{"name_suffix":"·改","effect":{"damage":8},"flavor_add":"改装了。改装件来路未登记。"}},{"id":"anm_0012","name":"维修凝胶","class":"anmin","type":"skill","rarity":"uncommon","veins":["water"],"energy":1,"effect":{"heal":7,"target":"self"},"cost_type":"none","cost_text":"","flavor":"凝胶不挑部位。哪里漏，哪里算伤口。","upgrade":{"name_suffix":"·新","effect":{"heal":10},"flavor_add":"过期了。过期之后更稠，更好用。"}},{"id":"anm_0013","name":"料径校准","class":"anmin","type":"attack","rarity":"uncommon","veins":["mineral"],"energy":1,"effect":{"damage":5,"hits":1,"target":"single","resonance_gain":4},"cost_type":"none","cost_text":"","flavor":"料径误差不许超过一丝。红光的误差不算误差。","upgrade":{"name_suffix":"·Ⅱ","effect":{"damage":7,"resonance_gain":5},"flavor_add":"校准了红光本身。它准得让人不安。"}},{"id":"anm_0014","name":"巡逻体残骸","class":"anmin","type":"attack","rarity":"uncommon","veins":["mineral"],"energy":1,"effect":{"damage":12,"hits":1,"target":"single"},"cost_type":"none","cost_text":"","flavor":"把它抬回避难所的路上，它一直在给别的巡逻体发位置。","upgrade":{"name_suffix":"·残","effect":{"damage":16},"flavor_add":"信号断了。是我们剪的。剪之前犹豫了一下。"}},{"id":"anm_0015","name":"主控授权·工程线","class":"anmin","type":"power","rarity":"rare","veins":["mineral"],"energy":1,"effect":{"target":"self","special":[{"code":"strength","value":2}]},"cost_type":"none","cost_text":"","flavor":"授权下发。从今天起，你拧的每一颗螺栓都算数。","upgrade":{"name_suffix":"·刻","effect":{"special":[{"code":"strength","value":1}]},"flavor_add":"授权延期。理由栏写着：还需要他。"}},{"id":"anm_0016","name":"主控授权·安全线","class":"anmin","type":"power","rarity":"rare","veins":["mineral"],"energy":1,"effect":{"target":"self","special":[{"code":"dexterity","value":2}]},"cost_type":"none","cost_text":"","flavor":"安全线授权比工程线难拿。因为安全线管的是命。","upgrade":{"name_suffix":"·刻","effect":{"special":[{"code":"dexterity","value":1}]},"flavor_add":"授权延期。理由栏写着：他还活着。"}},{"id":"anm_0017","name":"回收协议·总则","class":"anmin","type":"skill","rarity":"rare","veins":["mineral"],"energy":1,"effect":{"block":8,"resonance_drain":8,"target":"self"},"cost_type":"none","cost_text":"","flavor":"协议一旦下达不可撤销。这一条写在标题里。","upgrade":{"name_suffix":"·刻","effect":{"block":12},"flavor_add":"有人试着撤销过。条款仍在执行。"}},{"id":"anm_0018","name":"威胁等级·评估员","class":"anmin","type":"skill","rarity":"rare","veins":["mineral"],"energy":0,"effect":{"draw":2,"target":"self","gaze_cost":3},"cost_type":"none","cost_text":"","flavor":"评估员不需要勇气。评估员只需要看清等级，然后签字。","upgrade":{"name_suffix":"·新","effect":{"draw":3},"flavor_add":"签字笔换成了刻刀。等级刻进了手背。"}},{"id":"anm_0019","name":"例检手套","class":"anmin","type":"skill","rarity":"special","veins":["mineral"],"energy":1,"effect":{"block":6,"draw":1,"target":"self"},"cost_type":"none","cost_text":"","flavor":"手套里还留着上一任的体温。条例规定不得清空。","upgrade":{"name_suffix":"·旧","effect":{"block":9},"flavor_add":"体温散了。条例没散。"}},{"id":"anm_0020","name":"协议：静默段","class":"anmin","type":"skill","rarity":"uncommon","veins":["mineral"],"energy":1,"effect":{"block":6,"target":"self","special":[{"code":"resonance_lock"}]},"cost_type":"none","cost_text":"","flavor":"共振冻结。冻结不是和平，是账。","upgrade":{"name_suffix":"·Ⅱ","effect":{"block":10},"flavor_add":"第二次宣读。账本翻到了新的一页。"}},{"id":"anm_0021","name":"协议：优先级翻转","class":"anmin","type":"skill","rarity":"common","veins":["tremor"],"energy":1,"effect":{"draw":1,"block":4,"target":"self"},"cost_type":"none","cost_text":"","flavor":"先处理谁，后处理谁。协议说了算，证据不算。","upgrade":{"name_suffix":"·改","effect":{"block":6,"draw":1},"flavor_add":"优先级又翻了一次。协议没有疲惫。"}},{"id":"anm_0022","name":"协议：保运行","class":"anmin","type":"skill","rarity":"common","veins":["water"],"energy":1,"effect":{"heal":6,"target":"self"},"cost_type":"vitality","cost_text":"运行优先于人。","upgrade":{"name_suffix":"·旧","effect":{"heal":9},"flavor_add":"第九页撕掉了。撕掉之前有人读过。"},"flavor":"运行优先于人。人也是运行的一部分。"},{"id":"anm_0023","name":"协议：信息隔离","class":"anmin","type":"skill","rarity":"uncommon","veins":["light"],"energy":1,"effect":{"draw":2,"target":"self"},"cost_type":"none","cost_text":"","flavor":"走廊两侧互不通报。通报的都出事了。","upgrade":{"name_suffix":"·改","effect":{"draw":3},"flavor_add":"隔离升级。你不知道的事在保护你。"}},{"id":"anm_0024","name":"协议：库存封存","class":"anmin","type":"skill","rarity":"uncommon","veins":["mineral"],"energy":1,"effect":{"block":8,"target":"self"},"cost_type":"lock","cost_text":"封存物资每层只启封一次。","upgrade":{"name_suffix":"·固","effect":{"block":12},"flavor_add":"启封记录多了一行。是它自己写的。"},"flavor":"封存物资每层只启封一次。启封记录不公开。"},{"id":"anm_0025","name":"协议：终端确认","class":"anmin","type":"attack","rarity":"uncommon","veins":["mineral"],"energy":1,"effect":{"damage":10,"hits":1,"target":"single"},"cost_type":"none","cost_text":"","flavor":"请确认。再确认一次。第三次是给它的。","upgrade":{"name_suffix":"·刻","effect":{"damage":14},"flavor_add":"终端还在等第四次确认。你按了。"}},{"id":"anm_0026","name":"协议：最小代价原则","class":"anmin","type":"skill","rarity":"rare","veins":["water"],"energy":1,"effect":{"heal":5,"block":5,"target":"self"},"cost_type":"none","cost_text":"","flavor":"在两个坏结果里，协议替你选了小的。谢谢它。","upgrade":{"name_suffix":"·新","effect":{"heal":8,"block":5},"flavor_add":"协议开始自己选。选得比你狠。"}},{"id":"anm_0027","name":"协议：静默段·延长","class":"anmin","type":"skill","rarity":"rare","veins":["mineral"],"energy":0,"effect":{"target":"self","special":[{"code":"resonance_lock"}],"block":3},"cost_type":"vitality","cost_text":"静默段有第 2000 年了。","upgrade":{"name_suffix":"·Ⅱ","effect":{"block":6},"flavor_add":"续期成功。成功这个词用在这里很怪，但流程上没错。"},"flavor":"静默段有第 2000 年了。你续的是第 2001 年。"},{"id":"anm_0028","name":"协议：注销","class":"anmin","type":"attack","rarity":"special","veins":["mineral"],"energy":1,"effect":{"damage":14,"hits":1,"target":"single"},"cost_type":"memory","cost_text":"编号注销。","upgrade":{"name_suffix":"·残","effect":{"damage":18},"flavor_add":"注销申请被驳回了。驳回的人注销了自己。"},"flavor":"被注销的编号从此不属于任何人。"},{"id":"anm_0029","name":"氧气核算","class":"anmin","type":"skill","rarity":"common","veins":["water"],"energy":1,"effect":{"heal":5,"target":"self"},"cost_type":"none","cost_text":"","flavor":"氧气存量：够。人数：对得上。这两件事很少同时成立。","upgrade":{"name_suffix":"·新","effect":{"heal":8},"flavor_add":"核算通过。通过的那一栏有人签了名，不是你。"}},{"id":"anm_0030","name":"运料车残骸","class":"anmin","type":"attack","rarity":"common","veins":["mineral"],"energy":1,"effect":{"damage":7,"hits":1,"target":"single"},"cost_type":"none","cost_text":"","flavor":"运料车停在半路。停了五百年，货还算齐的。","upgrade":{"name_suffix":"·Ⅱ","effect":{"damage":10},"flavor_add":"你从残骸里多拖了一件。账上没有这件。"}},{"id":"anm_0031","name":"缓冲库存","class":"anmin","type":"skill","rarity":"common","veins":["water"],"energy":1,"effect":{"block":6,"target":"self"},"cost_type":"none","cost_text":"","flavor":"把今天的伤记成明天的库存。库存不算伤。","upgrade":{"name_suffix":"·Ⅱ","effect":{"block":9},"flavor_add":"库存转正了。伤不算伤，也算库存。"}},{"id":"anm_0032","name":"闭环利用","class":"anmin","type":"skill","rarity":"common","veins":["water"],"energy":0,"effect":{"heal":3,"target":"self"},"cost_type":"none","cost_text":"","flavor":"你呼出的，避难所会还给你。还的时候别问混了什么。","upgrade":{"name_suffix":"·新","effect":{"heal":5},"flavor_add":"闭环率提高了。闭环里多了一圈什么在游。"}},{"id":"anm_0033","name":"血统册摘录","class":"anmin","type":"skill","rarity":"common","veins":["light"],"energy":1,"effect":{"draw":1,"target":"self"},"cost_type":"none","cost_text":"","flavor":"册子上你的名字有三处批注。三处都是待修。","upgrade":{"name_suffix":"·旧","effect":{"draw":2},"flavor_add":"第四处批注出现了。日期是昨天。"}},{"id":"anm_0034","name":"辐射防护衬层","class":"anmin","type":"skill","rarity":"uncommon","veins":["light"],"energy":1,"effect":{"block":8,"target":"self"},"cost_type":"none","cost_text":"","flavor":"衬层穿了两千年。它比你更懂这颗卫星。","upgrade":{"name_suffix":"·固","effect":{"block":12},"flavor_add":"衬层换新了。旧的那件叠在新件里面。"}},{"id":"anm_0035","name":"超频保养","class":"anmin","type":"power","rarity":"uncommon","veins":["heat"],"energy":1,"effect":{"target":"self","special":[{"code":"strength","value":2}]},"cost_type":"vitality","cost_text":"损耗计入下个核算期。","upgrade":{"name_suffix":"·Ⅱ","effect":{"special":[{"code":"strength","value":1}]},"flavor_add":"核算期延长了。损耗不打算讨。"},"flavor":"超频的损耗计入下个核算期。核算期很长。"},{"id":"anm_0036","name":"保运行批文","class":"anmin","type":"skill","rarity":"uncommon","veins":["water"],"energy":1,"effect":{"heal":4,"block":4,"target":"self"},"cost_type":"none","cost_text":"","flavor":"批文核准：你再运行一个核算期。批复人栏是空的。","upgrade":{"name_suffix":"·新","effect":{"heal":6,"block":5},"flavor_add":"批复人栏出现了名字。名字被涂掉了。"}},{"id":"anm_0037","name":"动用储备","class":"anmin","type":"skill","rarity":"uncommon","veins":["mineral"],"energy":0,"effect":{"block":10,"target":"self"},"cost_type":"vitality","cost_text":"动用储备需要授权。","upgrade":{"name_suffix":"·Ⅱ","effect":{"block":14},"flavor_add":"储备见了底。底下面还有一层，没人批准过。"},"flavor":"储备不是用来保命的。储备是用来撑到下一次例检的。"},{"id":"anm_0038","name":"运料井下坠","class":"anmin","type":"attack","rarity":"uncommon","veins":["tremor"],"energy":1,"effect":{"damage":11,"hits":1,"target":"single"},"cost_type":"none","cost_text":"","flavor":"运输井没有电梯，只有方向。方向是下。","upgrade":{"name_suffix":"·残","effect":{"damage":15},"flavor_add":"井底传来回声。回声比你先到，先停。"}},{"id":"anm_0039","name":"菌婪者组织样本","class":"anmin","type":"attack","rarity":"uncommon","veins":["water"],"energy":1,"effect":{"damage":6,"hits":1,"target":"single","special":[{"code":"poison","v":4}]},"cost_type":"none","cost_text":"","flavor":"样本登记为：被改造生物，编号注销。它不同意注销。","upgrade":{"name_suffix":"·Ⅱ","effect":{"damage":8},"flavor_add":"样本开始记账。记的是你欠它的。"}},{"id":"anm_0040","name":"协议：例外条款","class":"anmin","type":"power","rarity":"rare","veins":["water"],"energy":1,"effect":{"target":"self","special":[{"code":"regenerate","value":3}]},"cost_type":"none","cost_text":"","flavor":"例外条款救不了所有人。它救的是签字的人。","upgrade":{"name_suffix":"·新","effect":{"special":[{"code":"regenerate","value":2}]},"flavor_add":"例外多了。例外开始互相援引。"}},{"id":"anm_0041","name":"保运行优先级","class":"anmin","type":"power","rarity":"rare","veins":["water"],"energy":2,"effect":{"target":"self","special":[{"code":"regenerate","value":2},{"code":"strength","value":1}]},"cost_type":"vitality","cost_text":"系统将优先保运行。","upgrade":{"name_suffix":"·刻","effect":{"special":[{"code":"regenerate","value":1}]},"flavor_add":"腿保住了。保运行的定义正在扩。"},"flavor":"主控将优先保运行。运行的定义不包括你的腿。"},{"id":"anm_0042","name":"基因修复台","class":"anmin","type":"skill","rarity":"rare","veins":["light"],"energy":1,"effect":{"heal":8,"target":"self"},"cost_type":"memory","cost_text":"修复覆盖一段序列。","upgrade":{"name_suffix":"·新","effect":{"heal":12},"flavor_add":"覆盖完成。你确认过，你确认过吗。"},"flavor":"修复会覆盖一段序列。覆盖的那段不通知你。"},{"id":"anm_0043","name":"静默段徵章","class":"anmin","type":"skill","rarity":"special","veins":["tremor"],"energy":1,"effect":{"block":10,"target":"self","special":[{"code":"retain"}]},"cost_type":"none","cost_text":"","flavor":"徵章授给经历过最长静默段的人。他没说话，就是证明。","upgrade":{"name_suffix":"·刻","effect":{"block":14},"flavor_add":"徵章传给了你。传的时候也没有仪式。"}},{"id":"anm_0044","name":"死者的工号牌","class":"anmin","type":"skill","rarity":"common","veins":["mineral"],"energy":0,"effect":{"draw":1,"target":"self"},"cost_type":"none","cost_text":"","flavor":"工号牌还在发信号。信号发给了两千年前。","upgrade":{"name_suffix":"·旧","effect":{"draw":2},"flavor_add":"信号有回执了。你没敢看回执内容。"}},{"id":"anm_0045","name":"读图纸的人","class":"anmin","type":"skill","rarity":"common","veins":["light"],"energy":1,"effect":{"draw":1,"target":"self"},"cost_type":"none","cost_text":"","flavor":"我看得懂图纸。这件事我谁也没告诉。","upgrade":{"name_suffix":"·新","effect":{"draw":2},"flavor_add":"图纸看懂了一页。那一页让一切更难懂了。"}},{"id":"anm_0046","name":"例检清单（残）","class":"anmin","type":"skill","rarity":"common","veins":["mineral"],"energy":1,"effect":{"block":6,"target":"self"},"cost_type":"none","cost_text":"","flavor":"清单缺了后半页。缺的后半页都是关键项。","upgrade":{"name_suffix":"·旧","effect":{"block":9},"flavor_add":"后半页找到了。找到了，但不想贴上。"}},{"id":"anm_0047","name":"通风守卫·代班","class":"anmin","type":"attack","rarity":"common","veins":["tremor"],"energy":1,"effect":{"damage":8,"hits":1,"target":"single"},"cost_type":"none","cost_text":"","flavor":"守卫还在通风口。通风早就停了。它没收到停工通知。","upgrade":{"name_suffix":"·残","effect":{"damage":11},"flavor_add":"通知找到了。它看完继续站岗。"}},{"id":"anm_0048","name":"运输井规程","class":"anmin","type":"skill","rarity":"uncommon","veins":["tremor"],"energy":1,"effect":{"block":5,"resonance_gain":3,"target":"self"},"cost_type":"none","cost_text":"","flavor":"下井前默哀十秒。规程上的时间，你们总是省着用。","upgrade":{"name_suffix":"·Ⅱ","effect":{"block":7,"resonance_gain":4},"flavor_add":"这次默哀了全程十秒。井底安静了很久。"}},{"id":"anm_0049","name":"撤销程序残片","class":"anmin","type":"skill","rarity":"rare","veins":["light"],"energy":1,"effect":{"draw":2,"resonance_drain":6,"target":"self"},"cost_type":"none","cost_text":"","flavor":"残片教你撤销一样东西。残片没说哪样。","upgrade":{"name_suffix":"·新","effect":{"resonance_drain":8},"flavor_add":"残片拼上了。拼上的部分写着你不能学。"}},{"id":"anm_0050","name":"主控密钥（烧毁）","class":"anmin","type":"power","rarity":"special","veins":["light"],"energy":1,"effect":{"target":"self","special":[{"code":"strength","value":1},{"code":"dexterity","value":1}]},"cost_type":"mark","cost_text":"烧毁的密钥只剩一半权限。","upgrade":{"name_suffix":"·刻","effect":{"special":[{"code":"strength","value":1}]},"flavor_add":"密钥重新烧了一遍。权限没变，温度变了。"},"flavor":"烧毁的密钥只剩一半权限。另一半在红光里。"}],"anminEnemies":[{"id":"anmenemy_01","name":"维护单元-7","layer":1,"tier":"normal","hp":"14-18","intent_pattern":[{"type":"attack","value":4},{"type":"attack","value":3},{"type":"defend","value":4}],"traits":[],"flavor":"它按时送来例检备件，按时清除非登记生物。两件事在它看来是同一件。"},{"id":"anmenemy_02","name":"哨戒塔（旧式）","layer":1,"tier":"normal","hp":"16-20","intent_pattern":[{"type":"attack","value":5},{"type":"defend","value":5}],"traits":[],"flavor":"塔身弹痕有三代。每一代弹痕下面都写着同一行字：判据正确。"},{"id":"anmenemy_03","name":"清障机·残","layer":1,"tier":"normal","hp":"15-19","intent_pattern":[{"type":"attack","value":3,"times":2},{"type":"defend","value":3}],"traits":[],"flavor":"它负责清障。障碍的定义由它现场解释。"},{"id":"anmenemy_04","name":"警报器（旧式）","layer":1,"tier":"normal","hp":"12-15","intent_pattern":[{"type":"attack","value":4},{"type":"attack","value":2},{"type":"defend","value":4}],"traits":[],"flavor":"它拉响警报。警报内容：一切正常。响度：最大。"},{"id":"anmenemy_05","name":"扫探虫群","layer":2,"tier":"normal","hp":"22-28","intent_pattern":[{"type":"attack","value":3,"times":2},{"type":"attack","value":4},{"type":"defend","value":4}],"traits":[],"flavor":"被改造的探腐虫。基因崩溃那年改的，改完它们开始探活物。"},{"id":"anmenemy_06","name":"焊接臂·军用型","layer":2,"tier":"normal","hp":"24-30","intent_pattern":[{"type":"attack","value":6},{"type":"defend","value":5}],"traits":[],"flavor":"焊接臂不问焊什么。条例里，你也是焊缝的一种。"},{"id":"anmenemy_07","name":"巡逻体-3","layer":2,"tier":"normal","hp":"23-29","intent_pattern":[{"type":"attack","value":5},{"type":"attack","value":4},{"type":"defend","value":5}],"traits":[],"flavor":"巡逻路线五百年没改过。路线穿过的宿舍，早就没有门了。"},{"id":"anmenemy_08","name":"隔离门","layer":2,"tier":"normal","hp":"26-32","intent_pattern":[{"type":"defend","value":7},{"type":"attack","value":6}],"traits":[],"flavor":"它关上的时候很温柔。温柔地切断两侧的一切联系。"},{"id":"anmenemy_09","name":"菌婪者","layer":2,"tier":"normal","hp":"22-28","intent_pattern":[{"type":"attack","value":4},{"type":"attack","value":5},{"type":"attack","value":3}],"traits":[],"flavor":"被改造生物。循环仓的藻被它啃穿三层。它还在长。"},{"id":"anmenemy_10","name":"运料车（失控）","layer":3,"tier":"normal","hp":"28-34","intent_pattern":[{"type":"attack","value":7},{"type":"defend","value":6}],"traits":[],"flavor":"运料路线穿过人群登记区。它五百年没减速。"},{"id":"anmenemy_11","name":"通风守卫","layer":3,"tier":"normal","hp":"27-33","intent_pattern":[{"type":"attack","value":6},{"type":"attack","value":6},{"type":"defend","value":6}],"traits":[],"flavor":"通风停了，它守着风口。风不来，它就守着不来。"},{"id":"anmenemy_12","name":"维护单元-12（叛变）","layer":3,"tier":"normal","hp":"30-36","intent_pattern":[{"type":"attack","value":7},{"type":"attack","value":5},{"type":"defend","value":6}],"traits":[],"flavor":"它给维护者送了五百年零件。上一次送来的，是维护者的编号注销单。"},{"id":"anmenemy_13","name":"修复体·终末型","layer":3,"tier":"elite","hp":"62-72","intent_pattern":[{"type":"buff","value":5},{"type":"attack","value":11},{"type":"defend","value":9},{"type":"attack","value":9}],"traits":[],"flavor":"修复体的任务是把一切修到能运行。它修不了基因崩溃，于是开始修定义。"},{"id":"anmenemy_14","name":"哨戒网中枢","layer":3,"tier":"elite","hp":"58-68","intent_pattern":[{"type":"attack","value":8,"times":2},{"type":"defend","value":10},{"type":"attack","value":10}],"traits":[],"flavor":"十二台哨戒塔的大脑。塔倒了九座，它把九份判据都记在自己身上。"},{"id":"anmenemy_15","name":"菌婪母巢","layer":3,"tier":"elite","hp":"64-74","intent_pattern":[{"type":"buff","value":5},{"type":"attack","value":10},{"type":"attack","value":8,"times":2},{"type":"defend","value":9}],"traits":[],"flavor":"基因崩溃留下的最后一个培养仓。里面的东西按自己的意思改造完了。"},{"id":"anmenemy_16","name":"三号避难所自动防御主控","layer":3,"tier":"boss","hp":110,"intent_pattern":[{"type":"attack","value":9},{"type":"buff","value":6},{"type":"defend","value":10},{"type":"attack","value":13}],"traits":[],"flavor":"还在执行最后一条命令的指挥系统。命令只有四个字：保运行。保谁的运行，命令没说。","phases":[{"hp_above":0.66,"log":"主控调出备案：威胁等级评估中。评估员栏是空的。它把自己填了进去。","intent_pattern":[{"type":"attack","value":8},{"type":"attack","value":8},{"type":"defend","value":10}]},{"hp_above":0.33,"log":"主控开始逐条调用旧命令。每一条都以保运行开头，没有一条定义过运行。","intent_pattern":[{"type":"buff","value":6},{"type":"attack","value":10},{"type":"defend","value":10},{"type":"attack","value":12}]},{"hp_above":0,"log":"最后一条命令开始执行。两千年来第一次，它升级了火力配置。","intent_pattern":[{"type":"attack","value":9,"times":2},{"type":"attack","value":12},{"type":"debuff","status":"weak","value":2}]}]}],"anminRelics":[{"id":"anrelic_01","name":"权限卡·叁级","rarity":"common","veins":["mineral"],"effect_text":"每场战斗开始时，获得 3 点格挡。","effect_code":[{"trigger":"combat_start","action":"block","value":3}],"flavor":"三级权限能开的门不多。够用的门都在里面。"},{"id":"anrelic_02","name":"权限卡·贰级（缺角）","rarity":"uncommon","veins":["mineral"],"effect_text":"每场战斗开始时，抽 1 张牌。","effect_code":[{"trigger":"combat_start","action":"draw","value":1}],"flavor":"缺的那一角是二级权限。缺角在转让时一起转给了你。"},{"id":"anrelic_03","name":"未拆封的维修包","rarity":"common","veins":["mineral"],"effect_text":"每回合开始时，回复 1 点生命。","effect_code":[{"trigger":"turn_start","action":"heal","value":1}],"flavor":"封条完好。里面有什么，型号表说了算。"},{"id":"anrelic_04","name":"死者的工号牌","rarity":"common","veins":["light"],"effect_text":"每场战斗开始时，凝视 +1。","effect_code":[{"trigger":"combat_start","action":"gaze","value":1}],"flavor":"工号还在发信号。收信号的设备全在下面。"},{"id":"anrelic_05","name":"例检清单（完整版）","rarity":"uncommon","veins":["mineral"],"effect_text":"每场战斗开始时，获得 4 点格挡。","effect_code":[{"trigger":"combat_start","action":"block","value":4}],"flavor":"关键项一个不缺。缺的是能看懂关键项的人。"},{"id":"anrelic_06","name":"静默段徽记","rarity":"uncommon","veins":["tremor"],"effect_text":"每回合开始时，共振 +2。","effect_code":[{"trigger":"turn_start","action":"resonance","value":2}],"flavor":"徵记授给撑过最长静默段的人。静默段还在继续。"},{"id":"anrelic_07","name":"保运行批文（已签）","rarity":"uncommon","veins":["water"],"effect_text":"每场战斗开始时，回复 3 点生命。","effect_code":[{"trigger":"combat_start","action":"heal","value":3}],"flavor":"批复人栏有名字。名字属于一个没有编号的人。"},{"id":"anrelic_08","name":"备件配给卡","rarity":"common","veins":["mineral"],"effect_text":"每场战斗开始时，获得 2 点格挡。","effect_code":[{"trigger":"combat_start","action":"block","value":2}],"flavor":"每月配给一次。配给站五百年没开过门，卡还能刷。"},{"id":"anrelic_09","name":"读图纸的手套","rarity":"uncommon","veins":["light"],"effect_text":"每场战斗开始时，抽 1 张牌，凝视 +1。","effect_code":[{"trigger":"combat_start","action":"draw","value":1},{"trigger":"combat_start","action":"gaze","value":1}],"flavor":"戴上它，图纸上的字会排队站好。摘下之后你不敢再想。"},{"id":"anrelic_10","name":"编号印章","rarity":"uncommon","veins":["mineral"],"effect_text":"每回合开始时，共振 +2。","effect_code":[{"trigger":"turn_start","action":"resonance","value":2}],"flavor":"印下去的编号永久有效。印在活物上的也有效。"},{"id":"anrelic_11","name":"封存册残页","rarity":"rare","veins":["mineral"],"effect_text":"格挡保留到下一回合；每场战斗开始时，格挡 +3。","effect_code":[{"trigger":"combat_start","action":"block","value":3}],"mod":{"keep_block":true},"flavor":"残页记着三件封存物。三件的封存原因栏都是空的。"},{"id":"anrelic_12","name":"应急照明电池","rarity":"common","veins":["light"],"effect_text":"每回合开始时，抽 1 张牌。","effect_code":[{"trigger":"turn_start","action":"draw","value":1}],"flavor":"电池标注寿命两千年。标错了一个数量级，朝着好的方向。"},{"id":"anrelic_13","name":"修复凝胶（过期）","rarity":"uncommon","veins":["water"],"effect_text":"击杀敌人时回复 3 点生命。","effect_code":[{"trigger":"on_kill","action":"heal","value":3}],"flavor":"过期之后凝胶学会了新用法。说明书没跟上它。"},{"id":"anrelic_14","name":"血统册摘录","rarity":"rare","veins":["water"],"effect_text":"每场战斗开始时，回复 4 点生命。","effect_code":[{"trigger":"combat_start","action":"heal","value":4}],"flavor":"摘录只留了一行：待修，待修，待修。你的名字在下一行。"},{"id":"anrelic_15","name":"主控密钥（烧毁）复刻件","rarity":"rare","veins":["light"],"effect_text":"每场战斗开始时，抽 1 张牌，凝视 +1。","effect_code":[{"trigger":"combat_start","action":"draw","value":1},{"trigger":"combat_start","action":"gaze","value":1}],"flavor":"复刻件没有权限。权限在原件烧掉的那半里。它假装不知道。"}],"anminEvents":[{"id":"anevent_01","layer":1,"title":"还在运转的机器","body":"走廊尽头一台通风机组还在转。转了两千年，噪声盖过了你的脚步。拆了它，避难所的循环会好一点；但它转了这么久，没打扰过任何人。","options":[{"text":"拆了它。","veins":["mineral"],"result":{"gold":40,"damage":4},"result_text":"拆除用时七分钟。零件计入你的库存。机组停转的瞬间，走廊深处有什么换了个姿势。"},{"text":"给它做一次例检。","veins":["light"],"result":{"heal":8,"gaze":1},"result_text":"你逐项打钩。它逐项通过。临走时它的转速稳了一点，像被人管过一次。"},{"text":"什么都不做。","veins":[],"result":{},"result_text":"你贴墙走过去了。它没有理由注意你，你没有理由给它一个。"}]},{"id":"anevent_02","layer":1,"title":"死者的工号牌","body":"地面上一排工号牌，摆放整齐，间距一致。每块牌的信号灯都还亮着。签收栏全部空白。","options":[{"text":"登录其中一块。","veins":["light"],"result":{"gaze":2,"gold":25},"result_text":"登录成功。欢迎信息显示了持有者的名字。名字后面跟着一行：预计返回时间，已过期。"},{"text":"按原样摆好，补齐间距。","veins":["tremor"],"result":{"heal":6},"result_text":"你把歪的那块扶正了。整排牌子一起闪了一下，像完成了一次交接。"},{"text":"什么都不做。","veins":[],"result":{},"result_text":"你绕开这排牌子走。身后的信号灯逐块熄灭，轮到你经过的那块时停了。"}]},{"id":"anevent_03","layer":2,"title":"等命令的维护单元","body":"一个维护单元立在岔口，屏幕上循环着一行字：等待指令。它的备件舱是满的，滤芯是新的，站姿是标准的。","options":[{"text":"向它下达一条指令。","veins":["mineral"],"result":{"gold":35,"damage":4},"result_text":"你让它打开备件舱。它照做了，然后把你也登记成了指挥链的一环。脱链的时候要出点血。"},{"text":"给它签一张假例检单。","veins":["light"],"result":{"heal":10,"gaze":1},"result_text":"签收成功。它有了新的执勤周期。你有了五百年里第一个被它道谢的记录。"},{"text":"绕开它。","veins":[],"result":{},"result_text":"你从它身后过。它没有转头。等待指令的单元不看指令以外的东西。"}]},{"id":"anevent_04","layer":2,"title":"封存原因栏为空的舱室","body":"三号避难所已封存。封存原因栏为空。封存日期是避难所历一百二十年，战争的第一个年头。","options":[{"text":"破开封条进去。","veins":["mineral"],"result":{"damage":5,"card_reward":"uncommon"},"result_text":"舱内一切如常，像刚有人离开。桌上放着一台还在运行的核算终端。"},{"text":"读门禁记录。","veins":["light"],"result":{"gaze":2},"result_text":"最后一条进出门禁记录是两分钟前。日期栏的格式是两千年前的。"},{"text":"把封条重新贴牢。","veins":[],"result":{},"result_text":"你贴得很平整。有些舱室封着，是因为里面的人想让它封着。"}]},{"id":"anevent_05","layer":3,"title":"血统册的最后一页","body":"血统册摊开在登记台上，最后一页只写了一半。墨迹突然中断，中断处有一个手按的印记，五指分明。","options":[{"text":"补完这一页。","veins":["light"],"result":{"gaze":1,"card_reward":"uncommon"},"result_text":"你按中断的笔迹续写。写到一半发现，续写的内容开始自己往下走。"},{"text":"把册子合上，归位。","veins":["tremor"],"result":{"heal":10},"result_text":"册子归位时发出一声轻响。登记台把你的手印也记了进去。"},{"text":"把这一页撕下来带走。","veins":["mineral"],"result":{"gold":35},"result_text":"纸很韧。撕口整齐。手印留在了册子上，少了一半。"}]},{"id":"anevent_06","layer":3,"title":"氧气核算差额","body":"核算屏显示：氧气存量超出预期 4%。避难所里没有多余的人。差额每天准时出现，准时被消耗。","options":[{"text":"追查消耗去向。","veins":["light"],"result":{"gaze":2,"damage":4},"result_text":"消耗记录指向一个没有编号的舱室。门是温的，你没有推。"},{"text":"按差额上调配给。","veins":["water"],"result":{"heal":14},"result_text":"多出来的氧气分给了所有人。核算屏当天恢复了平衡，像从来没差额过。"},{"text":"在报表上抹平。","veins":["mineral"],"result":{"gold":30},"result_text":"差额归零。报表干干净净。有些数字学会了不上账。"}]},{"id":"anevent_07","layer":1,"title":"读得懂的人的房间","body":"避难所里那位读得懂图纸的人死了。房间按原样封存。图纸摊开在桌上，第一页画着一个圈，圈里写着：看懂这页之前，别往下翻。","options":[{"text":"翻到第二页。","veins":["light"],"result":{"gaze":2,"card_reward":"uncommon"},"result_text":"第二页只有一句话：你翻得比我快。图纸剩下的部分，我们下面见。"},{"text":"只研究第一页的圈。","veins":["tremor"],"result":{"heal":8},"result_text":"圈不是圆的，是井口的俯视图。比例尺对上了，你对上了一半。"},{"text":"按遗嘱封存房间。","veins":[],"result":{},"result_text":"封条贴好。封存原因栏，你斟酌了很久，写了：他在学习。"}]},{"id":"anevent_08","layer":2,"title":"例检单要签字","body":"一台机械把例检单递到你面前。单子上的设备不是它。设备位置：你身后第三扇门。","options":[{"text":"签了。","veins":["mineral"],"result":{"gaze":1,"gold":25},"result_text":"签收成功。身后第三扇门开了一条缝。机械收走了单子，替你把门带上了。"},{"text":"拒签。","veins":["tremor"],"result":{"damage":5},"result_text":"拒签记录存档。机械退后一步，把例检单撕了。它第一次自己撕单子。"},{"text":"要求它先解释设备位置。","veins":["light"],"result":{"heal":8,"gaze":1},"result_text":"它调出图纸。图纸上那扇门不存在。图纸比门老，门比图纸新。"}]},{"id":"anevent_09","layer":2,"title":"运输井状态：运转中","body":"井口状态屏亮着：运转中。这口井的通行目的地栏为空。井底的送风是新的，往上的。","options":[{"text":"下井。","veins":["tremor"],"result":{"damage":6,"card_reward":"uncommon"},"result_text":"井比你查过的任何记录都深。落点是一间亮着灯的空机房，机器都在等交接班。"},{"text":"往井里喊一声。","veins":["light"],"result":{"gaze":1,"heal":6},"result_text":"回声隔了很久才回来。回声里多了一层机械混响，像有人在底下应答。"},{"text":"把状态屏改回停运。","veins":["mineral"],"result":{"gold":28},"result_text":"屏改了。井底的送风没有停。状态栏学会了说谎，井没有。"}]},{"id":"anevent_10","layer":3,"title":"静默段二十年","body":"本避难所的事故间隔纪录：二十个核算年。值班室墙上挂着长表，二十年里只有一个日期被圈了出来，没有批注。","options":[{"text":"查被圈出的日期。","veins":["light"],"result":{"gaze":2,"gold":30},"result_text":"那一年的档案是空的。空档案的封存原因栏写着：别查。字迹是值班室的。"},{"text":"继续守静默段。","veins":["tremor"],"result":{"heal":12},"result_text":"你在值班室坐了一天一夜。没有事故。第二十一年开始了。"},{"text":"故意弄出一声响。","veins":["heat"],"result":{"damage":6},"result_text":"响声传遍避难所。纪录清零。墙上长表换新的时候，你听见了几百扇门同时松了一口气。"}]}],"cangmin":[{"id":"cng_0001","name":"守夜","class":"cangmin","type":"skill","dream":false,"rarity":"common","veins":["light"],"energy":0,"effect":{"block":4,"target":"self"},"cost_type":"none","cost_text":"","flavor":"不睡，梦就不会破。不睡，明天也不会来。两件事我选了一夜。","upgrade":{"name_suffix":"·固","effect":{"block":6},"flavor_add":"第二夜守完了。第三夜的借口还没想好。"}},{"id":"cng_0002","name":"王国账簿","class":"cangmin","type":"skill","dream":false,"rarity":"common","veins":["mineral"],"energy":1,"effect":{"draw":1,"target":"self"},"cost_type":"none","cost_text":"","flavor":"王国的账记到一千三百年前。后面是空白，空白也算账。","upgrade":{"name_suffix":"·旧","effect":{"draw":2},"flavor_add":"空白页有人续了一行。字迹是新的。"}},{"id":"cng_0003","name":"巨神的欠条","class":"cangmin","type":"skill","dream":false,"rarity":"common","veins":["mineral"],"energy":1,"effect":{"block":6,"target":"self"},"cost_type":"none","cost_text":"","flavor":"巨神拿走了火母，欠我们一个天亮。欠条没有落款日期。","upgrade":{"name_suffix":"·Ⅱ","effect":{"block":9},"flavor_add":"利息开始计了。巨神没有还钱的意思。"}},{"id":"cng_0004","name":"灰藻汤","class":"cangmin","type":"skill","dream":false,"rarity":"common","veins":["water"],"energy":1,"effect":{"heal":5,"target":"self"},"cost_type":"none","cost_text":"","flavor":"灰藻是酸的。酸是好事，酸说明海还认得旧配方。","upgrade":{"name_suffix":"·新","effect":{"heal":8},"flavor_add":"汤里多了一块红的。没人敢问是哪来的。"}},{"id":"cng_0005","name":"巡夜灯","class":"cangmin","type":"skill","dream":false,"rarity":"common","veins":["light"],"energy":1,"effect":{"block":5,"target":"self"},"cost_type":"none","cost_text":"","flavor":"灯照三步。三步之外交给神。","upgrade":{"name_suffix":"·固","effect":{"block":7},"flavor_add":"灯芯换成了双的。神多收到了一份。"}},{"id":"cng_0006","name":"守夜人的表","class":"cangmin","type":"skill","dream":false,"rarity":"uncommon","veins":["light"],"energy":0,"effect":{"draw":1,"target":"self"},"cost_type":"none","cost_text":"","flavor":"光父每五十天绕一圈。我的表每小时绕一圈。总得有一样是准的。","upgrade":{"name_suffix":"·新","effect":{"draw":2},"flavor_add":"表快了。快的那部分借给了梦。"}},{"id":"cng_0007","name":"星表检索","class":"cangmin","type":"skill","dream":false,"rarity":"uncommon","veins":["light"],"energy":1,"effect":{"draw":2,"target":"self"},"cost_type":"none","cost_text":"","flavor":"星表第一页画着火母。第一页翻得最烂。","upgrade":{"name_suffix":"·Ⅱ","effect":{"draw":3},"flavor_add":"星表第二页开始没有火母。第二页很新。"}},{"id":"cng_0008","name":"历法之争","class":"cangmin","type":"skill","dream":false,"rarity":"rare","veins":["light"],"energy":1,"effect":{"draw":2,"block":4,"target":"self"},"cost_type":"none","cost_text":"","flavor":"两派为一息的长度打了十年。后来火母走了，架白吵了。","upgrade":{"name_suffix":"·新","effect":{"block":7},"flavor_add":"第十一年，两派合写了一份新历。第一个单位是：失踪。"}},{"id":"cng_0009","name":"光父的准点","class":"cangmin","type":"skill","dream":false,"rarity":"uncommon","veins":["light"],"energy":1,"effect":{"block":8,"target":"self"},"cost_type":"none","cost_text":"","flavor":"光父今夜准时。巨神今夜准时。只有该回来的那位，不准时。","upgrade":{"name_suffix":"·Ⅱ","effect":{"block":11},"flavor_add":"准时的两位被念了一整夜。不准时的欠了一整夜。"}},{"id":"cng_0010","name":"忆盐","class":"cangmin","type":"skill","dream":false,"rarity":"common","veins":["water"],"energy":0,"effect":{"heal":3,"target":"self"},"cost_type":"none","cost_text":"","flavor":"盐是灰的。梦是红的。嚼一口，账就记在火母那边。","upgrade":{"name_suffix":"·Ⅱ","effect":{"heal":5},"flavor_add":"梦里出现了颜色。第一种是红，第二种没记住。"}},{"id":"cng_0011","name":"猎巫者的谎","class":"cangmin","type":"skill","dream":false,"rarity":"uncommon","veins":["mineral"],"energy":1,"effect":{"block":7,"target":"self"},"cost_type":"none","cost_text":"","flavor":"猎巫人问我会不会飞。我说不会。他很高兴，多给了我半条鱼。","upgrade":{"name_suffix":"·改","effect":{"block":10},"flavor_add":"谎越撒越熟。半条鱼变成了整条。"}},{"id":"cng_0012","name":"母亲的祷文","class":"cangmin","type":"skill","dream":false,"rarity":"rare","veins":["water"],"energy":0,"effect":{"heal":6,"draw":1,"target":"self"},"cost_type":"none","cost_text":"","flavor":"她念到第三句就睡着。我抄下来，念到第三句，也睡着了。","upgrade":{"name_suffix":"·刻","effect":{"heal":9},"flavor_add":"第三句之后还有第四句。母亲没念过第四句。"}},{"id":"cng_0013","name":"灰藻供品","class":"cangmin","type":"skill","dream":false,"rarity":"common","veins":["water"],"energy":1,"effect":{"heal":4,"target":"self"},"cost_type":"none","cost_text":"","flavor":"供品摆在熄灭的方向。第二天供品还在，火母没吃，我自己吃了。","upgrade":{"name_suffix":"·旧","effect":{"heal":7},"flavor_add":"供品第二天少了一半。这次不是我。"}},{"id":"cng_0014","name":"伊格的方向","class":"cangmin","type":"skill","dream":false,"rarity":"common","veins":["light"],"energy":0,"effect":{"block":3,"draw":1,"target":"self"},"cost_type":"none","cost_text":"","flavor":"先找巨神的圆盘，再往左。火母的方向要用两步才能说清。","upgrade":{"name_suffix":"·Ⅱ","effect":{"block":5},"flavor_add":"现在只用一步。天上的东西也在挪。"}},{"id":"cng_0015","name":"守望席","class":"cangmin","type":"skill","dream":false,"rarity":"uncommon","veins":["light"],"energy":1,"effect":{"block":9,"target":"self"},"cost_type":"none","cost_text":"","flavor":"这是全城最体面的位置。体面在石头上磨出了坑。","upgrade":{"name_suffix":"·固","effect":{"block":12},"flavor_add":"坑又深了一点。体面是磨出来的。"}},{"id":"cng_0016","name":"火母历第一页","class":"cangmin","type":"skill","dream":false,"rarity":"rare","veins":["light"],"energy":1,"effect":{"draw":2,"heal":3,"target":"self"},"cost_type":"none","cost_text":"","flavor":"历法第一个单位是一息。观测对象没了，单位还在值班。","upgrade":{"name_suffix":"·刻","effect":{"heal":5},"flavor_add":"第一页末尾添了一笔小字：一息，约等于一次想念。"}},{"id":"cng_0017","name":"地下学院讲义","class":"cangmin","type":"skill","dream":false,"rarity":"special","veins":["light"],"energy":1,"effect":{"draw":2,"target":"self"},"cost_type":"none","cost_text":"","flavor":"第一页是呼吸法。我们练了十三代人，练会了呼吸。","upgrade":{"name_suffix":"·新","effect":{"draw":3},"flavor_add":"第二页开始出现批注。批注人是十三代人里最疯的那个。"}},{"id":"cng_0018","name":"巨神的凝视","class":"cangmin","type":"attack","dream":true,"rarity":"uncommon","veins":["mineral"],"energy":2,"effect":{"damage":13,"hits":1,"target":"single"},"cost_type":"none","cost_text":"","flavor":"在梦里，圆盘占四分之一的天。它看你的时候不用转身。","upgrade":{"name_suffix":"·Ⅱ","effect":{"damage":18},"flavor_add":"凝视聚焦了。梦里第一次有了影子。"}},{"id":"cng_0019","name":"王权梦","class":"cangmin","type":"power","dream":true,"rarity":"rare","veins":["mineral"],"energy":2,"effect":{"target":"self","special":[{"code":"strength","value":2}]},"cost_type":"none","cost_text":"","flavor":"梦里我也是王。醒来王冠留在枕头上，是灰藻编的。","upgrade":{"name_suffix":"·刻","effect":{"special":[{"code":"strength","value":1}]},"flavor_add":"梦里加了冕。加冕词用的是祷文第三句。"}},{"id":"cng_0020","name":"城墙梦","class":"cangmin","type":"skill","dream":true,"rarity":"uncommon","veins":["mineral"],"energy":2,"effect":{"block":14,"target":"self"},"cost_type":"none","cost_text":"","flavor":"梦里我把城墙修完了。修了一半的那半也长齐了。","upgrade":{"name_suffix":"·固","effect":{"block":19},"flavor_add":"城墙上加了塔。塔上有人，是我。"}},{"id":"cng_0021","name":"巨神的欠账","class":"cangmin","type":"attack","dream":true,"rarity":"uncommon","veins":["mineral"],"energy":1,"effect":{"damage":9,"hits":1,"target":"single"},"cost_type":"none","cost_text":"","flavor":"梦里我去讨债了。巨神的账房比醒着的城还大。","upgrade":{"name_suffix":"·Ⅱ","effect":{"damage":13},"flavor_add":"讨回来一角。一角在天上，我举不动。"}},{"id":"cng_0022","name":"卫星轨道","class":"cangmin","type":"attack","dream":true,"rarity":"rare","veins":["mineral"],"energy":2,"effect":{"damage":8,"hits":2,"target":"single"},"cost_type":"none","cost_text":"","flavor":"我沿着轨道跑。跑一圈二十一晚，每一晚都撞上同一个敌人。","upgrade":{"name_suffix":"·Ⅱ","effect":{"damage":11},"flavor_add":"轨道压低了。擦着它的头皮过。"}},{"id":"cng_0023","name":"潮汐锁","class":"cangmin","type":"skill","dream":true,"rarity":"rare","veins":["water"],"energy":1,"effect":{"block":12,"target":"self"},"cost_type":"none","cost_text":"","flavor":"潮汐锁住的是脸的方向。梦里我把它锁在了敌人身上。","upgrade":{"name_suffix":"·刻","effect":{"block":16},"flavor_add":"它挣了一下。锁环上多了一道它的爪痕。"}},{"id":"cng_0024","name":"暗盘俯瞰","class":"cangmin","type":"attack","dream":true,"rarity":"special","veins":["mineral"],"energy":2,"effect":{"damage":10,"hits":1,"target":"all"},"cost_type":"none","cost_text":"","flavor":"我从圆盘的高度往下看。梦里的一切都小，小到可以一次收拾。","upgrade":{"name_suffix":"·Ⅱ","effect":{"damage":14},"flavor_add":"俯瞰的角度练熟了。梦里也开始有重力和疼。"}},{"id":"cng_0025","name":"沉默权柄","class":"cangmin","type":"power","dream":true,"rarity":"special","veins":["mineral"],"energy":2,"effect":{"target":"self","special":[{"code":"thorns","value":4}]},"cost_type":"none","cost_text":"","flavor":"巨神一万年不说话。不说话的东西最吓人，也最硬。","upgrade":{"name_suffix":"·刻","effect":{"special":[{"code":"thorns","value":2}]},"flavor_add":"巨神在梦里开了口。只对我，只说了一个字。"}},{"id":"cng_0026","name":"光父的钟摆","class":"cangmin","type":"attack","dream":true,"rarity":"uncommon","veins":["light"],"energy":1,"effect":{"damage":7,"hits":1,"target":"single"},"cost_type":"none","cost_text":"","flavor":"钟摆左右摆。左边是昨天，右边是明天，中间是它砸下来的地方。","upgrade":{"name_suffix":"·改","effect":{"damage":10},"flavor_add":"摆幅加大了。昨天和明天都被砸中了。"}},{"id":"cng_0027","name":"红矮星风","class":"cangmin","type":"attack","dream":true,"rarity":"common","veins":["light"],"energy":1,"effect":{"damage":8,"hits":1,"target":"single"},"cost_type":"none","cost_text":"","flavor":"光父吹过来的风是暗红的。风里全是别处的火。","upgrade":{"name_suffix":"·新","effect":{"damage":11},"flavor_add":"风里多了一缕熟悉的红。我追了两步。"}},{"id":"cng_0028","name":"五十日","class":"cangmin","type":"skill","dream":true,"rarity":"rare","veins":["light"],"energy":1,"effect":{"block":10,"target":"self","special":[{"code":"regenerate","value":2}]},"cost_type":"none","cost_text":"","flavor":"五十天一个周期。我在梦里把五十天过成五十个夜。","upgrade":{"name_suffix":"·新","effect":{"block":13},"flavor_add":"第五十夜，钟摆停了。停摆的那晚最安全。"}},{"id":"cng_0029","name":"耀斑记忆","class":"cangmin","type":"attack","dream":true,"rarity":"uncommon","veins":["heat"],"energy":2,"effect":{"damage":12,"hits":1,"target":"single"},"cost_type":"none","cost_text":"","flavor":"光父发脾气我见过一次。梦里它冲我发脾气。受宠若惊。","upgrade":{"name_suffix":"·Ⅱ","effect":{"damage":16},"flavor_add":"第二次发脾气是冲着我的敌人。排位清楚了。"}},{"id":"cng_0030","name":"星光残照","class":"cangmin","type":"skill","dream":true,"rarity":"common","veins":["light"],"energy":1,"effect":{"block":9,"target":"self"},"cost_type":"none","cost_text":"","flavor":"星光很淡。淡光照见的东西，白天看不见。","upgrade":{"name_suffix":"·旧","effect":{"block":12},"flavor_add":"残照里走过来一个人影。走得很熟。"}},{"id":"cng_0031","name":"光父的审判","class":"cangmin","type":"attack","dream":true,"rarity":"rare","veins":["light"],"energy":2,"effect":{"damage":16,"hits":1,"target":"single"},"cost_type":"none","cost_text":"","flavor":"审判准时开始。被告席空着，判给了在场所有的东西。","upgrade":{"name_suffix":"·刻","effect":{"damage":21},"flavor_add":"判决书烧了。烧判决书的火比审判亮。"}},{"id":"cng_0032","name":"准时的心跳","class":"cangmin","type":"skill","dream":true,"rarity":"uncommon","veins":["light"],"energy":1,"effect":{"block":7,"heal":3,"target":"self"},"cost_type":"none","cost_text":"","flavor":"梦里我的心跳和光父同步。第一次同步的时候我哭了，梦里不知道。","upgrade":{"name_suffix":"·新","effect":{"heal":5},"flavor_add":"同步稳定了。心跳和我，总有一个是假的。"}},{"id":"cng_0033","name":"昴宿低语","class":"cangmin","type":"skill","dream":true,"rarity":"rare","veins":["light"],"energy":0,"effect":{"draw":2,"target":"self"},"cost_type":"none","cost_text":"","flavor":"光父说话很轻。它说：你母亲那颗星，我认识。","upgrade":{"name_suffix":"·新","effect":{"draw":3},"flavor_add":"它认识的不止一颗。它认识整个走散的家。"}},{"id":"cng_0034","name":"火母的怀抱","class":"cangmin","type":"attack","dream":true,"rarity":"uncommon","veins":["heat"],"energy":2,"effect":{"damage":10,"hits":1,"target":"single","special":[{"code":"burn","value":3,"turns":3}]},"cost_type":"none","cost_text":"","flavor":"抱住它的时候要忍住不哭。眼泪在梦里是助燃的。","upgrade":{"name_suffix":"·Ⅱ","effect":{"damage":14},"flavor_add":"这次没忍住。烧得更旺了，怪我。"}},{"id":"cng_0035","name":"伊格的痛苦","class":"cangmin","type":"attack","dream":true,"rarity":"rare","veins":["heat"],"energy":2,"effect":{"damage":7,"hits":1,"target":"all"},"cost_type":"none","cost_text":"","flavor":"她在梦里喊疼。我醒了，枕头是湿的，是红的。","upgrade":{"name_suffix":"·Ⅱ","effect":{"damage":10},"flavor_add":"疼痛分了级。最重的那级，她替我承受。"}},{"id":"cng_0036","name":"归乡","class":"cangmin","type":"skill","dream":true,"rarity":"rare","veins":["heat"],"energy":1,"effect":{"heal":10,"target":"self"},"cost_type":"none","cost_text":"","flavor":"梦里往回走。走到一半想起，老家已经是别人的星球了。","upgrade":{"name_suffix":"·刻","effect":{"heal":14},"flavor_add":"老家到了。门口坐着的影子站起来让我进。"}},{"id":"cng_0037","name":"影语","class":"cangmin","type":"attack","dream":true,"rarity":"special","veins":["tremor"],"energy":1,"effect":{"damage":9,"hits":1,"target":"single","special":[{"code":"weak","turns":2}]},"cost_type":"none","cost_text":"","flavor":"穹顶之影的话要倒着听。它说欢迎，意思是别走。","upgrade":{"name_suffix":"·残","effect":{"damage":12},"flavor_add":"这次我正着回了话。它沉默的方式变了。"}},{"id":"cng_0038","name":"震喉","class":"cangmin","type":"attack","dream":true,"rarity":"special","veins":["tremor"],"energy":2,"effect":{"damage":6,"hits":3,"target":"single"},"cost_type":"none","cost_text":"","flavor":"震喉的话不用听，站在声里就算读过。","upgrade":{"name_suffix":"·Ⅱ","effect":{"damage":8},"flavor_add":"三声之后还有第四声。第四声是我的回音。"}},{"id":"cng_0039","name":"光导","class":"cangmin","type":"skill","dream":true,"rarity":"special","veins":["light"],"energy":1,"effect":{"block":8,"draw":1,"target":"self"},"cost_type":"none","cost_text":"","flavor":"光蛭母把光分给你，也多要一点。利率面议。","upgrade":{"name_suffix":"·Ⅱ","effect":{"block":11},"flavor_add":"这次它多给了。多给的部分开始计息。"}},{"id":"cng_0040","name":"墟语","class":"cangmin","type":"attack","dream":true,"rarity":"rare","veins":["tremor"],"energy":2,"effect":{"damage":18,"hits":1,"target":"single"},"cost_type":"none","cost_text":"","flavor":"墟蛹的遗言很长。我在梦里只抄了伤害的部分。","upgrade":{"name_suffix":"·Ⅱ","effect":{"damage":24},"flavor_add":"遗言抄完了。最后一句是给我所在的时代。"}},{"id":"cng_0041","name":"红藻花园","class":"cangmin","type":"skill","dream":true,"rarity":"uncommon","veins":["water"],"energy":1,"effect":{"heal":8,"target":"self"},"cost_type":"none","cost_text":"","flavor":"梦里红藻是活的。一千三百年了，它们在梦里没死过。","upgrade":{"name_suffix":"·Ⅱ","effect":{"heal":12},"flavor_add":"花园扩建了。扩建的种子是我醒来后咳出来的。"}},{"id":"cng_0042","name":"火母的回应","class":"cangmin","type":"power","dream":true,"rarity":"rare","veins":["heat"],"energy":2,"effect":{"target":"self","special":[{"code":"regenerate","value":3}]},"cost_type":"none","cost_text":"","flavor":"我喊了火母一声。回应迟到了一千三百年，但押着韵。","upgrade":{"name_suffix":"·刻","effect":{"special":[{"code":"regenerate","value":2}]},"flavor_add":"回应开始带下文。下文是火母的字迹。"}},{"id":"cng_0043","name":"猎巫者的绳","class":"cangmin","type":"skill","dream":false,"rarity":"common","veins":["mineral"],"energy":1,"effect":{"block":7,"target":"self"},"cost_type":"none","cost_text":"","flavor":"绳打的是活结。猎巫人讲究效率，活结能重复用。","upgrade":{"name_suffix":"·改","effect":{"block":10},"flavor_add":"绳换了粗的。被捆的人开始反抗了。"}},{"id":"cng_0044","name":"三体历残卷","class":"cangmin","type":"skill","dream":false,"rarity":"uncommon","veins":["light"],"energy":1,"effect":{"draw":1,"target":"self"},"cost_type":"none","cost_text":"","flavor":"残卷记着三个天体的位置。有两个还准，一个在等。","upgrade":{"name_suffix":"·Ⅱ","effect":{"draw":2},"flavor_add":"第三个位置有了新坐标。是有人后来补的。"}},{"id":"cng_0045","name":"晨昏带地图","class":"cangmin","type":"skill","dream":false,"rarity":"common","veins":["mineral"],"energy":1,"effect":{"block":5,"target":"self"},"cost_type":"none","cost_text":"","flavor":"晨昏带是唯一不冷不热的地方。地图上它细得像一根线。","upgrade":{"name_suffix":"·固","effect":{"block":7},"flavor_add":"线上多了一个点。点是我今晚的落脚处。"}},{"id":"cng_0046","name":"火母的小像","class":"cangmin","type":"skill","dream":false,"rarity":"common","veins":["heat"],"energy":0,"effect":{"heal":3,"target":"self"},"cost_type":"none","cost_text":"","flavor":"小像拿红藻灰捏的。捏得不像。她走的时候我们也没看清。","upgrade":{"name_suffix":"·新","effect":{"heal":5},"flavor_add":"像重捏了一遍。捏得更不像了，但更像她。"}},{"id":"cng_0047","name":"不醒者的名单","class":"cangmin","type":"skill","dream":false,"rarity":"rare","veins":["light"],"energy":1,"effect":{"draw":2,"target":"self"},"cost_type":"none","cost_text":"","flavor":"名单上的人都在梦里没回来。名字之间画着线，像亲缘图。","upgrade":{"name_suffix":"·Ⅱ","effect":{"draw":3},"flavor_add":"名单末尾空了一行。空行的墨迹是湿的。"}},{"id":"cng_0048","name":"猎巫巡逻·换防","class":"cangmin","type":"attack","dream":false,"rarity":"uncommon","veins":["mineral"],"energy":1,"effect":{"damage":9,"hits":1,"target":"single"},"cost_type":"none","cost_text":"","flavor":"巡逻队换防要查火把。火把照不了梦，他们不信。","upgrade":{"name_suffix":"·Ⅱ","effect":{"damage":12},"flavor_add":"查完火把查了梦。我的梦很干净，干净得可疑。"}},{"id":"cng_0049","name":"岩洞集会","class":"cangmin","type":"skill","dream":false,"rarity":"common","veins":["mineral"],"energy":1,"effect":{"block":6,"draw":1,"target":"self"},"cost_type":"none","cost_text":"","flavor":"集会议题：今晚谁守夜。全票通过：不是我。","upgrade":{"name_suffix":"·Ⅱ","effect":{"block":8},"flavor_add":"议题改了：今晚谁先睡。还是全票通过。"}},{"id":"cng_0050","name":"疯先知的笔记","class":"cangmin","type":"power","dream":false,"rarity":"special","veins":["water"],"energy":1,"effect":{"target":"self","special":[{"code":"dexterity","value":2}]},"cost_type":"mark","cost_text":"笔记传抄时会顺手抄走读者的一段睡眠。","upgrade":{"name_suffix":"·刻","effect":{"special":[{"code":"dexterity","value":1}]},"flavor_add":"笔记传到我手里时多了个封套。封套里是一小撮灰，红的。"},"flavor":"笔记传到我手里时多了个封套。封套里是一小撮灰，红的。"}],"cngEnemies":[{"id":"cngenemy_01","name":"浅海鳗","layer":1,"tier":"normal","hp":"15-19","intent_pattern":[{"type":"attack","value":5},{"type":"defend","value":4}],"traits":[],"flavor":"浅海剩的最后一种大鱼。它咬人的方式和一千三百年前一样，只是咬得慢了。"},{"id":"cngenemy_02","name":"岩洞猎手","layer":1,"tier":"normal","hp":"16-20","intent_pattern":[{"type":"attack","value":4,"times":2},{"type":"defend","value":4}],"traits":[],"flavor":"同族。他打你的招式和打猎巫人的招式是同一套，谁给粮他打谁。"},{"id":"cngenemy_03","name":"盐虫群","layer":1,"tier":"normal","hp":"13-16","intent_pattern":[{"type":"attack","value":3,"times":2},{"type":"defend","value":3}],"traits":[],"flavor":"盐虫啃石头上的盐霜。现在盐霜少了，它们开始啃别的。"},{"id":"cngenemy_04","name":"灰藻采集者","layer":1,"tier":"normal","hp":"14-18","intent_pattern":[{"type":"attack","value":4},{"type":"attack","value":3},{"type":"defend","value":4}],"traits":[],"flavor":"她采灰藻养全家。你站的地方是她今天的第一块藻田。"},{"id":"cngenemy_05","name":"猎巫巡逻队","layer":2,"tier":"normal","hp":"20-26","intent_pattern":[{"type":"attack","value":6},{"type":"attack","value":4},{"type":"defend","value":5}],"traits":[],"flavor":"火把很亮。火把照不到的地方才是他们的辖区。"},{"id":"cngenemy_06","name":"饥荒影","layer":2,"tier":"normal","hp":"18-24","intent_pattern":[{"type":"attack","value":5},{"type":"attack","value":5},{"type":"defend","value":4}],"traits":[],"flavor":"不是生物，是短缺本身在人身上留下的形状。瘦得哲学。"},{"id":"cngenemy_07","name":"红蕨幻影","layer":2,"tier":"normal","hp":"22-28","intent_pattern":[{"type":"attack","value":6},{"type":"attack","value":5},{"type":"defend","value":5}],"traits":[],"flavor":"梦里红蕨是红的。它们扎根的方式和灰藻一样谦卑。"},{"id":"cngenemy_08","name":"热泉梦泡","layer":2,"tier":"normal","hp":"20-26","intent_pattern":[{"type":"attack","value":5,"times":2},{"type":"defend","value":4}],"traits":[],"flavor":"一串泡从梦的底部浮上来。破的时候是温的，温得难过。"},{"id":"cngenemy_09","name":"水脉回声","layer":2,"tier":"normal","hp":"24-30","intent_pattern":[{"type":"attack","value":6},{"type":"attack","value":5},{"type":"defend","value":6}],"traits":[],"flavor":"水脉在梦里还在流。回声是它流过你身边时说的话，你听不懂，但很耳熟。"},{"id":"cngenemy_10","name":"巨怪投影","layer":2,"tier":"normal","hp":"30-36","intent_pattern":[{"type":"attack","value":7},{"type":"defend","value":6},{"type":"attack","value":6}],"traits":[],"flavor":"真身睡了多久，投影就模糊多久。模糊不影响它挡路。"},{"id":"cngenemy_11","name":"自己的镜像","layer":3,"tier":"elite","hp":"58-68","intent_pattern":[{"type":"attack","value":8,"times":2},{"type":"defend","value":9},{"type":"attack","value":9}],"traits":[],"flavor":"它出你的牌，用你的犹豫。它比你多一样东西：它不慌。"},{"id":"cngenemy_12","name":"影语投影","layer":3,"tier":"elite","hp":"60-70","intent_pattern":[{"type":"buff","value":5},{"type":"attack","value":9},{"type":"defend","value":9},{"type":"attack","value":9}],"traits":[],"flavor":"穹顶之影在苍民梦里只会说一句话。投影把这句话放了一千三百年。"},{"id":"cngenemy_13","name":"震喉回声","layer":3,"tier":"elite","hp":"56-66","intent_pattern":[{"type":"attack","value":7,"times":3},{"type":"defend","value":8},{"type":"attack","value":9}],"traits":[],"flavor":"三声一组的回声。第一声给守夜的，第二声给睡着的，第三声给你。"},{"id":"cngenemy_14","name":"光导残光","layer":3,"tier":"normal","hp":"34-40","intent_pattern":[{"type":"attack","value":8},{"type":"defend","value":8}],"traits":[],"flavor":"光导者分剩的光。它在梦里找接盘的人，找了一千三百年。"},{"id":"cngenemy_15","name":"墟语残章","layer":3,"tier":"normal","hp":"36-42","intent_pattern":[{"type":"attack","value":9},{"type":"attack","value":7},{"type":"defend","value":8}],"traits":[],"flavor":"墟蛹遗言的碎片。碎片见字就念，念到谁的名字谁倒霉。"},{"id":"cngenemy_16","name":"不醒者·初代疯先知","layer":3,"tier":"boss","hp":105,"intent_pattern":[{"type":"attack","value":8},{"type":"buff","value":5},{"type":"defend","value":9},{"type":"attack","value":12}],"traits":[],"flavor":"一千三百年前第一个走进梦里没回来的人。他不是被困住了。他是自愿的看守，看守这个梦不塌。","phases":[{"hp_above":0.66,"log":"不醒者开口了。声音和你的一模一样，只是老了一千三百年。","intent_pattern":[{"type":"attack","value":7},{"type":"attack","value":7},{"type":"defend","value":9}]},{"hp_above":0.33,"log":"他说：我守着一千三百年，就是为了把梦交还给能醒的人。","intent_pattern":[{"type":"buff","value":5},{"type":"attack","value":9},{"type":"defend","value":9},{"type":"attack","value":11}]},{"hp_above":0,"log":"他松手了。梦开始塌。他把最后一道门留给了你，门的方向是醒。","intent_pattern":[{"type":"attack","value":8,"times":2},{"type":"attack","value":11},{"type":"debuff","status":"weak","value":2}]}]}],"cngRelics":[{"id":"cngrelic_01","name":"伊格的碎片","rarity":"uncommon","veins":["heat"],"effect_text":"每场战斗开始时，凝视 +2。","effect_code":[{"trigger":"combat_start","action":"gaze","value":2}],"flavor":"碎片是红的，摸着是温的。它离开火母一千三百年，还是温的。"},{"id":"cngrelic_02","name":"母亲的祷文","rarity":"common","veins":["water"],"effect_text":"每回合开始时，回复 1 点生命。","effect_code":[{"trigger":"turn_start","action":"heal","value":1}],"flavor":"祷文只有三句。第三句念完人会睡，睡的人都说没梦见。"},{"id":"cngrelic_03","name":"地下学院的讲义","rarity":"uncommon","veins":["light"],"effect_text":"每场战斗开始时，抽 1 张牌。","effect_code":[{"trigger":"combat_start","action":"draw","value":1}],"flavor":"讲义第一页是呼吸法。十三代人练会了呼吸，第十四代开始练第二页。"},{"id":"cngrelic_04","name":"猎巫者的绳","rarity":"common","veins":["mineral"],"effect_text":"每场战斗开始时，获得 3 点格挡。","effect_code":[{"trigger":"combat_start","action":"block","value":3}],"flavor":"绳上没有血。猎巫人后来改行了，绳留作纪念。"},{"id":"cngrelic_05","name":"守夜人的座垫","rarity":"common","veins":["light"],"effect_text":"每场战斗开始时，获得 2 点格挡。","effect_code":[{"trigger":"combat_start","action":"block","value":2}],"flavor":"座垫磨穿的形状是一个人盘腿的样子。全城最体面的磨损。"},{"id":"cngrelic_06","name":"三体历残卷","rarity":"uncommon","veins":["light"],"effect_text":"每回合开始时，共振 +2。","effect_code":[{"trigger":"turn_start","action":"resonance","value":2}],"flavor":"残卷记着三个天体。有两个还准。"},{"id":"cngrelic_07","name":"火母的小像","rarity":"common","veins":["heat"],"effect_text":"每场战斗开始时，回复 2 点生命。","effect_code":[{"trigger":"combat_start","action":"heal","value":2}],"flavor":"捏得不像。但认她的人看一眼就知道是谁。"},{"id":"cngrelic_08","name":"忆盐袋","rarity":"common","veins":["water"],"effect_text":"每回合开始时，共振 +2。","effect_code":[{"trigger":"turn_start","action":"resonance","value":2}],"flavor":"袋口的盐少得很快。没人承认在偷吃。"},{"id":"cngrelic_09","name":"影语者的耳饰","rarity":"uncommon","veins":["tremor"],"effect_text":"每场战斗开始时，凝视 +1，抽 1 张牌。","effect_code":[{"trigger":"combat_start","action":"gaze","value":1},{"trigger":"combat_start","action":"draw","value":1}],"flavor":"耳饰会震。震的节奏和穹顶之影的台词同源。"},{"id":"cngrelic_10","name":"猎巫密册（残）","rarity":"rare","veins":["mineral"],"effect_text":"格挡保留到下一回合；每场战斗开始时，格挡 +3。","effect_code":[{"trigger":"combat_start","action":"block","value":3}],"mod":{"keep_block":true},"flavor":"密册记着被烧的人最后喊的地名。地名一个比一个深。"},{"id":"cngrelic_11","name":"光父星图","rarity":"rare","veins":["light"],"effect_text":"每回合开始时，抽 1 张牌。","effect_code":[{"trigger":"turn_start","action":"draw","value":1}],"flavor":"星图上昴宿画在最中间。画图的人把最准时的话事者摆在正位。"},{"id":"cngrelic_12","name":"倒扣的圣杯","rarity":"rare","veins":["water"],"effect_text":"每场战斗开始时，回复 4 点生命。","effect_code":[{"trigger":"combat_start","action":"heal","value":4}],"flavor":"杯倒扣着，谁也不敢翻开。翻开的先例都成了故事的开头。"},{"id":"cngrelic_13","name":"最后一页梦记","rarity":"rare","veins":["tremor"],"effect_text":"每场战斗开始时，抽 1 张牌，凝视 +1。","effect_code":[{"trigger":"combat_start","action":"draw","value":1},{"trigger":"combat_start","action":"gaze","value":1}],"flavor":"梦记最后一句：梦的入口在醒的出口旁边。字迹越来越轻。"},{"id":"cngrelic_14","name":"晨昏带贝壳","rarity":"common","veins":["water"],"effect_text":"每场战斗开始时，获得 2 点格挡。","effect_code":[{"trigger":"combat_start","action":"block","value":2}],"flavor":"贝壳里有一层灰。灰是火母的红藻碎的，一千三百年没褪色。"},{"id":"cngrelic_15","name":"不醒者的睫毛","rarity":"uncommon","veins":["tremor"],"effect_text":"每场战斗开始时，凝视 +2。","effect_code":[{"trigger":"combat_start","action":"gaze","value":2}],"flavor":"从他眼睛上取下的。取的时候他没醒，睫毛颤了一下。"}],"cngEvents":[{"id":"cngevent_01","layer":1,"title":"猎巫火堆的灰","body":"广场中央的火堆刚熄，灰还温着。灰里混着一样东西的残角，不是柴。围观的居民站成一个很标准的圆。","options":[{"text":"从灰里捡出那样东西。","veins":["mineral"],"result":{"gold":30,"gaze":1},"result_text":"是半块梦记板。板上记的梦只剩下最后一个词：伊格。围观的人退了半步。"},{"text":"把灰扫拢，埋进岩缝。","veins":["water"],"result":{"heal":8},"result_text":"你埋的时候没人帮忙，也没人阻拦。埋完之后圆散了，各自回家。"},{"text":"什么都不做。","veins":[],"result":{},"result_text":"你站着。风把最热的那层灰吹向你对面的人。他没躲。"}]},{"id":"cngevent_02","layer":1,"title":"守夜换岗","body":"守望席上的人该换岗了，换岗的人来了，坐在席上的人不动。两人之间隔着一块磨穿的座垫。","options":[{"text":"替他们交接。","veins":["light"],"result":{"heal":8,"gaze":1},"result_text":"你喊了口令。两个都不动。口令的尾音落在座垫上，被磨穿的位置接住了。"},{"text":"坐上守望席。","veins":["tremor"],"result":{"gaze":2,"damage":3},"result_text":"你坐下去的那一刻，全城的灯都朝这个方向看了一眼。席比看上去凉。"},{"text":"把座垫捧给换岗的人。","veins":[],"result":{},"result_text":"他接了。他没坐。抱着座垫的人开始往火母熄灭的方向走。"}]},{"id":"cngevent_03","layer":2,"title":"祖先的梦（壁画）","body":"岩洞深处的壁画记着夜游：一排小人飘向天上一个点。画壁的颜料是红的。画脚有一行小字：此画每年补色一次。","options":[{"text":"补一次色。","veins":["heat"],"result":{"gaze":2,"card_reward":"uncommon"},"result_text":"你用的是自己的血。补完最后一笔，画上的小人们一起朝你偏了偏头。"},{"text":"抄下小字。","veins":["light"],"result":{"gold":25},"result_text":"小字是份契约：补色者可优先入学地下学院。抄本拿去，学院的门真的开了条缝。"},{"text":"把火把移开。","veins":[],"result":{},"result_text":"黑暗里壁画看不见了。看不见的时候，颜料里的红反而更清楚。"}]},{"id":"cngevent_04","layer":2,"title":"祭祀的空坛","body":"祭坛上该摆祭品的位置空着，空位的灰尘很薄，说明有人每天来摆、每天收走。坛后的神像没有脸。","options":[{"text":"摆上一份自己的口粮。","veins":["water"],"result":{"heal":10,"gaze":1},"result_text":"你摆完就走。第二天路过，口粮没了，位置上留着一小撮红的灰。"},{"text":"给神像补一张脸。","veins":["light"],"result":{"card_reward":"common"},"result_text":"你补的脸很抽象。当晚全城的人做了同一个梦，梦里谁也没看清这张脸。"},{"text":"数一数灰尘的日子。","veins":["tremor"],"result":{"gaze":1},"result_text":"薄灰计了三天。三天里收走祭品的人没露面，手很稳。"}]},{"id":"cngevent_05","layer":2,"title":"深海里的一盏灯","body":"浅海底有一盏灯，亮着，灯罩里没有火。灯的样式是三神城邦联盟的官制。灯下的水比周围暖。","options":[{"text":"潜下去取灯。","veins":["water"],"result":{"damage":5,"card_reward":"uncommon"},"result_text":"灯是温的，水是冷的。灯芯没有火，亮的方式和梦里一样。"},{"text":"在岸边等灯浮上来。","veins":["light"],"result":{"heal":8},"result_text":"等到第三天，灯浮了。它靠岸的时候绕开了你，停在离你不远的水面。"},{"text":"记下灯的位置就走。","veins":[],"result":{},"result_text":"你在星图上做了标记。第二次路过时，灯的位置换了。它也在挪。"}]},{"id":"cngevent_06","layer":2,"title":"地下学院的入学试","body":"地下学院开门了，门缝里塞着入学试的题纸。题只有一道：描述火母离开那晚的天色。答题处是空白的。","options":[{"text":"凭记载答。","veins":["light"],"result":{"card_reward":"common"},"result_text":"你抄了史书的记载。门缝里递出批语：正确，但不合格。"},{"text":"凭梦答。","veins":["tremor"],"result":{"gaze":2,"card_reward":"uncommon"},"result_text":"你写：天色和火母走之前一样，变的是看的人。门开了一条缝，又合上了。"},{"text":"交白卷。","veins":[],"result":{},"result_text":"白卷被收走了。门缝里传出一句话：一千三百年了，终于有人不装。"}]},{"id":"cngevent_07","layer":3,"title":"历法之争的投票","body":"两派为「一息」的观测方式重新投票。一派说以回忆为准，一派说以仪器为准。票箱有两只，都空着。","options":[{"text":"投回忆一票。","veins":["tremor"],"result":{"gaze":2,"heal":6},"result_text":"票投进去没有声响。回忆派的长老朝你点了点头，眼圈是红的。"},{"text":"投仪器一票。","veins":["light"],"result":{"gold":35},"result_text":"仪器派当场发你一笔津贴。津贴袋上印着：理智永存。"},{"text":"两只票箱都投。","veins":[],"result":{},"result_text":"你投了两票。两派都宣布你属于自己。你免费看了两份历法抄本。"}]},{"id":"cngevent_08","layer":3,"title":"灰藻歉收","body":"今年的灰藻歉收，采集配额减半。配额榜前画着三个圈：老、幼、疯。三个圈圈的是免税的人。","options":[{"text":"把配额让给圈内的人。","veins":["water"],"result":{"heal":6,"gaze":1},"result_text":"你让了。圈里的人朝你行了三神礼。行完各自去饿。"},{"text":"去圈外的深水采。","veins":["tremor"],"result":{"damage":5,"gold":40},"result_text":"深水藻厚。你采满的同时，被深水里的东西记住了气味。"},{"text":"提议改革配额。","veins":["light"],"result":{"gold":20},"result_text":"提议被记录在案。记录员说：上一个提议的人现在是疯先知。"}]},{"id":"cngevent_09","layer":3,"title":"猎巫名册上的名字","body":"猎巫名册摊在广场，上面还有十一个没划掉的名字。划掉的记载着火刑日期。名册旁的火堆是常备的。","options":[{"text":"把十一个名字全部划掉。","veins":["light"],"result":{"gaze":2,"damage":4},"result_text":"你划完最后一个，巡逻队正好到场。他们对视一眼，把火堆浇灭了。"},{"text":"把名册偷走。","veins":["mineral"],"result":{"gold":35},"result_text":"名册很轻。轻得像根本没有那十一个人。偷窃本身没有留下记录。"},{"text":"在名册上添一个名字。","veins":[],"result":{},"result_text":"你添了自己的名字，没写日期。名册合上时，夹住了一小片你的影子。"}]},{"id":"cngevent_10","layer":3,"title":"火母方向的流星","body":"夜里有流星划过火母熄灭的方向。全城的人看见了。两种解释当场开始竞争：吉兆，或凶兆。","options":[{"text":"宣布是吉兆。","veins":["light"],"result":{"heal":10,"gaze":2},"result_text":"吉兆的说法赢了。当夜全城睡得很沉，三百年来第一次没有人守夜。"},{"text":"宣布是凶兆。","veins":["tremor"],"result":{"gold":40},"result_text":"凶兆的说法赢了。守夜的人多了三倍，你被聘为解释者。"},{"text":"什么也不宣布。","veins":[],"result":{},"result_text":"你看着流星烧完。两种解释在没有你的地方吵到了天亮。流星不在乎。"}]}]};
</script>
<script>
'use strict';
/* ───────── 数据适配：把 JSON 卡牌适配成引擎吃法的对象 ───────── */
function adaptCard(src) {
  const c = JSON.parse(JSON.stringify(src));
  const e = c.effect = c.effect || {};
  const sps = e.special || [];
  const out = [];
  sps.forEach(sp => {
    const s = { code: sp.code };
    const v = (sp.value === undefined ? sp.v : sp.value);
    if (['burn', 'poison', 'strength', 'dexterity', 'regenerate', 'thorns', 'gaze_reduce'].indexOf(s.code) >= 0) {
      s.v = v;
      if (sp.turns !== undefined) s.turns = sp.turns;
      out.push(s);
    } else if (s.code === 'weak' || s.code === 'frail') {
      s.turns = v || 2; out.push(s);
    } else if (s.code === 'exhaust') { e.exhaust = true;
    } else if (s.code === 'retain') { e.retain = true;
    } else { out.push(s); }
  });
  e.special = out;
  return c;
}
  const CLASS_POOL = { diver: RAW.diver.map(adaptCard), tremor: RAW.tremor.map(adaptCard), anmin: RAW.anmin.map(adaptCard), cangmin: RAW.cangmin.map(adaptCard) };
  // T76 选项色条：键=脉取向，值=地图生态色板（ECO_C）同源色；_default=枢网蓝
  const OPT_BAR = { light: '#998b53', heat: '#d06b6b', water: '#68b291', mineral: '#85a567', tremor: '#59b4b6', _default: '#84b2e4' };

const $ = s => document.querySelector(s);
const el = (tag, cls, txt) => {
  const d = document.createElement(tag);
  if (cls) d.className = cls;
  if (txt !== undefined) d.textContent = txt;
  return d;
};

/* ───────── 全局状态 ───────── */
let run = null, C = null, pending = null;
let phase = 'select';              // select | intro | combat | reward | event | gameover | victory
let rewardQueue = [];              // 战后奖励步骤
let prev = { gaze: 0, resFired: 0, intents: {}, hps: {}, phaseIdx: {} };
window.G = {
  get run() { return run; },
  get C() { return C; },
  get pending() { return pending; },
  get phase() { return phase; }
};

const LAYER_NOTE = {
  1: '没有红光。光脉在这里什么都点不亮。',
  2: '红光衰减。所有效果都钝了一点。',
  3: '水脉枯竭。水脉牌更贵了。',
  4: '红光充沛。光脉在这里更亮。',
  5: '每三个回合，热气咬你一口。',
  6: '每回合掉血，但每回合多抽一张。',
  7: '每回合烧掉你手里的一张牌。',
  8: '时间在重演。别回头看上一步。'
};


/* ───────── 开局 ───────── */
function startRun(classId) {
  run = RedAbyss.newRun(classId, { seed: (Math.random() * 2147483647) >>> 0 });
  // T77 开局牌库审计：原「随机抽 6 张池牌」（16 张、强弱不可控）改为固定补位 2 张（总 12 张）。
  // 补位牌经 tools/card_power.js 审计：power ≤ 该职业卡池 P75、非黑名单、补机制多样性。三处同步：tools/starter_decks.json / tools/sim.js / 此处。
  const STARTER_EXTRA = {
    diver: ['dive_0053', 'dive_0019'],      // 渊光重工·备用电源(9) / 抗共振司·锚桩(8.5)
    tremor: ['trem_0044', 'trem_0050'],     // 相石·封忆(2.25) / 震语：传温(6)
    anmin: ['anm_0006', 'anm_0042'],        // 库存盘点(8) / 基因修复台(7.2)
    cangmin: ['cng_0016', 'cng_0032']       // 火母历第一页(9) / 准时的心跳(8.6)
  };
  let cleared = false;
  try { cleared = localStorage.getItem('redabyss_cleared') === '1'; } catch (e) {}
  (STARTER_EXTRA[classId] || []).slice(0, cleared ? 1 : 2).forEach((id, i) => {
    const c = CLASS_POOL[classId].find(x => x.id === id);
    if (c) run.deck.push(Object.assign({}, c, { uid: 'p' + i }));
  });
  // T51 二周目：通关过任意结局后，开局自带「死亡合同（增补条款）」——签过一次，第二次签得更熟练
  try {
    if (localStorage.getItem('redabyss_cleared') === '1') {
      const ng = RAW[classId].find(c => c.id === 'dive_0056');
      if (ng) run.deck.push(Object.assign({}, ng, { uid: 'ng0' }));
    }
  } catch (e) {}
  run.depth = 1;
  run.row = -1;
  run.col = 0;
  run.stats = { battles: 0, kills: 0, events: 0 };
  run.relics = [];
  run.gold = 0;
  run.parts = 0;
  showMap();
}

function restart() {
  run = null; C = null; pending = null; rewardQueue = [];
  hideOverlay();
  $('#screen-combat').classList.add('hidden');
  $('#screen-flow').classList.add('hidden');
  $('#screen-select').classList.remove('hidden');
  $('#hud').classList.add('hidden');      // 回到选职业界面时收起常驻 HUD
  phase = 'select';
}

/* ───────── 屏幕切换 ───────── */
function showScreen(id) {
  ['#screen-select', '#screen-combat', '#screen-flow'].forEach(s => $(s).classList.add('hidden'));
  $(id).classList.remove('hidden');
}

function layerRows() {
  const L = RAW.layers.layers[run.depth - 1];
  if (L.rows && L.rows.length) return L.rows;
  return (L.nodes || []).map(n => [{ type: n }]);
}
const NODE_GLYPH = { combat: '◇ 战', elite: '◆ 英', event: '？ 事', boss: '◎ 主', shop: '▣ 商', campfire: '△ 营' };

function progressText() {
  const L = RedAbyss.LAYER_AT(run.depth);
  const rows = layerRows();
  const at = Math.min(rows.length, Math.max(1, run.row + 1));
  return '第 ' + run.depth + ' 层　' + L.name + ' · 第 ' + at + '/' + rows.length + ' 行';
}

/* 层深度主题：地表有光 → 中层黑透 → 核心红光。
   2026-10-29 用户反馈第一版「太暗、看不出变化」，这版把跨度拉开。 */
const LAYER_THEME = {
  1: { bg: '#39434e', fg: '#f0ece6' },   // 地表：天光，明显偏亮偏冷
  2: { bg: '#2a323a', fg: '#e6e0d8' },
  3: { bg: '#1c2228', fg: '#dcd4cc' },
  4: { bg: '#0d1013', fg: '#cfc7c0' },   // 空洞海：最黑
  5: { bg: '#1a0b0e', fg: '#d8c8c0' },
  6: { bg: '#2b0a10', fg: '#e2c4bb' },
  7: { bg: '#420a12', fg: '#eec0b6' },
  8: { bg: '#64101a', fg: '#ffc9bd' }    // 核心：发红光
};
function applyLayerTheme(d) {
  const t = LAYER_THEME[d] || LAYER_THEME[4];
  const s = document.documentElement.style;
  s.setProperty('--bg', t.bg);
  s.setProperty('--text', t.fg);
  s.setProperty('--layer-bg', t.bg);   // T44：原始层色，供材质主题做混合（off 时不消费）
  setLayerAmbience(d);   // T41：氛围音钩子（空实现，见 docs/SFX_LIST.md）
}

function showMap() {
  phase = 'map';
  applyLayerTheme(run.depth);
  $('#hud').classList.remove('hidden');   // HUD 常驻：进局后所有界面都显示
  // 非战斗界面：只显示持久数值；格挡/能量/共鸣是战斗内概念，先收起来
  $('#hud-block-wrap').classList.add('hidden');
  $('#hud-energy-wrap').classList.add('hidden');
  $('#hud-res-wrap').classList.add('hidden');
  $('#hud-hp').textContent = run.hp + '/' + run.maxHp;
  $('#gaze-val').textContent = run.gaze;
  $('#hud-gold').textContent = run.gold;
  $('#hud-layer').textContent = progressText();   // HUD 常驻后，层行不能只靠战斗渲染刷新
  showScreen('#screen-flow');
  // HUD 跨屏同步（金币/零件标签与数值、苍民清醒度）
  const gl = document.getElementById('hud-gold-label');
  if (gl) gl.textContent = run.classId === 'anmin' ? '零件 ' : '金币 ';
  const gi = document.getElementById('hud-gold-ic');
  if (gi) gi.textContent = run.classId === 'anmin' ? '⚙' : '◈';
  const gv = document.getElementById('hud-gold');
  if (gv) gv.textContent = run.classId === 'anmin' ? (run.parts || 0) : run.gold;
  if (run.classId === 'cangmin') {
    const ce = document.getElementById('hud-clarity');
    if (ce) {
      ce.textContent = (run.clarity || 0) + '/' + (run.clarityMax || 5);
      ce.classList.toggle('clarity-low', (run.clarity || 0) < 3);
    }
  }
  const p = $('#flow-panel');
  p.textContent = '';
  const L = RedAbyss.LAYER_AT(run.depth);
  const rows = layerRows();
  p.appendChild(el('h2', '', (run.isEcho ? '静默段 · ' : '第 ' + run.depth + ' 层　') + L.name));
  p.appendChild(el('div', 'progress', progressText()));
  p.appendChild(el('div', 'rulerow', run.isEcho ? '黯星回响。这里的机械认得黯民的编号，也只认编号。' : (LAYER_NOTE[run.depth] || '')));
  const map = el('div', '');
  map.id = 'map';
  if (run.isEcho) map.className = 'echo';
  const nextRow = run.row + 1;
  rows.forEach((row, ri) => {
    const r = el('div', 'maprow');
    row.forEach((node, ci) => {
      const d = el('div', 'mnode' + (ri < nextRow ? ' done' : '') +
        (ri === run.row && ci === run.col ? ' here' : ''));
      d.textContent = NODE_GLYPH[node.type] || '？';
      if (ri === nextRow) {
        let cols;
        if (run.row < 0) cols = row.map((_, i) => i);
        else cols = [run.col - 1, run.col, run.col + 1].filter(c => c >= 0 && c < row.length);
        if (cols.indexOf(ci) >= 0) {
          d.classList.add('pickable');
          d.tabIndex = 0;
          d.setAttribute('role', 'button');
          d.setAttribute('aria-label', NODE_GLYPH[node.type] + '，第 ' + (ri + 1) + ' 行');
          d.addEventListener('click', () => resolveNode(ri, ci));
        }
      }
      r.appendChild(d);
    });
    map.appendChild(r);
  });
  p.appendChild(map);
  const firstPick = p.querySelector('.mnode.pickable');
  if (firstPick) firstPick.focus();
  if (run.row < 0) p.appendChild(el('div', 'flavor mapfoot', '红光在下面。它知道你来了。'));
}

/* ───────── 节点推进 ───────── */
function resolveNode(ri, ci) {
  playSfx('ui.click');
  run.row = ri;
  run.col = ci;
  const type = layerRows()[ri][ci].type;
  if (!run.stats.route) run.stats.route = [];
  run.stats.route.push({ d: run.depth, t: type });
  if (type === 'campfire') { showCampfire(); }
  else if (type === 'shop') { shopState = buildShopStock(); showShop(); }
  else if (type === 'event') {
    let pool = run.isEcho ? RAW.anminEvents.filter(x => x.layer === run.depth)
      : run.classId === 'cangmin' ? RAW.cngEvents.filter(x => x.layer === run.depth)
      : RAW.events.filter(x => x.layer === run.depth);
    if (!pool.length) {
      // D1/D8 没有专属事件，回退到最近的层
      for (let off = 1; off <= 8 && !pool.length; off++) {
        const src = run.isEcho ? RAW.anminEvents : RAW.events;
        pool = src.filter(x => x.layer === run.depth - off || x.layer === run.depth + off);
        if (!pool.length && run.isEcho) pool = RAW.anminEvents;
      }
    }
    const ev = pool[Math.floor(run.rng() * pool.length)];
    showEvent(ev);
  } else {
    const tier = type === 'elite' ? 'elite' : type === 'boss' ? 'boss' : 'normal';
    const src = run.isEcho ? echoEnemyPool(run.depth) : RAW.enemies;
    const pool = src.filter(x => x.layer === run.depth && x.tier === tier);
    const picks = [];
    const n = tier === 'normal' ? (run.rng() < 0.35 ? 1 : 2) : 1;
    const bag = pool.slice();
    while (picks.length < n && bag.length) {
      picks.push(bag.splice(Math.floor(run.rng() * bag.length), 1)[0]);
    }
    startCombatFlow(picks);
  }
}

function advanceNode() {
  const rows = layerRows();
  if (run.row + 1 >= rows.length) {
    run.depth++;
    run.row = -1;
    run.col = 0;
    if (run.depth > 8) { showVictory(); return; }
  }
  shopState = null;
  showMap();
}

/* ───────── 营火 ───────── */
const CAMPFIRE_TEXTS = [
  '你把头盔摘了。这里的空气够你活三次呼吸。',
  '火是你自己生的，很小心，很小。红蕨在远处看着。',
  '你听见岩层在动。它一直动，只是你平时听不见。',
  '静日。所有人都不说话，连岩缝里的风都放轻了。',
  '你换了新的氧气罐。旧的那个瘪着，像一口叹出来的气。',
  '禁声日还没过。你们靠手势分完了最后半块燃料。'
];

function showCampfire() {
  phase = 'reward';
  showScreen('#screen-flow');
  const p = $('#flow-panel');
  p.textContent = '';
  p.appendChild(el('h2', '', '营火'));
  p.appendChild(el('div', 'progress', progressText()));
  p.appendChild(el('div', 'flavor', CAMPFIRE_TEXTS[Math.floor(run.rng() * CAMPFIRE_TEXTS.length)]));
  p.appendChild(el('div', 'statline', '生命 ' + run.hp + '/' + run.maxHp + '　金币 ' + run.gold));
  const opts = el('div', '');
  function campOpt(title, desc, onPick, disabled, why) {
    const d = el('div', 'campopt' + (disabled ? ' disabled' : ''));
    d.appendChild(el('b', '', title));
    d.appendChild(el('span', '', desc));
    if (disabled && why) d.title = why;
    if (!disabled) d.addEventListener('click', onPick);
    opts.appendChild(d);
  }
  const healN = Math.max(1, Math.floor(run.maxHp * 0.5));
  campOpt('静日', '什么也不做。火光替你把血止住。生命 +' + healN + '。',
    () => {
      const got = Math.min(healN, run.maxHp - run.hp);
      run.hp += got;
      if (run.classId === 'cangmin') run.clarity = Math.min(run.clarityMax || 5, run.clarity + 1); // 守夜养神
      campfireResult('你在火边坐了很久。呼吸慢下来，血也慢下来。', ['生命 +' + got]);
    }, run.hp >= run.maxHp, '你不缺这个');
  campOpt('修整装备', '火光太软，手上的东西太钝。选一件，重新磨一遍。（升级 1 张卡）',
    () => showUpgradePick((oldCard, nu) => {
      if (nu) {
        campfireResult('「' + oldCard.name + '」在火边躺了一夜。醒来的时候，它有了新的名字。',
          ['升级：' + oldCard.name + ' → ' + nu.name]);
      } else {
        const r = pickRelics(1)[0] || pickEventRelics(1)[0];
        if (r) {
          grantRelic(r);
          campfireResult('没有能再磨的东西了。渊民把「' + r.name + '」塞给你，抵这一夜。', ['遗物：' + r.name]);
        } else {
          run.gold += 50;
          campfireResult('没有能再磨的东西了。渊民把一把旧币按进你手里。', ['金币 +50']);
        }
      }
    }));
  campOpt('听震', '把一枚多余的记忆按进岩层。它再也不会回来。（移除 1 张牌）',
    () => removeCardPick('听震', '把手按在石头上。选一张让它留下的牌。', (removed) => {
      if (removed) campfireResult('「' + removed.name + '」沉下去了。岩层替你记着它的重量。', ['移除：' + removed.name]);
      else campfireResult('你没有可以放下的东西。火看了一会儿，继续烧。', []);
    }));
  p.appendChild(opts);
}

function campfireResult(text, lines) {
  const kids = [el('div', 'flavor', text)];
  (lines || []).forEach(l => kids.push(el('div', 'statline', l)));
  showFlowPanel('营火', kids, '继续下潜', advanceNode);
}

/* ───────── 卡牌升级 ───────── */
function showUpgradePick(onDone) {
  phase = 'reward';
  showScreen('#screen-flow');
  const p = $('#flow-panel');
  p.textContent = '';
  p.appendChild(el('h2', '', '修整装备'));
  p.appendChild(el('div', 'progress', progressText()));
  const pool = run.deck.filter(c => c.upgrade && !c.upgraded);
  if (!pool.length) {
    p.appendChild(el('div', 'flavor', '你带下来的每一样东西都已经磨过了。'));
    const row = el('div', 'btnrow');
    const b = el('button', '', '继续');
    b.addEventListener('click', () => onDone(null, null));
    row.appendChild(b);
    p.appendChild(row);
    return;
  }
  p.appendChild(el('div', 'flavor', '选一件。火会替你把它重新说一遍。'));
  const wrap = el('div', '');
  wrap.id = 'flow-cards';
  pool.forEach(card => {
    const d = renderCardStatic(card);
    const preview = RedAbyss.upgradeCard(card);
    d.title = '升级预览：' + preview.name + '\n' + cardDesc(preview) +
      (preview.upgrade.flavor_add ? '\n———\n' + preview.upgrade.flavor_add : '');
    d.addEventListener('click', () => {
      const i = run.deck.indexOf(card);
      run.deck[i] = RedAbyss.upgradeCard(card);
      onDone(card, run.deck[i]);
    });
    wrap.appendChild(d);
  });
  p.appendChild(wrap);
}

function removeCardPick(title, flavor, onDone) {
  phase = 'reward';
  showScreen('#screen-flow');
  const p = $('#flow-panel');
  p.textContent = '';
  p.appendChild(el('h2', '', title));
  p.appendChild(el('div', 'progress', progressText()));
  if (!run.deck.length) {
    p.appendChild(el('div', 'flavor', '你身上已经没有牌了。'));
    const row = el('div', 'btnrow');
    const b = el('button', '', '继续');
    b.addEventListener('click', () => onDone(null));
    row.appendChild(b);
    p.appendChild(row);
    return;
  }
  if (flavor) p.appendChild(el('div', 'flavor', flavor));
  const wrap = el('div', '');
  wrap.id = 'flow-cards';
  run.deck.slice().forEach(card => {
    const d = renderCardStatic(card);
    d.addEventListener('click', () => {
      const gone = run.deck.splice(run.deck.indexOf(card), 1)[0];
      onDone(gone);
    });
    wrap.appendChild(d);
  });
  p.appendChild(wrap);
}

/* ───────── 商店 ───────── */
const SHOP_TEXTS = [
  '玻璃柜里摆着别人的东西。有些编号还没刮干净。',
  '掌柜没抬头。他只是把价签转了个方向。',
  '灯管接在岩电上，明一下，暗一下。货架也跟着明暗。',
  '墙上贴着回收价目表。你的名字不在任何一栏里。'
];
let shopState = null;

function shopPrice(a, b) { return a + Math.floor(run.rng() * (b - a + 1)); }

function buildShopStock() {
  const stock = [];
  weightedCards(2 + (run.rng() < 0.5 ? 1 : 0)).forEach(c => {
    const price = c.rarity === 'rare' ? shopPrice(150, 200)
      : c.rarity === 'uncommon' ? shopPrice(75, 110)
      : shopPrice(40, 60);
    stock.push({ kind: 'card', card: c, name: c.name, desc: cardDesc(c), price: price });
  });
  const rel = pickRelics(1)[0];
  if (rel) {
    const price = (rel.rarity === 'rare' || rel.rarity === 'boss') ? shopPrice(250, 320) : shopPrice(120, 160);
    stock.push({ kind: 'relic', relic: rel, name: rel.name, desc: rel.effect_text, price: price });
  }
  stock.push({ kind: 'remove', name: '删牌服务', desc: '让掌柜收走一张牌。一次。', price: 75 });
  stock.push({ kind: 'heal', name: '静脉合剂', desc: '回复 35% 最大生命。一次。', price: 60 });
  return stock;
}

function showShop() {
  phase = 'reward';
  showScreen('#screen-flow');
  const p = $('#flow-panel');
  p.textContent = '';
  p.appendChild(el('h2', '', '前哨杂货'));
  p.appendChild(el('div', 'progress', progressText()));
  p.appendChild(el('div', 'flavor', SHOP_TEXTS[Math.floor(run.rng() * SHOP_TEXTS.length)]));
  const goldLine = el('div', 'statline', '金币 ' + run.gold);
  p.appendChild(goldLine);
  const grid = el('div', 'shopgrid');
  shopState.forEach(item => {
    const d = el('div', 'shopitem');
    d.appendChild(el('b', '', item.name));
    d.appendChild(el('i', '', item.desc));
    const priceEl = el('div', 'price', item.sold ? '已售' : item.price + ' 金');
    d.appendChild(priceEl);
    d.addEventListener('click', () => {
      if (item.sold) return;
      if (item.kind === 'heal' && run.hp >= run.maxHp) { toast('你不缺这个。掌柜没抬头。'); return; }
      if (run.gold < item.price) {
        toast('你的金币不够。掌柜把价签又转了个方向。');
        return;
      }
      run.gold -= item.price;
      item.sold = true;
      if (item.kind === 'card') {
        run.deck.push(Object.assign({}, item.card, { uid: 's' + run.deck.length }));
        toast('「' + item.name + '」装进了行囊');
        showShop();
      } else if (item.kind === 'relic') {
        grantRelic(item.relic);
        toast('遗物到手：' + item.name);
        showShop();
      } else if (item.kind === 'heal') {
        run.hp = Math.min(run.maxHp, run.hp + Math.max(1, Math.floor(run.maxHp * 0.35)));
        showShop();
      } else if (item.kind === 'remove') {
        removeCardPick('删牌服务', '掌柜伸出一只手。选一张。', () => showShop());
      }
    });
    item.el = d;
    grid.appendChild(d);
  });
  p.appendChild(grid);
  const row = el('div', 'btnrow');
  const btn = el('button', '', '离开');
  btn.addEventListener('click', advanceNode);
  row.appendChild(btn);
  p.appendChild(row);
  // 买不起的变灰，已售的置暗
  shopState.forEach(item => {
    if (!item.el) return;
    const useless = item.kind === 'heal' && run.hp >= run.maxHp;
    item.el.classList.toggle('sold', !!item.sold);
    item.el.classList.toggle('cant', !item.sold && (run.gold < item.price || useless));
    if (useless) item.el.title = '你不缺这个';
  });
}

/* ───────── 战斗 ───────── */
function startCombatFlow(defs) {
  phase = 'combat';
  C = RedAbyss.startCombat(run, defs);
  if (run.classId === 'anmin' && run.parts) C.parts = run.parts; // 零件库存跨战斗持久
  pending = null;
  prev = { gaze: run.gaze, resFired: C.resonanceFired, intents: {}, hps: {}, phaseIdx: {}, hp: run.hp };
  C.enemies.forEach(e => { prev.intents[e.idx] = intentKey(e.intent); prev.hps[e.idx] = e.hp; });
  playSfx('combat.start');
  applyRelicTurnStart();
  showScreen('#screen-combat');
  document.getElementById('screen-combat').classList.toggle('world-dream', C.world === 'dream');
  document.getElementById('screen-combat').classList.toggle('world-wake', C.world !== 'dream');
  render();
  // T40 新手提示：只在前 3 场战斗
  if (run.stats.battles < 3) {
    onceHint('draw', '一回合抽五张。用过的牌进弃牌堆，堆里洗空了就回来。');
    onceHint('intent', '它下一步做什么，写在它头上。');
  }
}

function applyRelicTurnStart() {
  (run.relics || []).forEach(r => {
    (r.effect_code || []).forEach(ec => {
      if (ec.trigger !== 'turn_start') return;
      if (ec.action === 'heal') run.hp = Math.min(run.maxHp, run.hp + (ec.value || 0));
      if (ec.action === 'resonance') C.resonance += (ec.value || 0);
      if (ec.action === 'draw') RedAbyss.draw(C, ec.value || 1);
    });
  });
}

$('#btn-world').addEventListener('click', () => {
  if (!C || C.over || run.classId !== 'cangmin') return;
  const target = C.world === 'dream' ? 'wake' : 'dream';
  playSfx('special.world_switch');
  const r = RedAbyss.switchWorld(C, target);
  toast(r.ok ? (target === 'dream' ? '你睡着了。' : '你醒了。') : r.msg);
  render();
});
document.addEventListener('keydown', (ev) => {
  if (ev.key === 'w' || ev.key === 'W') { const b = document.getElementById('btn-world'); if (b && !b.disabled && !b.classList.contains('hidden')) b.click(); }
});
$('#btn-help').addEventListener('click', () => {
  const o = document.getElementById('help-overlay');
  playSfx(o.classList.contains('hidden') ? 'ui.open' : 'ui.close');
  o.classList.toggle('hidden');
});
$('#btn-help-close').addEventListener('click', () => {
  document.getElementById('help-overlay').classList.add('hidden');
});
document.getElementById('help-overlay').addEventListener('click', (ev) => {
  if (ev.target === ev.currentTarget) ev.currentTarget.classList.add('hidden');
});
// T67：职业立绘查表（选人界面四张）
document.querySelectorAll('.classface').forEach(cardEl => {
  const img = window.ART && ART['class_' + cardEl.getAttribute('data-class')];
  if (img) {
    const pt = cardEl.querySelector('img');
    if (pt) {
      pt.onerror = () => { pt.style.display = 'none'; };   // 资产缺失回退首字（CSS ::after）
      pt.style.backgroundPosition = 'center top';
      const sp = pt.querySelector('span');
      if (sp) sp.style.display = 'none';
    }
  }
});
document.addEventListener('keydown', (ev) => {
  if (ev.key === 'Escape') {
    document.getElementById('help-overlay').classList.add('hidden');
    document.getElementById('card-detail').classList.add('hidden');
    if (pending !== null) { pending = null; if (window.G && window.G.phase === 'combat') render(); }
  }
});
$('#btn-end').addEventListener('click', () => {
  if (!C || C.over) return;
  pending = null;
  const beforeTurn = C.turn;
  RedAbyss.endTurn(C);
  if (!C.over && C.turn > beforeTurn) applyRelicTurnStart();
  render();
  if (C.over) setTimeout(finishCombatFlow, 450);
});

function doPlay(handIdx, targetIdx) {
  const card = C.hand[handIdx];
  if (!card) return;
  const snapshot = {};
  C.enemies.forEach(e => { snapshot[e.idx] = e.hp; });
  flyCard(handIdx);
  playSfx(card.type === 'attack' ? 'card.play.attack' : card.type === 'power' ? 'card.play.power' : 'card.play.skill');
  if (card.cost_type && card.cost_type !== 'none') playSfx('card.play.cost');
  const r = RedAbyss.playCard(C, handIdx, targetIdx);
  if (!r.ok) { toast(r.msg); pending = null; render(); return; }
  if (card.cost_type && card.cost_type !== 'none') {
    run.stats.costPlays = (run.stats.costPlays || 0) + 1;
    if (run.stats.battles < 3) onceHint('cost', '这张牌要你付代价。它拿走的是真的东西。');
  }
  C.enemies.forEach(e => {
    if (snapshot[e.idx] !== undefined && snapshot[e.idx] > e.hp) {
      const node = $('#enemy-' + e.idx);
      if (node) floatText(node, '-' + (snapshot[e.idx] - e.hp));
    }
  });
  checkEasterEggs(card);
  if (r.chain > 0) toast('连携 +' + r.chain);
  pending = null;
  render();
  if (C.over) setTimeout(finishCombatFlow, 450);
}

/* ───────── T39 卡牌组合彩蛋（不写在卡面上，让玩家自己撞见） ───────── */
const EASTER_EGGS = [
  { id: 'fire_med', pair: ['dive_0033', 'dive_0003'], line: '圣火喝了一口药液。它决定再亮一会儿。',
    fx: (C) => { C.run.hp = Math.min(C.run.maxHp, C.run.hp + 3); } },
  { id: 'contract_ledger', pair: ['dive_0056', 'dive_0070'], line: '账本替你在第三条空白处垫了一行。有人认了这笔账。',
    fx: (C) => { C.block += 5; } },
  { id: 'pulse_teeth', pair: ['trem_0014', 'trem_0013'], line: '脉搏和齿音对上了。岩层跟你走了半拍。',
    fx: (C) => { C.resonance += 3; } },
  { id: 'gel_list', pair: ['anm_0012', 'anm_0008'], line: '凝胶抹在清单背面。清单底下的皮肤好了一点。',
    fx: (C) => { C.run.hp = Math.min(C.run.maxHp, C.run.hp + 4); } },
  { id: 'wake_dream', pair: ['cng_0001', 'cng_0018'], line: '醒着的那半和睡着的那半换了班。两个人守了一夜。',
    fx: (C) => { RedAbyss.draw(C, 2); } },
  { id: 'twice_gun', oncePerCard: 'dive_0002', line: '两声枪响。第二声是给下面听的。',
    fx: (C) => { C.run.gaze += 1; } },
  { id: 'vein5', veinStreak: 5, line: '同一道脉连响了五声。红渊跟着数了一遍。',
    fx: (C) => { C.resonance += 3; } },
  { id: 'layer4_flower', layer: 4, pair: ['dive_0052'], line: '盆栽在空洞海开了花。它不知道这里不该有花。',
    fx: (C) => { C.run.hp = Math.min(C.run.maxHp, C.run.hp + 5); } }
];
function showEgg(line) {
  C.log.push(line);
  const banner = $('#phase-banner');
  banner.textContent = line;
  banner.classList.add('show');
  clearTimeout(banner._tm);
  banner._tm = setTimeout(() => banner.classList.remove('show'), 2400);
  document.body.classList.remove('eggflash');
  void document.body.offsetWidth;
  document.body.classList.add('eggflash');
  setTimeout(() => document.body.classList.remove('eggflash'), 450);
  playSfx('special.egg');
}
function checkEasterEggs(card) {
  if (!C || C.over) return;
  if (!C._egg) C._egg = { ids: {}, streakV: null, streakN: 0, fired: {} };
  const st = C._egg;
  if (card.id) st.ids[card.id] = (st.ids[card.id] || 0) + 1;
  const v = (card.veins && card.veins[0]) || null;
  if (v && st.streakV === v) st.streakN++;
  else { st.streakV = v; st.streakN = v ? 1 : 0; }
  for (const egg of EASTER_EGGS) {
    if (st.fired[egg.id]) continue;
    let hit = false;
    if (egg.pair && egg.pair.every(id => (st.ids[id] || 0) >= 1)) hit = true;
    if (egg.oncePerCard && (st.ids[egg.oncePerCard] || 0) >= 2) hit = true;
    if (egg.veinStreak && st.streakN >= egg.veinStreak) hit = true;
    if (egg.layer && run.depth === egg.layer && egg.pair.every(id => (st.ids[id] || 0) >= 1)) hit = true;
    if (hit) {
      st.fired[egg.id] = true;
      egg.fx(C);
      showEgg(egg.line);
      render();
      return;   // 一次只触发一个，避免同屏叠提示
    }
  }
}

/* ───────── T50 遗物徽记：id 稳定散列到 12 个几何符号 × 6 种旋角 ───────── */
function relicBadge(id) {
  let h = 0;
  const str = String(id || '');
  for (let i = 0; i < str.length; i++) h = (h * 31 + str.charCodeAt(i)) % 2147483647;
  const sym = h % 12;
  const rot = Math.floor(h / 12) % 6;
  return '<svg class="rbadge rb-r' + rot + '" aria-hidden="true"><use href="#rb-' + sym + '"/></svg>';
}

/* ───────── T39 死亡结算的"这一局最值得说的事" ───────── */
function runMemoryLine() {
  const s = run.stats || {};
  if (run.classId === 'anmin' && (run.parts || 0) >= 5) {
    return '你在这一局拆了 ' + run.parts + ' 台机械。它们记得你的编号。';
  }
  if ((s.maxGaze || 0) >= 10) {
    return '凝视数到 ' + s.maxGaze + ' 才停下来。这个数字现在是你的名字。';
  }
  if ((s.costPlays || 0) >= 12) {
    return '这一局你签了 ' + s.costPlays + ' 次代价。每一次都签得比上一次熟练。';
  }
  if ((s.kills || 0) >= 12) {
    return s.kills + ' 个东西因你停下。红渊把它们记在你的名下。';
  }
  return '你停在深度第 ' + run.depth + ' 层。红光把你的名字留在了那里。';
}

/* ───────── T40 第一次死亡的死因提示（每种死因只出现一次） ───────── */
function deathHint() {
  if (!C) return null;
  const tail = C.log.slice(-8).join('\n');
  let key = null, msg = null;
  if (/过载/.test(tail)) {
    key = 'overload'; msg = '共振过了 30，红光开始烧账。它每回合都来收。';
  } else if (run.gaze >= 10 && /击中你/.test(tail)) {
    key = 'gaze'; msg = '凝视每满 10，渊里的东西下手重一分。你被看得够久了。';
  } else if (/击中你/.test(tail)) {
    key = 'block'; msg = '格挡只挡当回合。你的回合一散，它也散了——有遗物续着才留一半。';
  } else if ((run.stats.costPlays || 0) >= 10) {
    key = 'cost'; msg = '带代价的牌很强。它们收的利息是真的。';
  }
  if (!key) return null;
  try {
    const k = 'redabyss_death_' + key;
    if (localStorage.getItem(k)) return null;
    localStorage.setItem(k, '1');
  } catch (e) { return null; }
  return msg;
}

function finishCombatFlow() {
  if (phase !== 'combat') return;
  const dead = C.enemies.filter(e => e.dead).length;
  run.stats.battles++;
  run.stats.kills += dead;
  (run.relics || []).forEach(r => {
    (r.effect_code || []).forEach(ec => {
      if (ec.trigger === 'on_kill' && ec.action === 'heal') {
        run.hp = Math.min(run.maxHp, run.hp + (ec.value || 0) * dead);
      }
    });
  });
  if (C.result !== 'win') { showGameOver(); return; }
  playSfx('special.victory');
  const pay = RedAbyss.finishCombat(C);   // 战斗金币掉落（引擎原设计，此前前端未接线）
  if (run.classId === 'anmin') {
    // 黯民：战斗结束零件库存写回 run；战斗掉落金币折算零件
    run.parts = C.parts;
    if (pay && pay.gold) { run.gold -= pay.gold; run.parts += pay.gold; toast('零件 +' + pay.gold); }
    const gp = document.getElementById('hud-gold'); if (gp) gp.textContent = run.parts;
  } else if (pay && pay.gold) { toast('金币 +' + pay.gold); const g = document.getElementById('hud-gold'); if (g) g.textContent = run.gold; }
  // 黯民拆解结算：战后再领随机遗物（引擎 dismantle 已计数）
  if (run._relicReward) {
    const cnt = run._relicReward;
    run._relicReward = 0;
    for (let i = 0; i < cnt; i++) {
      const r = pickRelics(1)[0];
      if (r) { grantRelic(r); toast('拆解结算：' + r.name + ' 入库'); }
    }
  }
  const kind = layerRows()[run.row][run.col].type;
  rewardQueue = [];
  if (kind === 'boss') {
    rewardQueue.push('relic_must');
    if (run.depth < 8) rewardQueue.push('gold');
  } else if (kind === 'elite') {
    rewardQueue.push('card', 'relic');
  } else {
    rewardQueue.push('card');
  }
  nextReward();
}

/* ───────── 奖励 ───────── */
function nextReward() {
  if (!rewardQueue.length) { advanceNode(); return; }
  const step = rewardQueue.shift();
  if (step === 'card') {
    showCardChoice(weightedCards(3), false, nextReward);
  } else if (step === 'relic' || step === 'relic_must') {
    const opts = pickRelics(3);
    if (!opts.length) { nextReward(); return; }
    showRelicChoice(opts, step === 'relic_must', nextReward);
  } else if (step === 'gold') {
    const g = 50 + Math.floor(run.rng() * 31);
    if (run.classId === 'anmin') {
      run.parts += g;
      showFlowPanel('巨怪的遗骸', [
        el('div', 'flavor', '它不动了。它守着的东西现在归你。'),
        el('div', 'statline', '零件 +' + g)
      ], '继续下潜', nextReward);
    } else {
      run.gold += g;
      showFlowPanel('巨怪的遗骸', [
        el('div', 'flavor', '它不动了。它守着的东西现在归你。'),
        el('div', 'statline', '金币 +' + g)
      ], '继续下潜', nextReward);
    }
  }
}

function weightedCards(n) {
  const pool = CLASS_POOL[run.classId].filter(c => c.rarity !== 'special');
  const weight = { common: 6, uncommon: 3, rare: 1 };
  const out = [];
  const bag = pool.slice();
  while (out.length < n && bag.length) {
    let total = 0;
    bag.forEach(c => { total += weight[c.rarity] || 1; });
    let roll = run.rng() * total;
    let pick = bag[0];
    for (const c of bag) {
      roll -= weight[c.rarity] || 1;
      if (roll <= 0) { pick = c; break; }
    }
    out.push(pick);
    bag.splice(bag.indexOf(pick), 1);
  }
  return out;
}

function pickEventRelics(n) {
  const owned = new Set((run.relics || []).map(r => r.id));
  const bag = RAW.relics.filter(r => !owned.has(r.id) && r.source === 'event');
  const out = [];
  while (out.length < n && bag.length) {
    out.push(bag.splice(Math.floor(run.rng() * bag.length), 1)[0]);
  }
  if (out.length < n) pickRelics(n - out.length).forEach(x => out.push(x));
  return out;
}

function pickRelics(n) {
  const owned = new Set((run.relics || []).map(r => r.id));
  const srcAll = run.isEcho ? RAW.relics.concat(RAW.anminRelics) : run.classId === 'cangmin' ? RAW.relics.concat(RAW.cngRelics) : RAW.relics;
  const bag = srcAll.filter(r => !owned.has(r.id) && r.source !== 'event');
  const out = [];
  while (out.length < n && bag.length) {
    out.push(bag.splice(Math.floor(run.rng() * bag.length), 1)[0]);
  }
  return out;
}

function grantRelic(r) {
  run.relics.push(r);
  (r.effect_code || []).forEach(ec => {
    if (ec.trigger === 'run_start' && ec.action === 'maxhp') {
      run.maxHp = Math.max(1, run.maxHp + (ec.value || 0));
      run.hp = Math.min(run.hp, run.maxHp);
    }
  });
}

/* ───────── 流程面板 ───────── */
function showFlowPanel(title, children, btnText, onBtn) {
  phase = 'reward';
  showScreen('#screen-flow');
  const p = $('#flow-panel');
  p.textContent = '';
  p.appendChild(el('h2', '', title));
  p.appendChild(el('div', 'progress', progressText()));
  children.forEach(c => p.appendChild(c));
  const row = el('div', 'btnrow');
  const btn = el('button', '', btnText);
  btn.addEventListener('click', onBtn);
  row.appendChild(btn);
  p.appendChild(row);
}

function showCardChoice(cards, mustPick, onDone) {
  phase = 'reward';
  showScreen('#screen-flow');
  const p = $('#flow-panel');
  p.textContent = '';
  p.appendChild(el('h2', '', '行囊里还能再塞一样东西'));
  p.appendChild(el('div', 'progress', progressText()));
  const wrap = el('div', '');
  wrap.id = 'flow-cards';
  cards.forEach(card => {
    const d = renderCardStatic(card);
    d.addEventListener('click', () => {
      run.deck.push(Object.assign({}, card, { uid: 'g' + run.deck.length }));
      toast('「' + card.name + '」放进了行囊');
      onDone();
    });
    wrap.appendChild(d);
  });
  p.appendChild(wrap);
  const row = el('div', 'btnrow');
  if (!mustPick) {
    const skip = el('button', '', '跳过');
    skip.addEventListener('click', onDone);
    row.appendChild(skip);
  }
  p.appendChild(row);
}

function showRelicChoice(relics, mustPick, onDone) {
  phase = 'reward';
  showScreen('#screen-flow');
  const p = $('#flow-panel');
  p.textContent = '';
  p.appendChild(el('h2', '', mustPick ? '它要跟你走' : '有些东西想跟你走'));
  p.appendChild(el('div', 'progress', progressText()));
  const row = el('div', 'relicrow');
  relics.forEach(r => {
    const d = el('div', 'relic');
    d.innerHTML = relicBadge(r.id) + '<div><b>' + r.name + '</b><i>' + r.effect_text + '</i></div>';
    d.title = r.flavor;
    d.addEventListener('click', () => {
      grantRelic(r);
      toast('遗物到手：' + r.name);
      onDone();
    });
    row.appendChild(d);
  });
  p.appendChild(row);
  const btnrow = el('div', 'btnrow');
  if (!mustPick) {
    const skip = el('button', '', '不拿');
    skip.addEventListener('click', onDone);
    btnrow.appendChild(skip);
  }
  p.appendChild(btnrow);
}

/* 卡面图案区：按脉给预留符号（未来有素材时用内联背景样式覆盖） */
const VEIN_ART = {
  light:   { sym: '◉', color: '#9a8452' },
  water:   { sym: '≋', color: '#5a8a9a' },
  heat:    { sym: '✹', color: '#a04a35' },
  tremor:  { sym: '⌇', color: '#8a7aa8' },
  mineral: { sym: '◈', color: '#9a9a8a' }
};
const VEIN_ART_NONE = { sym: '·', color: '#3a2224' };
function veinArt(card) {
  const v = (card.veins && card.veins[0]) || null;
  return (v && VEIN_ART[v]) || VEIN_ART_NONE;
}
// T67：卡 → 素材 id。主脉 → 生态 face；素卡按职业语域（下潜者/维护者=地表，震语者/苍民=回路）
function cardArtId(card) {
  const veinEco = { light: 'eco_sea', water: 'eco_arid', heat: 'eco_vent', tremor: 'eco_cold', mineral: 'eco_rad' };
  let eco = veinEco[((card.veins || [])[0])];
  if (!eco) eco = (card.class === 'diver' || card.class === 'anmin') ? 'eco_surface' : 'eco_nexus';
  const h = String(card.id || '').split('').reduce((a, ch) => a + ch.charCodeAt(0), 0);
  return 'face_' + eco + '_' + (1 + h % 6);
}

function appendArt(d, card, cls) {
  const a = veinArt(card);
  const v = ((card.veins || []).filter(x => VEIN_ART[x])[0]) || 'none';
  const art = el('div', (cls || 'art') + ' v-' + v);
  const ph = el('span', 'art-ph', a.sym);
  ph.style.color = a.color;
  // T67 素材接口：按卡牌派生 face id 查 ART 常量表（data: URI），查不到回落脉色符号
  if (card && window.ART) {
    const aid = cardArtId(card);
    if (ART[aid]) {
      art.style.backgroundImage = 'url(' + ART[aid] + ')';
      art.style.backgroundSize = 'cover';
      art.style.backgroundPosition = 'center';
      ph.style.display = 'none';
      art.classList.add('has-art');
    }
  }
  art.appendChild(ph);
  d.appendChild(art);
}
function renderCardStatic(card) {
  const d = el('div', 'card' + (card.cost_type !== 'none' ? ' costly' : '') +
    (card.upgraded ? ' upgraded' : ''));
  d.appendChild(el('div', 'cost', card.energy || 0));
  d.appendChild(el('div', 'ctype', card.type === 'attack' ? '攻' : card.type === 'power' ? '势' : '技'));
  appendArt(d, card);
  d.appendChild(el('div', 'cname', card.name));
  const vs = el('div', 'cveins');
  (card.veins || []).forEach(v => vs.appendChild(el('span', '', RedAbyss.VEIN_CN[v] || '?')));
  d.appendChild(vs);
  const desc = cardDesc(card);
  if (desc) d.appendChild(el('div', 'ctext', desc));
  if (card.flavor) d.appendChild(el('div', 'cflavor', card.flavor));
  d.title = [card.flavor, card.cost_type !== 'none' ? '代价：' + card.cost_text : ''].filter(Boolean).join('\n');
  return d;
}

/* ───────── 事件 ───────── */
function showEvent(ev) {
  phase = 'event';
  run.stats.events++;
  showScreen('#screen-flow');
  const p = $('#flow-panel');
  p.textContent = '';
  p.appendChild(el('h2', '', ev.title));
  p.appendChild(el('div', 'progress', progressText()));
  p.appendChild(el('div', 'flavor', ev.body));
  const opts = el('div', 'opts');
  ev.options.forEach((o, i) => {
    const b = el('button', 'optbtn', o.text);
    b.style.borderLeftColor = OPT_BAR[(o.veins || [])[0]] || OPT_BAR._default;   // T76 脉向色条
    const sub = el('div', 'osub', (o.veins || []).map(v => RedAbyss.VEIN_CN[v]).join(' / '));
    if (sub.textContent) b.appendChild(sub);
    const req = o.requires && o.requires.vein_min;
    if (req) {
      const have = run.deck.filter(c => (c.veins || []).indexOf(o.requires.vein) >= 0).length;
      if (have < req) {
        b.disabled = true;
        b.title = '该脉的牌不够（需要 ' + req + ' 张，你有 ' + have + ' 张）';
      }
    }
    b.addEventListener('click', () => chooseEventOption(ev, i));
    opts.appendChild(b);
  });
  p.appendChild(opts);
}

function chooseEventOption(ev, i) {
  const o = ev.options[i];
  const r = o.result || {};
  const lines = [];
  if (r.heal) { run.hp = Math.min(run.maxHp, run.hp + r.heal); lines.push('生命 +' + r.heal); }
  if (r.damage) { run.hp -= r.damage; lines.push('生命 -' + r.damage); }
  if (r.gaze) { run.gaze = Math.max(0, run.gaze + r.gaze); lines.push('凝视 ' + (r.gaze > 0 ? '+' : '') + r.gaze); }
  if (r.gold) {
    if (run.classId === 'anmin') { run.parts += r.gold; lines.push('零件 +' + r.gold); } // 黯民：金币折算零件
    else { run.gold += r.gold; lines.push('金币 +' + r.gold); }
  }
  if (r.maxhp) { run.maxHp = Math.max(1, run.maxHp + r.maxhp); run.hp = Math.min(run.hp, run.maxHp); lines.push('最大生命 ' + (r.maxhp > 0 ? '+' : '') + r.maxhp); }
  const follow = [];
  if (r.card_reward) follow.push('card:' + r.card_reward);
  if (r.relic) follow.push('relic');
  if (run.hp <= 0) { run.hp = 0; showGameOver(); return; }
  phase = 'reward';
  showScreen('#screen-flow');
  const p = $('#flow-panel');
  p.textContent = '';
  p.appendChild(el('h2', '', ev.title));
  p.appendChild(el('div', 'flavor', o.result_text));
  lines.forEach(l => p.appendChild(el('div', 'statline', l)));
  function doFollow() {
    if (!follow.length) { advanceNode(); return; }
    const f = follow.shift();
    if (f === 'relic') {
      const opts = pickEventRelics(3);
      if (opts.length) { showRelicChoice(opts, true, doFollow); return; }
      doFollow();
    } else {
      showCardChoice(cardsOfRarity(f.split(':')[1], 3), true, doFollow);
    }
  }
  const row = el('div', 'btnrow');
  const btn = el('button', '', follow.length ? '接着看' : '继续下潜');
  btn.addEventListener('click', doFollow);
  row.appendChild(btn);
  p.appendChild(row);
}

function cardsOfRarity(rar, n) {
  const pool = CLASS_POOL[run.classId].filter(c => c.rarity === rar);
  const bag = pool.length ? pool : CLASS_POOL[run.classId].filter(c => c.rarity !== 'special');
  const out = [];
  const copy = bag.slice();
  while (out.length < n && copy.length) {
    out.push(copy.splice(Math.floor(run.rng() * copy.length), 1)[0]);
  }
  return out;
}

/* ───────── 结算 ───────── */
function showGameOver() {
  playSfx('special.death');
  phase = 'gameover';
  showScreen('#screen-flow');
  const p = $('#flow-panel');
  p.textContent = '';
  p.appendChild(el('h2', '', '下潜终止'));
  p.appendChild(el('div', 'flavor', '你的血在红光里流尽了。红渊记下了你的位置，像记下很多个之前的位置一样。'));
  p.appendChild(el('div', 'statline'));
  p.lastChild.innerHTML = '到达　<b>第 ' + run.depth + ' 层</b>';
  addStat(p, '战斗', run.stats.battles + ' 场');
  addStat(p, '击杀', run.stats.kills);
  addStat(p, '事件', run.stats.events + ' 次');
  addStat(p, '凝视', run.gaze);
  addStat(p, '金币', run.gold);
  p.appendChild(el('div', 'memoline', '—— ' + runMemoryLine()));
  const dhint = deathHint();
  if (dhint) p.appendChild(el('div', 'hintline', dhint));
  const row = el('div', 'btnrow');
  const btn = el('button', '', '重新开始');
  btn.addEventListener('click', restart);
  row.appendChild(btn);
  if (run.gaze >= 15 && !run.isEcho) {
    const echo = el('button', '', '进入静默段（黯星回响）');
    echo.title = '凝视足够高。红渊允许你以黯民的编号再做一次下潜。';
    echo.addEventListener('click', () => startEchoRun());
    row.appendChild(echo);
  }
  p.appendChild(row);
}

/* ───────── 黯星回响（静默段短局） ───────── */
function startEchoRun() {
  run = RedAbyss.newRun('anmin', { seed: (Math.random() * 2147483647) >>> 0 });
  const pool = CLASS_POOL.anmin.filter(c => c.rarity !== 'special').slice();
  for (let i = 0; i < 5 && pool.length; i++) {
    const j = Math.floor(run.rng() * pool.length);
    run.deck.push(Object.assign({}, pool.splice(j, 1)[0], { uid: 'e' + i }));
  }
  run.isEcho = true;
  run.depth = 1;
  run.row = -1;
  run.col = 0;
  run.stats = { battles: 0, kills: 0, events: 0 };
  showMap();
}
function echoEnemyPool(depth) { return RAW.anminEnemies.filter(x => x.layer === depth); }

function addStat(p, k, v) {
  const d = el('div', 'statline');
  d.innerHTML = k + '　<b>' + v + '</b>';
  p.appendChild(d);
}

const TURNED_TEXT = {
  diver: '你转身的时候，红光在你背后让开了一条缝。它让你走。走的人不带东西——你把带下来的都留下了。合同第三页有人签了收，签的不是你的字。',
  tremor: '你把最后一句震语留在了台阶上，人往回走。城邦不会收到它，岩层收到了。岩层说：回来的人要替走掉的人说话。',
  anmin: '你往回走了。例检单上最后一次签字的位置空着。机械按时来了三次，第三次学会了不再来。',
  cangmin: '你从梦里坐起来，没有回头。睡在旁边的那具身体已经凉了，凉的还保持着你的睡姿。伊格没有拦你。伊格什么都没有做。'
};
function markCleared(endingId) {
  try {
    localStorage.setItem('redabyss_cleared', '1');
    const seen = JSON.parse(localStorage.getItem('redabyss_endings') || '[]');
    if (seen.indexOf(endingId) < 0) { seen.push(endingId); localStorage.setItem('redabyss_endings', JSON.stringify(seen)); }
  } catch (e) {}
}
function showVictory() {
  playSfx('special.victory');
  markCleared(RedAbyss.pickEnding(run.gaze, run.classId).id);
  phase = 'victory';
  showScreen('#screen-flow');
  const p = $('#flow-panel');
  p.textContent = '';
  // T67：结局插画查表（turned 复用 walked 的画面——两者都是离开）
  const endId0 = RedAbyss.pickEnding(run.gaze, run.classId).id;
  const endArt = window.ART && ART['end_ending_' + (endId0 === 'turned' ? 'walked' : endId0)];
  if (endArt) {
    const ea = el('div', 'ending-art');
    ea.style.backgroundImage = 'url(' + endArt + ')';
    p.appendChild(ea);
  }
  p.appendChild(el('h2', '', '红渊核心 · ' + RedAbyss.pickEnding(run.gaze, run.classId).title));
  p.appendChild(el('div', 'ending', (() => {
    const e = RedAbyss.pickEnding(run.gaze, run.classId);
    return e.text + '\n\n' + e.lastLine;
  })()));
  addStat(p, '战斗', run.stats.battles + ' 场');
  addStat(p, '击杀', run.stats.kills);
  addStat(p, '事件', run.stats.events + ' 次');
  // 通关结算的关键选择（T39）：稀有卡 / 岔路 / 凝视的含义
  const rares = run.deck.filter(c => c.rarity === 'rare' || c.rarity === 'boss');
  addStat(p, '凝视', run.gaze + (run.gaze >= 20 ? '（长审：它把你从头到尾数完了）'
    : run.gaze <= 5 ? '（背身：它没有看全你）' : '（同行：它一路看着你走下来）'));
  if (rares.length) addStat(p, '稀有卡', rares.map(c => c.name).join('、'));
  if (run.stats.route && run.stats.route.length) {
    const RC = { combat: '战', event: '事', shop: '商', campfire: '营', elite: '英', boss: '主' };
    addStat(p, '岔路', run.stats.route.map(r => 'D' + r.d + (RC[r.t] || '?')).join(' '));
  }
  const row = el('div', 'btnrow');
  const back = el('button', '', '回头');
  back.title = '放弃带走的一切，原路回去。';
  back.addEventListener('click', () => {
    markCleared('turned');
    const txt = TURNED_TEXT[run.classId] || TURNED_TEXT.diver;
    p.textContent = '';
    p.appendChild(el('h2', '', '红渊核心 · 回头'));
    p.appendChild(el('div', 'ending', txt));
    const r2 = el('div', 'btnrow');
    const b2 = el('button', '', '重新开始');
    b2.addEventListener('click', restart);
    r2.appendChild(b2);
    p.appendChild(r2);
  });
  row.appendChild(back);
  const btn = el('button', '', '重新开始');
  btn.addEventListener('click', restart);
  row.appendChild(btn);
  p.appendChild(row);
}

/* ───────── 工具 ───────── */
function intentKey(it) { return it ? it.type + ':' + (it.value || 0) + 'x' + (it.times || 1) : ''; }
function intentHtml(it) {
  if (!it) return '';
  if (it.type === 'attack') {
    const base = (it.value || 0) + (it.times && it.times > 1 ? '×' + it.times : '');
    return '<span class="i-atk">⚔ ' + base + '</span>';
  }
  if (it.type === 'defend') return '<span class="i-def">🛡 ' + (it.value || 0) + '</span>';
  if (it.type === 'buff') return '▲';
  if (it.type === 'debuff') return '▼';
  return '?';
}
function uiCost(card) {
  let c = card.energy || 0;
  if (C && C.layer.rule === 'dry' && (card.veins || []).indexOf('water') >= 0) c += 1;
  (run && run.relics || []).forEach(r => {
    const m = r.mod || {};
    if (m.vein_cost && (card.veins || []).indexOf(m.vein_cost) >= 0) c = Math.max(0, c + m.vein_cost_delta);
  });
  return c;
}
function playBlockReason(card) {
  if (C.over) return '战斗已经结束';
  if (card._locked) return '锁死：这张牌本层无法再打出';
  const cost = uiCost(card);
  if (C.energy < cost) return '能量不足（需要 ' + cost + '）';
  if (card.effect && card.effect.gaze_cost && run.gaze < card.effect.gaze_cost)
    return '凝视不足（需要 ' + card.effect.gaze_cost + '）';
  if (card.effect && card.effect.resonance_cost && C.resonance < card.effect.resonance_cost)
    return '共振不足（需要 ' + card.effect.resonance_cost + '）';
  return null;
}
function needsTarget(card) {
  const e = card.effect || {};
  if (e.target !== 'single') return false;
  if (e.damage) return true;
  return (e.special || []).some(s => ['burn', 'poison', 'weak', 'frail'].indexOf(s.code) >= 0);
}
function toast(msg, ms) {
  const t = $('#toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(t._tm);
  t._tm = setTimeout(() => t.classList.remove('show'), ms || 1600);
}
/* T40 一次性提示：localStorage 记账，每条只浮一次（3 秒） */
function onceHint(key, msg) {
  let show = true;
  try {
    const k = 'redabyss_hint_' + key;
    if (localStorage.getItem(k)) show = false;
    else localStorage.setItem(k, '1');
  } catch (e) { /* 存不了就本次会话提示一次 */ }
  if (show) toast(msg, 3000);
  return show;
}
/* ───────── 音效接口（T41）：只留钩子，不生成音频 ─────────
   playSfx(code, opts)：code 用语义化点分命名（见 docs/SFX_LIST.md）。
   window.__SFX_LOG 存在时收集所有 code，供对账；__SFX_MUTED 为静音开关入口（未实现）。
   未来接 Web Audio 时只改这个函数；接管旧通道：window.RedAbyssSFX = function(code, opts){...} */
function playSfx(code, opts) {
  if (window.__SFX_LOG) window.__SFX_LOG.push(code);
  if (window.__SFX_MUTED) return;
  try { if (typeof window.RedAbyssSFX === 'function') window.RedAbyssSFX(code, opts); } catch (e) {}
}
/* 氛围音预留：按层切换背景循环音。空实现，清单见 docs/SFX_LIST.md。 */
function setLayerAmbience(depth) {
  if (window.__SFX_LOG) window.__SFX_LOG.push('ambience.depth' + depth);
}
// 出牌飞出动画：克隆手牌做一个向上飞散的残影
function flyCard(handIdx) {
  const el0 = document.querySelectorAll('#hand .card')[handIdx];
  if (!el0) return;
  const r = el0.getBoundingClientRect();
  const g = el0.cloneNode(true);
  g.classList.add('ghost-fly');
  g.style.left = r.left + 'px';
  g.style.top = r.top + 'px';
  g.style.width = r.width + 'px';
  g.style.height = r.height + 'px';
  g.style.margin = '0';
  document.body.appendChild(g);
  setTimeout(() => g.remove(), 320);
}
function flash(sel, cls, ms) {
  const n = $(sel);
  if (!n) return;
  n.classList.add(cls);
  setTimeout(() => n.classList.remove(cls), ms || 600);
}
function resFlash() {
  document.body.classList.add('resflash');
  setTimeout(() => document.body.classList.remove('resflash'), 1100);
}
function floatText(container, txt, heal, staggerKey) {
  const f = el('div', 'float' + (heal ? ' heal' : ''), txt);
  if (staggerKey) {
    const off = floatOffsetFor(staggerKey);
    if (off) f.style.top = 'calc(30% + ' + off + 'px)';
  }
  container.appendChild(f);
  setTimeout(() => f.remove(), 450);
}

/* ── T37 动作队列：动画依次播，输入不等动画 ── */
const animQueue = [];
let animPumping = false;
function enqueueAnim(fn) { animQueue.push(fn); pumpAnim(); }
function pumpAnim() {
  if (animPumping || !animQueue.length) return;
  animPumping = true;
  requestAnimationFrame(() => {
    const job = animQueue.shift();
    const done = () => { animPumping = false; pumpAnim(); };
    try { job(done); } catch (e) { done(); }
  });
}
/* 并发浮字错开垂直位置：-0 / -20 / -40 px */
const floatSlots = {};
function floatOffsetFor(key) {
  const now = performance.now();
  const slot = floatSlots[key];
  if (!slot || now - slot.t > 450) { floatSlots[key] = { t: now, n: 0 }; return 0; }
  slot.n = (slot.n + 1) % 3;
  slot.t = now;
  return slot.n * -20;
}
/* 帧耗时看门狗：连续 3 帧 > 50ms 就降级（关光晕/上浮，只留颜色） */
(function perfWatch() {
  let slow = 0, last = performance.now();
  function tick(now) {
    if (now - last > 50) slow++; else slow = 0;
    last = now;
    if (slow >= 3) document.body.classList.add('perf-low');
    requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);
})();

/* ───────── 渲染 ───────── */
function render() {
  if (!C) return;
  const hpEl = $('#hud-hp');
  hpEl.textContent = run.hp + '/' + run.maxHp;
  hpEl.classList.toggle('hp-low', run.hp <= run.maxHp * 0.3);
  document.body.classList.toggle('dying', run.hp <= run.maxHp * 0.3);
  if (prev.hp !== undefined && run.hp < prev.hp) {
    document.body.classList.remove('shake');
    void document.body.offsetWidth;
    document.body.classList.add('shake');
    playSfx('combat.hurt');
  }
  prev.hp = run.hp;
  $('#hud-block').textContent = C.block;
  const bi = document.querySelector('#hud-block-wrap .ic.block');
  if (C.block > (prev.block || 0) && bi) {
    playSfx('combat.block');
    bi.classList.remove('pulse'); void bi.offsetWidth; bi.classList.add('pulse');
    setTimeout(() => bi.classList.remove('pulse'), 450);
  }
  prev.block = C.block;
  $('#hud-energy').textContent = C.energy + '/' + run.energyMax;
  $('#hud-res').textContent = C.resonance;
  const gl = document.getElementById('hud-gold-label');
  if (gl) gl.textContent = run.classId === 'anmin' ? '零件 ' : '金币 ';
  const gi = document.getElementById('hud-gold-ic');
  if (gi) gi.textContent = run.classId === 'anmin' ? '⚙' : '◈';
  $('#hud-gold').textContent = run.classId === 'anmin' ? (run.parts || 0) : run.gold;
  const pw = $('#hud-parts-wrap');
  if (run.classId === 'anmin') {
    pw.classList.remove('hidden');
    const pe = $('#hud-parts');
    if (prev.parts !== undefined && C && C.parts > prev.parts) floatText(pe, '+' + (C.parts - prev.parts) + ' 零件');
    pe.textContent = C ? C.parts : 0;
  } else pw.classList.add('hidden');
  if (C) prev.parts = C.parts;
  const cw = $('#hud-clarity-wrap');
  if (run.classId === 'cangmin') {
    cw.classList.remove('hidden');
    const ce = $('#hud-clarity');
    ce.textContent = run.clarity + '/' + (run.clarityMax || 5);
    ce.classList.toggle('clarity-low', run.clarity < 3);
  } else cw.classList.add('hidden');
  const dw = $('#hud-dream-wrap');
  if (run.classId === 'cangmin' && C && C.world === 'dream') {
    dw.classList.remove('hidden');
    $('#hud-dream').textContent = C.dreamHp + '/' + C.dreamMaxHp;
  } else dw.classList.add('hidden');
  const pb = $('#protocol-banner');
  if (C && C.activeProtocol) {
    const T = { lockdown: '协议：封锁', purge: '协议：清剿', silence: '协议：静默' };
    pb.textContent = T[C.activeProtocol] || C.activeProtocol;
    pb.classList.remove('hidden');
  } else pb.classList.add('hidden');
  const gz = $('#gaze-val');
  gz.textContent = run.gaze;
  if (run.gaze > (run.stats.maxGaze || 0)) run.stats.maxGaze = run.gaze;
  if (run.gaze > prev.gaze && run.stats.battles < 3) onceHint('gaze', '红渊记住了你一点。');
  if (run.gaze > prev.gaze) { playSfx('state.gaze'); gz.classList.add('flash'); setTimeout(() => gz.classList.remove('flash'), 900); }
  prev.gaze = run.gaze;
  $('#hud-layer').textContent = progressText();
  // 战斗界面：格挡/能量/共鸣是战斗内概念，这里恢复显示
  $('#hud-block-wrap').classList.remove('hidden');
  $('#hud-energy-wrap').classList.remove('hidden');
  $('#hud-res-wrap').classList.remove('hidden');
  const rel = $('#hud-relics');
  rel.textContent = '';
  (run.relics || []).forEach(r => {
    const sp = el('span', '');
    sp.innerHTML = relicBadge(r.id);
    sp.appendChild(document.createTextNode(r.name));
    sp.title = r.effect_text;
    rel.appendChild(sp);
  });

  if (C.resonanceFired > prev.resFired || C.resonance >= 30) {
    playSfx('state.resonance');
    if (C.resonanceFired >= 1 && prev.resFired < 1 && run.stats.battles < 3) {
      onceHint('res10', '共振到 10 了。这一层的红光会应你一声。');
    }
    resFlash();
  }
  prev.resFired = C.resonanceFired;

  const ea = $('#enemy-area');
  ea.textContent = '';
  C.enemies.forEach(e => {
    const box = el('div', 'enemy' + (e.dead ? ' dead' : '') + (pending !== null ? ' targetable' : ''));
    box.id = 'enemy-' + e.idx;
    const tierCls = { elite: 'esym-e', boss: 'esym-b' }[e.def && e.def.tier] || 'esym-n';
    const tierSymId = { elite: 'sym-door', boss: 'sym-snake' }[e.def && e.def.tier] || 'sym-eye';
    const eart = el('div', 'eart');
    eart.innerHTML = '<svg class="esym ' + tierCls + '" aria-hidden="true"><use href="#' + tierSymId + '"/></svg>';
    // T67：敌人素材查表（layer→母本生态，id 哈希选 3 张中的 1 张），查不到回落剪影符号
    if (window.ART && e.def && e.def.layer) {
      const ecoHome = { 1: 'eco_surface', 2: 'eco_cold', 3: 'eco_arid', 4: 'eco_sea',
        5: 'eco_vent', 6: 'eco_rad', 7: 'eco_core', 8: 'eco_nexus' }[e.def.layer];
      const h = String(e.def.id || '').split('').reduce((a, ch) => a + ch.charCodeAt(0), 0);
      const fid = 'foe_' + ecoHome + '_' + (1 + h % 3);
      if (ART[fid]) {
        eart.style.backgroundImage = 'url(' + ART[fid] + ')';
        eart.style.backgroundSize = 'cover';
        eart.style.backgroundPosition = 'center';
        eart.classList.add('has-art');
      }
    }
    box.appendChild(eart);
    box.appendChild(el('div', 'ename', e.name));
    const it = el('div', 'intent');
    if (e.intent && e.intent.type === 'attack' && !e.dead) it.classList.add('atk-hot');
    it.innerHTML = '意图　' + intentHtml(e.intent);
    const k = intentKey(e.intent);
    if (prev.intents[e.idx] !== undefined && prev.intents[e.idx] !== k && !e.dead) it.classList.add('flash');
    prev.intents[e.idx] = k;
    box.appendChild(it);
    const bar = el('div', 'hpbar');
    const fill = el('i');
    fill.style.width = Math.max(0, (e.hp / e.maxHp) * 100) + '%';
    bar.appendChild(fill);
    box.appendChild(bar);
    box.appendChild(el('div', 'hpnum', e.hp + ' / ' + e.maxHp + (e.block ? '　🛡' + e.block : '') +
      (e.status.burn ? '　灼烧' : '') + (e.status.poison ? '　中毒' : '') +
      (e.status.weak ? '　虚弱' : '') + (e.status.frail ? '　脆弱' : '') +
      (e.buffAtk ? '　▲' + e.buffAtk : '')));
    box.addEventListener('click', () => {
      if (e.dead || !C || C.over) return;
      if (pending !== null) doPlay(pending, e.idx);
    });
    if (e.dead && prev.dead && prev.dead[e.idx] === false) playSfx('combat.kill');
    prev.dead = prev.dead || {};
    prev.dead[e.idx] = e.dead;
    if (!e.dead && prev.hps[e.idx] !== undefined && prev.hps[e.idx] > e.hp) {
      const dmg = prev.hps[e.idx] - e.hp;
      enqueueAnim((done) => {
        const box2 = document.getElementById('enemy-' + e.idx);
        if (!box2) { done(); return; }
        box2.classList.add('hitflash');
        playSfx('enemy.hit');
        setTimeout(() => box2.classList.remove('hitflash'), 130);
        const f = el('div', 'float', '-' + dmg);
        const off = floatOffsetFor('e' + e.idx);
        if (off) f.style.top = 'calc(30% + ' + off + 'px)';
        box2.appendChild(f);
        setTimeout(() => { f.remove(); done(); }, 430);
      });
    }
    // 阶段：血条分割线 + 切换横幅
    if (e.phases && !e.dead) {
      e.phases.forEach((p) => {
        if (!p.hp_above) return;
        const mark = el('i', 'pmark');
        mark.style.left = (p.hp_above * 100) + '%';
        bar.appendChild(mark);
      });
      if (prev.phaseIdx[e.idx] !== undefined && prev.phaseIdx[e.idx] !== e.phaseIdx && e.phaseIdx > 0) {
        const banner = $('#phase-banner');
        banner.textContent = e.phases[e.phaseIdx].log || (e.name + ' 换了一种方式看你。');
        playSfx('special.boss_phase');
        banner.classList.add('show');
        clearTimeout(banner._tm);
        banner._tm = setTimeout(() => banner.classList.remove('show'), 2000);
      }
      prev.phaseIdx[e.idx] = e.phaseIdx;
    }
    prev.hps[e.idx] = e.hp;
    ea.appendChild(box);
  });

  const hand = $('#hand');
  hand.textContent = '';
  C.hand.forEach((card, i) => {
    const reason = playBlockReason(card);
    const worldMismatch = run.classId === 'cangmin' && !!card.dream !== (C.world === 'dream');
    const d = el('div', 'card' +
      (card.cost_type !== 'none' ? ' costly' : '') +
      (card.upgraded ? ' upgraded' : '') +
      (worldMismatch ? ' wrongworld' : '') +
      (reason ? ' dimmed' : '') +
      (pending === i ? ' selected' : ''));
    d.appendChild(el('div', 'cost', uiCost(card)));
    d.appendChild(el('div', 'ctype', card.type === 'attack' ? '攻' : card.type === 'power' ? '势' : '技'));
    appendArt(d, card);
    d.appendChild(el('div', 'cname', card.name));
    const vs = el('div', 'cveins');
    (card.veins || []).forEach(v => vs.appendChild(el('span', '', RedAbyss.VEIN_CN[v] || '?')));
    d.appendChild(vs);
    const desc = cardDesc(card);
    if (desc) d.appendChild(el('div', 'ctext', desc));
    if (card.flavor) d.appendChild(el('div', 'cflavor', card.flavor));
    d.title = [card.flavor, card.cost_type !== 'none' ? '代价：' + card.cost_text : ''].filter(Boolean).join('\n');
    d.addEventListener('pointerdown', (ev) => startCardPointer(ev, d, card, i, worldMismatch));
    hand.appendChild(d);
  });
  layoutFan();

  const bw = document.getElementById('btn-world');
  if (run.classId === 'cangmin') {
    const sc = document.getElementById('screen-combat');
    sc.classList.toggle('world-dream', C.world === 'dream');
    sc.classList.toggle('world-wake', C.world !== 'dream');
    if (bw) {
      bw.classList.remove('hidden');
      const inDream = C.world === 'dream';
      bw.textContent = inDream ? '醒来' : '入梦';
      bw.disabled = (inDream && C.dreamLocked) || (!inDream && run.clarity <= 0);
      bw.title = inDream ? '结束这次入梦' : '消耗 1 点清醒度入梦';
    }
  } else if (bw) {
    bw.classList.add('hidden');
    document.getElementById('screen-combat').classList.remove('world-dream');
    document.getElementById('screen-combat').classList.add('world-wake');
  }
  $('#pile-draw').textContent = '抽牌堆 ' + C.drawPile.length;
  $('#pile-discard').textContent = '弃牌堆 ' + C.discardPile.length;
  $('#pile-exhaust').textContent = C.exhaustPile.length ? '已消耗 ' + C.exhaustPile.length : '';
  // 弃牌堆整堆洗回抽牌堆：抽牌堆数字重置动画
  if (prev.discard > 0 && C.discardPile.length === 0 && C.drawPile.length > 0) {
    const pd = document.getElementById('pile-draw');
    if (pd) { pd.classList.remove('pulse'); void pd.offsetWidth; pd.classList.add('pulse'); setTimeout(() => pd.classList.remove('pulse'), 450); }
  }
  prev.discard = C.discardPile.length;

  const logBox = $('#log');
  logBox.textContent = '';
  // 2026-10-30 用户定：**最新的在最上面**（逆序渲染，视口停在顶部）
  const lastLine = C.log.length - 1;
  for (let li = lastLine; li >= 0; li--) {
    const line = C.log[li];
    const d = el('div', (/^──/.test(line) ? 'turnline' : /击中你|受到/.test(line) ? 'hurt' : '') +
      (/^──/.test(line) && li === lastLine ? ' new' : ''), line);
    logBox.appendChild(d);
  }
  logBox.scrollTop = 0;
}

/* 卡牌不可用：轻微抖动（浮字原因走 toast） */
function shakeCard(d) {
  d.classList.remove('shakeit'); void d.offsetWidth; d.classList.add('shakeit');
  setTimeout(() => d.classList.remove('shakeit'), 320);
}

/* ───────── T53 手牌交互：扇形布局 / 点击详情 / 拖动打出 ───────── */
function layoutFan() {
  const cards = [...document.querySelectorAll('#hand .card')];
  const n = cards.length;
  if (!n) return;
  const mid = (n - 1) / 2;
  const hand = document.getElementById('hand');
  const span = Math.min(66, Math.max(38, (hand.clientWidth - 170) / Math.max(n - 1, 1)));
  const depth = mid > 0 ? Math.min(26, 210 * 0.12) : 0;
  const k = mid > 0 ? depth / (mid * mid) : 0;
  cards.forEach((el, i) => {
    const off = i - mid;
    el.style.setProperty('--tx', (off * span).toFixed(1) + 'px');
    el.style.setProperty('--ty', (off * off * k).toFixed(1) + 'px');
    el.style.setProperty('--rot', (off * (n > 1 ? 2.2 : 0)).toFixed(2) + 'deg');
    el.style.zIndex = i + 1;
  });
}
function startCardPointer(ev, d, card, i, worldMismatch) {
  if (ev.button !== 0 || !C || C.over) return;
  const startX = ev.clientX, startY = ev.clientY;
  let dragging = false;
  // 2026-10-30：一开始就抓指针（快速甩手时 pointermove 会跑到别的元素上，拖动不启动）
  try { d.setPointerCapture(ev.pointerId); } catch (err) {}
  // 记下这张牌在扇形里的偏移。拖动时必须带上它，否则「点左边、牌跑到右边」，
  // 越靠后的牌偏得越多（--tx 是累加的），最后会把手牌右侧的牌拖到界面外。
  const baseTx = parseFloat(d.style.getPropertyValue('--tx')) || 0;
  const baseTy = parseFloat(d.style.getPropertyValue('--ty')) || 0;
  const baseRot = parseFloat(d.style.getPropertyValue('--rot')) || 0;
  // 扇形里的牌是绕底边旋转的，旋转本身会把卡面中心推走 (h/2)*sin(rot) 像素。
  // 拖动时取消旋转，就必须把这个偏移补回来，否则「点左边、牌偏右」（实测偏 8px）。
  const rotComp = (d.offsetHeight / 2) * Math.sin(baseRot * Math.PI / 180);
  const worldBad = worldMismatch || (run.classId === 'cangmin' && !!card.dream !== (C.world === 'dream'));
  const onMove = (e2) => {
    const dx = e2.clientX - startX, dy = e2.clientY - startY;
    if (!dragging && Math.hypot(dx, dy) > 8) {
      dragging = true;
      d.classList.add('dragging');
      if (needsTarget(card)) [...document.querySelectorAll('#enemy-area .enemy:not(.dead)')].forEach(b => b.classList.add('targetable'));
      openCardDetail(i);          // 一拖起来，右侧信息区显示这张牌
    }
    if (dragging) {
      // 位置 = 扇形原位置 + 指针位移；原点改中心、取消旋转（绕底边转会挪走卡面中心十几像素）
      d.style.transformOrigin = '50% 50%';
      d.style.transform = 'translateX(calc(-50% + ' + (baseTx + dx + rotComp) + 'px)) ' +
        'translateY(' + (baseTy + dy - 18) + 'px) scale(1.05)';
      d.style.zIndex = 100;
      const near = dropEnemy(e2.clientX, e2.clientY);
      [...document.querySelectorAll('#enemy-area .enemy')].forEach(b => b.classList.toggle('drop-hot', b === near));
    }
  };
  const onUp = (e2) => {
    d.removeEventListener('pointermove', onMove);
    d.removeEventListener('pointerup', onUp);
    d.removeEventListener('pointercancel', onCancel);
    window.removeEventListener('pointermove', onMove);
    window.removeEventListener('pointerup', onUp);
    window.removeEventListener('pointercancel', onCancel);
    d.classList.remove('dragging');
    [...document.querySelectorAll('#enemy-area .enemy')].forEach(b => b.classList.remove('targetable', 'drop-hot'));
    d.style.transform = ''; d.style.zIndex = ''; d.style.transformOrigin = '';
    layoutFan();
    if (!dragging) { openCardDetail(i); return; }
    document.getElementById('card-detail').classList.add('hidden');   // 拖完收起信息区
    // T40 首次能量不足提示（拖出失败也走一次）
    const reason = (() => {
      if (worldBad) return card.dream ? '这来自梦里，醒着的手握不住。' : '醒着的东西进不了这个深度。';
      return playBlockReason(card);
    })();
    if (reason) {
      shakeCard(d);
      if (/能量不足/.test(reason) && run.stats.battles < 3 && onceHint('energy', '能量见底了。结束回合，它会满上。')) return;
      toast(reason);
      return;
    }
    // 判定区：按敌人矩形外扩算距离，不用 elementFromPoint
    // （松手瞬间卡片还在过渡回位，那时 elementFromPoint 命中的是卡片自己）
    const ebox = dropEnemy(e2.clientX, e2.clientY);
    const onEnemy = !!ebox;
    if (needsTarget(card)) {
      if (onEnemy) { doPlay(i, +ebox.id.split('-')[1]); return; }
      pending = null;
      toast('把它拖到目标身上才算数。');
      render();
      return;
    }
    if (e2.clientY < startY - 24 || onEnemy) { doPlay(i, undefined); return; }
    // 收回：落回手牌区，什么都不发生
  };
  const onCancel = () => {
    d.removeEventListener('pointermove', onMove);
    d.removeEventListener('pointerup', onUp);
    d.removeEventListener('pointercancel', onCancel);
    window.removeEventListener('pointermove', onMove);
    window.removeEventListener('pointerup', onUp);
    window.removeEventListener('pointercancel', onCancel);
    d.classList.remove('dragging');
    [...document.querySelectorAll('#enemy-area .enemy')].forEach(b => b.classList.remove('targetable', 'drop-hot'));
    d.style.transform = ''; d.style.zIndex = ''; d.style.transformOrigin = '';
    layoutFan();
  };
  d.addEventListener('pointermove', onMove);
  d.addEventListener('pointerup', onUp);
  d.addEventListener('pointercancel', onCancel);
  // 备用：指针捕获失败时（旧浏览器/触控）也能继续拖
  window.addEventListener('pointermove', onMove);
  window.addEventListener('pointerup', onUp);
  window.addEventListener('pointercancel', onCancel);
}
/* 落点判定区：指针离哪个活着的敌人最近，且在宽容度内就算命中。
   单敌 170px（几乎所有「往上甩」都算命中）；多敌 70px，取最近的那只。 */
function dropEnemy(x, y) {
  const alive = [...document.querySelectorAll('#enemy-area .enemy:not(.dead)')];
  if (!alive.length) return null;
  const GIVE = alive.length === 1 ? 170 : 70;
  let best = null;
  alive.forEach(el => {
    const r = el.getBoundingClientRect();
    const dx = Math.max(r.left - x, 0, x - r.right);
    const dy = Math.max(r.top - y, 0, y - r.bottom);
    const dist = Math.hypot(dx, dy);
    if (!best || dist < best.dist) best = { el, dist };
  });
  return best && best.dist <= GIVE ? best.el : null;
}
function openCardDetail(i) {
  if (!C || C.over || !C.hand[i]) return;
  const card = C.hand[i];
  const worldBad = run.classId === 'cangmin' && !!card.dream !== (C.world === 'dream');
  const box = document.getElementById('card-detail');
  const cc = document.getElementById('cd-card');
  cc.textContent = '';
  cc.appendChild(renderCardStatic(card));
  const reason = worldBad ? (card.dream ? '这来自梦里，醒着的手握不住。' : '醒着的东西进不了这个深度。') : playBlockReason(card);
  const lines = [];
  if (worldBad) lines.push('<div class="warn">' + reason + '</div>');
  if (card.cost_type !== 'none' && card.cost_text) lines.push('<div>代价：' + card.cost_text + '</div>');
  if (needsTarget(card)) lines.push('<div class="osub">打出后要选一个目标：把它拖到敌人身上，或按「打出」再点敌人。</div>');
  if (reason && !worldBad) lines.push('<div class="warn">现在打不出：' + reason + '</div>');
  if (card.upgrade && !card.upgraded) lines.push('<div class="osub">这张牌可以在营火升级。</div>');
  document.getElementById('cd-name').textContent = card.name +
    (card.cost_type !== 'none' ? '　' + (card.energy || 0) + ' 费' : '') +
    '　' + (card.type === 'attack' ? '攻' : card.type === 'power' ? '势' : '技');
  document.getElementById('cd-lines').innerHTML = lines.join('');
  document.getElementById('cd-play').disabled = !!(reason || worldBad);
  const closePanel = () => {
    box.classList.add('hidden');
    if (pending !== null) { pending = null; render(); }
  };
  // 2026-10-30 补：原来「收回 / ×」没绑事件，面板打开后关不掉
  document.getElementById('cd-cancel').onclick = closePanel;
  document.getElementById('cd-close').onclick = closePanel;
  document.getElementById('cd-play').onclick = () => {
    box.classList.add('hidden');
    if (needsTarget(card)) { pending = i; render(); toast('选择一个目标'); }
    else doPlay(i, undefined);
  };
  box.classList.remove('hidden');
}

function cardDesc(card) {
  const e = card.effect || {};
  const parts = [];
  if (e.damage) parts.push('伤害 ' + e.damage + (e.hits > 1 ? '×' + e.hits : '') +
    (e.target === 'all' ? '（全体）' : ''));
  if (e.block) parts.push('格挡 ' + e.block);
  if (e.draw) parts.push('抽 ' + e.draw);
  if (e.resonance_gain) parts.push('共振 +' + e.resonance_gain);
  if (e.resonance_cost) parts.push('消耗共振 ' + e.resonance_cost);
  if (e.gaze_cost) parts.push('需要凝视 ' + e.gaze_cost);
  if (e.gaze_gain) parts.push('凝视 +' + e.gaze_gain);
  if (e.heal) parts.push('回复 ' + e.heal);
  if (e.resonance_drain) parts.push('共振 -' + e.resonance_drain);
  (e.special || []).forEach(s => {
    const m = { burn: '灼烧', poison: '中毒', weak: '虚弱', frail: '脆弱', strength: '力量',
      dexterity: '敏捷', regenerate: '再生', thorns: '荆棘', resonance_lock: '共振锁定',
      retain: '保留',
      gaze_reduce: '凝视 -', delete_random: '删除一张牌' };
    if (m[s.code]) parts.push(m[s.code] + (s.v ? ' ' + s.v : '') + (s.turns && (s.code === 'burn') ? '×' + s.turns : ''));
  });
  if (e.exhaust) parts.push('消耗');
  if (e.retain) parts.push('保留');
  return parts.join('　');
}

/* ───────── 牌堆查看 ───────── */
/* ───────── 回收面板（黯民） ───────── */
function showSalvagePanel() {
  if (!C || run.classId !== 'anmin') return;
  hideOverlay();
  const p = $('#overlay-panel');
  p.textContent = '';
  p.appendChild(el('h3', '', '回收（零件 ' + C.parts + '）'));
  p.appendChild(el('div', 'prow', '改造：花 2 零件，给一张手牌永久 +2 伤害（本局有效）。点击下方手牌执行。'));
  const handWrap = el('div', '');
  C.hand.forEach((card, i) => {
    const row = el('div', 'prow');
    row.appendChild(el('b', '', card.name + (card._salvaged && card._salvaged.damage ? '（已改装+' + card._salvaged.damage + '）' : '')));
    const btn = el('button', '', '改造 +2 伤害');
    btn.addEventListener('click', () => {
      const r = RedAbyss.salvageUpgrade(C, i, 'damage');
      toast(r.ok ? '改装登记完成' : r.msg);
      showSalvagePanel();
    });
    row.appendChild(btn);
    handWrap.appendChild(row);
  });
  p.appendChild(handWrap);
  p.appendChild(el('div', 'prow', '拆解：花 3 零件换 1 件随机遗物（战后结算）。威胁等级会上升：剩余敌人攻击 +1，不可撤销。'));
  const dis = el('button', '', '拆解（威胁等级 +1）');
  let armed = false;
  dis.addEventListener('click', () => {
    if (!armed) { armed = true; dis.textContent = '确认：威胁等级会上升'; return; }
    const r = RedAbyss.dismantle(C);
    toast(r.ok ? '威胁等级上调报文已送达' : r.msg);
    hideOverlay();
    render();
  });
  p.appendChild(dis);
  const close = el('button', '', '关闭');
  close.addEventListener('click', hideOverlay);
  p.appendChild(close);
  $('#overlay').classList.remove('hidden');
}

/* ───────── 牌堆查看 ───────── */
function showPile(title, cards) {
  const p = $('#overlay-panel');
  p.textContent = '';
  p.appendChild(el('h3', '', title + '（' + cards.length + '）'));
  cards.forEach(c => {
    const r = el('div', 'prow');
    const b = el('b', '', c.name);
    r.appendChild(b);
    r.appendChild(document.createTextNode(
      '　' + (c.energy || 0) + '费　' + (c.veins || []).map(v => RedAbyss.VEIN_CN[v]).join('') +
      (c.cost_type !== 'none' ? '　代价' : '')));
    p.appendChild(r);
  });
  const btn = el('button', '', '合上');
  btn.addEventListener('click', hideOverlay);
  p.appendChild(btn);
  $('#overlay').classList.remove('hidden');
}
$('#pile-draw').addEventListener('click', () => C && showPile('抽牌堆', C.drawPile));
$('#pile-discard').addEventListener('click', () => C && showPile('弃牌堆', C.discardPile));
$('#pile-exhaust').addEventListener('click', () => C && showPile('已消耗', C.exhaustPile));
function hideOverlay() { $('#overlay').classList.add('hidden'); }

/* ───────── 回收入口 ───────── */
document.getElementById('hud-parts').addEventListener('click', showSalvagePanel);

/* ───────── 选职业（T78 两步：卡面 → 详情模态 → 确认开局） ───────── */
const CLASS_INFO = {
  diver: {
    name: '下潜者',
    line: '殖民者。签了死亡合同从地表下去。他不知道这里是什么，靠仪器和常识活着。',
    stats: ['初始生命 80', '偏重：光脉 / 矿脉'],
    mechs: ['开局携带「死亡合同副本」：0 费抽 1 张牌。', '共鸣爬到 10 / 20 / 30 触发本层回应，超 30 过载。', '凝视越高，渊里的东西下手越重。']
  },
  tremor: {
    name: '震语者',
    line: '渊民。震台城邦派出的记忆者学徒。什么都知道，但什么都不能说。',
    stats: ['初始生命 72', '偏重：震脉 / 热脉'],
    mechs: ['开局携带「静日触杖」：0 费抽 1 张牌。', '出牌挂震脉链，链上伤害逐张抬升。', '偏重脉的牌更容易进奖励与事件选项。']
  },
  cangmin: {
    name: '疯先知',
    line: '苍民。一千三百年来第一批重新梦见伊格的人。城里人叫你疯先知，你没有纠正。',
    stats: ['醒 30 / 梦 60（双生命）', '清醒度 3 / 5', '双牌堆：清醒与梦'],
    mechs: ['清醒度耗尽会被强制叫醒。', '入梦后换用梦牌堆，梦里打人用想念。', '营火守夜可回清醒。']
  },
  anmin: {
    name: '维护者',
    line: '黯民。登记在册的维护者。机械按时送来零件，你按时签例检单。两千年来你们是彼此唯一的供应商。',
    stats: ['初始生命 76', '偏重：料脉 / 照脉', '专属：零件与协议'],
    mechs: ['零件是专属货币：战斗掉落折算零件。', '拆解协议：战后再领一件随机遗物。', '点击 HUD 零件可打开回收面板。']
  }
};
const classModal = document.getElementById('class-modal');
let modalClass = null;
function openClassModal(cls) {
  const info = CLASS_INFO[cls];
  if (!info) return;
  modalClass = cls;
  document.getElementById('class-modal-art').innerHTML =
    '<img src="assets/class/' + cls + '.webp" alt="' + info.name + ' 立绘">';
  document.getElementById('class-modal-detail').innerHTML =
    '<h2>' + info.name + '</h2>' +
    '<p class="cm-line">' + info.line + '</p>' +
    '<ul class="cm-stats">' + info.stats.map(x => '<li>' + x + '</li>').join('') + '</ul>' +
    '<ul class="cm-mechs">' + info.mechs.map(x => '<li>' + x + '</li>').join('') + '</ul>' +
    '<div class="btnrow"><button id="btn-dive-confirm">以此身份下潜</button></div>';
  document.getElementById('class-modal').classList.remove('hidden');
  document.getElementById('btn-dive-confirm').focus();
}
function closeClassModal() {
  document.getElementById('class-modal').classList.add('hidden');
  modalClass = null;
}
document.querySelectorAll('.classface').forEach(btn => {
  btn.addEventListener('click', () => { playSfx('ui.click'); openClassModal(btn.dataset.class); });
});
document.getElementById('class-modal-close').addEventListener('click', closeClassModal);
document.getElementById('class-modal').addEventListener('click', e => {
  if (e.target.id === 'class-modal') closeClassModal();   // 点遮罩关
});
document.addEventListener('keydown', e => {
  if (e.key === 'Escape' && modalClass) closeClassModal();
});
document.getElementById('class-modal-box').addEventListener('click', e => {
  const btnC = e.target.closest('#btn-dive-confirm');
  if (btnC && modalClass) { playSfx('ui.click'); const cls = modalClass; closeClassModal(); startRun(cls); }
});

/* ───────── 无障碍：字号 / 低饱和 / 键盘 ───────── */
$('#font-plus').addEventListener('click', () => {
  const s = Math.min(150, (parseFloat(document.body.dataset.fs || 100)) + 10);
  document.body.dataset.fs = s;
  document.body.style.fontSize = s + '%';
});
$('#font-minus').addEventListener('click', () => {
  const s = Math.max(80, (parseFloat(document.body.dataset.fs || 100)) - 10);
  document.body.dataset.fs = s;
  document.body.style.fontSize = s + '%';
});
$('#lowsat').addEventListener('click', () => document.body.classList.toggle('lowsat'));
document.addEventListener('keydown', (ev) => {
  if (ev.key === 'Escape') { hideOverlay(); return; }
  if (phase === 'map') {
    const picks = [...document.querySelectorAll('.mnode.pickable')];
    if (!picks.length) return;
    const cur = picks.indexOf(document.activeElement);
    let next = -1;
    if (ev.key === 'ArrowRight' || ev.key === 'ArrowUp') next = cur < 0 ? 0 : (cur + 1) % picks.length;
    if (ev.key === 'ArrowLeft' || ev.key === 'ArrowDown') next = cur < 0 ? picks.length - 1 : (cur - 1 + picks.length) % picks.length;
    if (next >= 0) { picks[next].focus(); ev.preventDefault(); return; }
    if ((ev.key === 'Enter' || ev.key === ' ') && cur >= 0) { picks[cur].click(); ev.preventDefault(); return; }
    return;
  }
  if (phase !== 'combat' || !C || C.over) return;
  if (ev.key === 'Enter' || ev.key === 'e' || ev.key === 'E') { $('#btn-end').click(); return; }
  const n = parseInt(ev.key, 10);
  if (n >= 1 && n <= 9) {
    const cardEl = document.querySelectorAll('#hand .card')[n - 1];
    if (cardEl && !cardEl.classList.contains('dimmed')) cardEl.click();
  }
});
</script>
<script>
/* ==T56-MAP-MODULE== 新地图模块（默认启用；?map=old 回退旧 4 行图）——小图 + 行程列表 + 总图 + T57 玩法。
   T71 版式重构：小图填满停靠容器、总图真实比例+纵向滚动+0.6–2× 缩放、行程列表（最新在上）、
   格子图标化（禁「战/事/随/商/英」汉字）、生态色板提亮（tools/check_palette.js 验证）。
   玩法接入（路线推进/死路救援/跨带 BOSS）在 T57；内容绑定在 T58。
   可见性在数据层裁剪：渲染前先 MapGen.pruneForFrontend，未见的节点/边不进 DOM。 */
(function () {
  'use strict';
  if (/[?&]map=old/.test(location.search)) return;   // 已确认条款 3（2026-10-30 18:35）：新地图默认；?map=old 仅作回退通道
  const MG = window.MapGen;
  if (!MG) { console.error('mapgen-lib 未注入'); return; }

  /* ── T71 DOM 装配：小图挪进停靠容器 + 行程列表 + 总图缩放条（HTML 骨架不动，全部在此注入）── */
  const mini0 = document.getElementById('minimap');
  const dock = document.createElement('div'); dock.id = 'mm-dock';
  if (mini0) {
    mini0.parentNode.insertBefore(dock, mini0);
    dock.appendChild(mini0);
    const logBox = document.createElement('div'); logBox.id = 'mm-log';
    logBox.innerHTML = '<div class="mm-log-cap">行程</div><div id="mm-log-rows"></div>';
    mini0.appendChild(logBox);
    // T75 图例（懒填充：ICON/TYPE_WORD 声明在本块之后，init 时只建空壳，首次渲染再填内容）
    const legend = document.createElement('div'); legend.id = 'mm-legend';
    mini0.insertBefore(legend, document.getElementById('mm-body'));
  }
  // T74 后续反馈：HUD 上加「地图」按钮（Tab 的可见入口）；放大弹层/背板整体移除
  const hudStats0 = document.querySelector('#hud .hud-stats');
  const hudMapBtn = document.createElement('button'); hudMapBtn.id = 'hud-mapbtn';
  hudMapBtn.textContent = '地图'; hudMapBtn.title = '打开总图（Tab）';
  if (hudStats0) hudStats0.appendChild(hudMapBtn);
  const fmSvg0 = document.getElementById('fm-svg');
  const zbar = document.createElement('div'); zbar.id = 'fm-zbar';
  zbar.innerHTML = '<button id="fm-zout" title="缩小（下限 0.6×）">−</button><span id="fm-zoom-val">100%</span>' +
    '<button id="fm-zin" title="放大（上限 2×）">＋</button><button id="fm-zreset" title="恢复真实比例">1:1</button>';
  if (fmSvg0) fmSvg0.parentNode.insertBefore(zbar, fmSvg0);
  const hint0 = document.getElementById('fm-hint');
  if (hint0) hint0.textContent = '图例：⚔敌袭 ☠头目 ✧变数 ◈补给 ✉遭遇 ⌂休整 ◆跨带BOSS ◉最终BOSS ?未探明 · 看得到的地方，就知道是什么' + '滚动条 / 滚轮 / 拖拽都能滚 · Ctrl+滚轮或按钮缩放 0.6–2× · 关闭：× / Esc / 点背景';

  /* ── T71 图标与命名：格子里只允许图标，禁止「战/事/随/商/英」汉字（aria 同口径）── */
  const ICON = { combat: '⚔', elite: '☠', random: '✧', shop: '◈', event: '✉', campfire: '⌂', boss: '◆', finalBoss: '◉' };
  const TYPE_WORD = { combat: '敌袭', elite: '头目', random: '变数', shop: '补给', event: '遭遇', campfire: '休整', boss: '跨带BOSS', finalBoss: '最终BOSS' };
  // 生态配色 v2（T71 提亮）：L*≥55、相邻带 ΔL*≥6、两两色相间隔≥25°。
  // 唯一来源 tools/eco_palette.json；tools/check_palette.js 对拍本表并验证 CIELAB 约束，改动须两处同步。
  const ECO_C = {
    eco_surface: '#998b53', eco_cold: '#59b4b6', eco_arid: '#c98350', eco_sea: '#68b291',
    eco_vent: '#d06b6b', eco_rad: '#85a567', eco_core: '#c46994', eco_nexus: '#84b2e4'
  };
  const ECO_NAME = {
    eco_surface: '地表', eco_cold: '寒洞', eco_arid: '旱窑', eco_sea: '空海',
    eco_vent: '喷口', eco_rad: '辐林', eco_core: '核心', eco_nexus: '枢网'
  };
  // 格名池：每生态 3 个地名，按节点 id 哈希取用（确定性，不耗 RNG）
  const ECO_PLACES = {
    eco_surface: ['管廊苔毯', '灯绳菜圃', '锚地花田'],
    eco_cold: ['霜桥栈道', '冰帘回廊', '冻井站台'],
    eco_arid: ['旱窑砖垛', '灰陶集市', '风磨谷道'],
    eco_sea: ['沉船巷', '水线灯房', '浮骸码头'],
    eco_vent: ['震台旧驿', '蒸阔台地', '硫齿栈桥'],
    eco_rad: ['荧草圃', '磷火窖', '辐斑梯田'],
    eco_core: ['红髓炉廊', '岩心鼓室', '熔阶神龛'],
    eco_nexus: ['枢网残架', '静默机房', '索引墓廊']
  };
  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, c =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  }
  function placeName(n) {
    const pool = ECO_PLACES[n.eco] || ECO_PLACES.eco_surface;
    let h = 0;
    for (let i = 0; i < n.id.length; i++) h = (h * 31 + n.id.charCodeAt(i)) >>> 0;
    return pool[h % pool.length];
  }

  // T57 运行时参数——与 tools/mapgen_spec.json v1.3 同步（单文件无法读外部 JSON，改动须两处同步）
  const P = {
    boss: { firstAlways: true, p0: 0.5, decay: 0.6, min: 0.1 },
    rescue: { penaltyHpPct: 10, penaltyGoldPct: 15, ambushChance: 0.5, pickRule: 'sameBandFirst',   // 后三项 T75 起弃用（回返/死路救援改用 backtrack 表）
      backtrack: { badEvent: 0.45, combat: 0.30, elite: 0.15, boss: 0.08, none: 0.02, hpPct: [0.08, 0.15], goldPct: [0.15, 0.25] } },   // 与 tools/mapgen_spec.json rescue.backtrack 同步
    randomMix: { campfire: 0.45, event: 0.40, shop: 0.15 }
  };

  /* ==T75-BACKTRACK-ROLL== 纯函数：回返/死路救援共用的遭遇判定表（tools/check_backtrack.js 抽取本段评测，防两处漂移） */
  const backtrackRoll = (rng, PB) => {
    const r = rng();
    if (r < PB.badEvent) return 'badEvent';
    if (r < PB.badEvent + PB.combat) return 'combat';
    if (r < PB.badEvent + PB.combat + PB.elite) return 'elite';
    if (r < PB.badEvent + PB.combat + PB.elite + PB.boss) return 'boss';
    return 'none';
  };
  /* ==/T75-BACKTRACK-ROLL== */

  const st = { region: null, visited: {}, currentId: null, walked: {},
    override: {}, crossCount: 0,
    _pendingNode: null, _pendingEdge: null, _effType: null, _rescueNote: null, runRef: null,
    log: [], backtrackLog: [], _focusNid: null, _pend: null, _lastMini: null };
  // 运行时 BOSS 替换只改类型口径（mapOverride），生成结果 region 不动（已确认条款 2）
  function effTypeOf(n) { return (st.override[n.id] && n.type !== 'finalBoss') ? 'boss' : n.type; }   // walked: 已走过的边（from>to 键）

  // 可见子图（数据层裁剪）：visited ∪ 边邻居 1 跳。渲染只吃这里的返回值。
  function visible() {
    return MG.pruneForFrontend(st.region, st.visited, 1);
  }
  function nodeById(id) {
    return st.region.nodes[+id.slice(1)];
  }
  function bandOfNode(n) { return n.band; }
  // 当前可走节点 = current 的出边终点（T57 会换成带判定的推进）
  function pickableIds() {
    return st.region.edges.filter(e => e.from === st.currentId).map(e => e.to).filter(id => !st.visited[id]);   // T75: 已访问的相邻格改走 btrack 回返，不重进
  }

  /* ── SVG 生成（T71：按容器像素 1:1 渲染，格子/节点/文字都够大；总图真实比例+缩放走 CSS 尺寸）── */
  function drawMap(o) {
    const r = st.region;
    const vis = visible();
    const visSet = {}; vis.nodes.forEach(n => { visSet[n.id] = true; });
    const picks = {}; pickableIds().forEach(id => { if (visSet[id]) picks[id] = true; });
    const cur = nodeById(st.currentId);
    const bossR = { finalBoss: .52, boss: .47 };   // 已访问的 BOSS 格略大；未探明一律统一尺寸（不漏类型）
    const s = ['<svg width="' + o.W + '" height="' + o.H + '" viewBox="0 0 ' + o.W + ' ' + o.H + '" xmlns="http://www.w3.org/2000/svg">'];
    // 生态底：小图铺满整块容器（不留空白），总图铺网格区
    for (let y = o.y0; y <= o.y1; y++) {
      for (let x = 0; x < r.w; x++) {
        s.push('<rect class="fm-eco" x="' + (o.padX + x * o.cw).toFixed(1) + '" y="' + (o.padTop + (y - o.y0) * o.ch).toFixed(1) +
          '" width="' + o.cw.toFixed(1) + '" height="' + o.ch.toFixed(1) + '" fill="' + (ECO_C[r.ecoOf[y * r.w + x]] || '#454545') + '"/>');
      }
    }
    // 当前带高亮罩（焦点不在当前带时不画）
    const curBandY = (cur.band - 1) * r.bandRows;
    if (curBandY >= o.y0 && curBandY <= o.y1) {
      s.push('<rect class="fm-band-cur" x="' + o.padX + '" y="' + (o.padTop + (curBandY - o.y0) * o.ch).toFixed(1) +
        '" width="' + (o.W - 2 * o.padX) + '" height="' + (r.bandRows * o.ch).toFixed(1) + '"/>');
    }
    // 深度线 + D1–D8 标签（当前所在带加亮）
    for (let b = 1; b <= 8; b++) {
      const bandY0 = (b - 1) * r.bandRows;
      if (bandY0 < o.y0 || bandY0 > o.y1) continue;
      const yTop = o.padTop + (bandY0 - o.y0) * o.ch;
      s.push('<text class="fm-blabel' + (cur.band === b ? ' cur' : '') + '" x="' + (o.W - (o.mini ? 3 : 5)) +
        '" y="' + (yTop + 11) + '" text-anchor="end">D' + b + '</text>');
      if (b > 1) s.push('<line class="fm-depth" x1="0" y1="' + yTop.toFixed(1) + '" x2="' + o.W + '" y2="' + yTop.toFixed(1) + '"/>');
    }
    // 边（T75：全图渲染——视野外段压暗；走过的加粗）
    r.edges.forEach(e => {
      const u = nodeById(e.from), v = nodeById(e.to);
      if (u.y < o.y0 || u.y > o.y1 || v.y < o.y0 || v.y > o.y1) return;
      const key = e.from + '>' + e.to;
      const fog = (!visSet[e.from] || !visSet[e.to]) ? ' fog' : '';
      const cls = 'fm-line' + (e.crossBand ? ' cross' : '') + (st.walked[key] ? ' walked' : '') + fog;
      s.push('<line class="' + cls + '" x1="' + (o.padX + u.x * o.cw + o.cw / 2).toFixed(1) + '" y1="' + (o.padTop + (u.y - o.y0) * o.ch + o.ch / 2).toFixed(1) +
        '" x2="' + (o.padX + v.x * o.cw + o.cw / 2).toFixed(1) + '" y2="' + (o.padTop + (v.y - o.y0) * o.ch + o.ch / 2).toFixed(1) + '"/>');
    });
    // 节点（T75）：可见（已访问 ∪ 邻接已访问）直接显示真实类型 + data-type；
    // 可见范围外一律「?」且 DOM 不带任何类型字段；已访问的直接入邻格可「回返」
    const btSet = {};
    r.edges.forEach(e => { if (e.to === st.currentId && st.visited[e.from]) btSet[e.from] = true; });
    r.nodes.forEach(n => {
      if (n.y < o.y0 || n.y > o.y1) return;
      const eff = effTypeOf(n);
      const known = !!st.visited[n.id];
      const inSight = !!visSet[n.id];
      const showType = known || inSight;
      const cx = o.padX + n.x * o.cw + o.cw / 2, cy = o.padTop + (n.y - o.y0) * o.ch + o.ch / 2;
      const rad = Math.max(4.2, Math.min(o.cw, o.ch) * (showType ? (bossR[eff] || .42) : .42));
      const cls = 'fm-node' + (n.id === st.currentId ? ' here' : '') +
        (known ? '' : (inSight ? ' near' : ' unseen')) +
        (picks[n.id] ? ' pick' : '') + (btSet[n.id] ? ' btrack' : '');
      const label = known
        ? ICON[eff] + ' ' + TYPE_WORD[eff] + '，深度带D' + n.band +
          (n.id === st.currentId ? '，当前所在' : (btSet[n.id] ? '，可回返' : (picks[n.id] ? '，可走' : '，已探索')))
        : inSight
          ? ICON[eff] + ' ' + TYPE_WORD[eff] + '，深度带D' + n.band + (picks[n.id] ? '，可走' : '')
          : '未探明，深度带D' + n.band;
      s.push('<g class="' + cls + '" data-nid="' + n.id + '"' + (showType ? ' data-type="' + eff + '"' : '') +
        ' tabindex="0" role="button" aria-label="' + label + '">' +
        '<circle cx="' + cx.toFixed(1) + '" cy="' + cy.toFixed(1) + '" r="' + rad.toFixed(1) + '"/>' +
        '<text class="fm-glyph" x="' + cx.toFixed(1) + '" y="' + cy.toFixed(1) + '" style="font-size:' +
        Math.max(11, Math.round(rad * 1.8)) + 'px">' + (showType ? ICON[eff] : '?') + '</text></g>');
    });
    s.push('</svg>');
    return s.join('');
  }

  /* ── 小图：焦点带 + 下一带（T74: 网格加宽到 20 列、带高 12 行后，窗口行数自适应——
        格子不足 10px 时只显示 1 个带，保住 T71 的「格子 ≥10px / 节点 ≥7px / 文字 ≥11px」验收线）── */
  function renderMiniMap() {
    if (!st.region) return;
    const body = document.getElementById('mm-body');
    if (!body || body.clientWidth < 60 || body.clientHeight < 60) return;
    const r = st.region, cur = nodeById(st.currentId);
    document.getElementById('mm-band').textContent =
      'D' + cur.band + ' · ' + RedAbyss.LAYER_AT(cur.band).name + ' · ' + (ECO_NAME[cur.eco] || '');
    const fb = st._focusNid ? ((nodeById(st._focusNid) || cur).band) : cur.band;
    const y0 = Math.min((fb - 1) * r.bandRows, r.h - 1);
    const maxRows = Math.floor(body.clientHeight / 10);
    const bands = Math.max(1, Math.min(2, Math.floor(maxRows / r.bandRows)));
    const y1 = Math.min(r.h - 1, y0 + bands * r.bandRows - 1);
    const W = body.clientWidth, H = body.clientHeight;
    st._lastMini = { W, H, cw: W / r.w, ch: H / (y1 - y0 + 1), rows: y1 - y0 + 1 };
    body.innerHTML = drawMap({ y0, y1, W, H, cw: W / r.w, ch: H / (y1 - y0 + 1), padX: 0, padTop: 0, mini: true });
    wireClicks(body);
    paintHl();
    paintCursor();
    renderLog();
    const lgEl = document.getElementById('mm-legend');
    if (lgEl && !lgEl.dataset.built) {
      lgEl.innerHTML = '<b>图例</b>' + Object.keys(ICON).map(k =>
        '<span class="lg-i">' + ICON[k] + TYPE_WORD[k] + '</span>').join('') +
        '<span class="lg-i">?未探明</span><span class="lg-tip">看得到的地方，就知道是什么</span>';
      lgEl.dataset.built = '1';
    }
  }

  /* ── 行程列表：每个已访问格子一行，最新在最上面；点行高亮对应格子 ── */
  function renderLog() {
    const box = document.getElementById('mm-log-rows');
    if (!box) return;
    if (!st.log.length) { box.innerHTML = '<div class="mm-log-empty">还没走过任何格子</div>'; return; }
    box.innerHTML = st.log.map(e =>
      '<div class="mm-row' + (e.nid === st._focusNid ? ' active' : '') + '" data-nid="' + e.nid +
      '" title="点一下：在小图上定位这一格">' +
      '<span class="mm-ic">' + e.icon + '</span>' +
      '<span class="mm-name">' + esc(e.name) + '</span>' +
      '<span class="mm-tail">' + e.word +
      (e.gains.length ? '<span class="mm-gain">　' + esc(e.gains.join(' · ')) + '</span>' : '') +
      '</span>' +
      '<div class="mm-desc">' + esc(e.desc) + '</div>' +
      '</div>').join('');
    box.querySelectorAll('.mm-row').forEach(row => {
      row.addEventListener('click', () => {
        const nid = row.getAttribute('data-nid');
        st._focusNid = (st._focusNid === nid) ? null : nid;
        renderMiniMap();   // 焦点带不在当前窗口时窗口跟着挪；高亮在 paintHl 里补
        if (st._focusNid) {
          const nr = box.querySelector('.mm-row[data-nid="' + nid + '"]');
          if (nr) { nr.classList.add('active'); nr.scrollIntoView({ block: 'nearest' }); }
        }
      });
    });
  }
  function paintHl() {
    document.querySelectorAll('.fm-node.hl').forEach(g => g.classList.remove('hl'));
    if (!st._focusNid) return;
    document.querySelectorAll('.fm-node[data-nid="' + st._focusNid + '"]').forEach(g => g.classList.add('hl'));
  }

  /* ── 总图：真实比例渲染 + 容器纵向滚动（滚动条/滚轮/拖拽）+ 0.6–2× 缩放 ── */
  const FCELL = 24, FPADX = 20, FPTOP = 10;      // 1× 时的真实像素格距
  const fm = { open: false, z: 1, W: 0, H: 0 };
  function fullMapSvg() {
    const r = st.region;
    fm.W = r.w * FCELL + FPADX * 2;
    fm.H = r.h * FCELL + FPTOP + 6;
    return drawMap({ y0: 0, y1: r.h - 1, W: fm.W, H: fm.H, cw: FCELL, ch: FCELL, padX: FPADX, padTop: FPTOP, mini: false });
  }
  function buildFullMap(keepScroll) {
    const box = document.getElementById('fm-svg');
    const sl = box.scrollLeft, stp = box.scrollTop;
    box.innerHTML = fullMapSvg();
    const svg = box.querySelector('svg');
    svg.style.width = (fm.W * fm.z) + 'px';
    svg.style.height = (fm.H * fm.z) + 'px';
    document.getElementById('fm-zoom-val').textContent = Math.round(fm.z * 100) + '%';
    if (keepScroll) { box.scrollLeft = sl; box.scrollTop = stp; }
    wireClicks(box);
  }
  function openFullMap() {
    buildFullMap(false);
    document.getElementById('fullmap-layer').classList.add('show');
    fm.open = true;
    centerOnCurrent();
  }
  function centerOnCurrent() {
    const box = document.getElementById('fm-svg'), cur = nodeById(st.currentId);
    if (!box || !cur) return;
    box.scrollLeft = Math.max(0, (FPADX + cur.x * FCELL + FCELL / 2) * fm.z - box.clientWidth / 2);
    box.scrollTop = Math.max(0, (FPTOP + cur.y * FCELL + FCELL / 2) * fm.z - box.clientHeight / 3);
  }
  function closeFullMap() {
    document.getElementById('fullmap-layer').classList.remove('show');
    fm.open = false;
  }
  function fmSetZoom(nz, unitX, unitY) {
    nz = Math.round(Math.max(0.6, Math.min(2, nz)) * 100) / 100;
    if (nz === fm.z) return;
    const box = document.getElementById('fm-svg');
    if (unitX == null) {   // 缺省锚点 = 视口中心
      unitX = (box.scrollLeft + box.clientWidth / 2) / fm.z;
      unitY = (box.scrollTop + box.clientHeight / 2) / fm.z;
    }
    fm.z = nz;
    const svg = box.querySelector('svg');
    svg.style.width = (fm.W * nz) + 'px';
    svg.style.height = (fm.H * nz) + 'px';
    box.scrollLeft = Math.max(0, unitX * nz - box.clientWidth / 2);
    box.scrollTop = Math.max(0, unitY * nz - box.clientHeight / 2);
    document.getElementById('fm-zoom-val').textContent = Math.round(nz * 100) + '%';
  }
  function fmWheel(e) {
    if (!e.ctrlKey) return;   // 普通滚轮 = 原生滚动；Ctrl+滚轮 = 以光标为锚缩放
    e.preventDefault();
    const box = e.currentTarget, rect = box.getBoundingClientRect();
    const ux = (box.scrollLeft + (e.clientX - rect.left)) / fm.z;
    const uy = (box.scrollTop + (e.clientY - rect.top)) / fm.z;
    fmSetZoom(fm.z * (e.deltaY < 0 ? 1.15 : 1 / 1.15), ux, uy);
  }
  function fmPan(e) {
    if (e.button !== 0) return;
    const box = e.currentTarget;
    box.classList.add('panning');
    const sx = e.clientX, sy = e.clientY, ol = box.scrollLeft, ot = box.scrollTop;
    let moved = 0;
    const move = ev => {
      moved = Math.max(moved, Math.abs(ev.clientX - sx) + Math.abs(ev.clientY - sy));
      box.scrollLeft = ol - (ev.clientX - sx);
      box.scrollTop = ot - (ev.clientY - sy);
    };
    const up = () => {
      box.classList.remove('panning');
      window.removeEventListener('pointermove', move);
      window.removeEventListener('pointerup', up);
      if (moved > 6) {   // 拖拽后拦掉紧随的 click，避免松手误入格子
        box.dataset.dragged = '1';
        setTimeout(() => { delete box.dataset.dragged; }, 0);
      }
    };
    window.addEventListener('pointermove', move);
    window.addEventListener('pointerup', up);
  }
  function wireClicks(root) {
    const box = root.id === 'fm-svg' ? root : null;
    root.querySelectorAll('.fm-node.pick').forEach(g => {
      g.addEventListener('click', ev => {
        ev.stopPropagation();
        if (box && box.dataset.dragged) return;
        playSfx('ui.click');
        enterNode(g.getAttribute('data-nid'));
      });
    });
    root.querySelectorAll('.fm-node.btrack').forEach(g => {
      g.addEventListener('click', ev => {
        ev.stopPropagation();
        if (box && box.dataset.dragged) return;
        backtrackTo(g.getAttribute('data-nid'));   // T75 回返入口（必定触发遭遇）
      });
    });
  }

  /* ── 接线：开局生成 / 换屏刷新 / 总图开关 ─────────── */
  // 浏览器侧内容绑定数据源：用页面内联 RAW 按 layer/tier 过滤（与 T55 测试的 node 侧 provider 同口径；
  // 实表与回退链细化在 T58 的 data/mapgen_bindings.json）
  function dataProvider(ecoId, band) {
    const es = (RAW.enemies || []).filter(x => x.layer === band);
    const evs = (RAW.events || []).filter(x => x.layer === band);
    if (!es.length && !evs.length) return null;
    return {
      enemyPool: es.filter(x => x.tier === 'normal').map(x => x.id),
      elitePool: es.filter(x => x.tier === 'elite').map(x => x.id),
      bossPool: es.filter(x => x.tier === 'boss').map(x => x.id),
      eventPool: evs.map(x => x.id)
    };
  }
  function initRun() {
    const seed = /[?&]mapseed=(\d+)/.test(location.search)
      ? parseInt(location.search.match(/[?&]mapseed=(\d+)/)[1], 10)
      : (Math.random() * 2147483647) >>> 0;
    st.region = MG.generate(seed, null, dataProvider);
    st.visited = {}; st.walked = {};
    st.override = {}; st.crossCount = 0;
    st._pendingNode = null; st._pendingEdge = null; st._effType = null; st._rescueNote = null;
    st.log = []; st.backtrackLog = []; st._focusNid = null; st._pend = null; st._lastMini = null;
    st.currentId = st.region.startId;
    st.visited[st.currentId] = true;
    const sn = nodeById(st.currentId);
    st.log.unshift({ nid: sn.id, name: placeName(sn), icon: '❖', word: '起点',
      gains: [], _relicNames: [], desc: '下潜的起点。红渊从这里开始看你。' });
    run.depth = nodeById(st.currentId).band;   // 主题与层规则跟带走
    run.row = 0; run.col = 0;                  // 奖励结算按 layerRows()[0][0] 取合成类型
    st.runRef = run;
  }

  /* ── 行程日志：进入格子建条目，到达时结算收获（状态差分，覆盖战斗/事件/商店/营火全部来源）── */
  function pendEntry(n) {
    st._pend = {
      nid: n.id, name: placeName(n),
      icon: ICON[st._effType] || '?', word: TYPE_WORD[st._effType] || '未知',
      gains: [], _relicNames: [], desc: '', _rescue: false,
      _cur: run.classId === 'anmin' ? (run.parts || 0) : run.gold,
      _hp: run.hp, _deck: run.deck.slice()
    };
  }
  function markResolved(kind, desc) {
    if (!st._pend) return;
    st._pend.icon = ICON[kind] || st._pend.icon;
    st._pend.word = TYPE_WORD[kind] || st._pend.word;
    if (desc) st._pend.desc = desc;
  }
  function finalizeLog() {
    const p = st._pend;
    if (!p) return;
    const dCur = (run.classId === 'anmin' ? (run.parts || 0) : run.gold) - p._cur;
    if (dCur > 0) p.gains.push((run.classId === 'anmin' ? '零件 +' : '金币 +') + dCur);
    const dHp = run.hp - p._hp;
    if (dHp !== 0) p.gains.push('生命 ' + (dHp > 0 ? '+' + dHp : '-' + (-dHp)));
    const have = new Set(p._deck);
    run.deck.forEach(c => { if (!have.has(c)) p.gains.push('得卡「' + c.name + '」'); });
    p._relicNames.forEach(nm => p.gains.push('遗物「' + nm + '」'));
    st._pend = null;
    st.log.unshift(p);   // 最新在最上面
    renderLog();
  }
  // 钩子：包一层全局结算函数取「描述/遗物」，不改其内部逻辑（函数声明在全局作用域，包装对全页生效）
  const _grantRelic = window.grantRelic;
  window.grantRelic = function (r) {
    const n0 = st._pend ? run.relics.length : -1;
    _grantRelic(r);
    if (st._pend && n0 >= 0 && run.relics.length > n0) st._pend._relicNames.push(r.name);
  };
  const _finishCombatFlow = window.finishCombatFlow;
  window.finishCombatFlow = function () {
    _finishCombatFlow();
    if (st._pend && typeof C !== 'undefined' && C && C.result === 'win') {
      const dead = C.enemies.filter(x => x.dead).map(x => x.name);
      st._pend.desc = (st._pend._rescue ? '救援路上遭遇伏击：' : '') +
        '击退 ' + dead.slice(0, 2).join('、') + (dead.length > 2 ? ' 等 ' + dead.length + ' 名' : '');
    }
  };
  const _chooseEventOption = window.chooseEventOption;
  window.chooseEventOption = function (ev, i) {
    const o = ev && ev.options ? ev.options[i] : null;
    _chooseEventOption(ev, i);
    if (st._pend && o) st._pend.desc = String(o.result_text || '').split('\n')[0];
  };
  const _campfireResult = window.campfireResult;
  window.campfireResult = function (text, lines) {
    _campfireResult(text, lines);
    if (st._pend) st._pend.desc = String(text || '').split('\n')[0];
  };

  /* ── T57 路线推进 ─────────────────────────────────── */
  function isDeadEnd() {
    const cur = nodeById(st.currentId);
    if (effTypeOf(cur) === 'finalBoss') return false;
    return !st.region.edges.some(e => e.from === st.currentId && !st.visited[e.to]);
  }
  function pickEnemies(poolIds, band, tier, wantCount) {
    let defs = [];
    if (poolIds && poolIds.length) {
      const bag = RAW.enemies.filter(x => poolIds.indexOf(x.id) >= 0).slice();
      const want = wantCount || (tier === 'normal' ? (run.rng() < 0.35 ? 1 : 2) : 1);
      while (defs.length < want && bag.length) defs.push(bag.splice(Math.floor(run.rng() * bag.length), 1)[0]);
    }
    if (!defs.length) defs = RAW.enemies.filter(x => x.layer === band && x.tier === tier).slice(0, wantCount || (tier === 'normal' ? (run.rng() < 0.35 ? 1 : 2) : 1));
    return defs;
  }
  function pickEventFor(n) {
    const B = n.binding || {};
    if (B.eventPool && B.eventPool.length) {
      const pool = RAW.events.filter(x => B.eventPool.indexOf(x.id) >= 0);
      if (pool.length) return pool[Math.floor(run.rng() * pool.length)];
    }
    // 旧回退链：就近层的层事件池
    let pool = RAW.events.filter(x => x.layer === n.band);
    for (let off = 1; off <= 8 && !pool.length; off++) {
      pool = RAW.events.filter(x => x.layer === n.band - off || x.layer === n.band + off);
    }
    return pool.length ? pool[Math.floor(run.rng() * pool.length)] : null;
  }
  function dispatch(type, n) {
    const B = n.binding || {};
    if (type === 'shop') { markResolved('shop', '在前哨杂货换了些补给。'); shopState = buildShopStock(); showShop(); return; }
    if (type === 'event') { markResolved('event'); const ev = pickEventFor(n); if (ev) showEvent(ev); return; }
    if (type === 'random') {
      const r = run.rng();
      if (r < P.randomMix.campfire) { markResolved('campfire'); showCampfire(); return; }
      if (r < P.randomMix.campfire + P.randomMix.event) { markResolved('event'); const ev = pickEventFor(n); if (ev) showEvent(ev); return; }
      markResolved('shop', '在前哨杂货换了些补给。');
      shopState = buildShopStock(); showShop(); return;
    }
    if (type === 'elite') { startCombatFlow(pickEnemies(B.elitePool, n.band, 'elite')); return; }
    if (type === 'boss' || type === 'finalBoss') { startCombatFlow(pickEnemies(B.bossPool, n.band, 'boss')); return; }
    startCombatFlow(pickEnemies(B.enemyPool, n.band, 'normal'));
  }
  function enterNode(nid) {
    const n = nodeById(nid);
    if (!n || st._pendingNode) return;
    if (st.visited[nid]) { backtrackTo(nid); return; }   // T75: 点已访问格 = 回返（不重触发内容）
    const edge = st.region.edges.find(e => e.from === st.currentId && e.to === nid);
    // 跨带 BOSS 运行时判定：首次必出；之后 p0 逐带衰减到下限（只改 run 级 override）
    if (edge && edge.crossBand) {
      st.crossCount += 1;
      if (!st.override[nid] && n.type !== 'finalBoss') {
        const p = (st.crossCount === 1 && P.boss.firstAlways)
          ? 1
          : Math.max(P.boss.min, P.boss.p0 * Math.pow(P.boss.decay, st.crossCount - 2));
        if (run.rng() < p) st.override[nid] = true;
      }
    }
    st._pendingNode = nid;
    st._pendingEdge = edge ? edge.from + '>' + edge.to : null;
    st._effType = effTypeOf(n);
    pendEntry(n);            // T71 行程条目：进入即建，到达时结算
    run.depth = n.band;      // 目的格的层规则/主题在战斗里生效
    dispatch(st._effType, n);
  }
  function arriveAtNode() {
    const n = nodeById(st._pendingNode);
    if (st._pendingEdge) st.walked[st._pendingEdge] = true;
    st.visited[n.id] = true;
    finalizeLog();           // 行程结算：在状态再次变动前吃差分
    st.currentId = n.id;
    st._pendingNode = null; st._pendingEdge = null;
    st._focusNid = null;
    shopState = null;
    run.depth = n.band;
    run.row = 0; run.col = 0;
    if (n.type === 'finalBoss') { showVictory(); return; }
    showMap();   // 迷雾在 _showMap 里按新 visited 重算重绘
  }
  /* ── T75 回返：点已走过的直接入邻格退 1 格，必定触发一次遭遇（与死路救援共用同一套判定） ── */
  function r_edgesIn(nid) { return st.region.edges.filter(e => e.to === nid).map(e => e.from); }
  function backtrackTargets() {   // 当前格的直接入邻（已访问），浅的优先（更靠起点方向）
    return r_edgesIn(st.currentId)
      .map(id => nodeById(id)).filter(n => st.visited[n.id])
      .sort((a, b) => (a.y - b.y) || (a.id < b.id ? -1 : 1));
  }
  function resolveEncounter(n) {   // 遭遇判定（backtrackRoll 表：坏事件45/战斗30/精英15/跨带BOSS8/空手2）
    const roll = backtrackRoll(run.rng, P.rescue.backtrack);
    const B = n.binding || {};
    if (roll === 'badEvent') {
      let line;
      if (run.rng() < 0.5 && run.gold > 0) {
        const pct = P.rescue.backtrack.goldPct[0] + run.rng() * (P.rescue.backtrack.goldPct[1] - P.rescue.backtrack.goldPct[0]);
        const cut = Math.min(run.gold, Math.floor(run.gold * pct));
        run.gold -= cut;
        line = '回返的代价：碎屑在暗处散了一路，金币 -' + cut + '。';
      } else {
        const pct = P.rescue.backtrack.hpPct[0] + run.rng() * (P.rescue.backtrack.hpPct[1] - P.rescue.backtrack.hpPct[0]);
        const cut = Math.max(1, Math.ceil(run.hp * pct));
        run.hp = Math.max(1, run.hp - cut);   // 回返不杀人（与死路救援同一取舍）
        line = '回返的代价：暗处的一记冷手，生命 -' + cut + '。';
      }
      C.log.push(line); st.backtrackLog.push(line);
      showFlowPanel('回返', [el('div', 'flavor', line + ' 你退回了 ' + placeName(n) + '。')], '继续下潜', arriveAtNode);
      return;
    }
    if (roll === 'combat') {
      const want = 2 + (run.rng() < 0.5 ? 1 : 0);   // 2–3 只
      st._effType = 'combat';
      const lC = '回返遇袭：' + placeName(n) + ' 的猎手闻着味来了（' + want + '）。';
      C.log.push(lC); st.backtrackLog.push(lC);
      startCombatFlow(pickEnemies(B.enemyPool, n.band, 'normal', want));
      return;
    }
    if (roll === 'elite') {
      st._effType = 'elite';
      C.log.push('回返撞上了头目——它认得回头的人。'); st.backtrackLog.push('回返撞上了头目——它认得回头的人。');
      startCombatFlow(pickEnemies(B.elitePool, n.band, 'elite'));
      return;
    }
    if (roll === 'boss') {
      st._effType = 'boss';
      C.log.push('回返惊动了大家伙——跨带的它转过头来。'); st.backtrackLog.push('回返惊动了大家伙——跨带的它转过头来。');
      startCombatFlow(pickEnemies(B.bossPool, n.band, 'boss'));
      return;
    }
    // none（2%）：空手而归
    C.log.push('回返：什么都没发生，只有自己的脚步声。'); st.backtrackLog.push('回返：什么都没发生，只有自己的脚步声。');
    toast('回返：空手而归。');
    arriveAtNode();
  }
  function backtrackTo(nid) {
    const n = nodeById(nid);
    if (!n || st._pendingNode) return;
    if (!st.visited[n.id]) return;                 // 只能回走到已走过的格
    if (!r_edgesIn(st.currentId).includes(nid)) return;   // 每次只退 1 格（直接入邻）
    playSfx('ui.click');
    st._pendingNode = nid;
    st._pendingEdge = null;                        // 回走不算新的行进边
    st._effType = effTypeOf(n);
    st._pend = null;                               // 重访不重复记行程（行程行已有这一格）
    run.depth = n.band;
    resolveEncounter(n);
  }
  function doRescue() {
    if (!isDeadEnd() || st._pendingNode) return;
    const back = backtrackTargets()[0];
    if (!back) { toast('渊里安静得反常——连回头路都没有。'); return; }
    st._rescueNote = '必须回返：你退回了 ' + placeName(back) + '。';
    const lR = '死路回返：退回 ' + placeName(back) + '（D' + back.band + '）。';
    C.log.push(lR); st.backtrackLog.push(lR);
    backtrackTo(back.id);
  }

  const _showScreen = window.showScreen;
  window.showScreen = function (id) {
    _showScreen(id);
    const dk = document.getElementById('mm-dock');
    if (!dk) return;
    // 2026-10-31 反馈最终版：小图只在地图选择态出现（大图居中偏下）；事件/战斗等一律不放
    const big = id === '#screen-flow' && phase === 'map' && !!run;
    dk.classList.toggle('big', big);
    dk.classList.toggle('show', big);
    if (big) renderMiniMap();
  };

  const _progressText = window.progressText;
  window.progressText = function () {
    if (st.region && st.runRef === run) {
      const cur = nodeById(st.currentId);
      return '深度带 D' + cur.band + '/8　' + RedAbyss.LAYER_AT(cur.band).name;
    }
    return _progressText();
  };

  const _showMap = window.showMap;
  window.showMap = function () {
    _showMap();
    // 新地图模式：地图选择态 = 地图居中 + 键盘光标（方向键选路 / 空格进入）。
    // 懒初始化：startRun 内部就会调 showMap，此时 initRun 还没跑过；换新局（run 引用变了）也在这里重开。
    if (!st.region || st.runRef !== run) initRun();
    document.getElementById('hud-layer').textContent = progressText();
    const p = document.getElementById('flow-panel');
    p.textContent = '';
    p.classList.add('map-mode');           // 地图选择态：面板顶对齐，给居中小图让位
    const cur = nodeById(st.currentId);
    const head = el('div', 'maphead');
    head.appendChild(el('h2', '', '第 ' + cur.band + ' 深度带　' + RedAbyss.LAYER_AT(cur.band).name));
    head.appendChild(el('div', 'progress', '深度带 D' + cur.band + '/8　·　已触发 ' +
      Object.keys(st.visited).length + ' / ' + st.region.nodes.length + ' 格　·　' + (LAYER_NOTE[cur.band] || '')));
    if (st._rescueNote) { head.appendChild(el('div', 'statline', st._rescueNote)); st._rescueNote = null; }
    p.appendChild(head);
    // 2026-10-31 反馈：地图选择态用大图（居中偏下、行程在左），本态就是主内容
    const dk = document.getElementById('mm-dock');
    dk.classList.add('show', 'big');
    renderMiniMap();   // _showScreen 里渲染时 region 未就绪，这里必须重画一次
    // 初始光标：落在第一个可走节点上（方向键可直接微调，空格立即可用）
    const picks0 = currentPicks();
    if (!st.cursorId || picks0.indexOf(st.cursorId) < 0) st.cursorId = picks0[0] || null;
    // 死路检测：无未访问出边且非 finalBoss → 给「另寻一路」（T57 死路救援）
    if (isDeadEnd()) {
      p.appendChild(el('div', 'statline', '路在这里沉下去了——必须回返（点走过的格子，或点下面的按钮）。'));
      const rb = el('button', '', '必须回返');
      rb.id = 'btn-rescue';
      rb.addEventListener('click', doRescue);
      p.appendChild(rb);
      p.appendChild(el('div', 'flavor', '回返必有遭遇：坏事件 45% / 战斗 30% / 精英 15% / 跨带BOSS 8% / 空手 2%。'));
    }
    const foot = el('div', 'mapfoot');
    const b = el('button', '', '打开总图');
    b.id = 'btn-open-fullmap';
    b.addEventListener('click', openFullMap);
    foot.appendChild(b);
    foot.appendChild(el('span', 'map-hint', '方向键选路 · 空格进入 · 点走过的格子回返（有代价） · Tab 开总图'));
    p.appendChild(foot);
    paintCursor();
    // 总图开着时热刷新（迷雾随 visited 变化），滚动位置不丢
    if (fm.open) buildFullMap(true);
  };

  /* ── 键盘光标：方向键在可选节点间移动，空格/回车进入 ── */
  function currentPicks() {
    return st.region.edges.filter(e => e.from === st.currentId).map(e => e.to);  // 可走=出边终点，与渲染口径一致
  }
  function paintCursor() {
    document.querySelectorAll('.fm-node.cursor').forEach(g => g.classList.remove('cursor'));
    if (!st.cursorId) return;
    document.querySelectorAll('.fm-node[data-nid="' + st.cursorId + '"]').forEach(g => g.classList.add('cursor'));
  }
  function moveCursor(dir) {
    const picks = currentPicks();
    if (!picks.length) return;
    const fromId = (st.cursorId && picks.indexOf(st.cursorId) >= 0) ? st.cursorId : st.currentId;
    const from = nodeById(fromId);
    const v = { ArrowUp: [0, -1], ArrowDown: [0, 1], ArrowLeft: [-1, 0], ArrowRight: [1, 0] }[dir];
    let best = null, bestScore = Infinity;
    picks.forEach(id => {
      if (id === from.id) return;
      const n = nodeById(id);
      const dx = n.x - from.x, dy = n.y - from.y;
      const along = dx * v[0] + dy * v[1];
      if (along <= 0) return;
      const perp = Math.abs(dx * v[1] - dy * v[0]);
      const score = along + perp * 1.5;
      if (score < bestScore) { bestScore = score; best = id; }
    });
    if (best) { st.cursorId = best; paintCursor(); }
  }
  document.addEventListener('keydown', e => {
    if (!st.region || st.runRef !== run) return;
    if (fm.open) return;                       // 总图开着时不抢键盘
    if (phase !== 'map') return;               // 只在地图选择态
    if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].indexOf(e.key) >= 0) {
      e.preventDefault();
      moveCursor(e.key);
    } else if (e.key === ' ' || e.key === 'Enter') {
      const picks = currentPicks();
      if (st.cursorId && picks.indexOf(st.cursorId) >= 0) {
        e.preventDefault();
        playSfx('ui.click');
        enterNode(st.cursorId);
      }
    }
  });

  // 奖励/事件/商店/营火的收尾全部汇入 advanceNode——新地图在这里「到达」节点
  const _advanceNode = window.advanceNode;
  window.advanceNode = function () {
    if (st.region && st.runRef === run && st._pendingNode) { arriveAtNode(); return; }
    _advanceNode();
  };
  // 奖励结算按 layerRows()[run.row][run.col] 取节点类型——新地图给合成行（含运行时 BOSS 替换）
  const _layerRows = window.layerRows;
  window.layerRows = function () {
    if (st.region && st.runRef === run) return [[{ type: st._effType || 'combat' }]];
    return _layerRows();
  };

  document.getElementById('btn-fullmap').addEventListener('click', openFullMap);
  document.getElementById('fm-close').addEventListener('click', closeFullMap);
  document.getElementById('fullmap-layer').addEventListener('click', e => {
    if (e.target.id === 'fullmap-layer') closeFullMap();   // 点背景关
  });
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && fm.open) closeFullMap();     // Esc 关（叠加在既有 Esc 处理之上）
  });
  const fmSvgBox = document.getElementById('fm-svg');
  fmSvgBox.addEventListener('wheel', fmWheel, { passive: false });
  fmSvgBox.addEventListener('pointerdown', fmPan);
  document.getElementById('fm-zin').addEventListener('click', () => fmSetZoom(fm.z * 1.2));
  document.getElementById('fm-zout').addEventListener('click', () => fmSetZoom(fm.z / 1.2));
  document.getElementById('fm-zreset').addEventListener('click', () => fmSetZoom(1));
  // T74 后续反馈：Tab 开关总图 + HUD 按钮入口（游戏中随时可用）
  if (hudMapBtn) hudMapBtn.addEventListener('click', () => {
    playSfx('ui.click');
    if (fm.open) closeFullMap(); else openFullMap();
  });
  document.addEventListener('keydown', e => {
    if (e.key !== 'Tab') return;
    if (!st.region || st.runRef !== run) return;   // 只在局内
    e.preventDefault();                            // 别让 Tab 去挪焦点
    playSfx('ui.click');
    if (fm.open) closeFullMap(); else openFullMap();
  });
  let _rzT = 0;
  window.addEventListener('resize', () => {
    clearTimeout(_rzT);
    _rzT = setTimeout(() => {
      const dk = document.getElementById('mm-dock');
      if (st.region && dk && dk.classList.contains('show')) renderMiniMap();
    }, 120);
  });

  window.NewMap = { st, openFullMap, closeFullMap, renderMiniMap, visible, effTypeOf, enterNode, doRescue,
    debug: {
      isDeadEnd,
      // 验收用：把当前格的所有出边终点标记为已触发（模拟「都走过了」），强制死路状态
      forceDeadEnd() {
        st.region.edges.filter(e => e.from === st.currentId).forEach(e => { st.visited[e.to] = true; });
        showMap();
        return isDeadEnd();
      },
      // 验收用：直接走完 finalBoss 战斗到结算（赢了才到 showVictory，输了走死亡）
      jumpToFinalBoss() {
        const fb = nodeById(st.region.finalBossId);
        const e0 = st.region.edges.find(e => e.to === fb.id);
        const up = e0 ? nodeById(e0.from) : st.region.nodes.find(n => n.band === 8 && n.id !== fb.id);
        if (!up) return false;
        st.currentId = up.id; st.visited[up.id] = true;
        enterNode(fb.id);
        return true;
      },
      winFight() {
        // 验收用：清场并走结算链（置胜负字段=引擎 checkCombatEnd 胜利分支的等价操作，
        // 该函数在引擎闭包内不可直接调用 → finishCombatFlow → 奖励 → advanceNode → 到达）
        if (!C || C.over) return false;
        C.enemies.forEach(e => { e.hp = 0; e.dead = true; });
        C.over = true; C.result = 'win';
        finishCombatFlow();
        return true;
      },
      // T71 验收：小图面板/格子/节点/文字的实际 DOM 尺寸
      metrics() {
        const dk = document.getElementById('mm-dock'), mini = document.getElementById('minimap'),
          body = document.getElementById('mm-body'), rowsBox = document.getElementById('mm-log-rows');
        const circ = document.querySelector('#mm-body .fm-node circle');
        const glyph = document.querySelector('#mm-body .fm-glyph');
        const eco = document.querySelector('#mm-body .fm-eco');
        const lm = st._lastMini;
        const dkR = dk ? dk.getBoundingClientRect() : null;
        return {
          viewport: { w: window.innerWidth, h: window.innerHeight },
          dockPos: dkR ? { top: Math.round(dkR.top), rightGap: Math.round(window.innerWidth - dkR.right),
            rightEdge: Math.round(dkR.right), mode: dk.classList.contains('big') ? 'big' : (dk.classList.contains('show') ? 'corner' : 'hidden') } : null,
          dock: dk ? { w: dk.clientWidth, h: dk.clientHeight } : null,
          panel: mini ? { w: mini.clientWidth, h: mini.clientHeight,
            fillsDock: dk ? Math.abs(mini.clientWidth - dk.clientWidth) < 2 : null } : null,
          mapArea: body ? { w: body.clientWidth, h: body.clientHeight } : null,
          cellPx: eco ? { w: +eco.getAttribute('width'), h: +eco.getAttribute('height') } : null,
          nodeDiameterPx: circ ? +circ.getBoundingClientRect().width.toFixed(1) : null,
          glyphFontPx: glyph ? parseFloat(getComputedStyle(glyph).fontSize) : null,
          blankPct: (lm && body) ? +(100 * (1 - (lm.W * lm.H) / (body.clientWidth * body.clientHeight))).toFixed(2) : null,
          logRows: boxRows(),
          logScrollable: rowsBox ? rowsBox.scrollHeight > rowsBox.clientHeight + 2 : null,
          pageScrollbar: document.documentElement.scrollWidth > window.innerWidth + 1 ||
            document.documentElement.scrollHeight > window.innerHeight + 1
        };
        function boxRows() { const b = document.getElementById('mm-log-rows'); return b ? b.querySelectorAll('.mm-row').length : 0; }
      },
      // T71 验收：扫格子里的禁字（#mm-body / #fm-svg 的文本 + 节点 aria）
      cellsScan() {
        const bad = /[战事随商英]/;
        const hits = [];
        ['#mm-body', '#fm-svg'].forEach(sel => {
          const box = document.querySelector(sel);
          if (!box) return;
          if (bad.test(box.textContent)) hits.push(sel + ' 文本命中');
          box.querySelectorAll('.fm-node').forEach(g => {
            const a = g.getAttribute('aria-label') || '';
            if (bad.test(a)) hits.push((g.getAttribute('data-nid') || '?') + ' aria命中');
          });
        });
        return { banned: '战事随商英', hits, clean: hits.length === 0 };
      },
      // T71 验收：行程列表内容倒序 dump
      backtrackLog() { return st.backtrackLog.slice(); },   // T75: 持久回返遭遇日志（跨战斗不丢）
      logDump() {
        return st.log.map(e => ({ nid: e.nid, name: e.name, word: e.word,
          gains: e.gains.join('；'), desc: e.desc }));
      },
      state() {
        return { current: st.currentId, visited: Object.keys(st.visited).length,
          dead: st.region ? isDeadEnd() : false, cross: st.crossCount,
          override: Object.keys(st.override), pending: st._pendingNode, log: st.log.length };
      }
    } };
})();
</script>
</body>
</html>
